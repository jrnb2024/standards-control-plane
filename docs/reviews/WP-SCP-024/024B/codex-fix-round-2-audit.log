21\t\n   122\tusage() {\n   123\t  cat <<'EOF' >&2\n   124\tUsage: enable-required-check.sh --repo OWNER/NAME --branch BRANCH [flags]\n   125\t\n   126\tRequired:\n   127\t  --repo OWNER/NAME   Target repository (e.g. mapp-pim/mapp-pim).\n   128\t  --branch BRANCH     Default branch to protect (typically `main`).\n   129\t\n   130\tFlags:\n   131\t  --required-check NAME    Override the required-check context name.\n   132\t                           Default: \"policy-check / scp/policy-check\".\n   133\t  --plan                   Print the PUT payload AND current branch-\n   134\t                           protection state without applying. Use\n   135\t                           this first to verify intent.\n   136\t  --no-enforce-admins      Disable enforce_admins. NOT canonical;\n   137\t                           requires a separate\n   138\t                           --i-understand-this-bypasses-the-gate flag\n   139\t                           to take effect (per 020G R1 SAF-003 closure).\n   140\t  --i-understand-this-bypasses-the-gate\n   141\t                           Required confirmation when combined with\n   142\t                           --no-enforce-admins. Without this flag, the\n   143\t                           script ignores --no-enforce-admins.\n   144\t  --restore PRE-STATE.json  Restore branch protection from a captured\n   145\t                           pre-state JSON emitted by a prior run.\n   146\t  --i-understand-this-repo-has-no-prior-green-ci\n   147\t                           Override the forward-mode precondition that\n   148\t                           the target repo has already green-CI'd once.\n   149\t  --help / -h              Show this help.\n   150\t\n   151\tBootstrap-only — this script is NOT run unattended. It refuses to\n   152\trun when CI=true or GITHUB_ACTIONS=true. Operator attention is\n   153\trequired for the apply, the diff review, and the invocation-log\n   154\tcommit afterward.\n   155\t\n   156\tReference: docs/DECISIONS.md D-022 (federation primitive adoption);\n   157\tD-033 (rendered context-name `policy-check / scp/policy-check`);\n   158\tD-035 (this slice's invocation procedure); WP-SCP-020 §4 020G.\n   159\tEOF\n   160\t}\n   161\t\n   162\twhile [ $# -gt 0 ]; do\n   163\t  case \"$1\" in\n   164\t    --repo)\n   165\t      [ $# -lt 2 ] && { echo \"error: --repo requires a value\" >&2; usage; exit 2; }\n   166\t      REPO=\"$2\"; shift 2 ;;\n   167\t    --branch)\n   168\t      [ $# -lt 2 ] && { echo \"error: --branch requires a value\" >&2; usage; exit 2; }\n   169\t      BRANCH=\"$2\"; shift 2 ;;\n   170\t    --required-check)\n   171\t      [ $# -lt 2 ] && { echo \"error: --required-check requires a value\" >&2; usage; exit 2; }\n   172\t      REQUIRED_CONTEXT=\"$2\"; shift 2 ;;\n   173\t    --plan) PLAN_ONLY=1; shift ;;\n   174\t    --enforce-admins) ENFORCE_ADMINS=\"true\"; shift ;;\n   175\t    --no-enforce-admins) ENFORCE_ADMINS=\"false\"; shift ;;\n   176\t    --i-understand-this-bypasses-the-gate) ACK_ADMIN_BYPASS=1; shift ;;\n   177\t    --restore)\n   178\t      [ $# -lt 2 ] && { echo \"error: --restore requires a value\" >&2; usage; exit 2; }\n   179\t      RESTORE_STATE=\"$2\"; shift 2 ;;\n   180\t    --i-understand-this-repo-has-no-prior-green-ci) ACK_NO_PRIOR_GREEN_CI=1; shift ;;\n   181\t    -h|--help) usage; exit 0 ;;\n   182\t    *) echo \"unknown flag: $1\" >&2; usage; exit 2 ;;\n   183\t  esac\n   184\tdone\n   185\t\n   186\tif [ -n \"$RESTORE_STATE\" ] && { [ -n \"$REPO\" ] || [ -n \"$BRANCH\" ] || [ \"$PLAN_ONLY\" -eq 1 ] || [ \"$ACK_ADMIN_BYPASS\" -eq 1 ] || [ \"$ACK_NO_PRIOR_GREEN_CI\" -eq 1 ] || [ \"$ENFORCE_ADMINS\" != \"true\" ]; }; then\n   187\t  echo \"error: --restore is a standalone mode and cannot be combined with forward-mode flags\" >&2\n   188\t  usage\n   189\t  exit 2\n   190\tfi\n   191\t\n   192\tif [ -z \"$RESTORE_STATE\" ] && { [ -z \"$REPO\" ] || [ -z \"$BRANCH\" ]; }; then\n   193\t  echo \"error: --repo and --branch are both required\" >&2\n   194\t  usage\n   195\t  exit 2\n   196\tfi\n   197\t\n   198\t# Closes 020G R2 correctness CORR2-003: --i-understand-this-bypasses-\n   199\t# the-gate is silently meaningless without --no-enforce-admins.\n   200\t# Refuse the combination so an operator who pre-fills the long flag\n   201\t# from history but forgets the trigger sees a clear error.\n   202\tif [ \"$ACK_ADMIN_BYPASS\" -eq 1 ] && [ \"$ENFORCE_ADMINS\" = \"true\" ]; then\n   203\t  echo \"error: --i-understand-this-bypasses-the-gate is meaningless without --no-enforce-admins\" >&2\n   204\t  echo \"       remove the ack flag, or pair it with --no-enforce-admins\" >&2\n   205\t  exit 2\n   206\tfi\n   207\t\n   208\t# Per 020G R1 safety SAF-003: --no-enforce-admins is a serious\n   209\t# foot-gun. Refuse silently unless the explicit acknowledgement\n   210\t# flag is also set. With the flag, escalate to a 5-second pause\n   211\t# + visible warning so the operator who actually means it\n   212\t# can't run on autopilot.\n   213\tif [ \"$ENFORCE_ADMINS\" != \"true\" ]; then\n   214\t  if [ \"$ACK_ADMIN_BYPASS\" -ne 1 ]; then\n   215\t    echo \"error: --no-enforce-admins ignored without --i-understand-this-bypasses-the-gate\" >&2\n   216\t    echo \"       enforce_admins=true is the canonical SCP federation primitive posture.\" >&2\n   217\t    exit 2\n   218\t  fi\n   219\t  echo \"\" >&2\n   220\t  echo \"================================================================\" >&2\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba scripts/enable-required-check.sh | sed -n '220,420p'\"","aggregated_output":"   220\t  echo \"================================================================\" >&2\n   221\t  echo \"WARNING: --no-enforce-admins applied with explicit acknowledgement.\" >&2\n   222\t  echo \"         This means repository administrators can push directly\" >&2\n   223\t  echo \"         to '$BRANCH' bypassing the SCP policy-check gate.\" >&2\n   224\t  echo \"         5-second pause to allow Ctrl-C...\" >&2\n   225\t  echo \"================================================================\" >&2\n   226\t  sleep 5\n   227\tfi\n   228\t\n   229\tif [ -z \"$RESTORE_STATE\" ]; then\n   230\t# Path-traversal guard on REPO + BRANCH (per 020G R1 safety SAF-006\n   231\t# + 020G R2 correctness CORR2-002 — `owner/..` would have satisfied\n   232\t# the original regex because `..` matches `[A-Za-z0-9._-]+`).\n   233\t# Repo names match GitHub's ASCII rules; branch names disallow `..`\n   234\t# or leading slashes that could be misread by url joining.\n   235\t  if printf '%s' \"$REPO\" | grep -qE '(^|/)\\.'; then\n   236\t    echo \"error: --repo '$REPO' contains path-traversal sequence (.., leading dot, dot-segment after /)\" >&2\n   237\t    exit 2\n   238\t  fi\n   239\t  if ! printf '%s' \"$REPO\" | grep -qE '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$'; then\n   240\t    echo \"error: --repo '$REPO' does not match owner/name shape\" >&2\n   241\t    exit 2\n   242\t  fi\n   243\t  if printf '%s' \"$BRANCH\" | grep -qE '(^\\.|/|\\.\\.)'; then\n   244\t    echo \"error: --branch '$BRANCH' invalid (no slashes, no .., no leading dot)\" >&2\n   245\t    exit 2\n   246\t  fi\n   247\t\n   248\t  if [ \"$ACK_NO_PRIOR_GREEN_CI\" -ne 1 ]; then\n   249\t    WORKFLOW_ID=\"$(\n   250\t      gh api \"repos/${REPO}/actions/workflows\" \\\n   251\t        --jq '.workflows[] | select(.name == \"policy-check\") | .id' \\\n   252\t        | head -1 || true\n   253\t    )\"\n   254\t    if [ -z \"$WORKFLOW_ID\" ]; then\n   255\t      echo \"ERROR: target ${REPO} has no registered policy-check workflow; refuse to enable required-check before wrapper has green-CI'd at least once. (Override with --i-understand-this-repo-has-no-prior-green-ci if you accept the risk.)\" >&2\n   256\t      exit 1\n   257\t    fi\n   258\t    prior_green_cutoff=\"$(\n   259\t      python3 -c 'import datetime; print((datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=60)).strftime(\"%Y-%m-%dT%H:%M:%SZ\"))'\n   260\t    )\"\n   261\t    prior_green_ci=\"$(\n   262\t      gh api \"repos/${REPO}/actions/runs?workflow_id=${WORKFLOW_ID}&status=success&created=>=${prior_green_cutoff}\" \\\n   263\t        --jq '.workflow_runs[]' \\\n   264\t        | head -1 || true\n   265\t    )\"\n   266\t    if [ -z \"$prior_green_ci\" ]; then\n   267\t      echo \"ERROR: target ${REPO} has no successful policy-check workflow runs in the last 60 days; refuse to enable required-check before wrapper has green-CI'd at least once. Override with --i-understand-this-repo-has-no-prior-green-ci if you accept the risk.\" >&2\n   268\t      exit 1\n   269\t    fi\n   270\t  fi\n   271\tfi\n   272\t\n   273\t# Closes 020G R3 safety SAF-R3-002: REQUIRED_CONTEXT is included\n   274\t# verbatim in the emitted markdown log block; backticks or\n   275\t# newlines would corrupt the operator's pasteable log entry. Reject\n   276\t# obvious markdown-injection chars. The actual GitHub Actions\n   277\t# check-run name space is bounded (alphanumerics, slashes, spaces,\n   278\t# hyphens, parentheses) — no legitimate name needs backticks or\n   279\t# newlines.\n   280\tcase \"$REQUIRED_CONTEXT\" in\n   281\t  *'`'*|*$'\\n'*|*$'\\r'*)\n   282\t    echo \"error: --required-check '$REQUIRED_CONTEXT' contains markdown-corrupting chars (backtick, CR, LF)\" >&2\n   283\t    exit 2 ;;\n   284\tesac\n   285\tif [ \"${#REQUIRED_CONTEXT}\" -gt 200 ]; then\n   286\t  echo \"error: --required-check value is ${#REQUIRED_CONTEXT} chars; max 200\" >&2\n   287\t  exit 2\n   288\tfi\n   289\t\n   290\tlog() {\n   291\t  printf '[020G] %s\\n' \"$*\"\n   292\t}\n   293\t\n   294\trestore_branch_protection() {\n   295\t  local restore_path=\"$1\"\n   296\t  local restore_meta\n   297\t  local restore_repo\n   298\t  local restore_branch\n   299\t  local restore_before_json\n   300\t  local restore_current_state\n   301\t  local restore_after_json\n   302\t  local restore_ts\n   303\t  local restore_operator\n   304\t  local restore_script_path\n   305\t  local restore_script_sha256\n   306\t  local restore_script_git_sha\n   307\t\n   308\t  if [ ! -f \"$restore_path\" ]; then\n   309\t    echo \"error: --restore file not found: $restore_path\" >&2\n   310\t    exit 2\n   311\t  fi\n   312\t\n   313\t  if ! restore_meta=\"$(python3 - \"$restore_path\" <<'PY'\n   314\timport json\n   315\timport sys\n   316\tfrom pathlib import Path\n   317\t\n   318\tstate = json.loads(Path(sys.argv[1]).read_text(encoding=\"utf-8\"))\n   319\tif not isinstance(state, dict):\n   320\t    raise SystemExit(\"restore JSON must be an object\")\n   321\tfor key in (\"repo\", \"branch\", \"before\"):\n   322\t    if key not in state:\n   323\t        raise SystemExit(f\"restore JSON missing required key: {key}\")\n   324\tif not isinstance(state[\"repo\"], str) or not state[\"repo\"]:\n   325\t    raise SystemExit(\"restore JSON 'repo' value must be a non-empty string\")\n   326\tif not isinstance(state[\"branch\"], str) or not state[\"branch\"]:\n   327\t    raise SystemExit(\"restore JSON 'branch' value must be a non-empty string\")\n   328\tbefore = state[\"before\"]\n   329\tif not isinstance(before, dict):\n   330\t    raise SystemExit(\"restore JSON 'before' value must be an object\")\n   331\tfor key in (\"required_status_checks\", \"enforce_admins\", \"required_pull_request_reviews\", \"restrictions\"):\n   332\t    if key not in before:\n   333\t        raise SystemExit(f\"restore JSON 'before' missing required key: {key}\")\n   334\t\n   335\trequired_status_checks = before.get(\"required_status_checks\")\n   336\tif not isinstance(required_status_checks, dict):\n   337\t    raise SystemExit(\"restore JSON 'before' missing or malformed key: required_status_checks\")\n   338\tenforce_admins = before.get(\"enforce_admins\")\n   339\tif not isinstance(enforce_admins, dict) or not isinstance(enforce_admins.get(\"enabled\"), bool):\n   340\t    raise SystemExit(\"restore JSON 'before' missing or malformed key: enforce_admins.enabled\")\n   341\trequired_pull_request_reviews = before.get(\"required_pull_request_reviews\")\n   342\tif required_pull_request_reviews is not None and not isinstance(required_pull_request_reviews, dict):\n   343\t    raise SystemExit(\"restore JSON 'before' missing or malformed key: required_pull_request_reviews\")\n   344\trestrictions = before.get(\"restrictions\")\n   345\tif restrictions is not None and not isinstance(restrictions, dict):\n   346\t    raise SystemExit(\"restore JSON 'before' missing or malformed key: restrictions\")\n   347\tprint(state[\"repo\"])\n   348\tprint(state[\"branch\"])\n   349\tprint(json.dumps(before))\n   350\tPY\n   351\t  )\"; then\n   352\t    exit 1\n   353\t  fi\n   354\t\n   355\t  restore_repo=\"$(printf '%s' \"$restore_meta\" | sed -n '1p')\"\n   356\t  restore_branch=\"$(printf '%s' \"$restore_meta\" | sed -n '2p')\"\n   357\t  restore_before_json=\"$(printf '%s' \"$restore_meta\" | sed -n '3p')\"\n   358\t\n   359\t  if [ -z \"$restore_repo\" ] || [ -z \"$restore_branch\" ] || [ -z \"$restore_before_json\" ]; then\n   360\t    echo \"error: invalid --restore file\" >&2\n   361\t    exit 2\n   362\t  fi\n   363\t\n   364\t  if printf '%s' \"$restore_repo\" | grep -qE '(^|/)\\.'; then\n   365\t    echo \"error: --restore repo '$restore_repo' contains path-traversal sequence (.., leading dot, dot-segment after /)\" >&2\n   366\t    exit 2\n   367\t  fi\n   368\t  if ! printf '%s' \"$restore_repo\" | grep -qE '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$'; then\n   369\t    echo \"error: --restore repo '$restore_repo' does not match owner/name shape\" >&2\n   370\t    exit 2\n   371\t  fi\n   372\t  if printf '%s' \"$restore_branch\" | grep -qE '(^\\.|/|\\.\\.)'; then\n   373\t    echo \"error: --restore branch '$restore_branch' invalid (no slashes, no .., no leading dot)\" >&2\n   374\t    exit 2\n   375\t  fi\n   376\t\n   377\t  printf '[020G] restoring branch protection for %s@%s\\n' \"$restore_repo\" \"$restore_branch\" >&2\n   378\t  restore_current_state=\"$(gh api -X GET \"repos/${restore_repo}/branches/${restore_branch}/protection\" 2>/dev/null || echo '{\"_note\":\"capture-failed\"}')\"\n   379\t  printf '%s' \"$restore_before_json\" | gh api -X PUT \"repos/${restore_repo}/branches/${restore_branch}/protection\" \\\n   380\t    -H \"Accept: application/vnd.github+json\" \\\n   381\t    --input - >/dev/null\n   382\t\n   383\t  restore_after_json=\"$(gh api -X GET \"repos/${restore_repo}/branches/${restore_branch}/protection\")\"\n   384\t  restore_ts=\"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"\n   385\t  restore_operator=\"$(gh api user --jq '.login' 2>/dev/null || echo unknown)\"\n   386\t  restore_script_path=\"$(readlink -f \"$0\" 2>/dev/null || printf '%s' \"$0\")\"\n   387\t  restore_script_sha256=\"$(shasum -a 256 \"$restore_script_path\" | awk '{print $1}')\"\n   388\t  restore_script_git_sha=\"$(git -C \"$(dirname \"$restore_script_path\")\" log -1 --format=%H -- \"$(basename \"$restore_script_path\")\" 2>/dev/null || true)\"\n   389\t  restore_script_git_sha=\"${restore_script_git_sha:-not-in-git-clone}\"\n   390\t\n   391\t  cat <<EOF\n   392\t---\n   393\t\n   394\t## Invocation log entry\n   395\t\n   396\tAppend the block below to docs/reviews/WP-SCP-020/branch-protection-log.md on the SCP repo, commit on a feature branch, open PR, merge:\n   397\t\n   398\t~~~markdown\n   399\t### ${restore_ts} — ${restore_repo}@${restore_branch}\n   400\t\n   401\t- **MODE:** restore\n   402\t- **Operator:** @${restore_operator}\n   403\t- **Script SHA256:** \\`${restore_script_sha256}\\` (hash of executed file)\n   404\t- **Script git SHA:** \\`${restore_script_git_sha}\\` (last committed; \"not-in-git-clone\" if N/A)\n   405\t- **Plan-only:** no\n   406\t- **Restoring TO (original captured before-state):**\n   407\t\\`\\`\\`json\n   408\t$(printf '%s' \"$restore_before_json\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$restore_before_json\")\n   409\t\\`\\`\\`\n   410\t- **Before:**\n   411\t\\`\\`\\`json\n   412\t$(printf '%s' \"$restore_current_state\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$restore_current_state\")\n   413\t\\`\\`\\`\n   414\t- **After:**\n   415\t\\`\\`\\`json\n   416\t$(printf '%s' \"$restore_after_json\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$restore_after_json\")\n   417\t\\`\\`\\`\n   418\t~~~\n   419\t\n   420\tThe Before/After JSON blocks are authoritative; scalar mirrors are omitted to avoid stale copies of branch-protection fields.\n","exit_code":0,"status":"completed"}}

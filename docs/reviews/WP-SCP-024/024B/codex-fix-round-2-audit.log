{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba scripts/enable-required-check.sh | sed -n '420,620p'\"","aggregated_output":"   420\tThe Before/After JSON blocks are authoritative; scalar mirrors are omitted to avoid stale copies of branch-protection fields.\n   421\tThe log commit is part of the invocation procedure per WP-SCP-020 §4 020G(iii) + D-035; without it the restore is unrecorded.\n   422\tEOF\n   423\t}\n   424\t\n   425\tif [ -n \"$RESTORE_STATE\" ]; then\n   426\t  restore_branch_protection \"$RESTORE_STATE\"\n   427\t  exit 0\n   428\tfi\n   429\t\n   430\tlog \"target repo: $REPO\"\n   431\tlog \"target branch: $BRANCH\"\n   432\tlog \"required check: $REQUIRED_CONTEXT\"\n   433\tlog \"enforce_admins: $ENFORCE_ADMINS\"\n   434\t[ \"$PLAN_ONLY\" = \"1\" ] && log \"MODE: plan-only (no API mutation)\"\n   435\t\n   436\t# ---------- Construct PUT payload ----------\n   437\t#\n   438\t# Per 020G R1 correctness CORR-003: required_signatures is a\n   439\t# DEDICATED sub-resource and is NOT a documented field of the\n   440\t# unified branch-protection PUT body. Apply it separately via\n   441\t# the /required_signatures endpoint after the main PUT. The\n   442\t# unified PUT body therefore omits required_signatures.\n   443\t#\n   444\t# Per 020G R1 safety SAF-002: required_pull_request_reviews must\n   445\t# be PRESERVED if it already exists. We capture before-state and\n   446\t# splice the existing review-shape into the PUT payload rather\n   447\t# than nulling it out.\n   448\t\n   449\tbuild_payload() {\n   450\t  local existing_reviews=\"$1\"\n   451\t  jq -n \\\n   452\t    --arg context \"$REQUIRED_CONTEXT\" \\\n   453\t    --argjson admins \"$ENFORCE_ADMINS\" \\\n   454\t    --argjson reviews \"$existing_reviews\" \\\n   455\t    '{\n   456\t       required_status_checks: {\n   457\t         strict: true,\n   458\t         contexts: [$context]\n   459\t       },\n   460\t       enforce_admins: $admins,\n   461\t       required_pull_request_reviews: $reviews,\n   462\t       restrictions: null,\n   463\t       required_linear_history: false,\n   464\t       allow_force_pushes: false,\n   465\t       allow_deletions: false,\n   466\t       block_creations: false,\n   467\t       required_conversation_resolution: false,\n   468\t       lock_branch: false,\n   469\t       allow_fork_syncing: false\n   470\t     }'\n   471\t}\n   472\t\n   473\t# ---------- Capture before-state ----------\n   474\t\n   475\tlog \"capturing before-state...\"\n   476\tBEFORE_RAW=\"$(gh api -X GET \"repos/${REPO}/branches/${BRANCH}/protection\" 2>&1)\" || BEFORE_STATUS=$?\n   477\tBEFORE_STATUS=\"${BEFORE_STATUS:-0}\"\n   478\t\n   479\tif [ \"$BEFORE_STATUS\" -eq 0 ]; then\n   480\t  BEFORE_JSON=\"$BEFORE_RAW\"\n   481\telif printf '%s' \"$BEFORE_RAW\" | grep -q \"Branch not protected\"; then\n   482\t  BEFORE_JSON='{\"_note\":\"no protection currently configured\"}'\n   483\telse\n   484\t  echo \"error: gh api GET branch protection failed; cannot proceed safely\" >&2\n   485\t  echo \"$BEFORE_RAW\" >&2\n   486\t  exit 1\n   487\tfi\n   488\t\n   489\t# Extract existing required_pull_request_reviews, default to null\n   490\t# if absent. Either way, we send what was there.\n   491\tEXISTING_REVIEWS=\"$(printf '%s' \"$BEFORE_JSON\" | jq '.required_pull_request_reviews // null')\"\n   492\t\n   493\t# Per WP-SCP-022 020H pt 3 R3 SAFE-R3-003 closure (2026-04-30):\n   494\t# multi-maintainer adopters MUST set dismiss_stale_reviews: true to\n   495\t# close the post-approval-malicious-push attack surface (see\n   496\t# ADOPT-001 §12.7.4). This script preserves the adopter's existing\n   497\t# review-shape verbatim and does NOT set dismiss_stale_reviews; emit\n   498\t# a stderr WARNING if it is currently false or absent so the operator\n   499\t# is prompted to configure it explicitly.\n   500\tDISMISS_STALE_VAL=\"$(printf '%s' \"$EXISTING_REVIEWS\" | jq -r '\n   501\t  if . == null then \"absent\"\n   502\t  elif (.dismiss_stale_reviews // false) == true then \"true\"\n   503\t  else \"false\"\n   504\t  end\n   505\t')\"\n   506\tif [ \"$DISMISS_STALE_VAL\" != \"true\" ]; then\n   507\t  echo \"[020G] WARNING: required_pull_request_reviews.dismiss_stale_reviews is ${DISMISS_STALE_VAL} on the target repo\" >&2\n   508\t  echo \"[020G] WARNING: multi-maintainer SCP adopters MUST set dismiss_stale_reviews: true (ADOPT-001 §12.7.4)\" >&2\n   509\t  echo \"[020G] WARNING: this script preserves the existing review-shape verbatim and does not set this for you\" >&2\n   510\t  echo \"[020G] WARNING: configure it via 'gh api -X PATCH repos/<owner>/<repo>/branches/<branch>/protection/required_pull_request_reviews -F dismiss_stale_reviews=true'\" >&2\n   511\t  echo \"[020G] WARNING: single-operator adopters with required_approving_review_count=0 (per D-033) can ignore this warning\" >&2\n   512\tfi\n   513\t\n   514\tPAYLOAD=\"$(build_payload \"$EXISTING_REVIEWS\")\"\n   515\t\n   516\tif [ \"$PLAN_ONLY\" = \"1\" ]; then\n   517\t  log \"current branch-protection state (before):\"\n   518\t  printf '%s\\n' \"$BEFORE_JSON\" | jq .\n   519\t  log \"plan (would PUT to repos/${REPO}/branches/${BRANCH}/protection):\"\n   520\t  printf '%s\\n' \"$PAYLOAD\" | jq .\n   521\t  log \"post-PUT, would also enable required_signatures via the dedicated sub-resource.\"\n   522\t  log \"to apply, re-run without --plan\"\n   523\t  exit 0\n   524\tfi\n   525\t\n   526\t# ---------- Apply ----------\n   527\t\n   528\t# Closes 020G R2 safety SAF-R2-001: trap a non-zero exit during\n   529\t# the apply phase so partial state still emits an audit-trail\n   530\t# log entry. Otherwise `set -e` skips log emission entirely on\n   531\t# any HTTP 403/network failure during the dedicated POST step.\n   532\t\n   533\tAPPLY_FAIL=0\n   534\t\n   535\tlog \"applying branch protection (unified PUT)...\"\n   536\tprintf '%s' \"$PAYLOAD\" | gh api -X PUT \"repos/${REPO}/branches/${BRANCH}/protection\" \\\n   537\t  -H \"Accept: application/vnd.github+json\" \\\n   538\t  --input - >/dev/null || APPLY_FAIL=1\n   539\t\n   540\tif [ \"$APPLY_FAIL\" -ne 0 ]; then\n   541\t  echo \"ERROR: unified PUT failed; partial branch-protection state may exist on ${REPO}@${BRANCH}\" >&2\n   542\t  echo \"       continuing to log emission so the failure is auditable, then exiting non-zero\" >&2\n   543\t  FAIL=1\n   544\telse\n   545\t  log \"enabling required_signatures (dedicated sub-resource)...\"\n   546\t  gh api -X POST \"repos/${REPO}/branches/${BRANCH}/protection/required_signatures\" >/dev/null || APPLY_FAIL=1\n   547\t  if [ \"$APPLY_FAIL\" -ne 0 ]; then\n   548\t    echo \"ERROR: required_signatures POST failed; status-checks/admins/reviews are set but signatures are NOT\" >&2\n   549\t    echo \"       continuing to log emission so the partial-state failure is auditable, then exiting non-zero\" >&2\n   550\t    FAIL=1\n   551\t  fi\n   552\tfi\n   553\t\n   554\t# ---------- Verify ----------\n   555\t\n   556\tlog \"verifying...\"\n   557\tAFTER_JSON=\"$(gh api -X GET \"repos/${REPO}/branches/${BRANCH}/protection\")\"\n   558\t\n   559\tCHECKS_STRICT=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_status_checks.strict // false')\"\n   560\tCHECKS_CONTEXTS=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_status_checks.contexts // [] | join(\",\")')\"\n   561\tAPPLIED_ADMINS=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.enforce_admins.enabled // false')\"\n   562\tSIGS_ENABLED=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_signatures.enabled // false')\"\n   563\t\n   564\t# Closes 020G R3 correctness CORR3-001 + safety SAF-R3-001:\n   565\t# preserve any FAIL=1 set by the apply-phase trap. Initialising\n   566\t# FAIL=0 unconditionally would launder an apply-failure into a\n   567\t# false-success when the pre-existing state happens to satisfy\n   568\t# the verify checks. Default to 0 only if not already set.\n   569\tFAIL=\"${FAIL:-0}\"\n   570\t[ \"$CHECKS_STRICT\" = \"true\" ] || { echo \"verify FAIL: required_status_checks.strict=${CHECKS_STRICT}\" >&2; FAIL=1; }\n   571\tprintf '%s' \"$CHECKS_CONTEXTS\" | grep -q -F \"$REQUIRED_CONTEXT\" || { echo \"verify FAIL: contexts missing ${REQUIRED_CONTEXT} (got: ${CHECKS_CONTEXTS})\" >&2; FAIL=1; }\n   572\t[ \"$APPLIED_ADMINS\" = \"$ENFORCE_ADMINS\" ] || { echo \"verify FAIL: enforce_admins=${APPLIED_ADMINS} (expected ${ENFORCE_ADMINS})\" >&2; FAIL=1; }\n   573\t[ \"$SIGS_ENABLED\" = \"true\" ] || { echo \"verify FAIL: required_signatures=${SIGS_ENABLED}\" >&2; FAIL=1; }\n   574\t\n   575\t# Closes 020G R2 correctness CORR2-001 + safety SAF-R2-002: only\n   576\t# emit \"verification passed\" when FAIL=0. Previously this line\n   577\t# emitted unconditionally after the fall-through, producing a\n   578\t# misleading false-success message on stdout when verification had\n   579\t# actually failed.\n   580\tif [ \"${FAIL:-0}\" -ne 0 ]; then\n   581\t  echo \"verification failed; see message(s) above\" >&2\n   582\t  echo \"\" >&2\n   583\t  echo \"Even on failure, capture an invocation log entry so the audit trail\" >&2\n   584\t  echo \"records the failure. The before/after blocks below show the partial\" >&2\n   585\t  echo \"state and aid post-mortem.\" >&2\n   586\t  # fall through to log emission so an audit entry exists\n   587\telse\n   588\t  log \"verification passed ✓\"\n   589\t  log \"  required check:        ${CHECKS_CONTEXTS} (strict=${CHECKS_STRICT})\"\n   590\t  log \"  enforce_admins:        ${APPLIED_ADMINS}\"\n   591\t  log \"  required_signatures:   ${SIGS_ENABLED}\"\n   592\tfi\n   593\t\n   594\t# ---------- Emit invocation log ----------\n   595\t#\n   596\t# Per 020G R1 safety SAF-001 + correctness CORR-002:\n   597\t# the audit trail records the SHA256 of the actually-running\n   598\t# script content (not the last-committed git SHA, which can lie if\n   599\t# the operator has uncommitted changes or runs from outside an SCP\n   600\t# clone). The git-SHA is recorded as a secondary identifier when\n   601\t# available.\n   602\t\n   603\t# Self-hash via $0. Exits non-zero only if the script can't read\n   604\t# itself, which is essentially impossible at this point.\n   605\tSCRIPT_PATH=\"$(readlink -f \"$0\" 2>/dev/null || printf '%s' \"$0\")\"\n   606\tSCRIPT_SHA256=\"$(shasum -a 256 \"$SCRIPT_PATH\" | awk '{print $1}')\"\n   607\t\n   608\t# Try to also report the last-committed git SHA if we're inside an\n   609\t# SCP-shaped clone. Empty fallback is explicit.\n   610\tSCRIPT_GIT_SHA=\"$(git -C \"$(dirname \"$SCRIPT_PATH\")\" log -1 --format=%H -- \"$(basename \"$SCRIPT_PATH\")\" 2>/dev/null || true)\"\n   611\tSCRIPT_GIT_SHA=\"${SCRIPT_GIT_SHA:-not-in-git-clone}\"\n   612\t\n   613\tOPERATOR=\"$(gh api user --jq '.login' 2>/dev/null || echo unknown)\"\n   614\tTS=\"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"\n   615\t\n   616\tLOG_FILE=\"docs/reviews/WP-SCP-020/branch-protection-log.md\"\n   617\t\n   618\t# Emit the log block. Use ~~~~ outer fence so inner ``` JSON\n   619\t# fences nest correctly (CommonMark requires the closing fence\n   620\t# to match the opening fence character; fence types ~~~ and ```\n","exit_code":0,"status":"completed"}}

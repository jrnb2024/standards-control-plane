_modified\" -eq 1 ] || die \"ERROR: branch-protection-log.md was not modified for cascade-status=onboarded\"\n180:    printf 'OK: cascade-status=%s; 2 checks passed\\n' \"$cascade_status\"\n182:  onboarded-operator-bump)\n183:    [ \"$branch_log_modified\" -eq 1 ] || die \"ERROR: branch-protection-log.md was not modified for cascade-status=onboarded-operator-bump\"\n186:    python3 - \"$STATUS_MD\" \"$adopter_slug\" <<'PY' || die \"ERROR: STATUS.md missing required TF-024X-renovate row for the adopter target\"\n194:if not re.search(pattern, text):\n197:    printf 'OK: cascade-status=%s; 3 checks passed\\n' \"$cascade_status\"\n200:    [ \"$branch_log_modified\" -eq 0 ] || die \"ERROR: branch-protection-log.md was modified for cascade-status=blocked-on-adopter-conflict\"\n209:if not re.search(pattern, text):\n212:    printf 'OK: cascade-status=%s; 2 checks passed\\n' \"$cascade_status\"\n","exit_code":0,"status":"completed"}}

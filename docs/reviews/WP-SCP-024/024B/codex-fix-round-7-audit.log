 local restore_admin_enforcement_enabled\n378:  local restore_required_checks_have_contexts\n379:  local restore_current_state\n380:  local restore_after_json\n381:  local restore_ts\n382:  local restore_operator\n383:  local restore_script_path\n384:  local restore_script_sha256\n385:  local restore_script_git_sha\n387:  echo \"[020G] restore pre-state JSON should come from a prior invocation log entry in docs/reviews/WP-SCP-020/branch-protection-log.md\" >&2\n389:  if [ ! -f \"$restore_path\" ]; then\n390:    echo \"error: --restore file not found: $restore_path\" >&2\n394:  if ! restore_meta=\"$(python3 - \"$restore_path\" <<'PY'\n401:    raise SystemExit(\"restore JSON must be an object\")\n404:        raise SystemExit(f\"restore JSON missing required key: {key}\")\n406:    raise SystemExit(\"restore JSON 'repo' value must be a non-empty string\")\n408:    raise SystemExit(\"restore JSON 'branch' value must be a non-empty string\")\n411:    raise SystemExit(\"restore JSON 'before' value must be an object\")\n414:        raise SystemExit(f\"restore JSON 'before' missing required key: {key}\")\n418:    raise SystemExit(\"restore JSON 'before' missing or malformed key: required_status_checks\")\n421:    raise SystemExit(\"restore JSON 'before' missing or malformed key: enforce_admins.enabled\")\n424:    raise SystemExit(\"restore JSON 'before' missing or malformed key: required_pull_request_reviews\")\n439:restore_admin_enforcement_enabled = enforce_admins[\"enabled\"]\n440:restore_required_checks_have_contexts = isinstance(required_status_checks.get(\"contexts\"), list) and len(required_status_checks.get(\"contexts\")) > 0\n441:restore_required_signatures_enabled = bool((before.get(\"required_signatures\") or {}).get(\"enabled\", False))\n443:before_scrubbed[\"enforce_admins\"] = restore_admin_enforcement_enabled\n457:        print(\"[020G] WARNING: restore pre-state restrictions contained unexpected fields: {}; restoring users/teams/apps only\".format(\", \".join(unexpected)), file=sys.stderr)\n468:print(\"true\" if restore_admin_enforcement_enabled else \"false\")\n469:print(\"true\" if restore_required_checks_have_contexts else \"false\")\n470:print(\"true\" if restore_required_signatures_enabled else \"false\")\n478:  restore_repo=\"$(printf '%s' \"$restore_meta\" | sed -n '1p')\"\n479:  restore_branch=\"$(printf '%s' \"$restore_meta\" | sed -n '2p')\"\n480:  restore_admin_enforcement_enabled=\"$(printf '%s' \"$restore_meta\" | sed -n '3p')\"\n481:  restore_required_checks_have_contexts=\"$(printf '%s' \"$restore_meta\" | sed -n '4p')\"\n482:  restore_required_signatures_enabled=\"$(printf '%s' \"$restore_meta\" | sed -n '5p')\"\n483:  restore_before_json=\"$(printf '%s' \"$restore_meta\" | sed -n '6p')\"\n484:  restore_put_json=\"$(printf '%s' \"$restore_meta\" | sed -n '7p')\"\n486:  if [ -z \"$restore_repo\" ] || [ -z \"$restore_branch\" ] || [ -z \"$restore_before_json\" ] || [ -z \"$restore_put_json\" ]; then\n487:    echo \"error: invalid --restore file\" >&2\n491:  if printf '%s' \"$restore_repo\" | grep -qE '(^|/)\\.'; then\n492:    echo \"error: --restore repo '$restore_repo' contains path-traversal sequence (.., leading dot, dot-segment after /)\" >&2\n495:  if ! printf '%s' \"$restore_repo\" | grep -qE '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$'; then\n496:    echo \"error: --restore repo '$restore_repo' does not match owner/name shape\" >&2\n499:  if printf '%s' \"$restore_branch\" | grep -qE '(^\\.|/|\\.\\.)'; then\n500:    echo \"error: --restore branch '$restore_branch' invalid (no slashes, no .., no leading dot)\" >&2\n503:  case \"$restore_branch\" in\n505:      echo \"error: --restore branch '$restore_branch' contains markdown-corrupting chars (backtick, CR, LF)\" >&2\n510:  if [ \"$restore_admin_enforcement_enabled\" = \"false\" ] || [ \"$restore_required_checks_have_contexts\" != \"true\" ]; then\n511:    if [ \"$restore_admin_enforcement_enabled\" = \"false\" ]; then\n512:      echo \"[020G] WARNING: restore
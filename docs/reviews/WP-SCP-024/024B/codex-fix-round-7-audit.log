{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,40p' tests/scaffolder/test_scaffold_downstream.sh\"","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nREPO_ROOT=\"$(cd \"${SCRIPT_DIR}/../..\" && pwd)\"\nSCRIPT=\"${REPO_ROOT}/scripts/scaffold-downstream.sh\"\nSCP_SHA=\"$(git -C \"${REPO_ROOT}\" rev-parse HEAD)\"\n\n# Output directories are created under $TMPDIR and explicitly removed\n# after each case; the trap below is the final backstop.\nTMPDIR=\"$(mktemp -d)\"\ntrap 'rm -rf \"$TMPDIR\"' EXIT INT TERM\n\nfail() {\n  printf 'FAIL: %s\\n' \"$*\" >&2\n  exit 1\n}\n\nrun_expect_exit() {\n  local expected=\"$1\"\n  shift\n  local stdout_file stderr_file status\n  stdout_file=\"$(mktemp)\"\n  stderr_file=\"$(mktemp)\"\n  if \"$@\" >\"$stdout_file\" 2>\"$stderr_file\"; then\n    status=0\n  else\n    status=$?\n  fi\n  if [ \"$status\" -ne \"$expected\" ]; then\n    printf 'unexpected exit code: expected %s got %s\\n' \"$expected\" \"$status\" >&2\n    printf 'stdout:\\n' >&2\n    cat \"$stdout_file\" >&2\n    printf 'stderr:\\n' >&2\n    cat \"$stderr_file\" >&2\n    rm -f \"$stdout_file\" \"$stderr_file\"\n    exit 1\n  fi\n  rm -f \"$stdout_file\" \"$stderr_file\"\n}\n","exit_code":0,"status":"completed"}}

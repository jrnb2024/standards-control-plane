ame: Enforce invocation-log entry contract\n    47\t        shell: bash\n    48\t        run: |\n    49\t          set -euo pipefail\n    50\t\n    51\t          git fetch --no-tags --depth=1 origin main\n    52\t\n    53\t          dispatch_note=\"$(\n    54\t            git diff --name-only origin/main...HEAD |\n    55\t              awk '/^docs\\/reviews\\/WP-SCP-024\\/[^\\/]+\\/DISPATCH-NOTE\\.md$/ { note = $0 } END { print note }'\n    56\t          )\"\n    57\t\n    58\t          if [ -z \"$dispatch_note\" ]; then\n    59\t            # This PR did not touch a WP-SCP-024 cascade DISPATCH-NOTE.md,\n    60\t            # so there is nothing for invariant 2 to enforce.\n    61\t            exit 0\n    62\t          fi\n    63\t\n    64\t          scripts/check-invocation-log-entry.sh \\\n    65\t            --diff-base origin/main \\\n    66\t            --dispatch-note \"$dispatch_note\" \\\n    67\t            --status-md STATUS.md \\\n    68\t            --branch-protection-log docs/reviews/WP-SCP-020/branch-protection-log.md\n","exit_code":0,"status":"completed"}}

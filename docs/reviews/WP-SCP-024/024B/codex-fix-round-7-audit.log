{"type":"item.completed","item":{"id":"item_159","type":"command_execution","command":"/bin/zsh -lc \"nl -ba scripts/enable-required-check.sh | sed -n '1,260p'\"","aggregated_output":"     1\t#!/usr/bin/env bash\n     2\t# shellcheck shell=bash\n     3\t# WP-SCP-020 slice 020G — adopter-side branch-protection helper.\n     4\t#\n     5\t# Configures a downstream adopter repo's default branch with the\n     6\t# canonical SCP federation primitive required-status-check posture:\n     7\t#\n     8\t#   - required_status_checks.contexts = [\"${SCP_REQUIRED_CONTEXT}\"]\n     9\t#     (default: \"policy-check / scp/policy-check\" — the rendered\n    10\t#     check-run name from the canonical adopter wrapper)\n    11\t#   - required_status_checks.strict = true (PR must be up-to-date\n    12\t#     with base before evaluation)\n    13\t#   - enforce_admins = true (no admin bypass)\n    14\t#   - required_signatures = true (every commit verified-signed,\n    15\t#     applied via dedicated sub-resource endpoint)\n    16\t#\n    17\t# This is the adopter-side analogue of SCP-self's\n    18\t# `scripts/configure-020d2-required-check.sh`. Adopters with\n    19\t# multi-maintainer teams MAY enable additional review gates;\n    20\t# the script preserves any existing required_pull_request_reviews\n    21\t# rather than nulling them out (per 020G R1 SAF-002 closure).\n    22\t#\n    23\t# ## Bootstrap-only — NOT run unattended\n    24\t#\n    25\t# This script writes durable state to a third-party repository\n    26\t# (the adopter's branch protection). It refuses to run when CI=true\n    27\t# or GITHUB_ACTIONS=true (the two standard CI env vars). Operator\n    28\t# attention is required to:\n    29\t#   - confirm the target via --plan first\n    30\t#   - review the diff between before-state and after-state\n    31\t#   - paste the emitted markdown log entry into the SCP repo's\n    32\t#     `docs/reviews/WP-SCP-020/branch-protection-log.md` and merge.\n    33\t#\n    34\t# The log commit is part of the invocation procedure per\n    35\t# WP-SCP-020 §4 020G(iii). The script emits a log block on EVERY\n    36\t# completed invocation, including verification failures and partial-\n    37\t# state apply failures (e.g. the unified PUT succeeds but the\n    38\t# required_signatures POST fails) — the operator commits the\n    39\t# resulting log entry whether the apply succeeded or partially\n    40\t# failed, so the audit trail captures both outcomes.\n    41\t#\n    42\t# ## Required PAT scope\n    43\t#\n    44\t# `gh` must be authenticated with `administration:write` on the\n    45\t# target repo (fine-grained PAT with single-repo scope strongly\n    46\t# preferred over classic). The script cannot introspect token\n    47\t# scope without making an authorised call; on the first PUT it\n    48\t# will fail with HTTP 403 if the scope is insufficient. Run with\n    49\t# `--plan` first to verify intent before any mutation.\n    50\t#\n    51\t# Reference: docs/DECISIONS.md D-022 (federation-primitive adoption);\n    52\t# D-033 (the rendered context name `policy-check / scp/policy-check`\n    53\t# established for the SCP self-dogfood gate, used here as the\n    54\t# canonical adopter default); D-035 (this slice's invocation\n    55\t# procedure); D-044 (WP-SCP-024 024B restore mode + prior-green-CI\n    56\t# safety); WP-SCP-020 §4 020G; ADOPT-001 §12 (federation integration\n    57\t# appendix — lands in 020H part 3).\n    58\t\n    59\tset -euo pipefail\n    60\t\n    61\t# ---------- Bootstrap-only guard ----------\n    62\t\n    63\tif [ \"${CI:-}\" = \"true\" ] || [ \"${GITHUB_ACTIONS:-}\" = \"true\" ]; then\n    64\t  echo \"020G refuses to run in CI: this is an attended bootstrap script.\" >&2\n    65\t  echo \"If you need to run a dry-run from CI, unset CI/GITHUB_ACTIONS first AND pass --plan explicitly.\" >&2\n    66\t  exit 1\n    67\tfi\n    68\t\n    69\t# ---------- (i) Header preconditions ----------\n    70\t\n    71\trequire_cmd() {\n    72\t  command -v \"$1\" >/dev/null 2>&1 || {\n    73\t    echo \"missing required command: $1\" >&2\n    74\t    exit 1\n    75\t  }\n    76\t}\n    77\t\n    78\trequire_cmd gh\n    79\trequire_cmd jq\n    80\trequire_cmd git\n    81\trequire_cmd python3\n    82\trequire_cmd shasum\n    83\t\n    84\tassert_gh_version() {\n    85\t  local raw major minor\n    86\t  raw=\"$(gh --version 2>/dev/null | head -1 | awk '{print $3}')\"\n    87\t  if [ -z \"$raw\" ]; then\n    88\t    echo \"could not determine gh CLI version\" >&2\n    89\t    exit 1\n    90\t  fi\n    91\t  major=\"$(printf '%s' \"$raw\" | cut -d. -f1)\"\n    92\t  minor=\"$(printf '%s' \"$raw\" | cut -d. -f2)\"\n    93\t  # 2.40 floor — the unified branch-protection PUT shape used here\n    94\t  # has been stable since gh 2.x; anything older risks API drift.\n    95\t  if [ \"$major\" -lt 2 ] || { [ \"$major\" -eq 2 ] && [ \"$minor\" -lt 40 ]; }; then\n    96\t    echo \"gh CLI ${raw} too old: 2.40+ required\" >&2\n    97\t    exit 1\n    98\t  fi\n    99\t}\n   100\t\n   101\tassert_gh_version\n   102\t\n   103\tSCP_REPO_ROOT=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n   104\tBRANCH_PROTECTION_LOG=\"${SCP_REPO_ROOT}/docs/reviews/WP-SCP-020/branch-protection-log.md\"\n   105\tRELEASE_TAG_SHAS_CACHE=\"\"\n   106\t\n   107\t# Per WP-SCP-020 §4 020G(i): \"log-warn, don't block, since the\n   108\t# script can't introspect token scope without making a call\". The\n   109\t# warning is loud (printed to stderr before any mutation) so the\n   110\t# operator who skipped --plan still sees it.\n   111\techo \"WARNING: this script requires gh authenticated with administration:write on the target repo.\" >&2\n   112\techo \"         Recommended: fine-grained PAT scoped to the single target repo.\" >&2\n   113\techo \"         Run with --plan first if you have not verified scope sufficiency.\" >&2\n   114\t\n   115\tload_release_tag_shas() {\n   116\t  if [ -z \"$RELEASE_TAG_SHAS_CACHE\" ]; then\n   117\t    RELEASE_TAG_SHAS_CACHE=\"$(\n   118\t      gh api repos/jrnb2024/standards-control-plane-/tags --paginate --jq '.[].commit.sha'\n   119\t    )\"\n   120\t  fi\n   121\t  printf '%s\\n' \"$RELEASE_TAG_SHAS_CACHE\"\n   122\t}\n   123\t\n   124\tvalidate_release_tag_sha() {\n   125\t  local expected_sha=\"$1\"\n   126\t  if ! load_release_tag_shas | grep -Fxq -- \"$expected_sha\"; then\n   127\t    echo \"error: --expected-wrapper-sha ${expected_sha} is not a release-tag SHA (queried git tags via gh api). Pass a SHA that is at the tip of a v* tag, OR use --i-understand-no-gate-2-verification if you have manually verified the SHA's provenance.\" >&2\n   128\t    exit 2\n   129\t  fi\n   130\t}\n   131\t\n   132\t# ---------- (ii) Argument parsing ----------\n   133\t\n   134\tREPO=\"\"\n   135\tBRANCH=\"\"\n   136\tREQUIRED_CONTEXT=\"${SCP_REQUIRED_CONTEXT:-policy-check / scp/policy-check}\"\n   137\tEXPECTED_WRAPPER_SHA=\"\"\n   138\tPLAN_ONLY=0\n   139\tENFORCE_ADMINS=\"true\"\n   140\tACK_ADMIN_BYPASS=0\n   141\tRESTORE_STATE=\"\"\n   142\tACK_NO_PRIOR_GREEN_CI=0\n   143\tACK_NO_GATE2_VERIFICATION=0\n   144\tACK_RESTORE_ADMIN_DEGRADATION=0\n   145\tACK_RESTORE_REQUIRED_CHECKS_DEGRADATION=0\n   146\t\n   147\tusage() {\n   148\t  cat <<'EOF' >&2\n   149\tUsage: enable-required-check.sh --repo OWNER/NAME --branch BRANCH [flags]\n   150\t\n   151\tRequired:\n   152\t  --repo OWNER/NAME   Target repository (e.g. mapp-pim/mapp-pim).\n   153\t  --branch BRANCH     Default branch to protect (typically `main`).\n   154\t\n   155\tFlags:\n   156\t  --required-check NAME    Override the required-check context name.\n   157\t                           Default: \"policy-check / scp/policy-check\".\n   158\t  --plan                   Print the PUT payload AND current branch-\n   159\t                           protection state without applying. Use\n   160\t                           this first to verify intent.\n   161\t  --no-enforce-admins      Disable enforce_admins. NOT canonical;\n   162\t                           requires a separate\n   163\t                           --i-understand-this-bypasses-the-gate flag\n   164\t                           to take effect (per 020G R1 SAF-003 closure).\n   165\t  --i-understand-this-bypasses-the-gate\n   166\t                           Required confirmation when combined with\n   167\t                           --no-enforce-admins. Without this flag, the\n   168\t                           script ignores --no-enforce-admins.\n   169\t  --restore PRE-STATE.json  Restore branch protection from a captured\n   170\t                           pre-state JSON emitted by a prior run.\n   171\t                           Source it from\n   172\t                           docs/reviews/WP-SCP-020/branch-protection-log.md;\n   173\t                           do not trust unverified JSON.\n   174\t  --i-understand-restore-removes-admin-enforcement\n   175\t                           Required confirmation when a restore-state\n   176\t                           would remove enforce_admins.\n   177\t  --i-understand-restore-removes-required-checks\n   178\t                           Required confirmation when a restore-state\n   179\t                           would clear required_status_checks.contexts.\n   180\t  --i-understand-this-repo-has-no-prior-green-ci\n   181\t                           Override the forward-mode precondition that\n   182\t                           the target repo has already green-CI'd once.\n   183\t  --expected-wrapper-sha SHA\n   184\t                           Optional forward-mode safety check: require\n   185\t                           the adopter wrapper's `uses:` pin to match a\n   186\t                           release-tag SHA before re-arming the gate.\n   187\t  --i-understand-no-gate-2-verification\n   188\t                           Explicit override when re-arming without\n   189\t                           proving Gate 2's wrapper SHA pin.\n   190\t  --help / -h              Show this help.\n   191\t\n   192\tBootstrap-only — this script is NOT run unattended. It refuses to\n   193\trun when CI=true or GITHUB_ACTIONS=true. Operator attention is\n   194\trequired for the apply, the diff review, and the invocation-log\n   195\tcommit afterward.\n   196\t\n   197\tReference: docs/DECISIONS.md D-022 (federation primitive adoption);\n   198\tD-033 (rendered context-name `policy-check / scp/policy-check`);\n   199\tD-035 (this slice's invocation procedure); WP-SCP-020 §4 020G.\n   200\tEOF\n   201\t}\n   202\t\n   203\twhile [ $# -gt 0 ]; do\n   204\t  case \"$1\" in\n   205\t    --repo)\n   206\t      [ $# -lt 2 ] && { echo \"error: --repo requires a value\" >&2; usage; exit 2; }\n   207\t      REPO=\"$2\"; shift 2 ;;\n   208\t    --branch)\n   209\t      [ $# -lt 2 ] && { echo \"error: --branch requires a value\" >&2; usage; exit 2; }\n   210\t      BRANCH=\"$2\"; shift 2 ;;\n   211\t    --required-check)\n   212\t      [ $# -lt 2 ] && { echo \"error: --required-check requires a value\" >&2; usage; exit 2; }\n   213\t      REQUIRED_CONTEXT=\"$2\"; shift 2 ;;\n   214\t    --plan) PLAN_ONLY=1; shift ;;\n   215\t    --enforce-admins) ENFORCE_ADMINS=\"true\"; shift ;;\n   216\t    --no-enforce-admins) ENFORCE_ADMINS=\"false\"; shift ;;\n   217\t    --i-understand-this-bypasses-the-gate) ACK_ADMIN_BYPASS=1; shift ;;\n   218\t    --restore)\n   219\t      [ $# -lt 2 ] && { echo \"error: --restore requires a value\" >&2; usage; exit 2; }\n   220\t      RESTORE_STATE=\"$2\"; shift 2 ;;\n   221\t    --i-understand-this-repo-has-no-prior-green-ci) ACK_NO_PRIOR_GREEN_CI=1; shift ;;\n   222\t    --expected-wrapper-sha)\n   223\t      [ $# -lt 2 ] && { echo \"error: --expected-wrapper-sha requires a value\" >&2; usage; exit 2; }\n   224\t      EXPECTED_WRAPPER_SHA=\"$2\"; shift 2 ;;\n   225\t    --i-understand-restore-removes-admin-enforcement) ACK_RESTORE_ADMIN_DEGRADATION=1; shift ;;\n   226\t    --i-understand-restore-removes-required-checks) ACK_RESTORE_REQUIRED_CHECKS_DEGRADATION=1; shift ;;\n   227\t    --i-understand-no-gate-2-verification) ACK_NO_GATE2_VERIFICATION=1; shift ;;\n   228\t    -h|--help) usage; exit 0 ;;\n   229\t    *) echo \"unknown flag: $1\" >&2; usage; exit 2 ;;\n   230\t  esac\n   231\tdone\n   232\t\n   233\tif [ -z \"$RESTORE_STATE\" ] && { [ \"$ACK_RESTORE_ADMIN_DEGRADATION\" -eq 1 ] || [ \"$ACK_RESTORE_REQUIRED_CHECKS_DEGRADATION\" -eq 1 ]; }; then\n   234\t  echo \"error: restore-only acknowledgement flags require --restore\" >&2\n   235\t  usage\n   236\t  exit 2\n   237\tfi\n   238\t\n   239\tif [ -n \"$RESTORE_STATE\" ] && { [ -n \"$REPO\" ] || [ -n \"$BRANCH\" ] || [ \"$PLAN_ONLY\" -eq 1 ] || [ \"$ACK_ADMIN_BYPASS\" -eq 1 ] || [ \"$ACK_NO_PRIOR_GREEN_CI\" -eq 1 ] || [ \"$ACK_NO_GATE2_VERIFICATION\" -eq 1 ] || [ -n \"$EXPECTED_WRAPPER_SHA\" ] || [ \"$ENFORCE_ADMINS\" != \"true\" ]; }; then\n   240\t  echo \"error: --restore is a standalone mode and cannot be combined with forward-mode flags\" >&2\n   241\t  usage\n   242\t  exit 2\n   243\tfi\n   244\t\n   245\tif [ -z \"$RESTORE_STATE\" ] && { [ -z \"$REPO\" ] || [ -z \"$BRANCH\" ]; }; then\n   246\t  echo \"error: --repo and --branch are both required\" >&2\n   247\t  usage\n   248\t  exit 2\n   249\tfi\n   250\t\n   251\tif [ -n \"$EXPECTED_WRAPPER_SHA\" ] && [ \"$ACK_NO_PRIOR_GREEN_CI\" -eq 1 ]; then\n   252\t  echo \"error: --expected-wrapper-sha and --i-understand-this-repo-has-no-prior-green-ci are incompatible\" >&2\n   253\t  exit 2\n   254\tfi\n   255\t\n   256\t# Closes 020G R2 correctness CORR2-003: --i-understand-this-bypasses-\n   257\t# the-gate is silently meaningless without --no-enforce-admins.\n   258\t# Refuse the combination so an operator who pre-fills the long flag\n   259\t# from history but forgets the trigger sees a clear error.\n   260\tif [ \"$ACK_ADMIN_BYPASS\" -eq 1 ] && [ \"$ENFORCE_ADMINS\" = \"true\" ]; then\n","exit_code":0,"status":"completed"}}

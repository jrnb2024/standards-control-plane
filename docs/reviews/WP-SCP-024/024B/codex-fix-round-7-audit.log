{"type":"item.completed","item":{"id":"item_161","type":"command_execution","command":"/bin/zsh -lc \"nl -ba tests/scaffolder/test_scaffold_downstream.sh | sed -n '1,260p'\"","aggregated_output":"     1\t#!/usr/bin/env bash\n     2\tset -euo pipefail\n     3\t\n     4\tSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n     5\tREPO_ROOT=\"$(cd \"${SCRIPT_DIR}/../..\" && pwd)\"\n     6\tSCRIPT=\"${REPO_ROOT}/scripts/scaffold-downstream.sh\"\n     7\tSCP_SHA=\"$(git -C \"${REPO_ROOT}\" rev-parse HEAD)\"\n     8\t\n     9\t# Output directories are created under $TMPDIR and explicitly removed\n    10\t# after each case; the trap below is the final backstop. Keep the temp\n    11\t# root inside the repo workspace so the script's system-path guard\n    12\t# does not reject it on macOS.\n    13\tTMPDIR=\"$(mktemp -d \"${REPO_ROOT}/tmp.scaffold.XXXXXX\")\"\n    14\ttrap 'rm -rf \"$TMPDIR\"' EXIT INT TERM\n    15\t\n    16\tfail() {\n    17\t  printf 'FAIL: %s\\n' \"$*\" >&2\n    18\t  exit 1\n    19\t}\n    20\t\n    21\trun_expect_exit() {\n    22\t  local expected=\"$1\"\n    23\t  shift\n    24\t  local stdout_file stderr_file status\n    25\t  stdout_file=\"$(mktemp)\"\n    26\t  stderr_file=\"$(mktemp)\"\n    27\t  if \"$@\" >\"$stdout_file\" 2>\"$stderr_file\"; then\n    28\t    status=0\n    29\t  else\n    30\t    status=$?\n    31\t  fi\n    32\t  if [ \"$status\" -ne \"$expected\" ]; then\n    33\t    printf 'unexpected exit code: expected %s got %s\\n' \"$expected\" \"$status\" >&2\n    34\t    printf 'stdout:\\n' >&2\n    35\t    cat \"$stdout_file\" >&2\n    36\t    printf 'stderr:\\n' >&2\n    37\t    cat \"$stderr_file\" >&2\n    38\t    rm -f \"$stdout_file\" \"$stderr_file\"\n    39\t    exit 1\n    40\t  fi\n    41\t  rm -f \"$stdout_file\" \"$stderr_file\"\n    42\t}\n    43\t\n    44\tvalidate_manifest() {\n    45\t  local manifest=\"$1\"\n    46\t  local outdir=\"$2\"\n    47\t  local expected_sha=\"$3\"\n    48\t  python3 - \"$manifest\" \"$outdir\" \"$expected_sha\" <<'PY'\n    49\timport hashlib\n    50\timport json\n    51\timport pathlib\n    52\timport sys\n    53\t\n    54\tmanifest_path = pathlib.Path(sys.argv[1])\n    55\toutdir = pathlib.Path(sys.argv[2])\n    56\tpayload = json.loads(manifest_path.read_text(encoding=\"utf-8\"))\n    57\t\n    58\trequired_keys = {\"emitted_at\", \"adopter_repo\", \"default_branch\", \"scp_sha\", \"scorecard_emit\", \"files\"}\n    59\tif set(payload) != required_keys:\n    60\t    raise SystemExit(f\"unexpected manifest keys: {sorted(payload)}\")\n    61\tif payload[\"adopter_repo\"] != \"jrnb2024/test-adopter\":\n    62\t    raise SystemExit(\"unexpected adopter_repo\")\n    63\tif payload[\"default_branch\"] != \"main\":\n    64\t    raise SystemExit(\"unexpected default_branch\")\n    65\tif payload[\"scp_sha\"] != sys.argv[3]:\n    66\t    raise SystemExit(\"unexpected scp_sha\")\n    67\tif payload[\"scorecard_emit\"] is not False:\n    68\t    raise SystemExit(\"unexpected scorecard_emit\")\n    69\tif not isinstance(payload[\"emitted_at\"], str) or not payload[\"emitted_at\"]:\n    70\t    raise SystemExit(\"missing emitted_at\")\n    71\tif len(payload[\"files\"]) != 3:\n    72\t    raise SystemExit(\"manifest.files should list 3 of 4 emitted files (MANIFEST.json does not hash itself)\")\n    73\t\n    74\tfor entry in payload[\"files\"]:\n    75\t    path = outdir / entry[\"path\"]\n    76\t    if not path.exists():\n    77\t        raise SystemExit(f\"missing emitted file: {path}\")\n    78\t    digest = hashlib.sha256(path.read_bytes()).hexdigest()\n    79\t    if digest != entry[\"sha256\"]:\n    80\t        raise SystemExit(f\"sha mismatch for {entry['path']}\")\n    81\t    if len(entry[\"sha256\"]) != 64:\n    82\t        raise SystemExit(f\"bad sha length for {entry['path']}\")\n    83\tPY\n    84\t}\n    85\t\n    86\tassert_wrapper_contract() {\n    87\t  local wrapper=\"$1\"\n    88\t  grep -Fq 'github.event.pull_request.head.repo.full_name == github.event.pull_request.base.repo.full_name' \"$wrapper\" \\\n    89\t    || fail \"wrapper missing fork-PR refusal if: clause\"\n    90\t  grep -Fq 'contents: read' \"$wrapper\" \\\n    91\t    || fail \"wrapper missing least-privilege contents: read\"\n    92\t  grep -Fq 'statuses: write' \"$wrapper\" \\\n    93\t    || fail \"wrapper missing statuses: write\"\n    94\t  ! grep -qF 'id-token:' \"$wrapper\" \\\n    95\t    || fail \"wrapper unexpectedly requests id-token at workflow level\"\n    96\t  ! grep -qF 'attestations:' \"$wrapper\" \\\n    97\t    || fail \"wrapper unexpectedly requests attestations at workflow level\"\n    98\t}\n    99\t\n   100\tmake_output_dir() {\n   101\t  mktemp -d \"${TMPDIR}/out.XXXXXX\"\n   102\t}\n   103\t\n   104\tmain() {\n   105\t  local outdir\n   106\t  outdir=\"$(make_output_dir)\"\n   107\t  run_expect_exit 0 env -i PATH=\"$PATH\" HOME=\"$HOME\" \\\n   108\t    \"$SCRIPT\" \\\n   109\t    --adopter-repo jrnb2024/test-adopter \\\n   110\t    --default-branch main \\\n   111\t    --scp-sha \"$SCP_SHA\" \\\n   112\t    --scorecard-emit false \\\n   113\t    --output-dir \"$outdir\"\n   114\t\n   115\t  [ -f \"$outdir/.github/workflows/policy-check-wrapper.yml\" ] || fail \"missing emitted wrapper\"\n   116\t  [ -f \"$outdir/.github/CODEOWNERS-snippet.txt\" ] || fail \"missing CODEOWNERS snippet\"\n   117\t  [ -f \"$outdir/CASCADE-PR-BODY.md\" ] || fail \"missing PR body\"\n   118\t  [ -f \"$outdir/MANIFEST.json\" ] || fail \"missing manifest\"\n   119\t\n   120\t  grep -Fq 'branches: [main]' \"$outdir/.github/workflows/policy-check-wrapper.yml\" || fail \"wrapper missing substituted default branch\"\n   121\t  grep -Fq \"$SCP_SHA\" \"$outdir/.github/workflows/policy-check-wrapper.yml\" || fail \"wrapper missing substituted SHA\"\n   122\t  grep -Fq 'scorecard-emit: false' \"$outdir/.github/workflows/policy-check-wrapper.yml\" || fail \"wrapper missing scorecard-emit false\"\n   123\t  assert_wrapper_contract \"$outdir/.github/workflows/policy-check-wrapper.yml\"\n   124\t  grep -Fq '@<adopter-CODEOWNERS-account>' \"$outdir/.github/CODEOWNERS-snippet.txt\" || fail \"CODEOWNERS snippet placeholder missing\"\n   125\t  grep -Fq 'T-024-09 expects roughly 2-5 minutes on ubuntu-24.04' \"$outdir/CASCADE-PR-BODY.md\" || fail \"PR body missing cost paragraph\"\n   126\t  python3 - \"$outdir/.github/workflows/policy-check-wrapper.yml\" <<'PY'\n   127\timport pathlib\n   128\timport sys\n   129\t\n   130\ttry:\n   131\t    import yaml\n   132\texcept ImportError as exc:\n   133\t    raise SystemExit(\"SKIP: pyyaml not installed — install it to run YAML lint checks\") from exc\n   134\t\n   135\tyaml.safe_load(pathlib.Path(sys.argv[1]).read_text(encoding=\"utf-8\"))\n   136\tPY\n   137\t  validate_manifest \"$outdir/MANIFEST.json\" \"$outdir\" \"$SCP_SHA\"\n   138\t  rm -rf \"$outdir\"\n   139\t\n   140\t  local non_head_sha\n   141\t  non_head_sha=\"$(git -C \"${REPO_ROOT}\" rev-parse HEAD^ 2>/dev/null || git -C \"${REPO_ROOT}\" rev-list --max-count=2 HEAD | tail -n 1)\"\n   142\t  [ -n \"$non_head_sha\" ] || fail \"could not resolve a non-HEAD SHA\"\n   143\t\n   144\t  local outdir_non_head\n   145\t  outdir_non_head=\"$(make_output_dir)\"\n   146\t  local non_head_stdout non_head_stderr non_head_status\n   147\t  non_head_stdout=\"$(mktemp \"${TMPDIR}/stdout.XXXXXX\")\"\n   148\t  non_head_stderr=\"$(mktemp \"${TMPDIR}/stderr.XXXXXX\")\"\n   149\t  if env -i PATH=\"$PATH\" HOME=\"$HOME\" \\\n   150\t    \"$SCRIPT\" \\\n   151\t    --adopter-repo jrnb2024/test-adopter \\\n   152\t    --default-branch main \\\n   153\t    --scp-sha \"$non_head_sha\" \\\n   154\t    --scorecard-emit false \\\n   155\t    --output-dir \"$outdir_non_head\" >\"$non_head_stdout\" 2>\"$non_head_stderr\"; then\n   156\t    non_head_status=0\n   157\t  else\n   158\t    non_head_status=$?\n   159\t  fi\n   160\t  if [ \"$non_head_status\" -ne 0 ]; then\n   161\t    printf 'unexpected exit code: expected 0 got %s\\n' \"$non_head_status\" >&2\n   162\t    printf 'stdout:\\n' >&2\n   163\t    cat \"$non_head_stdout\" >&2\n   164\t    printf 'stderr:\\n' >&2\n   165\t    cat \"$non_head_stderr\" >&2\n   166\t    rm -f \"$non_head_stdout\" \"$non_head_stderr\"\n   167\t    exit 1\n   168\t  fi\n   169\t  grep -Fq 'is not current SCP main HEAD' \"$non_head_stderr\" || fail \"non-HEAD SHA did not warn\"\n   170\t  rm -f \"$non_head_stdout\" \"$non_head_stderr\"\n   171\t  [ -f \"$outdir_non_head/.github/workflows/policy-check-wrapper.yml\" ] || fail \"missing emitted wrapper for non-HEAD SHA\"\n   172\t  [ -f \"$outdir_non_head/.github/CODEOWNERS-snippet.txt\" ] || fail \"missing CODEOWNERS snippet for non-HEAD SHA\"\n   173\t  [ -f \"$outdir_non_head/CASCADE-PR-BODY.md\" ] || fail \"missing PR body for non-HEAD SHA\"\n   174\t  [ -f \"$outdir_non_head/MANIFEST.json\" ] || fail \"missing manifest for non-HEAD SHA\"\n   175\t  assert_wrapper_contract \"$outdir_non_head/.github/workflows/policy-check-wrapper.yml\"\n   176\t  validate_manifest \"$outdir_non_head/MANIFEST.json\" \"$outdir_non_head\" \"$non_head_sha\"\n   177\t  rm -rf \"$outdir_non_head\"\n   178\t\n   179\t  local outdir_master\n   180\t  outdir_master=\"$(make_output_dir)\"\n   181\t  run_expect_exit 0 env -i PATH=\"$PATH\" HOME=\"$HOME\" \\\n   182\t    \"$SCRIPT\" \\\n   183\t    --adopter-repo jrnb2024/test-adopter \\\n   184\t    --default-branch master \\\n   185\t    --scp-sha \"$SCP_SHA\" \\\n   186\t    --scorecard-emit true \\\n   187\t    --output-dir \"$outdir_master\"\n   188\t  grep -Fq 'branches: [master]' \"$outdir_master/.github/workflows/policy-check-wrapper.yml\" || fail \"master variant missing substituted branch\"\n   189\t  grep -Fq 'scorecard-emit: true' \"$outdir_master/.github/workflows/policy-check-wrapper.yml\" || fail \"true variant missing scorecard-emit\"\n   190\t  assert_wrapper_contract \"$outdir_master/.github/workflows/policy-check-wrapper.yml\"\n   191\t  rm -rf \"$outdir_master\"\n   192\t\n   193\t  local outdir_develop\n   194\t  outdir_develop=\"$(make_output_dir)\"\n   195\t  run_expect_exit 0 env -i PATH=\"$PATH\" HOME=\"$HOME\" \\\n   196\t    \"$SCRIPT\" \\\n   197\t    --adopter-repo jrnb2024/test-adopter \\\n   198\t    --default-branch develop \\\n   199\t    --scp-sha \"$SCP_SHA\" \\\n   200\t    --scorecard-emit false \\\n   201\t    --output-dir \"$outdir_develop\"\n   202\t  grep -Fq 'branches: [develop]' \"$outdir_develop/.github/workflows/policy-check-wrapper.yml\" || fail \"develop variant missing substituted branch\"\n   203\t  assert_wrapper_contract \"$outdir_develop/.github/workflows/policy-check-wrapper.yml\"\n   204\t  rm -rf \"$outdir_develop\"\n   205\t\n   206\t  local error_outdir\n   207\t  error_outdir=\"$(make_output_dir)\"\n   208\t\n   209\t  run_expect_exit 1 env -i PATH=\"$PATH\" HOME=\"$HOME\" \\\n   210\t    CI=true \\\n   211\t    \"$SCRIPT\" \\\n   212\t    --adopter-repo jrnb2024/test-adopter \\\n   213\t    --default-branch main \\\n   214\t    --scp-sha \"$SCP_SHA\" \\\n   215\t    --scorecard-emit false \\\n   216\t    --output-dir \"$error_outdir\"\n   217\t\n   218\t  run_expect_exit 1 env -i PATH=\"$PATH\" HOME=\"$HOME\" \\\n   219\t    GITHUB_ACTIONS=true \\\n   220\t    \"$SCRIPT\" \\\n   221\t    --adopter-repo jrnb2024/test-adopter \\\n   222\t    --default-branch main \\\n   223\t    --scp-sha \"$SCP_SHA\" \\\n   224\t    --scorecard-emit false \\\n   225\t    --output-dir \"$error_outdir\"\n   226\t\n   227\t  tmp_deny_base=\"$(mktemp -d \"${TMPDIR}/tr.XXXXXX\")\"\n   228\t  tmp_deny_dir=\"${tmp_deny_base}/../../etc\"\n   229\t  run_expect_exit 1 env -i PATH=\"$PATH\" HOME=\"$HOME\" \\\n   230\t    \"$SCRIPT\" \\\n   231\t    --adopter-repo jrnb2024/test-adopter \\\n   232\t    --default-branch main \\\n   233\t    --scp-sha \"$SCP_SHA\" \\\n   234\t    --scorecard-emit false \\\n   235\t    --output-dir \"$tmp_deny_dir\"\n   236\t  rm -rf \"$tmp_deny_base\"\n   237\t\n   238\t  run_expect_exit 1 env -i PATH=\"$PATH\" HOME=\"$HOME\" \\\n   239\t    \"$SCRIPT\" \\\n   240\t    --adopter-repo jrnb2024/test-adopter \\\n   241\t    --default-branch main \\\n   242\t    --scp-sha \"$SCP_SHA\" \\\n   243\t    --scorecard-emit false \\\n   244\t    --output-dir /tmp\n   245\t\n   246\t  run_expect_exit 1 env -i PATH=\"$PATH\" HOME=\"$HOME\" \\\n   247\t    \"$SCRIPT\" \\\n   248\t    --adopter-repo jrnb2024/test-adopter \\\n   249\t    --default-branch main \\\n   250\t    --scp-sha \"$SCP_SHA\" \\\n   251\t    --scorecard-emit false \\\n   252\t    --output-dir /var/tmp\n   253\t\n   254\t  if [[ \"$(uname)\" == \"Darwin\" ]]; then\n   255\t    run_expect_exit 1 env -i PATH=\"$PATH\" HOME=\"$HOME\" \\\n   256\t      \"$SCRIPT\" \\\n   257\t      --adopter-repo jrnb2024/test-adopter \\\n   258\t      --default-branch main \\\n   259\t      --scp-sha \"$SCP_SHA\" \\\n   260\t      --scorecard-emit false \\\n","exit_code":0,"status":"completed"}}

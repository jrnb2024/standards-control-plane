{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' .github/workflows/check-invocation-log-entry.yml\"","aggregated_output":"name: check-invocation-log-entry\n\n# WP-SCP-024 slice 024B fix-round-6 wiring for plan-doc invariant 2 / D-044.\n# This workflow is the CI-enforced half of the operator-run + invocation-\n# logged + CI-enforced contract. Adopter repos may later add the\n# `check-invocation-log-entry / check-invocation-log-entry` context to\n# their required checks list.\n\n\"on\":\n  pull_request:\n    branches:\n      - main\n    types:\n      - opened\n      - synchronize\n      - reopened\n    paths:\n      - docs/reviews/WP-SCP-024/**\n      - docs/reviews/WP-SCP-020/branch-protection-log.md\n      - STATUS.md\n\npermissions:\n  contents: read\n  pull-requests: read\n\njobs:\n  check-invocation-log-entry:\n    runs-on: ubuntu-24.04\n    steps:\n      - name: Checkout PR head\n        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2\n        with:\n          ref: ${{ github.event.pull_request.head.sha }}\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Enforce invocation-log entry contract\n        shell: bash\n        run: |\n          set -euo pipefail\n\n          git fetch --no-tags --depth=1 origin main\n\n          dispatch_note=\"$(\n            git diff --name-only origin/main...HEAD |\n              awk '/^docs\\/reviews\\/WP-SCP-024\\/[^\\/]+\\/DISPATCH-NOTE\\.md$/ { note = $0 } END { print note }'\n          )\"\n\n          if [ -z \"$dispatch_note\" ]; then\n            # This PR did not touch a WP-SCP-024 cascade DISPATCH-NOTE.md,\n            # so there is nothing for invariant 2 to enforce.\n            exit 0\n          fi\n\n          scripts/check-invocation-log-entry.sh \\\n            --diff-base origin/main \\\n            --dispatch-note \"$dispatch_note\" \\\n            --status-md STATUS.md \\\n            --branch-protection-log docs/reviews/WP-SCP-020/branch-protection-log.md\n","exit_code":0,"status":"completed"}}

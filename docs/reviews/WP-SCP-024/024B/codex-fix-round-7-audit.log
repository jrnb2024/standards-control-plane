{"type":"item.completed","item":{"id":"item_158","type":"command_execution","command":"/bin/zsh -lc \"nl -ba scripts/check-invocation-log-entry.sh | sed -n '1,220p'\"","aggregated_output":"     1\t#!/usr/bin/env bash\n     2\t# shellcheck shell=bash\n     3\t# WP-SCP-024 slice 024B invocation-log CI enforcer.\n     4\t#\n     5\t# Enforces the cascade-status contract defined by WP-SCP-024 plan-doc\n     6\t# §5.2 and invariant 2. Supports either PR-driven checks or a local\n     7\t# diff-base comparison.\n     8\t#\n     9\t# Reference: docs/plans/WP-SCP-024-estate-cascade.md §5.2 / §6;\n    10\t# docs/reviews/WP-SCP-024/024B/DISPATCH-NOTE.md; docs/DECISIONS.md D-044.\n    11\t\n    12\tset -euo pipefail\n    13\t\n    14\tusage() {\n    15\t  cat >&2 <<'EOF'\n    16\tUsage: check-invocation-log-entry.sh --pr <number> | --diff-base <ref> --dispatch-note <path> [--status-md <path>] [--branch-protection-log <path>]\n    17\t\n    18\tRequired:\n    19\t  --pr <number>                  Check a PR via gh.\n    20\t  --diff-base <ref>              Check the current branch against a git ref.\n    21\t  --dispatch-note <path>         Slice DISPATCH-NOTE.md path.\n    22\t\n    23\tOptional:\n    24\t  --status-md <path>             STATUS.md path (default: STATUS.md).\n    25\t  --branch-protection-log <path> Branch-protection log path.\n    26\t                                 Default: docs/reviews/WP-SCP-020/branch-protection-log.md\n    27\t  --help / -h                    Show this help.\n    28\tEOF\n    29\t}\n    30\t\n    31\tdie() {\n    32\t  printf '%s\\n' \"$1\" >&2\n    33\t  exit \"${2:-1}\"\n    34\t}\n    35\t\n    36\tPR=\"\"\n    37\tDIFF_BASE=\"\"\n    38\tDISPATCH_NOTE=\"\"\n    39\tSTATUS_MD=\"STATUS.md\"\n    40\tBRANCH_PROTECTION_LOG=\"docs/reviews/WP-SCP-020/branch-protection-log.md\"\n    41\t\n    42\twhile [ $# -gt 0 ]; do\n    43\t  case \"$1\" in\n    44\t    --pr)\n    45\t      [ $# -ge 2 ] || die \"ERROR: --pr requires a value\" 2\n    46\t      PR=\"$2\"\n    47\t      shift 2\n    48\t      ;;\n    49\t    --diff-base)\n    50\t      [ $# -ge 2 ] || die \"ERROR: --diff-base requires a value\" 2\n    51\t      DIFF_BASE=\"$2\"\n    52\t      shift 2\n    53\t      ;;\n    54\t    --dispatch-note)\n    55\t      [ $# -ge 2 ] || die \"ERROR: --dispatch-note requires a value\" 2\n    56\t      DISPATCH_NOTE=\"$2\"\n    57\t      shift 2\n    58\t      ;;\n    59\t    --status-md)\n    60\t      [ $# -ge 2 ] || die \"ERROR: --status-md requires a value\" 2\n    61\t      STATUS_MD=\"$2\"\n    62\t      shift 2\n    63\t      ;;\n    64\t    --branch-protection-log)\n    65\t      [ $# -ge 2 ] || die \"ERROR: --branch-protection-log requires a value\" 2\n    66\t      BRANCH_PROTECTION_LOG=\"$2\"\n    67\t      shift 2\n    68\t      ;;\n    69\t    -h|--help)\n    70\t      usage\n    71\t      exit 0\n    72\t      ;;\n    73\t    *)\n    74\t      die \"ERROR: unknown flag: $1\" 2\n    75\t      ;;\n    76\t  esac\n    77\tdone\n    78\t\n    79\tif [ -n \"$PR\" ] && [ -n \"$DIFF_BASE\" ]; then\n    80\t  die \"ERROR: --pr and --diff-base are mutex\" 2\n    81\tfi\n    82\tif [ -z \"$PR\" ] && [ -z \"$DIFF_BASE\" ]; then\n    83\t  die \"ERROR: one of --pr or --diff-base is required\" 2\n    84\tfi\n    85\tif [ -z \"$DISPATCH_NOTE\" ]; then\n    86\t  die \"ERROR: --dispatch-note is required\" 2\n    87\tfi\n    88\t\n    89\tnormalize_path() {\n    90\t  python3 -c 'import os, sys; print(os.path.normpath(sys.argv[1]))' \"$1\"\n    91\t}\n    92\t\n    93\tcanonicalize_adopter_slug() {\n    94\t  printf '%s' \"$1\" | python3 -c 'import re, sys\n    95\ts = sys.stdin.read().strip().lower()\n    96\ts = re.sub(r\"[^a-z0-9-]+\", \"-\", s.replace(\"/\", \"-\"))\n    97\ts = re.sub(r\"-+\", \"-\", s).strip(\"-\")\n    98\tprint(s)'\n    99\t}\n   100\t\n   101\tDISPATCH_NOTE=\"$(normalize_path \"$DISPATCH_NOTE\")\"\n   102\tSTATUS_MD=\"$(normalize_path \"$STATUS_MD\")\"\n   103\tBRANCH_PROTECTION_LOG=\"$(normalize_path \"$BRANCH_PROTECTION_LOG\")\"\n   104\t\n   105\tREPO_ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || true)\"\n   106\tif [ -z \"$REPO_ROOT\" ]; then\n   107\t  die \"ERROR: could not resolve repository root\"\n   108\tfi\n   109\tREPO_ROOT=\"$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' \"$REPO_ROOT\")\"\n   110\tBRANCH_PROTECTION_LOG_REAL=\"$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' \"$BRANCH_PROTECTION_LOG\")\"\n   111\tcase \"$BRANCH_PROTECTION_LOG_REAL\" in\n   112\t  \"$REPO_ROOT\"|\"$REPO_ROOT\"/*) ;;\n   113\t  *) die \"ERROR: --branch-protection-log must resolve inside repository root: $BRANCH_PROTECTION_LOG\" 2 ;;\n   114\tesac\n   115\t\n   116\t[ -f \"$DISPATCH_NOTE\" ] || die \"ERROR: DISPATCH-NOTE not found: $DISPATCH_NOTE\" 2\n   117\t[ -f \"$STATUS_MD\" ] || die \"ERROR: STATUS.md not found: $STATUS_MD\" 2\n   118\t[ -f \"$BRANCH_PROTECTION_LOG\" ] || die \"ERROR: branch-protection log not found: $BRANCH_PROTECTION_LOG\" 2\n   119\t\n   120\tdispatch_note_mode=\"$(\n   121\t  python3 - \"$DISPATCH_NOTE\" <<'PY'\n   122\timport re\n   123\timport sys\n   124\tfrom pathlib import Path\n   125\t\n   126\ttext = Path(sys.argv[1]).read_text(encoding=\"utf-8\")\n   127\tmatch = re.search(r'(?m)^[ \\t]*cascade-status:\\s+([^\\r\\n]+?)\\s*$', text)\n   128\tif not match:\n   129\t    raise SystemExit(1)\n   130\tprint(match.group(1).strip())\n   131\tPY\n   132\t)\" || true\n   133\tif [ \"$dispatch_note_mode\" = \"not applicable\" ]; then\n   134\t  printf 'OK: DISPATCH-NOTE declares cascade-status: not applicable; not a cohort cascade slice — nothing to enforce\\n'\n   135\t  exit 0\n   136\tfi\n   137\t\n   138\tcascade_status=\"$(\n   139\t  python3 - \"$DISPATCH_NOTE\" <<'PY'\n   140\timport re\n   141\timport sys\n   142\tfrom pathlib import Path\n   143\t\n   144\ttext = Path(sys.argv[1]).read_text(encoding=\"utf-8\")\n   145\tmatches = re.findall(r'^cascade-status:\\s+([a-z-]+)\\s*$', text, re.M)\n   146\tif len(matches) != 1:\n   147\t    joined = \", \".join(matches) if matches else \"[]\"\n   148\t    print(f\"ERROR: expected exactly one cascade-status match, found {len(matches)}: {joined}\", file=sys.stderr)\n   149\t    sys.exit(1)\n   150\tprint(matches[0])\n   151\tPY\n   152\t)\"\n   153\t\n   154\tcase \"$cascade_status\" in\n   155\t  onboarded|onboarded-operator-bump|blocked-on-adopter-conflict)\n   156\t    ;;\n   157\t  \"not applicable\")\n   158\t    printf 'OK: DISPATCH-NOTE declares cascade-status: not applicable; not a cohort cascade slice — nothing to enforce\\n'\n   159\t    exit 0\n   160\t    ;;\n   161\t  *)\n   162\t    die \"FAIL-CLOSED: cascade-status field absent or unrecognised; must be one of {onboarded, onboarded-operator-bump, blocked-on-adopter-conflict, not applicable}\"\n   163\t    ;;\n   164\tesac\n   165\t\n   166\ttarget_repo=\"$(\n   167\t  python3 - \"$DISPATCH_NOTE\" <<'PY'\n   168\timport re\n   169\timport sys\n   170\tfrom pathlib import Path\n   171\t\n   172\ttext = Path(sys.argv[1]).read_text(encoding=\"utf-8\")\n   173\tmatch = re.search(r'^[ \\t]*-[ \\t]+\\*\\*Target:\\*\\*[ \\t]+([a-zA-Z0-9._/-]+)[ \\t]*$', text, re.M)\n   174\tif not match:\n   175\t    sys.exit(1)\n   176\tprint(match.group(1))\n   177\tPY\n   178\t)\" || die \"ERROR: could not extract target from DISPATCH-NOTE\" 2\n   179\t\n   180\tadopter_slug=\"$(canonicalize_adopter_slug \"$target_repo\")\"\n   181\t\n   182\tif [ \"$PR\" != \"\" ]; then\n   183\t  gh pr view \"$PR\" --json body --jq '.body' >/dev/null\n   184\t  changed_files=\"$(gh pr diff \"$PR\" --name-only)\"\n   185\t  branch_log_patch=\"$(gh pr diff \"$PR\" --patch -- \"$BRANCH_PROTECTION_LOG\" 2>/dev/null || true)\"\n   186\telse\n   187\t  changed_files=\"$(git diff --name-only \"${DIFF_BASE}..HEAD\")\"\n   188\t  branch_log_patch=\"$(git diff --unified=0 \"${DIFF_BASE}..HEAD\" -- \"$BRANCH_PROTECTION_LOG\")\"\n   189\tfi\n   190\t\n   191\tbranch_log_modified=0\n   192\tif grep -Fxq \"$BRANCH_PROTECTION_LOG\" <<<\"$changed_files\"; then\n   193\t  branch_log_modified=1\n   194\tfi\n   195\t\n   196\tparse_entry_repo() {\n   197\t  python3 -c 'import re, sys\n   198\tpatch = sys.stdin.read().splitlines()\n   199\tmatched = []\n   200\tfor line in patch:\n   201\t    if line.startswith(\"+### \"):\n   202\t        match = re.search(r\"^###\\s+.+\\s+—\\s+([A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)?)@([A-Za-z0-9._./-]+)$\", line[1:])\n   203\t        if match:\n   204\t            matched.append(match.group(1))\n   205\tif len(matched) != 1:\n   206\t    values = \", \".join(matched) if matched else \"[]\"\n   207\t    print(\"ERROR: expected exactly one log entry target match, found {}: {}\".format(len(matched), values), file=sys.stderr)\n   208\t    sys.exit(1)\n   209\tprint(matched[0])\n   210\t' \n   211\t}\n   212\t\n   213\tentry_repo=\"\"\n   214\tif [ \"$branch_log_modified\" -eq 1 ]; then\n   215\t  if ! entry_repo=\"$(printf '%s' \"$branch_log_patch\" | parse_entry_repo)\"; then\n   216\t    exit 1\n   217\t  fi\n   218\tfi\n   219\t\n   220\tcase \"$cascade_status\" in\n","exit_code":0,"status":"completed"}}

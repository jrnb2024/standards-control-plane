ncoding=\"utf-8\")\npattern = rf'TF-024X-conflict-{re.escape(slug)}(?:\\*\\*)? \\((open|pending|in-progress|closed)\\): \\S.{{19,}}'\nif not re.search(pattern, text):\n    sys.exit(1)\nPY\n    printf 'OK: cascade-status=%s; 2 checks passed\\n' \"$cascade_status\"\n    ;;\nesac\n","exit_code":0,"status":"completed"}}

required_status_checks\")\nscripts/enable-required-check.sh:423:restore_required_checks_have_contexts = isinstance(required_status_checks.get(\"contexts\"), list) and len(required_status_checks.get(\"contexts\")) > 0\nscripts/enable-required-check.sh:426:before_scrubbed[\"required_status_checks\"] = {\nscripts/enable-required-check.sh:427:    \"strict\": required_status_checks.get(\"strict\"),\nscripts/enable-required-check.sh:428:    \"contexts\": required_status_checks.get(\"contexts\"),\nscripts/enable-required-check.sh:439:        print(\"[020G] WARNING: restore pre-state restrictions contained unexpected fields: {}; restoring users/teams/apps only\".format(\", \".join(unexpected)), file=sys.stderr)\nscripts/enable-required-check.sh:492:      echo \"[020G] WARNING: restore pre-state would remove admin enforcement (enforce_admins.enabled=false)\" >&2\nscripts/enable-required-check.sh:495:      echo \"[020G] WARNING: restore pre-state would clear required status checks (required_status_checks.contexts empty or null)\" >&2\nscripts/enable-required-check.sh:498:      echo \"[020G] WARNING: pass --i-understand-restore-removes-admin-enforcement to continue\" >&2\nscripts/enable-required-check.sh:502:      echo \"[020G] WARNING: pass --i-understand-restore-removes-required-checks to continue\" >&2\nscripts/enable-required-check.sh:579:# Per 020G R1 correctness CORR-003: required_signatures is a\nscripts/enable-required-check.sh:582:# the /required_signatures endpoint after the main PUT. The\nscripts/enable-required-check.sh:583:# unified PUT body therefore omits required_signatures.\nscripts/enable-required-check.sh:597:       required_status_checks: {\nscripts/enable-required-check.sh:639:# a stderr WARNING if it is currently false or absent so the operator\nscripts/enable-required-check.sh:648:  echo \"[020G] WARNING: required_pull_request_reviews.dismiss_stale_reviews is ${DISMISS_STALE_VAL} on the target repo\" >&2\nscripts/enable-required-check.sh:649:  echo \"[020G] WARNING: multi-maintainer SCP adopters MUST set dismiss_stale_reviews: true (ADOPT-001 §12.7.4)\" >&2\nscripts/enable-required-check.sh:650:  echo \"[020G] WARNING: this script preserves the existing review-shape verbatim and does not set this for you\" >&2\nscripts/enable-required-check.sh:651:  echo \"[020G] WARNING: configure it via 'gh api -X PATCH repos/<owner>/<repo>/branches/<branch>/protection/required_pull_request_reviews -F dismiss_stale_reviews=true'\" >&2\nscripts/enable-required-check.sh:652:  echo \"[020G] WARNING: single-operator adopters with required_approving_review_count=0 (per D-033) can ignore this warning\" >&2\nscripts/enable-required-check.sh:662:  log \"post-PUT, would also enable required_signatures via the dedicated sub-resource.\"\nscripts/enable-required-check.sh:686:  log \"enabling required_signatures (dedicated sub-resource)...\"\nscripts/enable-required-check.sh:687:  gh api -X POST \"repos/${REPO}/branches/${BRANCH}/protection/required_signatures\" >/dev/null || APPLY_FAIL=1\nscripts/enable-required-check.sh:689:    echo \"ERROR: required_signatures POST failed; status-checks/admins/reviews are set but signatures are NOT\" >&2\nscripts/enable-required-check.sh:700:CHECKS_STRICT=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_status_checks.strict // false')\"\nscripts/enable-required-check.sh:701:CHECKS_CONTEXTS=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_status_checks.contexts // [] | join(\",\")')\"\nscripts/enable-required-check.sh:703:SIGS_ENABLED=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_signatures.enabled // false')\"\nscripts/enable-required-check.sh:711:[ \"$CHECKS_STRICT\" = \"true\" ] || { echo \"verify FAIL: required_status_checks.strict=${CHECKS_STRICT}\" >&2; FAIL=1; }\nscripts/enable-required-check.sh:714:[ \"$SIGS_ENABLED\" = \"true\" ] || { echo \"verify FAIL: required_signatures=${SIGS_ENABLED}\" >&2; FAIL=1; }\nscripts/enable-required-check.sh:732:  log \"  required_signatures:   ${SIGS_ENABLED}\"\ndocs/adoption/ADOPT-001-project-onboarding.md:706:  invocation per the **three-gate** break-glass procedure documented\ndocs/adoption/ADOPT-001-project-onboarding.md:710:**CODEOWNERS requirement (MUST).** CODEOWNERS protection on `.scp/rule-config.yaml` is required, not optional: a `disable: true` entry suppresses a rule's deny WITHOUT triggering the three-gate break-glass check (see §12.7.4), making `.scp/rule-config.yaml` a bypass-surface equivalent to `scp_bypass: true`. Without CODEOWNERS coverage, a single developer can silently disable any SCP rule. Minimum:\ndocs/adoption/ADOPT-001-project-onboarding.md:757:SCP cuts a new release, and how break-glass + rollback work.\ndocs/adoption/ADOPT-001-project-onboarding.md:870:4. Logs a stderr WARNING about required PAT scope (`administration:write` on the single target repo).\ndocs/adoption/ADOPT-001-project-onboarding.md:871:5. Captures before-state, applies the unified PUT (status-checks + admins + reviews), then a separate POST to the `required_signatures` sub-resource.\ndocs/adoption/ADOPT-001-project-onboarding.md:877:For multi-maintainer adopters who want review enforcement: the script *preserves* any existing `required_pull_request_reviews` shape rather than nulling it (per 020G fix-round-1 SAF-002 closure). Configure your review-shape via the standard GitHub UI or API; the SCP helper won't touch it. **Multi-maintainer adopters MUST also set `dismiss_stale_reviews: true`** — see §12.7.4 for the security rationale and the helper's stderr WARNING when this is missing.\ndocs/adoption/ADOPT-001-project-onboarding.md:888:   gh api repos/OWNER/NAME/branches/BRANCH/protection/required_status_checks \\\ndocs/adoption/ADOPT-001-project-onboarding.md:893:2. Confirm `enforce_admins` and `required_signatures`:\ndocs/adoption/ADOPT-001-project-onboarding.md:898:   gh api repos/OWNER/NAME/branches/BRANCH/protection/required_signatures --jq '.enabled'\ndocs/adoption/ADOPT-001-project-onboarding.md:916:- **Multi-maintainer adopters.** Configure branch protection with `required_approving_review_count >= 1`, `require_code_owner_reviews: true`, **AND `dismiss_stale_reviews: true`**. (GitHub enforces non-self-approval at the platform level — there is no separate REST API field for that constraint; the WP-SCP-020 plan corpus uses `require_review_from_non_author: true` as shorthand for this platform behaviour, but no API field needs to be set.) Gate 1 is **machine-enforced** — a bypass PR cannot merge without a CODEOWNER review from someone other than the author. The `dismiss_stale_reviews: true` setting is non-optional in this mode: without it, an approving CODEOWNER review on an initial commit persists across subsequent commits in the same PR, so an attacker who obtains a clean review can later push commits that add `.scp/rule-config.yaml disable: true`, change `scp_bypass: true`, or weaken the wrapper's fork-PR `if:` — and merge without re-review. Dismissal fires on ANY push to the PR branch regardless of which files the new commit touches — it is not path-selective. Stale-review dismissal is the enforcement complement to `require_code_owner_reviews`. The `enable-required-check.sh` helper preserves your existing review-shape verbatim and does NOT set `dismiss_stale_reviews: true` for you; configure it explicitly via the GitHub branch-protection UI or API. (As of fix-round-5 of this slice, `enable-required-check.sh` emits a stderr WARNING when the preserved existing review config has `dismiss_stale_reviews: false` — see also the \"verify the gate is live\" block in §12.7.3.)\ndocs/adoption/ADOPT-001-project-onboarding.md:950:   gh api repos/OWNER/NAME/branches/BRANCH/protection/required_status_checks --jq '.contexts'\ndocs/adoption/ADOPT-001-project-onboarding.md:957:   gh api -X PATCH repos/OWNER/NAME/branches/BRANCH/protection/required_status_checks \\\ndocs/adoption/ADOPT-001-project-onboarding.md:963:   gh api -X PATCH repos/OWNER/NAME/branches/BRANCH/protection/required_status_checks \\\ndocs/adoption/ADOPT-001-project-onboarding.md:969:3. Optionally relax `enforce_admins` if it was set ONLY for the SCP gate. Keep `required_signatures` regardless — it is independent of SCP and a baseline supply-chain hygiene control.\ndocs/adoption/ADOPT-001-project-onboarding.md:1203:### 12.8 Break-glass procedure for federation-primitive failure\ndocs/adoption/ADOPT-001-project-onboarding.md:1205:If the SCP federation primitive ships a defect that makes the wrapper or branch-protection path unsafe to keep armed, adopters use a three-gate break-glass procedure to bypass the gate temporarily without manually mutating branch protection in the GitHub UI.\ndocs/adoption/ADOPT-001-project-onboarding.md:1209:   - Note: if the captured pre-state would remove `enforce_admins` or clear `required_status_checks.contexts`, the restore exits 2 unless you add `--i-understand-restore-removes-admin-enforcement` and/or `--i-understand-restore-removes-required-checks`. Those acknowledgements are safe to include unconditionally when the pre-state is known to be degraded.\ndocs/adoption/ADOPT-001-project-onboarding.md:1214:   0. **REQUIRED: pass `--expected-wrapper-sha <release-tag-sha-from-gate-2>` to `scripts/enable-required-check.sh --repo <owner/repo> --branch <branch>` before re-arming.** Do not re-enable without it. If you are intentionally skipping Gate 2 verification for an emergency re-arm, pass `--i-understand-no-gate-2-verification` instead and record the exception in the invocation log.\ndocs/DECISIONS.md:78:| D-031 | 2026-04-30 | Apply WP-SCP-020 slice 020K on the SCP repository in the personal-account / single-operator mode resolved at §14 U-k closure: (a) NO `scp-break-glass` GitHub team is created — GitHub teams are not available on user namespaces and `jrnb2024` is a personal user account; (b) `CODEOWNERS` extends to cover the additional governance-sensitive paths named in §4 020K (canonical-minimum), then broadened/extended via 020K R1+R2+R3 safety reviews to close 7 MAJ + 4 MIN + 6 nit findings — see CODEOWNERS file header + `FIX-ROUND-{1,2,3}.md` for the full audit trail of which paths were broadened (subsuming a narrower canonical rule) vs added net-new; (c) at slice 020D2, branch-protection on `main` is configured with `required_approving_review_count = 1`, `dismiss_stale_reviews: true`, and `require_review_from_non_author = false` (solo operator; self-approval is the only option) — **NOTE (D-033 amendment, 2026-04-30 evening):** the anticipated `required_approving_review_count = 1` was corrected to `count = 0` by D-033 when the first PR through enforced mode revealed that GitHub forbids PR self-review; count=1 + sole CODEOWNER = operator locked out of repo. See D-033 for the live state, the operational test path (USER-GATE-A signoff PR #64), and the second-maintainer escalation path; (d) §8 bus-factor-1 risk row remains LIVE with quarterly escalation review at 2026-07-21 named in `STATUS.md` \"Open scheduled follow-ups\" and in auto-memory `project_scheduled_followups.md`. **Escalation path when a second maintainer onboards:** add them to `CODEOWNERS`, flip `require_review_from_non_author = true`, amend §8 risk row to CLOSED. **020D1 → 020D2 dependency:** 020K completes before 020D2 opens (the branch-protection wiring at 020D2 reads from CODEOWNERS established here). Identified at WP-SCP-020 plan §3 sequence + §4 020K + §14 U-k closure | ACCEPTED | Personal-account path is the only viable shape for v1.0.0 on a personal user namespace. The CODEOWNERS expansion forces every future change to `renovate/**` (Renovate preset that cascades pin-bumps across adopters), `docs/DECISIONS.md` (the decision-record canonical home), and `output/findings/waivers.json` (the safety-valve store) through reviewer attention rather than allowing direct push. Bus-factor-1 is acknowledged as live operational exposure rather than papered over: `require_review_from_non_author = false` reflects reality (a solo operator cannot self-approve under non-author review), and the 2026-07-21 quarterly review is the named re-evaluation moment. Path (b) extension of `CODEOWNERS` is forward-looking on `renovate/**` (the directory does not yet exist in the working tree; it lands in slice 020F); CODEOWNERS rules on non-existent paths are no-ops, so adding the rule pre-emptively is harmless and removes a future drift risk where 020F could land without simultaneously adding the matching CODEOWNERS row. Full rationale in `docs/plans/WP-SCP-020-policy-federation-primitive.md` §4 020K + §8 (bus factor risk row, line 188) + §14 U-k closure |\ndocs/DECISIONS.md:82:| D-035 | 2026-04-30 | Adopt the WP-SCP-020 slice 020G adopter-helper invocation procedure as estate doctrine. The required-check context name `policy-check / scp/policy-check` traces to D-033 (the rendered Actions check-run name established for the SCP self-dogfood gate). Adopters of the SCP federation primitive enable this required status check on their default branch via `scripts/enable-required-check.sh` from the SCP repo. The script applies branch protection in two API calls (unified PUT for status-checks/admins/reviews + dedicated POST to `required_signatures` sub-resource per the GitHub API shape), refuses to bypass admin enforcement without an explicit `--i-understand-this-bypasses-the-gate` acknowledgement flag, refuses to run in CI (CI=true / GITHUB_ACTIONS=true env-var guards), preserves any pre-existing `required_pull_request_reviews` shape rather than nulling it, and emits an invocation-log block (operator, timestamp, script SHA256 + git SHA, target repo+branch, before/after API JSON) for paste into `docs/reviews/WP-SCP-020/branch-protection-log.md`. The log commit is part of the invocation procedure: an apply without the log entry is considered unrecorded. Estate cascade rollout (WP-SCP-024) drives this script across PIM, recommender, shopify-app, mapp-doc-agent, control-tower; FLA pilot (WP-SCP-020.1) is the canary first invocation | ACCEPTED | Symmetric posture with D-030 (020J `v*` tag-protection), D-031 (020K CODEOWNERS personal-account), D-032 (020D2 SCP-self required-status-check), D-034 (020F `renovate/v*` tag-protection): every operational procedure that mutates third-party repository state ships an idempotent applier + ratifying D-NNN + invocation log convention. The bootstrap-only / no-CI guard reflects that this script writes to a third-party repo's branch protection — an automation tool that ran it unattended could mass-mutate the estate via stolen credentials before any operator noticed. The `--i-understand-this-bypasses-the-gate` confirmation reflects that `--no-enforce-admins` defeats the whole point of the federation primitive on the target repo and so should require explicit intent. The `required_pull_request_reviews` preservation reflects that adopters with multi-maintainer teams have legitimate review-shape state that 020G must not destroy. Identified at WP-SCP-020 §4 020G + 020G R1 review (3 MAJ + 5 MIN + 2 nit on safety, 2 MAJ + 4 MIN + nit on completeness, 3 MAJ + 2 MIN + 2 nit on correctness — fixpoint via fix-round-1) |\ndocs/DECISIONS.md:90:| D-044 | 2026-05-09 | Adopt the WP-SCP-024 slice 024B operational contracts for cascade scaffolding (this PR). Components: (1) `scripts/scaffold-downstream.sh` (= `SCP-073-scaffolder` per WP-SCP-020 §11 follow-up + WP-SCP-021 follow-up `SCP-075-scaffolder-compose`) generates adopter-side artefacts mechanically — bootstrap-only (refuses `CI=true` / `GITHUB_ACTIONS=true` per D-035 symmetry); validates `--scp-sha` against SCP main HEAD lineage (warns if not main HEAD; refuses if non-existent); emits `MANIFEST.json` with SHA256 audit; arguments `--adopter-repo`, `--default-branch`, `--scp-sha`, `--scorecard-emit`, `--output-dir` per plan-doc §5.3. (2) `templates/adopter-wrapper.yml.tmpl` is the canonical adopter wrapper shape per ADOPT-001 §12; cascade-onboarded adopters standardise on `policy-check-wrapper.yml`, while pre-cascade manual adopters may still have `policy-check.yml` until they rename to the canonical filename (the §12.7.1 callout covers this carve-out and the follow-on `--wrapper-path` work item). (3) `scripts/enable-required-check.sh --restore <pre-state.json>` mode reverses prior branch-protection mutation from a captured before-state, validates the captured GET-shape JSON, transforms it into the PUT payload by stripping `_links` / `url` / `checks` envelope fields, flattening `enforce_admins.enabled` back to a boolean, preserving `required_pull_request_reviews` recursively, and normalising invalid or absent `restrictions` to null. Restore mode now warns and requires explicit acknowledgements when the captured pre-state would remove `enforce_admins` or clear `required_status_checks.contexts`, captures the observed current branch-protection state immediately before PUT, and mirrors forward-mode's APPLY_FAIL pattern so failed PUTs still emit an audit log before exiting non-zero. New safety check (forward mode only): resolves the canonical wrapper by repo-relative path (`.github/workflows/policy-check-wrapper.yml`) instead of workflow display name, then refuses to invoke unless the repo has at least one successful `policy-check` workflow run in the last 60 days on the target branch; once a target already has an invocation log entry, forward-mode re-arming requires `--expected-wrapper-sha <release-tag-sha-from-gate-2>` or the explicit `--i-understand-no-gate-2-verification` override. (4) `scripts/check-invocation-log-entry.sh` CI enforces invariant 2's 4 cascade-status check behaviours: fail-closed default for absent/unrecognised `cascade-status:`; `onboarded` requires log entry + target match; `onboarded-operator-bump` additionally requires STATUS.md `TF-024X-renovate-<adopter-slug>` row matching regex literally; `blocked-on-adopter-conflict` requires DISPATCH-NOTE `TF-024X-conflict-<adopter>` reference matching regex literally + log file NOT modified. Slug matching canonicalises adopter names to lowercased hyphen-only owner/repo strings so dots/underscores collapse to hyphens before regex matching. Regex (Python re): `TF-024X-(renovate|conflict)-[a-z0-9]+(?:-[a-z0-9]+)+(?:\\*\\*)? \\((open|pending|in-progress|closed)\\): \\S.{19,}` — matches in STATUS.md or DISPATCH-NOTE; `\\S` anchor at description start prevents all-whitespace bypass; ≥20 chars total. (5) ADOPT-001 §12.8 break-glass procedure — 3-gate playbook (disable via `--restore` → SHA-pin to last known-good release tag → re-enable after Renovate-bumped fix). All four script components (scaffolder + `--restore` + `--i-understand` flag + `check-invocation-log-entry.sh` covering all four CI behaviours) are hard predecessors for slice 024C. Slice 024B itself ships under documented protocol deviation (direct codex exec / claude -p; non-kernel-dangerous shell + tests + docs scope) per `feedback_four_tier_dispatch.md` note + justify rule; 024C entry is conditional on `FUP-ACC-INSTALL-TARGET-REPO-001` closure (per-repo dispatcher install pattern resolved in ACC). | ACCEPTED | D-044 was reserved at WP-SCP-024 plan-doc 024A merge (PR #102, 2026-05-04) per the §9 reservation block; this slice ratifies it. The four-component scope (scaffolder + template + `--restore` + `check-invocation-log-entry.sh`) is the single hardest predecessor surface for cohort cascade — without all four, cascade slices 024C-F would each rebuild the per-adopter wrapper shape, the rollback procedure, and the cascade-status invariant enforcement from scratch (multiplying the 9-round adversarial-review burden that 024A absorbed by 4 cohort slices). The `MANIFEST.json` + SHA256 audit surface mirrors the `install_acc_hook.sh` pattern (atomic config + binary SHA pinning) — provides forensic traceability for cascade-driven adopter-side artefact authorship. The `--i-understand-this-repo-has-no-prior-green-ci` flag closes the cold-start chicken-and-egg: a new adopter has no green CI before the wrapper merges + at least one PR runs, so the safety check would otherwise block first-onboard; the explicit flag is the operator's acknowledgement that they accept the cold-start risk for that single first-onboard run. The break-glass 3-gate procedure is intentionally NOT a one-button kill-switch (all gates auditable in git history; Gate 2's wrapper-SHA-pin is explicit operator consent to step backwards from current SCP main; Gate 3 ensures adopters don't stay un-gated forever). Bus-factor-1 acknowledged (D-031); 2026-07-21 quarterly review covers. Identified at WP-SCP-024 plan-doc §9 D-044 reservation. |\n","exit_code":0,"status":"completed"}}

it 2\n   152\tfi\n   153\t\n   154\tif [ \"$SCP_SHA\" != \"$V1_0_0_SCP_SHA\" ]; then\n   155\t  if ! git -C \"$SCP_REPO_ROOT\" rev-parse v1.2.0 >/dev/null 2>&1; then\n   156\t    warn \"v1.2.0 tag not present in local clone; TF-023E-002 startup_failure check skipped — verify manually if SHA is post-v1.2.0 (memory project_wp_scp_023_state.md). Continuing emission.\"\n   157\t  elif git -C \"$SCP_REPO_ROOT\" merge-base --is-ancestor v1.2.0 \"$SCP_SHA\" 2>/dev/null; then\n   158\t    warn \"--scp-sha $SCP_SHA is post-v1.2.0. Until TF-023E-002 closes (memory project_wp_scp_023_state.md), the called workflow's attest-scorecard job permissions ceiling causes startup_failure regardless of scorecard-emit value. Generated wrapper will fail GitHub Actions startup. RECOMMENDED: use --scp-sha $V1_0_0_SCP_SHA (v1.0.0). Continuing emission per operator request.\"\n   159\t  fi\n   160\tfi\n   161\t\n   162\tMAIN_HEAD_SHA=\"$(git -C \"$SCP_REPO_ROOT\" rev-parse main 2>/dev/null || true)\"\n   163\tif [ -z \"$MAIN_HEAD_SHA\" ]; then\n   164\t  warn \"could not resolve SCP main HEAD; continuing without HEAD-lineage warning\"\n   165\telif [ \"$SCP_SHA\" != \"$MAIN_HEAD_SHA\" ]; then\n   166\t  warn \"--scp-sha $SCP_SHA is not current SCP main HEAD $MAIN_HEAD_SHA; emitted wrapper will be behind main\"\n   167\tfi\n   168\t\n   169\tWORKFLOWS_DIR=\"${OUTPUT_DIR}/.github/workflows\"\n   170\tmkdir -p \"$WORKFLOWS_DIR\"\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/zsh -lc \"nl -ba scripts/check-invocation-log-entry.sh | sed -n '1,240p'\"","aggregated_output":"     1\t#!/usr/bin/env bash\n     2\t# shellcheck shell=bash\n     3\t# WP-SCP-024 slice 024B invocation-log CI enforcer.\n     4\t#\n     5\t# Enforces the cascade-status contract defined by WP-SCP-024 plan-doc\n     6\t# §5.2 and invariant 2. Supports either PR-driven checks or a local\n     7\t# diff-base comparison. \"not applicable\" is for tooling slices ONLY\n     8\t# (024A plan-doc; 024B-core; 024B-extras; 024G Threshold A telemetry).\n     9\t# Cohort cascade slices (024C/D/E/F) MUST declare one of the 3\n    10\t# enforcement values; slice-type metadata in DISPATCH-NOTE closes the\n    11\t# operator-misuse bypass by distinguishing tooling from cohort slices.\n    12\t#\n    13\t# Reference: docs/plans/WP-SCP-024-estate-cascade.md §5.2 / §6;\n    14\t# docs/reviews/WP-SCP-024/024B-core/DISPATCH-NOTE.md; docs/DECISIONS.md D-044.\n    15\t\n    16\tset -euo pipefail\n    17\t\n    18\tusage() {\n    19\t  cat >&2 <<'EOF'\n    20\tUsage: check-invocation-log-entry.sh --pr <number> | --diff-base <ref> --dispatch-note <path> [--status-md <path>] [--branch-protection-log <path>] [--allow-not-applicable] [--tooling-slice-id <id>]\n    21\t\n    22\tRequired:\n    23\t  --pr <number>                  Check a PR via gh.\n    24\t  --diff-base <ref>              Check the current branch against a git ref.\n    25\t  --dispatch-note <path>         Slice DISPATCH-NOTE.md path.\n    26\t\n    27\tOptional:\n    28\t  --status-md <path>             STATUS.md path (default: STATUS.md).\n    29\t  --branch-protection-log <path> Branch-protection log path.\n    30\t                                 Default: docs/reviews/WP-SCP-020/branch-protection-log.md\n    31\t  --allow-not-applicable         Allow cascade-status: not applicable.\n    32\t  --tooling-slice-id <id>        Required with --allow-not-applicable; must be one of 024A, 024B-core, 024B-extras, 024G.\n    33\t  --help / -h                    Show this help.\n    34\tEOF\n    35\t}\n    36\t\n    37\tdie() {\n    38\t  printf '%s\\n' \"$1\" >&2\n    39\t  exit \"${2:-1}\"\n    40\t}\n    41\t\n    42\tPR=\"\"\n    43\tDIFF_BASE=\"\"\n    44\tDISPATCH_NOTE=\"\"\n    45\tSTATUS_MD=\"STATUS.md\"\n    46\tBRANCH_PROTECTION_LOG=\"docs/reviews/WP-SCP-020/branch-protection-log.md\"\n    47\tALLOW_NOT_APPLICABLE=0\n    48\tTOOLING_SLICE_ID=\"\"\n    49\t\n    50\twhile [ $# -gt 0 ]; do\n    51\t  case \"$1\" in\n    52\t    --pr)\n    53\t      [ $# -ge 2 ] || die \"ERROR: --pr requires a value\" 2\n    54\t      PR=\"$2\"\n    55\t      shift 2\n    56\t      ;;\n    57\t    --diff-base)\n    58\t      [ $# -ge 2 ] || die \"ERROR: --diff-base requires a value\" 2\n    59\t      DIFF_BASE=\"$2\"\n    60\t      shift 2\n    61\t      ;;\n    62\t    --dispatch-note)\n    63\t      [ $# -ge 2 ] || die \"ERROR: --dispatch-note requires a value\" 2\n    64\t      DISPATCH_NOTE=\"$2\"\n    65\t      shift 2\n    66\t      ;;\n    67\t    --status-md)\n    68\t      [ $# -ge 2 ] || die \"ERROR: --status-md requires a value\" 2\n    69\t      STATUS_MD=\"$2\"\n    70\t      shift 2\n    71\t      ;;\n    72\t    --branch-protection-log)\n    73\t      [ $# -ge 2 ] || die \"ERROR: --branch-protection-log requires a value\" 2\n    74\t      BRANCH_PROTECTION_LOG=\"$2\"\n    75\t      shift 2\n    76\t      ;;\n    77\t    --allow-not-applicable)\n    78\t      ALLOW_NOT_APPLICABLE=1\n    79\t      shift\n    80\t      ;;\n    81\t    --tooling-slice-id)\n    82\t      [ $# -ge 2 ] || die \"ERROR: --tooling-slice-id requires a value\" 2\n    83\t      TOOLING_SLICE_ID=\"$2\"\n    84\t      shift 2\n    85\t      ;;\n    86\t    -h|--help)\n    87\t      usage\n    88\t      exit 0\n    89\t      ;;\n    90\t    *)\n    91\t      die \"ERROR: unknown flag: $1\" 2\n    92\t      ;;\n    93\t  esac\n    94\tdone\n    95\t\n    96\tif [ -n \"$PR\" ] && [ -n \"$DIFF_BASE\" ]; then\n    97\t  die \"ERROR: --pr and --diff-base are mutex\" 2\n    98\tfi\n    99\tif [ -z \"$PR\" ] && [ -z \"$DIFF_BASE\" ]; then\n   100\t  die \"ERROR: one of --pr or --diff-base is required\" 2\n   101\tfi\n   102\tif [ -z \"$DISPATCH_NOTE\" ]; then\n   103\t  die \"ERROR: --dispatch-note is required\" 2\n   104\tfi\n   105\t\n   106\tnormalize_path() {\n   107\t  python3 -c 'import os, sys; print(os.path.normpath(sys.argv[1]))' \"$1\"\n   108\t}\n   109\t\n   110\tcanonicalize_adopter_slug() {\n   111\t  # Canonical slugs are a normalization aid, not a collision-resistant ID.\n   112\t  # Cohort adopter repo names must remain unique after canonicalization.\n   113\t  printf '%s' \"$1\" | python3 -c 'import re, sys\n   114\ts = sys.stdin.read().strip().lower()\n   115\ts = re.sub(r\"[^a-z0-9-]+\", \"-\", s.replace(\"/\", \"-\"))\n   116\ts = re.sub(r\"-+\", \"-\", s).strip(\"-\")\n   117\tprint(s)'\n   118\t}\n   119\t\n   120\tDISPATCH_NOTE=\"$(normalize_path \"$DISPATCH_NOTE\")\"\n   121\tSTATUS_MD=\"$(normalize_path \"$STATUS_MD\")\"\n   122\tBRANCH_PROTECTION_LOG=\"$(normalize_path \"$BRANCH_PROTECTION_LOG\")\"\n   123\t\n   124\tREPO_ROOT=\"$(git rev-parse --show-toplevel 2>/dev/null || true)\"\n   125\tif [ -z \"$REPO_ROOT\" ]; then\n   126\t  die \"ERROR: could not resolve repository root\"\n   127\tfi\n   128\tREPO_ROOT=\"$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' \"$REPO_ROOT\")\"\n   129\tDISPATCH_NOTE_REAL=\"$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' \"$DISPATCH_NOTE\")\"\n   130\tSTATUS_MD_REAL=\"$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' \"$STATUS_MD\")\"\n   131\tBRANCH_PROTECTION_LOG_REAL=\"$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' \"$BRANCH_PROTECTION_LOG\")\"\n   132\t\n   133\tcase \"$DISPATCH_NOTE_REAL\" in\n   134\t  \"$REPO_ROOT\"|\"$REPO_ROOT\"/*) ;;\n   135\t  *) die \"ERROR: --dispatch-note must resolve inside repository root: $DISPATCH_NOTE\" 2 ;;\n   136\tesac\n   137\tcase \"$STATUS_MD_REAL\" in\n   138\t  \"$REPO_ROOT\"|\"$REPO_ROOT\"/*) ;;\n   139\t  *) die \"ERROR: --status-md must resolve inside repository root: $STATUS_MD\" 2 ;;\n   140\tesac\n   141\tcase \"$BRANCH_PROTECTION_LOG_REAL\" in\n   142\t  \"$REPO_ROOT\"|\"$REPO_ROOT\"/*) ;;\n   143\t  *) die \"ERROR: --branch-protection-log must resolve inside repository root: $BRANCH_PROTECTION_LOG\" 2 ;;\n   144\tesac\n   145\t\n   146\tDISPATCH_NOTE=\"$DISPATCH_NOTE_REAL\"\n   147\tSTATUS_MD=\"$STATUS_MD_REAL\"\n   148\tBRANCH_PROTECTION_LOG=\"$BRANCH_PROTECTION_LOG_REAL\"\n   149\tBRANCH_PROTECTION_LOG_REPO_REL=\"$(python3 -c 'import os, sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' \"$BRANCH_PROTECTION_LOG\" \"$REPO_ROOT\")\"\n   150\t\n   151\tif [ -n \"$DIFF_BASE\" ]; then\n   152\t  diff_base_sha=\"$(git -C \"$REPO_ROOT\" rev-parse \"$DIFF_BASE\" 2>/dev/null || echo MISSING)\"\n   153\t  head_sha=\"$(git -C \"$REPO_ROOT\" rev-parse HEAD 2>/dev/null || echo MISSING)\"\n   154\t  if [ \"$diff_base_sha\" = \"$head_sha\" ] && [ \"$diff_base_sha\" != \"MISSING\" ]; then\n   155\t    die \"ERROR: --diff-base resolves to HEAD — diff is trivially empty; provide the PR base commit or origin/main instead\" 2\n   156\t  fi\n   157\tfi\n   158\t\n   159\t[ -f \"$DISPATCH_NOTE\" ] || die \"ERROR: DISPATCH-NOTE not found: $DISPATCH_NOTE\" 2\n   160\t[ -f \"$STATUS_MD\" ] || die \"ERROR: STATUS.md not found: $STATUS_MD\" 2\n   161\t[ -f \"$BRANCH_PROTECTION_LOG\" ] || die \"ERROR: branch-protection log not found: $BRANCH_PROTECTION_LOG\" 2\n   162\t\n   163\tif ! cascade_status=\"$(\n   164\t  python3 - \"$DISPATCH_NOTE\" <<'PY'\n   165\timport re\n   166\timport sys\n   167\tfrom pathlib import Path\n   168\t\n   169\ttext = Path(sys.argv[1]).read_text(encoding=\"utf-8\")\n   170\tmatches = re.findall(r'^cascade-status:\\s+([^\\r\\n]+?)\\s*$', text, re.M)\n   171\tif len(matches) != 1:\n   172\t    joined = \", \".join(matches) if matches else \"[]\"\n   173\t    print(f\"ERROR: expected exactly one cascade-status match, found {len(matches)}: {joined}\", file=sys.stderr)\n   174\t    sys.exit(1)\n   175\tprint(matches[0])\n   176\tPY\n   177\t)\"; then\n   178\t  exit 1\n   179\tfi\n   180\t\n   181\tif ! slice_type=\"$(\n   182\t  python3 - \"$DISPATCH_NOTE\" <<'PY'\n   183\timport re\n   184\timport sys\n   185\tfrom pathlib import Path\n   186\t\n   187\ttext = Path(sys.argv[1]).read_text(encoding=\"utf-8\")\n   188\tmatches = re.findall(r'^slice-type:\\s+([^\\r\\n]+?)\\s*$', text, re.M)\n   189\tif len(matches) > 1:\n   190\t    joined = \", \".join(matches)\n   191\t    print(f\"ERROR: expected at most one slice-type match, found {len(matches)}: {joined}\", file=sys.stderr)\n   192\t    sys.exit(1)\n   193\tprint(matches[0] if matches else \"MISSING\")\n   194\tPY\n   195\t)\"; then\n   196\t  exit 1\n   197\tfi\n   198\t\n   199\tcase \"$cascade_status\" in\n   200\t  onboarded|onboarded-operator-bump|blocked-on-adopter-conflict)\n   201\t    ;;\n   202\t  \"not applicable\")\n   203\t    # \"not applicable\" is reserved for tooling slices ONLY; cohort\n   204\t    # cascade slices must use one of the three enforcement values.\n   205\t    if [ \"$ALLOW_NOT_APPLICABLE\" -ne 1 ]; then\n   206\t      die \"ERROR: cascade-status: not applicable found, but --allow-not-applicable was not passed. This carve-out is for tooling slices ONLY (024A, 024B-core, 024B-extras, 024G); cohort cascade slices 024C/D/E/F MUST NOT use it. If this is a tooling slice, pass --allow-not-applicable explicitly.\" 2\n   207\t    fi\n   208\t    if [ \"$slice_type\" != \"tooling\" ]; then\n   209\t      die \"ERROR: --allow-not-applicable requires DISPATCH-NOTE to declare 'slice-type: tooling'. Found: ${slice_type}. Cohort cascade slices (024C/D/E/F) MUST NOT pass --allow-not-applicable.\" 2\n   210\t    fi\n   211\t    case \"$TOOLING_SLICE_ID\" in\n   212\t      024A|024B-core|024B-extras|024G) ;;\n   213\t      *) die \"ERROR: --allow-not-applicable requires --tooling-slice-id <id> where <id> ∈ {024A, 024B-core, 024B-extras, 024G}\" 2 ;;\n   214\t    esac\n   215\t    printf 'OK: DISPATCH-NOTE declares cascade-status: not applicable; not a cohort cascade slice — nothing to enforce\\n'\n   216\t    exit 0\n   217\t    ;;\n   218\t  *)\n   219\t    die \"FAIL-CLOSED: cascade-status field absent or unrecognised; must be one of {onboarded, onboarded-operator-bump, blocked-on-adopter-conflict}; not applicable requires --allow-not-applicable for tooling slices only\" 2\n   220\t    ;;\n   221\tesac\n   222\t\n   223\tif [ \"$ALLOW_NOT_APPLICABLE\" -eq 1 ] && [ \"$cascade_status\" != \"not applicable\" ]; then\n   224\t  die \"ERROR: --allow-not-applicable was passed but cascade-status is '$cascade_status' — flag is for tooling slices declaring cascade-status: not applicable ONLY. Cohort cascade slices (024C/D/E/F) MUST NOT pass this flag.\" 2\n   225\tfi\n   226\t\n   227\tif [ \"$slice_type\" != \"MISSING\" ] && [ \"$slice_type\" != \"tooling\" ] && [ \"$slice_type\" != \"cohort\" ]; then\n   228\t  die \"ERROR: invalid slice-type '$slice_type' in DISPATCH-NOTE; expected tooling or cohort\" 2\n   229\tfi\n   230\t\n   231\tif [ -n \"$TOOLING_SLICE_ID\" ] && [ \"$slice_type\" != \"MISSING\" ]; then\n   232\t  if [ \"$slice_type\" != \"tooling\" ]; then\n   233\t    die \"ERROR: --tooling-slice-id requires DISPATCH-NOTE to declare 'slice-type: tooling'. Found: ${slice_type}. Cohort cascade slices (024C/D/E/F) MUST NOT pass --tooling-slice-id.\" 2\n   234\t  fi\n   235\t  case \"$TOOLING_SLICE_ID\" in\n   236\t    024A|024B-core|024B-extras|024G) ;;\n   237\t    *) die \"ERROR: --tooling-slice-id requires one of {024A, 024B-core, 024B-extras, 024G}\" 2 ;;\n   238\t  esac\n   239\tfi\n   240\t\n","exit_code":0,"status":"completed"}}

\" \"$@\") >\"$stdout_file\" 2>\"$stderr_file\"; then\n    status=0\n  else\n    status=$?\n  fi\n  if [ \"$status\" -ne \"$expected_exit\" ]; then\n    printf 'unexpected exit code: expected %s got %s\\n' \"$expected_exit\" \"$status\" >&2\n    printf 'stdout:\\n' >&2\n    cat \"$stdout_file\" >&2\n    printf 'stderr:\\n' >&2\n    cat \"$stderr_file\" >&2\n    rm -f \"$stdout_file\" \"$stderr_file\"\n    exit 1\n  fi\n  if [ -n \"$expected_stdout\" ]; then\n    grep -Fq \"$expected_stdout\" \"$stdout_file\" || {\n      printf 'expected stdout to contain: %s\\n' \"$expected_stdout\" >&2\n      printf 'stdout:\\n' >&2\n      cat \"$stdout_file\" >&2\n      printf 'stderr:\\n' >&2\n      cat \"$stderr_file\" >&2\n      rm -f \"$stdout_file\" \"$stderr_file\"\n      exit 1\n    }\n  fi\n  if [ -n \"$expected_stderr\" ]; then\n    grep -Fq \"$expected_stderr\" \"$stderr_file\" || {\n      printf 'expected stderr to contain: %s\\n' \"$expected_stderr\" >&2\n      printf 'stdout:\\n' >&2\n      cat \"$stdout_file\" >&2\n      printf 'stderr:\\n' >&2\n      cat \"$stderr_file\" >&2\n      rm -f \"$stdout_file\" \"$stderr_file\"\n      exit 1\n    }\n  fi\n  rm -f \"$stdout_file\" \"$stderr_file\"\n}\n\nrun_pr_case() {\n  local repo_dir=\"$1\"\n  local fake_gh_dir=\"$2\"\n  local expected_exit=\"$3\"\n  local expected_stdout=\"$4\"\n  local expected_stderr=\"$5\"\n  local branch_protection_log=\"${6:-docs/reviews/WP-SCP-020/branch-protection-log.md}\"\n  local stdout_file stderr_file status\n  stdout_file=\"$(mktemp \"${TMPDIR}/stdout.XXXXXX\")\"\n  stderr_file=\"$(mktemp \"${TMPDIR}/stderr.XXXXXX\")\"\n  if (\n    cd \"$repo_dir\" &&\n    PATH=\"$fake_gh_dir:$PATH\" \\\n    \"$SCRIPT\" --pr 99 --dispatch-note DISPATCH-NOTE.md --status-md STATUS.md --branch-protection-log \"$branch_protection_log\"\n  ) >\"$stdout_file\" 2>\"$stderr_file\"; then\n    status=0\n  else\n    status=$?\n  fi\n  if [ \"$status\" -ne \"$expected_exit\" ]; then\n    printf 'unexpected exit code: expected %s got %s\\n' \"$expected_exit\" \"$status\" >&2\n    printf 'stdout:\\n' >&2\n    cat \"$stdout_file\" >&2\n    printf 'stderr:\\n' >&2\n    cat \"$stderr_file\" >&2\n    rm -f \"$stdout_file\" \"$stderr_file\"\n    exit 1\n  fi\n  if [ -n \"$expected_stdout\" ]; then\n    grep -Fq \"$expected_stdout\" \"$stdout_file\" || {\n      printf 'expected stdout to contain: %s\\n' \"$expected_stdout\" >&2\n      printf 'stdout:\\n' >&2\n      cat \"$stdout_file\" >&2\n      printf 'stderr:\\n' >&2\n      cat \"$stderr_file\" >&2\n      rm -f \"$stdout_file\" \"$stderr_file\"\n      exit 1\n    }\n  fi\n  if [ -n \"$expected_stderr\" ]; then\n    grep -Fq \"$expected_stderr\" \"$stderr_file\" || {\n      printf 'expected stderr to contain: %s\\n' \"$expected_stderr\" >&2\n      printf 'stdout:\\n' >&2\n      cat \"$stdout_file\" >&2\n      printf 'stderr:\\n' >&2\n      cat \"$stderr_file\" >&2\n      rm -f \"$stdout_file\" \"$stderr_file\"\n      exit 1\n    }\n  fi\n  rm -f \"$stdout_file\" \"$stderr_file\"\n}\n\nmain() {\n  local repo_dir\n\n  grep -Eq 'not applicable.*tooling slices ONLY|tooling slices.*ONLY' \"$SCRIPT\" || fail \"script missing not-applicable tooling-slice documentation\"\n\n  repo_dir=\"$TMPDIR/case1\"\n  init_case_repo \"$repo_dir\"\n  cat >\"$repo_dir/DISPATCH-NOTE.md\" <<'EOF'\ncascade-status: onboarded\n- **Target:** jrnb2024/pim\nEOF\n  cat >\"$repo_dir/docs/reviews/WP-SCP-020/branch-protection-log.md\" <<'EOF'\n---\n\n## Invocation log entry\n\n~~~markdown\n### 2026-05-09T00:00:00Z — jrnb2024/pim@main\n\n- **Operator:** @tester\n~~~\nEOF\n  commit_case \"$repo_dir\" \"case 1\"\n  run_case \"$repo_dir\" 0 'OK: cascade-status=onboarded; 2 checks passed' ''\n\n  repo_dir=\"$TMPDIR/case2\"\n  init_case_repo \"$repo_dir\"\n  cat >\"$repo_dir/DISPATCH-NOTE.md\" <<'EOF'\ncascade-status: onboarded\n- **Target:** jrnb2024/pim\nEOF\n  commit_case \"$repo_dir\" \"case 2\"\n  run_case \"$repo_dir\" 1 '' 'ERROR: branch-protection-log.md was not modified for cascade-status=onboarded'\n\n  repo_dir=\"$TMPDIR/case3\"\n  init_case_repo \"$repo_dir\"\n  cat >\"$repo_dir/DISPATCH-NOTE.md\" <<'EOF'\ncascade-status: onboarded\n- **Target:** jrnb2024/pim\nEOF\n  cat >\"$repo_dir/docs/reviews/WP-SCP-020/branch-protection-log.md\" <<'EOF'\n---\n\n## Invocation log entry\n\n~~~markdown\n### 2026-05-09T00:00:00Z — jrnb2024/wrong@main\n\n- **Operator:** @tester\n~~~\nEOF\n  commit_case \"$repo_dir\" \"case 3\"\n  run_case \"$repo_dir\" 1 '' \"ERROR: log entry target 'jrnb2024/wrong' does not match DISPATCH-NOTE target 'jrnb2024/pim'\"\n\n  repo_dir=\"$TMPDIR/case3b\"\n  init_case_repo \"$repo_dir\"\n  cat >\"$repo_dir/DISPATCH-NOTE.md\" <<'EOF'\ncascade-status: onboarded\n- **Target:** jrnb2024/wrong\n- **Target:** jrnb2024/pim\nEOF\n  cat >\"$repo_dir/docs/reviews/WP-SCP-020/branch-protection-log.md\" <<'EOF'\n---\n\n## Invocation log entry\n\n~~~markdown\n### 2026-05-09T00:00:00Z — jrnb2024/wrong@main\n\n- **Operator:** @tester\n~~~\nEOF\n  commit_case \"$repo_dir\" \"case 3b\"\n  run_case \"$repo_dir\" 1 '' 'ERROR: expected exactly one **Target:** match in DISPATCH-NOTE, found 2: jrnb2024/wrong, jrnb2024/pim'\n\n  # Plan-doc §2 invariant 2 worked-example matrix plus the operator-bump\n  # unmodified-log negative guard.\n\n  repo_dir=\"$TMPDIR/case4a\"\n  init_case_repo \"$repo_dir\"\n  cat >\"$repo_dir/DISPATCH-NOTE.md\" <<'EOF'\ncascade-status: onboarded-operator-bump\n- **Target:** jrnb2024/pim\nEOF\n  cat >\"$repo_dir/STATUS.md\" <<'EOF'\n- **TF-024X-renovate-jrnb2024-pim** (open): Renovate disabled on PIM; operator-bumped @abc123 at 024C; track until adopter enables Renovate cohort.\nEOF\n  cat >\"$repo_dir/docs/reviews/WP-SCP-020/branch-protection-log.md\" <<'EOF'\n---\n\n## Invocation log entry\n\n~~~markdown\n### 2026-05-09T00:00:00Z — jrnb2024/pim@main\n\n- **Operator:** @tester\n~~~\nEOF\n  commit_case \"$repo_dir\" \"case 4a\"\n  run_case \"$repo_dir\" 0 'OK: cascade-status=onboarded-operator-bump; 3 checks passed' ''\n\n  repo_dir=\"$TMPDIR/case4a-negative\"\n  init_case_repo \"$repo_dir\"\n  cat >\"$repo_dir/DISPATCH-NOTE.md\" <<'EOF'\ncascade-status: onboarded-operator-bump\n- **Target:** jrnb2024/pim\nEOF\n  cat >\"$repo_dir/STATUS.md\" <<'EOF'\n- **TF-024X-renovate-jrnb2024-pim** (open): Renovate disabled on PIM; operator-bumped @abc123 at 024C; track until adopter enables Renovate cohort.\nEOF\n  commit_case \"$repo_dir\" \"case 4a-negative\"\n  run_case \"$repo_dir\" 1 '' 'ERROR: branch-protection-log.md was not modified for cascade-status=onboarded-operator-bump'\n\n  repo_dir=\"$TMPDIR/case4a-target-mismatch\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"STATUS_MD|BRANCH_PROTECTION_LOG|DISPATCH_NOTE|cascade-status|TF-024X-renovate|TF-024X-conflict|re\\\\.search|re\\\\.findall|not applicable|onboarded-operator-bump|blocked-on-adopter-conflict\\\" scripts/check-invocation-log-entry.sh tests/check_invocation_log/test_check_invocation_log_entry.sh docs/reviews/WP-SCP-024/024B-core/r1-correctness.json docs/reviews/WP-SCP-024/024B-core/r1-safety_bypass.json docs/reviews/WP-SCP-024/024B-core/r1-completeness_governance.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"STATUS_MD|BRANCH_PROTECTION_LOG|DISPATCH_NOTE|cascade-status|TF-024X-renovate|TF-024X-conflict|re\\\\.search|re\\\\.findall|not applicable|onboarded-operator-bump|blocked-on-adopter-conflict\\\" scripts/check-invocation-log-entry.sh tests/check_invocation_log/test_check_invocation_log_entry.sh docs/reviews/WP-SCP-024/024B-core/r1-correctness.json docs/reviews/WP-SCP-024/024B-core/r1-safety_bypass.json docs/reviews/WP-SCP-024/024B-core/r1-completeness_governance.json\"","aggregated_output":"docs/reviews/WP-SCP-024/024B-core/r1-correctness.json:1:{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"api_error_status\":null,\"duration_ms\":1262024,\"duration_api_ms\":1263142,\"num_turns\":14,\"result\":\"I now have all the information needed. Producing the structured review output.\\n\\n```json\\n{\\n  \\\"reviewer_lens\\\": \\\"correctness\\\",\\n  \\\"verdict\\\": \\\"CHANGES_REQUESTED\\\",\\n  \\\"review_summary\\\": \\\"024B-core is structurally sound. scaffold-downstream.sh correctly validates all arguments (regex, enum, 40-hex, writability), guards the bootstrap-only gate, canonicalises paths via realpath with a system-path denylist, emits 4 files with SHA256 MANIFEST, and applies TF-023E-002 warnings on post-v1.2.0 pins. The adopter-wrapper template mirrors the canonical SCP self-wrapper: Renovate marker immediately before uses:, least-privilege permissions (contents:read + statuses:write only), fork-PR refusal if: clause, and correct substitution tokens. check-invocation-log-entry.sh correctly implements all five cascade-status check-paths with exactly-one-match assertions on cascade-status and **Target:** extraction, slug-anchored patterns for TF references, and a correctly-gated not-applicable carve-out. Test coverage is broad: happy path, all error exits with correct codes, CRLF handling, subdirectory invocation, PR-mode via fake_gh, system-path denylist including Darwin /private/var, the SAFE-003 phantom-2-entry test, and all 6 worked-example matrix cases. D-044 row (2026-05-09, ACCEPTED, core-scoped, cites SCOPE-CORRECTION), STATUS.md chain entry (2026-05-09 PM), and plan-doc §6 split-amendment (024C gated on both halves + FUP-ACC-INSTALL-TARGET-REPO-001) are all present and correctly scoped. Two MAJ findings: STATUS_MD and BRANCH_PROTECTION_LOG existence checks fire before cascade-status is parsed, creating a spurious dependency for not-applicable tooling slices; and TF reference matching uses re.search() rather than the exactly-one assertion required by the review spec. Two MIN findings: sed delimiter fragility and v1.2.0 exact SHA silently excluded from the TF-023E-002 warning. One nit. No CRIT found.\\\",\\n  \\\"findings\\\": [\\n    {\\n      \\\"id\\\": \\\"MAJ-CORR-001\\\",\\n      \\\"severity\\\": \\\"MAJ\\\",\\n      \\\"claim\\\": \\\"check-invocation-log-entry.sh unconditionally checks STATUS_MD and BRANCH_PROTECTION_LOG existence (lines 164-166) before cascade-status is parsed (lines 168-184). For cascade-status: not applicable the script exits at line 229 without ever reading either file, making both pre-checks spurious for tooling slices.\\\",\\n      \\\"evidence\\\": \\\"Lines 164-166: `[ -f \\\\\\\"$STATUS_MD\\\\\\\" ] || die ...` and `[ -f \\\\\\\"$BRANCH_PROTECTION_LOG\\\\\\\" ] || die ...` run unconditionally. not-applicable exit is at line 229, after these guards but before any STATUS_MD/log I/O. All tests pass only because init_case_repo pre-creates both files in every case repo.\\\",\\n      \\\"impact\\\": \\\"A tooling-slice CI invocation in a fresh repo or isolated test environment lacking branch-protection-log.md fails with ERROR: branch-protection log not found even though that path never executes. This breaks the not-applicable carve-out's promise of zero-dependency for tooling slices and could block a future test that doesn't pre-create the log.\\\",\\n      \\\"mitigation\\\": \\\"Move STATUS_MD and BRANCH_PROTECTION_LOG existence checks inside the onboarded / onboarded-operator-bump / blocked-on-adopter-conflict case branches where they are actually consumed. The DISPATCH_NOTE existence check can stay unconditional since it is read for all paths.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"MAJ-CORR-002\\\",\\n      \\\"severity\\\": \\\"MAJ\\\",\\n      \\\"claim\\\": \\\"TF reference matching for onboarded-operator-bump (lines 344-354) and blocked-on-adopter-conflict (lines 359-369) uses re.search(), which returns the first match and ignores duplicates. The review spec states 'Exactly-one-match assertion (closes multi-occurrence injection).' No test exercises the duplicate-TF-row scenario.\\\",\\n      \\\"evidence\\\": \\\"Line 351: `if not re.search(pattern, text): sys.exit(1)` — no count check. Line 366: same pattern. Contrast: cascade-status uses findall + `len(matches) != 1` guard (lines 175-180); **Target:** extraction uses findall + exact-count (lines 261-268). Test suite has no case with two matching TF-024X-renovate-{slug} rows in STATUS.md.\\\",\\n      \\\"impact\\\": \\\"A STATUS.md that accumulates two TF-024X-renovate-{slug} rows for the same adopter (e.g. a correction attempt that left the old row) silently passes the onboarded-operator-bump check even if one row is malformed. The multi-occurrence injection bypass the spec describes is unclosed and untested.\\\",\\n      \\\"mitigation\\\": \\\"Replace re.search() with re.findall() and assert len(matches) == 1 for both TF reference checks, mirroring the cascade-status extraction pattern. Add a test case where STATUS.md has two identical-slug TF-024X-renovate rows and expect exit 1.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"MIN-CORR-001\\\",\\n      \\\"severity\\\": \\\"MIN\\\",\\n      \\\"claim\\\": \\\"scaffold-downstream.sh sed substitution (lines 177-181) uses / as delimiter with bare shell variable expansion. Current validation restricts values to safe sets, but any future relaxation of --default-branch to include slash-bearing names (e.g. release/1.0) would break the sed expression silently rather than raising an error.\\\",\\n      \\\"evidence\\\": \\\"Line 178: `sed -e \\\\\\\"s/{{DEFAULT_BRANCH}}/${DEFAULT_BRANCH}/g\\\\\\\"`. DEFAULT_BRANCH validated to {main,master,develop} — no / today. The unreplaced-marker check at line 183 catches unsubstituted tokens but not a corrupted substitution caused by a / in the value hitting the sed delimiter.\\\",\\n      \\\"impact\\\": \\\"If --default-branch validation is extended to allow slash-containing names, the generated wrapper would contain a malformed uses: line instead of a controlled die. The operator would receive a syntactically broken YAML file with no diagnostic.\\\",\\n      \\\"mitigation\\\": \\\"Use a non-slash sed delimiter (e.g. `|`) for all three substitution expressions, or replace the sed block with a single Python str.replace() call that is delimiter-immune.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"MIN-CORR-002\\\",\\n      \\\"severity\\\": \\\"MIN\\\",\\n      \\\"claim\\\": \\\"scaffold-downstream.sh TF-023E-002 warning (lines 154-159) uses a strict-after condition: `SHA != v1.2.0 AND merge-base --is-ancestor v1.2.0 SHA`. STATUS.md confirms v1.2.0 was cut at 023B which introduced the attest-scorecard job — the same job that causes startup_failure. The exact v1.2.0 SHA receives no warning.\\\",\\n      \\\"evidence\\\": \\\"Line 155: `elif [ \\\\\\\"$SCP_SHA\\\\\\\" != \\\\\\\"$(git rev-parse v1.2.0)\\\\\\\" ] && git merge-base --is-ancestor v1.2.0 \\\\\\\"$SCP_SHA\\\\\\\"; then warn`. STATUS.md 023B row: 'New separate attest-scorecard job with job-scoped OIDC permissions... v1.1.0 → v1.2.0'. Test line 205 explicitly asserts `! grep -Fq 'post-v1.2.0' stderr` for exact v1.2.0 SHA.\\\",\\n      \\\"impact\\\": \\\"An operator pinning --scp-sha to the exact v1.2.0 SHA receives no warning, generates a wrapper that will fail with GitHub Actions startup_failure in adopter CI — the same defect the warning is designed to prevent. The test validates the silent-pass, cementing the incorrect boundary.\\\",\\n      \\\"mitigation\\\": \\\"Remove the `SHA != v1.2.0_SHA` exclusion so the condition is `merge-base --is-ancestor v1.2.0 SHA` (inclusive of v1.2.0 itself). Update the warning message to 'v1.2.0 or later'. Update the test at line 205 to expect the warning for exact v1.2.0 SHA.\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"nit-CORR-001\\\",\\n      \\\"severity\\\": \\\"nit\\\",\\n      \\\"claim\\\": \\\"test_check_invocation_log_entry.sh run_pr_case helper (lines 94-145) uses a fixed SCRIPT invocation with no variadic argument forwarding, unlike run_case which accepts extra args via shift 5 + '$@' (line 51-55).\\\",\\n      \\\"evidence\\\": \\\"run_pr_case line 107: `\\\\\\\"$SCRIPT\\\\\\\" --pr 99 --dispatch-note DISPATCH-NOTE.md --status-md STATUS.md --branch-protection-log \\\\\\\"$branch_protection_log\\\\\\\"` — no trailing $@. run_case line 55: `\\\\\\\"$SCRIPT\\\\\\\" --diff-base base ... \\\\\\\"$@\\\\\\\"` — variadic.\\\",\\n      \\\"impact\\\": \\\"Future PR-mode tests that need --allow-not-applicable or --tooling-slice-id (e.g. if 024B-extras adds a tooling-slice PR-mode test) must manually duplicate run_pr_case or modify the helper. Latent maintenance hazard; no current test is blocked.\\\",\\n      \\\"mitigation\\\": \\\"Apply the same shift-and-forward pattern as run_case: add `shift 6` after consuming positional args in run_pr_case and append `\\\\\\\"$@\\\\\\\"` to the SCRIPT invocation line.\\\"\\n    }\\n  ]\\n}\\n```\",\"stop_reason\":\"end_turn\",\"session_id\":\"695650ea-9b51-4606-a7da-62784d5a46cd\",\"total_cost_usd\":1.69613875,\"usage\":{\"input_tokens\":8,\"cache_creation_input_tokens\":160235,\"cache_read_input_tokens\":289305,\"output_tokens\":67061,\"server_tool_use\":{\"web_search_requests\":0,\"web_fetch_requests\":0},\"service_tier\":\"standard\",\"cache_creation\":{\"eph
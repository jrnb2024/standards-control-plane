CABLE\" -eq 1 ] && [ \"$cascade_status\" != \"not applicable\" ]; then\nscripts/check-invocation-log-entry.sh:237:  die \"ERROR: --allow-not-applicable was passed but cascade-status is '$cascade_status' — flag is for tooling slices declaring cascade-status: not applicable ONLY. Cohort cascade slices (024C/D/E/F) MUST NOT pass this flag.\" 2\nscripts/check-invocation-log-entry.sh:255:  python3 - \"$DISPATCH_NOTE\" <<'PY'\nscripts/check-invocation-log-entry.sh:261:matches = re.findall(r'^[ \\t]*-[ \\t]+\\*\\*Target:\\*\\*[ \\t]+([a-zA-Z0-9._/-]+)[ \\t]*$', text, re.M)\nscripts/check-invocation-log-entry.sh:280:  if branch_log_patch=\"$(gh pr diff \"$PR\" --patch -- \"$BRANCH_PROTECTION_LOG_REPO_REL\" 2>/dev/null)\"; then\nscripts/check-invocation-log-entry.sh:289:  if ! branch_log_patch=\"$(git -C \"$REPO_ROOT\" diff --unified=0 \"${DIFF_BASE}..HEAD\" -- \"$BRANCH_PROTECTION_LOG_REPO_REL\")\"; then\nscripts/check-invocation-log-entry.sh:304:  # must not contain an em dash so re.search cannot backtrack to a later\nscripts/check-invocation-log-entry.sh:313:        match = re.search(r\"^###\\s+[^—]+—\\s+([A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)?)@([A-Za-z0-9._/-]+)\\s*$\", line[1:])\nscripts/check-invocation-log-entry.sh:318:    if header_lines and not matched and any(re.search(r\"\\s---\\s\", line) for line in header_lines):\nscripts/check-invocation-log-entry.sh:331:    [ \"$branch_log_modified\" -eq 1 ] || die \"ERROR: branch-protection-log.md was not modified for cascade-status=onboarded\"\nscripts/check-invocation-log-entry.sh:336:    printf 'OK: cascade-status=%s; 2 checks passed\\n' \"$cascade_status\"\nscripts/check-invocation-log-entry.sh:338:  onboarded-operator-bump)\nscripts/check-invocation-log-entry.sh:339:    [ \"$branch_log_modified\" -eq 1 ] || die \"ERROR: branch-protection-log.md was not modified for cascade-status=onboarded-operator-bump\"\nscripts/check-invocation-log-entry.sh:344:    python3 - \"$STATUS_MD\" \"$adopter_slug\" <<'PY' || die \"ERROR: STATUS.md missing required TF-024X-renovate row for the adopter target\"\nscripts/check-invocation-log-entry.sh:351:pattern = rf'TF-024X-renovate-{re.escape(slug)}(?:\\*\\*)? \\((open|pending|in-progress|closed)\\): \\S.{{19,}}'\nscripts/check-invocation-log-entry.sh:352:if not re.search(pattern, text):\nscripts/check-invocation-log-entry.sh:355:    printf 'OK: cascade-status=%s; 3 checks passed\\n' \"$cascade_status\"\nscripts/check-invocation-log-entry.sh:357:  blocked-on-adopter-conflict)\nscripts/check-invocation-log-entry.sh:358:    [ \"$branch_log_modified\" -eq 0 ] || die \"ERROR: branch-protection-log.md was modified for cascade-status=blocked-on-adopter-conflict\"\nscripts/check-invocation-log-entry.sh:359:    python3 - \"$DISPATCH_NOTE\" \"$adopter_slug\" <<'PY' || die \"ERROR: DISPATCH-NOTE missing required TF-024X-conflict reference for the adopter target\"\nscripts/check-invocation-log-entry.sh:366:pattern = rf'TF-024X-conflict-{re.escape(slug)}(?:\\*\\*)? \\((open|pending|in-progress|closed)\\): \\S.{{19,}}'\nscripts/check-invocation-log-entry.sh:367:if not re.search(pattern, text):\nscripts/check-invocation-log-entry.sh:370:    printf 'OK: cascade-status=%s; 2 checks passed\\n' \"$cascade_status\"\ndocs/reviews/WP-SCP-024/024B-core/r1-safety_bypass.json:1:{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"api_error_status\":null,\"duration_ms\":816198,\"duration_api_ms\":816682,\"num_turns\":18,\"result\":\"I have read all required files. Producing the structured safety-bypass review.\\n\\n```json\\n{\\\"reviewer_lens\\\":\\\"safety_bypass\\\",\\\"verdict\\\":\\\"CHANGES_REQUESTED\\\",\\\"review_summary\\\":\\\"024B-core safety surface is compact and focused: scaffolder + adopter-wrapper template + cascade-status CLI enforcement script + tests. No CRIT found. One MAJ: the not-applicable tooling-slice carve-out is CLI-level only; a cohort cascade operator can forge slice-type: tooling in their DISPATCH-NOTE and pass --allow-not-applicable to skip all cascade enforcement entirely. Documented as FUP-024B-CORE-NOT-APPLICABLE-WORKFLOW-001 with workflow-side closure deferred to 024B-extras. All other axes check out: fail-closed default fires on absent or unrecognised cascade-status (exit 2); bootstrap guard (exit 1) fires before SHA non-existence (exit 2); exactly-one assertions on cascade-status and **Target:** confirmed via findall+count in both parsers; phantom-2-entry tests (cases 4i, 17) confirm parse_entry_repo fires on multi-target patches; the 4 worked-example ❌ cases (bare-prefix, empty, all-whitespace, short) all correctly fail via the \\\\S.{19,} regex; path normalisation via realpath occurs before the system-path denylist check; /private/var/* macOS canonicalisation is in the denylist and covered by the Darwin test; fork-PR refusal if: clause is preserved; workflow-level permissions are capped at contents:read + statuses:write with no id-token or attestations; test cleanup is via EXIT trap with no real network calls and no elevated privileges; D-044 trust model accurately scopes exactly-one to cascade-status + Target extraction only; slug canonicalisation correctly converts dots, underscores, and slashes to hyphens. Two MINs (DISPATCH-NOTE phrasing ambiguity on exactly-one; --pr unvalidated as integer) and one nit.\\\",\\\"findings\\\":[{\\\"id\\\":\\\"SAFE-MAJ-001\\\",\\\"severity\\\":\\\"MAJ\\\",\\\"claim\\\":\\\"The not-applicable tooling-slice carve-out is fully bypassable by a cohort cascade operator. Passing --allow-not-applicable --tooling-slice-id <any-valid-id> combined with a DISPATCH-NOTE that declares cascade-status: not applicable and slice-type: tooling bypasses all four enforcement check-paths and exits 0 with no log entry, no STATUS.md row, and no target verification. The CLI guard at line 221 enforces slice_type == 'tooling' from DISPATCH-NOTE content, but DISPATCH-NOTE is operator-authored; a cohort slice can forge the tooling declaration.\\\",\\\"evidence\\\":\\\"check-invocation-log-entry.sh lines 221-229: if [ \\\\\\\"$slice_type\\\\\\\" != \\\\\\\"tooling\\\\\\\" ]; then die. slice_type extracted from DISPATCH-NOTE via Python re at lines 186-203. Code comment lines 218-223 explicitly says: 'The CLI can only refuse obvious misuse; it cannot prove the operator did not forge a tooling-slice shape.' FUP-024B-CORE-NOT-APPLICABLE-WORKFLOW-001 is tracked. D-044 rationale paragraph: 'The CLI guard is necessary-but-not-sufficient; workflow-side hardcoding... is the canonical closure path.'\\\",\\\"impact\\\":\\\"A cohort cascade slice (024C/D/E/F) can exit 0 with zero cascade enforcement: no branch-protection-log entry, no STATUS.md TF row, no target match verification. The cascade audit trail that D-035 requires would be absent for that adopter with no CI failure.\\\",\\\"mitigation\\\":\\\"024B-extras must hardcode --tooling-slice-id per workflow file and omit --allow-not-applicable from cohort workflow invocations (FUP-024B-CORE-NOT-APPLICABLE-WORKFLOW-001). CORE-level partial hardening: cross-check that a DISPATCH-NOTE declaring slice-type: tooling has no **Target:** line (tooling slices don't onboard an adopter); exit 2 if a Target: is present alongside slice-type: tooling to catch accidental or deliberate misuse at the CLI layer.\\\"},{\\\"id\\\":\\\"SAFE-MIN-001\\\",\\\"severity\\\":\\\"MIN\\\",\\\"claim\\\":\\\"DISPATCH-NOTE §'Cascade-status CI enforcement script (CLI)' states 'Exactly-one-match assertion (closes multi-occurrence injection bypass)' as a general feature of the script, immediately after 'Regex via python3 -c with re.search()'. A hostile reader can cite this as authority that TF reference matching also uses exactly-one enforcement. In fact, TF reference matching for both onboarded-operator-bump (STATUS.md) and blocked-on-adopter-conflict (DISPATCH-NOTE) uses re.search() with no count assertion. D-044 is accurate (limits exactly-one claim to cascade-status and **Target:** parsing) but DISPATCH-NOTE is ambiguous.\\\",\\\"evidence\\\":\\\"DISPATCH-NOTE lines: 'Regex via python3 -c with re.search() (PCRE-style; plan-doc §2 invariant 2 byte-for-byte). Exactly-one-match assertion (closes multi-occurrence injection bypass).' TF reference check at check-invocation-log-entry.sh lines 344-354 and 359-369: re.search() only, no findall+count. Contrast: cascade-status (lines 175-180) and **Target:** (lines 261-268) both use re.findall + len==1 assertion. D-044 accurately states 'exactly-one-match assertions on both cascade-status and **Target:** extraction' — does not extend to TF references.\\\",\\\"impact\\\":\\\"If DISPATCH-NOTE is later cited as authority that TF multi-occurrence injection is closed across all check axes, a PR adding two TF-024X-renovate-{slug} rows (one malformed-but-matching, one legitimate) would silently pass the STATUS.md check. The trust model citation would be false.\\\",\\\"mitigation\\\":\\\"Clarify DISPATCH-NOTE: 'Exactly-one-match assertion on cascade-status and **Target:** extraction (closes multi-occurrence injection bypass for those fields). TF reference matching is a presence check (re.search; at least one valid row required) per plan-doc file-agnostic design.' Optionally align TF matching with findall+count per correctness lens MAJ-CORR-002 recommendation.\\\"},{\\\"id\\\":\\\"SAFE-MIN-002\\\",\\\"severity\\\":\\\"MIN\\\",\\\"claim\\\":\\\"The --pr argument is stored verbatim at check-invocation-log-entry.sh line 54 with no positive-integer validation. Unusual values (0, -1, '99 --inject', string PR specifiers) are passed as raw strings to gh pr view and gh pr diff. Shell injection is prevented by double-quoting ('$PR'), so gh receives the value as a single C-string argument and rejects it, but the rejection produces a gh-layer error message rather than a controlled CLI diagnostic.\\\",\\\"evidence\\\":\\\"Lines 53-57: PR=\\\\\\\"$2\\\\\\\"; shift 2 — no regex or integer check. Line 277: gh pr view \\\\\\\"$PR\\\\\\\" --json body --jq '.body' >/dev/null 2>&1. The failure branch at line 279 correctly exits 2 with 'ERROR: gh pr view failed for PR $PR; check gh auth and PR existence' — which would also fire for an invalid PR number.\\\",\\\"impact\\\":\\\"No functional bypass; gh handles the rejection. Operator receives a confusing error that says 'check gh auth and PR existence' when the real problem is an invalid PR number. Potential confusion during break-glass or debugging scenarios.\\\",\\\"mitigation\\\":\\\"Add [[ \\\\\\\"$PR\\\\\\\" =~ ^[1-9][0-9]*$ ]] || die 'ERROR: --pr must be a positive integer' 2 immediately after PR=\\\\\\\"$2\\\\\\\" at line 54.\\\"},{\\\"id\\\":\\\"SAFE-nit-001\\\",\\\"severity\\\":\\\"nit\\\",\\\"claim\\\":\\\"normalize_path() at check-invocation-log-entry.sh lines 112-113 invokes Python os.path.normpath on DISPATCH_NOTE, STATUS_MD, and BRANCH_PROTECTION_LOG (lines 125-127). The results are then fed into os.path.realpath calls at lines 134-136. os.path.realpath subsumes normpath (it resolves symlinks AND normalises components), making the intermediate normpath subshell redundant — three extra Python process launches per invocation.\\\",\\\"evidence\\\":\\\"Lines 112-113: normalize_path() { python3 -c 'import os, sys; print(os.path.normpath(sys.argv[1]))' \\\\\\\"$1\\\\\\\"; }. Lines 125-127: DISPATCH_NOTE=\\\\\\\"$(normalize_path \\\\\\\"$DISPATCH_NOTE\\\\\\\")\\\\\\\"; STATUS_MD=\\\\\\\"$(normalize_path \\\\\\\"$STATUS_MD\\\\\\\")\\\\\\\"; BRANCH_PROTECTION_LOG=\\\\\\\"$(normalize_path \\\\\\\"$BRANCH_PROTECTION_LOG\\\\\\\")\\\\\\\". Lines 134-136: DISPATCH_NOTE_REAL=\\\\\\\"$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' \\\\\\\"$DISPATCH_NOTE\\\\\\\")\\\\\\\"; etc. The containment checks at lines 138-149 use the _REAL variables, not the normpath-only intermediates.\\\",\\\"impact\\\":\\\"No functional gap; no security implication. Three redundant Python subshell invocations per run (negligible latency in practice).\\\",\\\"mitigation\\\":\\\"Remove normalize_path() and the three calls at lines 125-127. Populate DISPATCH_NOTE, STATUS_MD, BRANCH_PROTECTION_LOG directly from realpath calls (or rename the _REAL variables to the base names after realpath resolution).\\\"}]}\\n```\",\"stop_reason\":\"end_turn\",\"session_id\":\"b8e4702a-5256-4501-b9ae-a8af5d279c28\",\"total_cost_usd\":1.246881,\"usage\":{\"input_tokens\":12,\"cache_creation_input_tokens\":114014,\"cache_read_input_tokens\":597165,\"output_tokens\":42546,\"server_tool_use\":{\"web_search_requests\":0,\"web_fetch_requests\":0},\"service_tier\":\"standard\",\"cache_creation\":{\"ephemeral_1h_input_tokens\":114014,\"ephemeral_5m_input_tokens\":0},\"inference_geo\":\"\",\"iterations\":[{\"input_tokens\":1,\"output_tokens\":4819,\"cache_read_input_tokens\":117504,\"cache_creation_input_tokens\":3891,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":3891},\"type\":\"message\"}],\"speed\":\"standard\"},\"modelUsage\":{\"claude-haiku-4-5-20251001\":{\"inputTokens\":1838,\"outputTokens\":23,\"cacheReadInputTokens\":0,\"cacheCreationInputTokens\":0,\"webSearchRequests\":0,\"costUSD\":0.001953,\"contextWindow\":200000,\"maxOutputTokens\":32000},\"claude-sonnet-4-6\":{\"inputTokens\":12,\"outputTokens\":42546,\"cacheReadInputTokens\":597165,\"cacheCreationInputTokens\":114014,\"webSearchRequests\":0,\"costUSD\":1.2449279999999998,\"contextWindow\":200000,\"maxOutputTokens\":32000}},\"permission_denials\":[],\"terminal_reason\":\"completed\",\"fast_mode_state\":\"off\",\"uuid\":\"0a38d936-8678-4f49-979f-8f3b701c7264\"}\ndocs/reviews/WP-SCP-024/024B-core/r1-completeness_governance.json:1:{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"api_error_status\":null,\"duration_ms\":295251,\"duration_api_ms\":295822,\"num_turns\":20,\"result\":\"I have all the data needed. Let me construct the review output.\\n\\n```json\\n{\\\"reviewer_lens\\\":\\\"completeness_governance\\\",\\\"slice\\\":\\\"WP-SCP-024/024B-core\\\",\\\"review_round\\\":\\\"R1\\\",\\\"verdict\\\":\\\"APPROVED\\\",\\\"summary\\\":\\\"024B-core delivers scaffolder, adopter-wrapper template, cascade-status CI enforcement CLI, and tests. All plan-doc §2 invariant 2 enforcement paths are present in check-invocation-log-entry.sh: fail-closed default (absent/unrecognised cascade-status → exit non-zero); onboarded (log-modified + target-match); onboarded-operator-bump (log-modified + target-match + STATUS.md TF-024X-renovate regex); blocked-on-adopter-conflict (TF-024X-conflict regex in DISPATCH-NOTE + log NOT modified). Exactly-one-match assertions on cascade-status and **Target:** close injection bypasses. The adopter-wrapper template carries the Renovate marker per plan-doc invariant 8 Threshold A criterion. The scaffolder emits 4 files with SHA256 manifest, validates args, enforces bootstrap-only, and warns correctly on post-v1.2.0 SHAs referencing TF-023E-002. The split governance (SCOPE-CORRECTION-2026-05-09.md) is properly documented: R6→R7→R8 trajectory table, empirical justification, anti-descope framing ('both halves still ship'), extras-parking branch reference. D-044 is correctly scoped to core deliverables and cites the correction document. STATUS.md has the split-decision audit row and outcome table (3 rows). Plan-doc §6 has the 024B split note gating 024C on BOTH halves plus FUP-ACC-INSTALL-TARGET-REPO-001. VERSIONING.md alignment is correct: all core deliverables (scripts/, templates/) are internal-only per §'Scope' → no version bump required. Extras carve-out is clean (no --restore content, no break-glass, no .github/workflows/check-invocation-log-entry.yml in tree). One MIN: STATUS.md carries two differently-named entries for the same workflow-mitigation TF in different sections, creating tracking ambiguity for 024B-extras closure. Two nits: template header names the slice '024B' not '024B-core'; DISPATCH-NOTE footer is stale post-13-fix-rounds.\\\",\\\"findings\\\":[{\\\"id\\\":\\\"CMP-MIN-001\\\",\\\"severity\\\":\\\"MIN\\\",\\\"claim\\\":\\\"STATUS.md has two differently-named TF entries describing the same workflow-mitigation mitigation: TF-024B-core-WORKFLOW-MITIGATION-001 under 'Tracked-forward items from 020C.1' (wrong section) and FUP-024B-CORE-NOT-APPLICABLE-WORKFLOW-001 under 'Tracked-forward items from WP-SCP-024 024B-core / 024B-extras'. The 020C.1 section is for WP-SCP-020 slice 020C.1 items; placing a 024B-core item there is incorrect.\\\",\\\"evidence\\\":\\\"STATUS.md line 175: TF-024B-core-WORKFLOW-MITIGATION-001 under '## Tracked-forward items from 020C.1'. STATUS.md line 300: FUP-024B-CORE-NOT-APPLICABLE-WORKFLOW-001 under '## Tracked-forward items from WP-SCP-024 024B-core / 024B-extras'. Both describe 024B-extras hardcoding --tooling-slice-id + omitting --allow-not-applicable from cohort workflows.\\\",\\\"impact\\\":\\\"024B-extras closure author cannot determine which name is canonical; risk of closing one entry while leaving the other open, creating a false-open TF. Cross-references in D-044 use FUP-024B-CORE-NOT-APPLICABLE-WORKFLOW-001, but STATUS.md also carries TF-024B-core-WORKFLOW-MITIGATION-001 in an unrelated section.\\\",\\\"mitigation\\\":\\\"Remove TF-024B-core-WORKFLOW-MITIGATION-001 from the 020C.1 section (it has no 020C.1 origin). Consolidate under the 024B-core TF section using FUP-024B-CORE-NOT-APPLICABLE-WORKFLOW-001 as the canonical name (that is the name used in D-044). One entry, one section, one name.\\\"},{\\\"id\\\":\\\"CMP-nit-001\\\",\\\"severity\\\":\\\"nit\\\",\\\"claim\\\":\\\"templates/adopter-wrapper.yml.tmpl line 1 header comment says 'per WP-SCP-024 024B (D-044)' — the slice name is stale after the scope split; it should say '024B-core'.\\\",\\\"evidence\\\":\\\"templates/adopter-wrapper.yml.tmpl:1 — '# Generated by scripts/scaffold-downstream.sh = SCP-073-scaffolder per WP-SCP-024 024B (D-044).' The scope split occurred 2026-05-09; this template is a 024B-core deliverable.\\\",\\\"impact\\\":\\\"Downstream readers diffing the template against a DECISIONS.md or DISPATCH-NOTE reference will see a mismatch between '024B' in the header and '024B-core' everywhere else. Low risk but adds noise during 024C cascade slice reviews that inspect the generated wrapper.\\\",\\\"mitigation\\\":\\\"Change '024B' to '024B-core' in the template header comment. One-character-class change; no substitution placeholder affected.\\\"},{\\\"id\\\":\\\"CMP-nit-002\\\",\\\"severity\\\":\\\"nit\\\",\\\"claim\\\":\\\"DISPATCH-NOTE.md footer still reads 'Status: DRAFT v0.1 — awaiting Codex T3 surgical-clean dispatch.' after 13 fix-rounds, misrepresenting the document's current state.\\\",\\\"evidence\\\":\\\"docs/reviews/WP-SCP-024/024B-core/DISPATCH-NOTE.md final line: '**Status:** DRAFT v0.1 — awaiting Codex T3 surgical-clean dispatch.' Git log shows fix-round-13 as the most recent commit (1e7c498).\\\",\\\"impact\\\":\\\"Audit readers using the DISPATCH-NOTE to gauge slice maturity see 'DRAFT' and 'awaiting Codex dispatch' long after both phases completed. Cosmetic but undermines the DISPATCH-NOTE as a reliable state document.\\\",\\\"mitigation\\\":\\\"Update the Status footer to reflect R-fixpoint state, e.g., 'Status: IN REVIEW — R1 round in progress; fix-round-13 complete.'\\\"}]}\\n```\",\"stop_reason\":\"end_turn\",\"session_id\":\"2447baca-1114-428a-840d-ca052d082447\",\"total_cost_usd\":0.9323179500000001,\"usage\":{\"input_tokens\":5613,\"cache_creation_input_tokens\":124923,\"cache_read_input_tokens\":742229,\"output_tokens\":14855,\"server_tool_use\":{\"web_search_requests\":0,\"web_fetch_requests\":0},\"service_tier\":\"standard\",\"cache_creation\":{\"ephemeral_1h_input_tokens\":124923,\"ephemeral_5m_input_tokens\":0},\"inference_geo\":\"\",\"iterations\":[{\"input_tokens\":1,\"output_tokens\":3555,\"cache_read_input_tokens\":131666,\"cache_creation_input_tokens\":638,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":638},\"type\":\"message\"}],\"speed\":\"standard\"},\"modelUsage\":{\"claude-haiku-4-5-20251001\":{\"inputTokens\":1434,\"outputTokens\":18,\"cacheReadInputTokens\":0,\"cacheCreationInputTokens\":0,\"webSearchRequests\":0,\"costUSD\":0.001524,\"contextWindow\":200000,\"maxOutputTokens\":32000},\"claude-sonnet-4-6\":{\"inputTokens\":5613,\"outputTokens\":14855,\"cacheReadInputTokens\":742229,\"cacheCreationInputTokens\":124923,\"webSearchRequests\":0,\"costUSD\":0.9307939500000001,\"contextWindow\":200000,\"maxOutputTokens\":32000}},\"permission_denials\":[],\"terminal_reason\":\"completed\",\"fast_mode_state\":\"off\",\"uuid\":\"003c8fb7-d5e9-447d-aea4-c5e913ca9fbe\"}\n","exit_code":0,"status":"completed"}}

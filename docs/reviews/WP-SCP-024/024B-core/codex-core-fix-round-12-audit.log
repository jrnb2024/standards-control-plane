{"type":"item.completed","item":{"id":"item_88","type":"command_execution","command":"/bin/zsh -lc \"nl -ba scripts/check-invocation-log-entry.sh | sed -n '100,120p;205,220p;300,325p'\"","aggregated_output":"   100\t  die \"ERROR: one of --pr or --diff-base is required\" 2\n   101\tfi\n   102\tif [ -z \"$DISPATCH_NOTE\" ]; then\n   103\t  die \"ERROR: --dispatch-note is required\" 2\n   104\tfi\n   105\t\n   106\t# Exit-code taxonomy:\n   107\t# 1 = malformed or ambiguous required log content while parsing a note or log\n   108\t#     entry shape.\n   109\t# 2 = operator input rejected on policy grounds or bad CLI usage.\n   110\t\n   111\tnormalize_path() {\n   112\t  python3 -c 'import os, sys; print(os.path.normpath(sys.argv[1]))' \"$1\"\n   113\t}\n   114\t\n   115\tcanonicalize_adopter_slug() {\n   116\t  # Canonical slugs are a normalization aid, not a collision-resistant ID.\n   117\t  # Cohort adopter repo names must remain unique after canonicalization.\n   118\t  printf '%s' \"$1\" | python3 -c 'import re, sys\n   119\ts = sys.stdin.read().strip().lower()\n   120\ts = re.sub(r\"[^a-z0-9-]+\", \"-\", s.replace(\"/\", \"-\"))\n   205\t  onboarded|onboarded-operator-bump|blocked-on-adopter-conflict)\n   206\t    ;;\n   207\t  \"not applicable\")\n   208\t    # \"not applicable\" is reserved for tooling slices ONLY; cohort\n   209\t    # cascade slices must use one of the three enforcement values.\n   210\t    if [ \"$ALLOW_NOT_APPLICABLE\" -ne 1 ]; then\n   211\t      die \"ERROR: cascade-status: not applicable found, but --allow-not-applicable was not passed. This carve-out is for tooling slices ONLY (024A, 024B-core, 024B-extras, 024G); cohort cascade slices 024C/D/E/F MUST NOT use it. If this is a tooling slice, pass --allow-not-applicable explicitly.\" 2\n   212\t    fi\n   213\t    # NOTE: All fields validated here (cascade-status, slice-type,\n   214\t    # --tooling-slice-id) are operator-supplied. The CLI can only refuse\n   215\t    # obvious misuse; it cannot prove the operator did not forge a\n   216\t    # tooling-slice shape. The canonical defense is workflow-side:\n   217\t    # 024B-extras will hardcode the workflow invocation so cohort\n   218\t    # workflows omit --allow-not-applicable and tooling workflows supply\n   219\t    # a fixed --tooling-slice-id. Residual workflow-side bypass surface\n   220\t    # is tracked as FUP-024B-CORE-NOT-APPLICABLE-WORKFLOW-001.\n   300\t  # Expected branch-protection-log line format:\n   301\t  # ### <timestamp> — <owner/repo>@<branch>\n   302\t  # The separator is U+2014 (em dash); keep this in sync with the\n   303\t  # branch-protection log emitter in 024B-extras. The timestamp prefix\n   304\t  # must not contain an em dash so re.search cannot backtrack to a later\n   305\t  # repo segment on malformed multi-segment headers.\n   306\t  python3 -c 'import re, sys\n   307\tpatch = sys.stdin.read().splitlines()\n   308\tmatched = []\n   309\theader_lines = []\n   310\tfor line in patch:\n   311\t    if line.startswith(\"+### \"):\n   312\t        header_lines.append(line[1:])\n   313\t        match = re.search(r\"^###\\s+[^—]+—\\s+([A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)?)@([A-Za-z0-9._/-]+)\\s*$\", line[1:])\n   314\t        if match:\n   315\t            matched.append(match.group(1))\n   316\tif len(matched) != 1:\n   317\t    values = \", \".join(matched) if matched else \"[]\"\n   318\t    if header_lines and not matched and any(re.search(r\"\\s---\\s\", line) for line in header_lines):\n   319\t        print(\"ERROR: found log entry header but em-dash separator is missing; expected exactly one log entry target match, found 0: []\", file=sys.stderr)\n   320\t    else:\n   321\t        print(\"ERROR: expected exactly one log entry target match, found {}: {}\".format(len(matched), values), file=sys.stderr)\n   322\t    sys.exit(1)\n   323\tprint(matched[0])\n   324\t' \n   325\t}\n","exit_code":0,"status":"completed"}}

e]\nscripts/enable-required-check.sh:509:print(json.dumps(transform(data)))\nscripts/enable-required-check.sh:558:prior_restore_evidence_present() {\nscripts/enable-required-check.sh:590:validate_expected_wrapper_sha_against_tags() {\nscripts/enable-required-check.sh:656:check_forward_mode_safety() {\nscripts/enable-required-check.sh:660:    if prior_restore_evidence_present \"docs/reviews/WP-SCP-020/branch-protection-log.md\" \"${REPO}@${BRANCH}\"; then\nscripts/enable-required-check.sh:678:      log \"CAUTION: --i-understand-this-repo-has-no-prior-green-ci rejected for ${REPO}@${BRANCH}; successful workflow runs exist\"\nscripts/enable-required-check.sh:706:  # prior_restore_evidence_present gates ACK_NO_GATE2_VERIFICATION here.\nscripts/enable-required-check.sh:707:  if prior_restore_evidence_present \"docs/reviews/WP-SCP-020/branch-protection-log.md\" \"${REPO}@${BRANCH}\"; then\nscripts/enable-required-check.sh:708:    if [ \"$ACK_NO_GATE2_VERIFICATION\" -eq 1 ]; then\nscripts/enable-required-check.sh:710:++ CAUTION: Gate 2 wrapper-SHA verification bypassed via --i-understand-no-gate-2-verification.\nscripts/enable-required-check.sh:714:      GATE2_CAUTION_LINE=\"- **CAUTION:** Gate 3 invoked with --i-understand-no-gate-2-verification — wrapper SHA NOT verified against release-tag SHA. Operator @${OPERATOR} acknowledges break-glass risk.\"\nscripts/enable-required-check.sh:716:    if [ -z \"$EXPECTED_WRAPPER_SHA\" ] && [ \"$ACK_NO_GATE2_VERIFICATION\" -ne 1 ]; then\nscripts/enable-required-check.sh:718:      echo \"       pass --i-understand-no-gate-2-verification to bypass Gate 2 verification (audited via CAUTION log entry)\" >&2\nscripts/enable-required-check.sh:724:    if ! prior_restore_evidence_present \"docs/reviews/WP-SCP-020/branch-protection-log.md\" \"${REPO}@${BRANCH}\"; then\nscripts/enable-required-check.sh:729:    validate_expected_wrapper_sha_against_tags \"$EXPECTED_WRAPPER_SHA\"\nscripts/enable-required-check.sh:754:      log \"CAUTION: wrapper
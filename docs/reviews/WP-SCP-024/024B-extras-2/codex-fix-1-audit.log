r\" \"org/repo-foo\" \"main\" 0 'safety check bypassed via --i-understand-this-repo-has-no-prior-green-ci' '' \"$repo_dir/scripts/enable-required-check.sh\" --i-understand-this-repo-has-no-prior-green-ci\n\n  repo_dir=\"$TMPDIR/enable-expected-sha-arbitrary\"\n  init_case_repo \"$repo_dir\"\n  fake_gh_dir=\"$TMPDIR/fake-gh-enable-expected-sha-arbitrary\"\n  make_restore_fake_gh \"$fake_gh_dir\"\n  cat >\"$fake_gh_dir/repo.json\" <<'EOF'\n{\"default_branch\":\"main\"}\n","exit_code":0,"status":"completed"}}

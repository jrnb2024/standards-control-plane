equired_status_checks.contexts must contain only strings (got {type(item).__name__}: {item!r})\", file=sys.stderr)\n441:        print(f\"error: required_status_checks.strict must be a boolean, got {type(strict).__name__}: {strict!r}\", file=sys.stderr)\n444:enforce_admins = data.get(\"enforce_admins\")\n445:if \"enabled\" not in enforce_admins:\n446:    print(\"error: restore pre-state JSON: enforce_admins.enabled is absent; required key\", file=sys.stderr)\n448:enabled = enforce_admins.get(\"enabled\")\n454:    print(\"error: enforce_admins.enabled must be a boolean\", file=sys.stderr)\n492:            if key == \"enforce_admins\" and isinstance(value, dict):\n497:            elif key == \"required_status_checks\" and value is None:\n499:            elif key == \"required_status_checks\" and isinstance(value, dict):\n506:            elif key == \"required_pull_request_reviews\" and isinstance(value, dict):\n683:  if [ \"$NO_PRIOR_GREEN_CI\" -eq 1 ]; then\n784:      if [ \"$ACK_WRAPPER_INACCESSIBLE\" -ne 1 ]; then\n790:      WRAPPER_INACCESSIBLE_CAUTION_LINE=\"- **CAUTION:** Gate 3 wrapper content was inaccessible from the current context; operator acknowledged via --i-understand-wrapper-inaccessible before proceeding.\"\n797:    if [ \"$ACK_WRAPPER_INACCESSIBLE\" -eq 1 ] && [ -n \"$wrapper_content\" ]; then\n810:log \"enforce_admins: $ENFORCE_ADMINS\"\n825:# Per 020G R1 safety SAF-002: required_pull_request_reviews must\n837:       required_status_checks: {\n841:       enforce_admins: $admins,\n842:       required_pull_request_reviews: $reviews,\n844:       required_linear_history: false,\n845:       allow_force_pushes: false,\n847:       block_creations: false,\n848:       required_conversation_resolution: false,\n849:       lock_branch: false,\n850:       allow_fork_syncing: false\n870:# Extract existing required_pull_request_reviews, default to null\n872:EXISTING_REVIEWS=\"$(printf '%s' \"$BEFORE_JSON\" | jq '.required_pull_request_reviews // null')\"\n888:  ech
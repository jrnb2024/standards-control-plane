\t  python3 - \"$file\" <<'PY'\n   383\timport json\n   384\timport sys\n   385\t\n   386\tpath = sys.argv[1]\n   387\ttry:\n   388\t    with open(path) as fh:\n   389\t        data = json.load(fh)\n   390\texcept Exception:\n   391\t    with open(path) as fh:\n   392\t        sys.stdout.write(fh.read())\n   393\telse:\n   394\t    print(json.dumps(data, indent=2, sort_keys=False))\n   395\tPY\n   396\t}\n   397\t\n   398\tjson_string_to_pretty_stdout() {\n   399\t  python3 - <<'PY'\n   400\timport json\n   401\timport sys\n   402\t\n   403\tpayload = sys.stdin.read()\n   404\ttry:\n   405\t    data = json.loads(payload)\n   406\texcept Exception:\n   407\t    sys.stdout.write(payload)\n   408\telse:\n   409\t    print(json.dumps(data, indent=2, sort_keys=False))\n   410\tPY\n   411\t}\n   412\t\n   413\tprior_restore_evidence_present() {\n   414\t  local log_path=\"$1\"\n   415\t  local target=\"$2\"\n   416\t  local committed_blob=\"\" working_tree_diff=\"\" committed_history_diff=\"\"\n   417\t  if [ -f \"$log_path\" ]; then\n   418\t    committed_blob=\"$(cat \"$log_path\")\"\n   419\t  fi\n   420\t  working_tree_diff=\"$(git diff HEAD -- \"$log_path\" 2>/dev/null || true)\"\n   421\t  committed_history_diff=\"$(git log -p -- \"$log_path\" 2>/dev/null || true)\"\n   422\t  printf '%s\\n%s\\n%s' \"$committed_blob\" \"$working_tree_diff\" \"$committed_history_diff\" | awk -v target=\"$target\" '\n   423\t    BEGIN { found = 0; in_block = 0 }\n   424\t    {\n   425\t      line = $0\n   426\t      sub(/^[+-]/, \"\", line)\n   427\t      if (line ~ /^### /) {\n   428\t        pat = \"(^|[^A-Za-z0-9._/-])\" target \"([^A-Za-z0-9._/-]|$)\"\n   429\t        in_block = (match(line, pat) > 0)\n   430\t      }\n","exit_code":0,"status":"completed"}}

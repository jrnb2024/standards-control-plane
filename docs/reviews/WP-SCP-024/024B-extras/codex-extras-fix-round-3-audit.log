       Required confirmation when combined with\n   148\t                           --no-enforce-admins. Without this flag, the\n   149\t                           script ignores --no-enforce-admins.\n   150\t  --restore PRE-STATE.json\n   151\t                           Restore branch protection from a captured\n   152\t                           pre-state JSON file.\n   153\t  --expected-wrapper-sha SHA\n   154\t                           Assert the caller pins the wrapper to a\n   155\t                           known release-tag SHA.\n   156\t  --i-understand-this-repo-has-no-prior-green-ci\n   157\t                           Bypass the forward-mode prior-green-CI safety\n   158\t                           check for cold-start adopters.\n   159\t  --i-understand-restore-removes-admin-enforcement\n   160\t                           Confirm a restore target that removes admin\n   161\t                           enforcement.\n   162\t  --i-understand-restore-removes-required-checks\n   163\t                           Confirm a restore target that removes required\n   164\t                           status checks.\n   165\t  --i-understand-no-gate-2-verification\n   166\t                           Confirm break-glass Gate 2 bypass during\n   167\t                           emergency recovery.\n   168\t  --help / -h              Show this help.\n   169\t\n   170\tBootstrap-only — this script is NOT run unattended. It refuses to\n   171\trun when CI=true or GITHUB_ACTIONS=true. Operator attention is\n   172\trequired for the apply, the diff review, and the invocation-log\n   173\tcommit afterward.\n   174\t\n   175\tReference: docs/DECISIONS.md D-022 (federation primitive adoption);\n   176\tD-033 (rendered context-name `policy-check / scp/policy-check`);\n   177\tD-035 (this slice's invocation procedure); WP-SCP-020 §4 020G.\n   178\tEOF\n   179\t}\n   180\t\n   181\twhile [ $# -gt 0 ]; do\n   182\t  case \"$1\" in\n   183\t    --repo)\n   184\t      [ $# -lt 2 ] && { echo \"error: --repo requires a value\" >&2; usage; exit 2; }\n   185\t      REPO=\"$2\"; shift 2 ;;\n   186\t    --branch)\n   187\t      [ $# -lt 2 ] && { echo \"error: --branch requires a value\" >&2; usage; exit 2; }\n   188\t      BRANCH=\"$2\"; shift 2 ;;\n   189\t    --required-check)\n   190\t      [ $# -lt 2 ] && { echo \"error: --required-check requires a value\" >&2; usage; exit 2; }\n   191\t      REQUIRED_CONTEXT=\"$2\"; shift 2 ;;\n   192\t    --plan) PLAN_ONLY=1; shift ;;\n   193\t    --enforce-admins) ENFORCE_ADMINS=\"true\"; shift ;;\n   194\t    --no-enforce-admins) ENFORCE_ADMINS=\"false\"; shift ;;\n   195\t    --i-understand-this-bypasses-the-gate) ACK_ADMIN_BYPASS=1; shift ;;\n   196\t    --restore)\n   197\t      [ $# -lt 2 ] && { echo \"error: --restore requires a value\" >&2; usage; exit 2; }\n   198\t      RESTORE_MODE=1\n   199\t      RESTORE_PRE_STATE=\"$2\"\n   200\t      shift 2 ;;\n   201\t    --expected-wrapper-sha)\n   202\t      [ $# -lt 2 ] && { echo \"error: --expected-wrapper-sha requires a value\" >&2; usage; exit 2; }\n   203\t      EXPECTED_WRAPPER_SHA=\"$2\"\n   204\t      shift 2 ;;\n   205\t    --i-understand-this-repo-has-no-prior-green-ci) NO_PRIOR_GREEN_CI=1; shift ;;\n   206\t    --i-understand-restore-removes-admin-enforcement) ACK_RESTORE_ADMIN_REMOVAL=1; shift ;;\n   207\t    --i-understand-restore-removes-required-checks) ACK_RESTORE_REQUIRED_CHECKS_REMOVAL=1; shift ;;\n   208\t    --i-understand-no-gate-2-verification) ACK_NO_GATE2_VERIFICATION=1; shift ;;\n   209\t    -h|--help) usage; exit 0 ;;\n   210\t    *) echo \"unknown flag: $1\" >&2; usage; exit 2 ;;\n   211\t  esac\n   212\tdone\n   213\t\n   214\tif [ -z \"$REPO\" ] || [ -z \"$BRANCH\" ]; then\n   215\t  echo \"error: --repo and --branch are both required\" >&2\n   216\t  usage\n   217\t  exit 2\n   218\tfi\n   219\t\n   220\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n   221\t  if [ -z \"$RESTORE_PRE_STATE\" ]; then\n   222\t    echo \"error: --restore requires a pre-state JSON path\" >&2\n   223\t    exit 2\n   224\t  fi\n   225\t  if [ \"$PLAN_ONLY\" -eq 1 ]; then\n   226\t    echo \"error: --restore cannot be combined with --plan\" >&2\n   227\t    exit 2\n   228\t  fi\n   229\t  if [ \"$ENFORCE_ADMINS\" != \"true\" ]; then\n   230\t    echo \"error: --restore cannot be combined with --no-enforce-admins\" >&2\n   231\t    exit 2\n   232\t  fi\n   233\t  if [ \"$ACK_ADMIN_BYPASS\" -eq 1 ]; then\n   234\t    echo \"error: --restore cannot be combined with --i-understand-this-bypasses-the-gate\" >&2\n   235\t    exit 2\n   236\t  fi\n   237\t  if [ -n \"$EXPECTED_WRAPPER_SHA\" ]; then\n   238\t    echo \"error: --restore cannot be combined with --expected-wrapper-sha\" >&2\n   239\t    exit 2\n   240\t  fi\n   241\t  if [ \"$NO_PRIOR_GREEN_CI\" -eq 1 ]; then\n   242\t    echo \"error: --restore cannot be combined with --i-understand-this-repo-has-no-prior-green-ci\" >&2\n   243\t    exit 2\n   244\t  fi\n   245\t  if [ \"$ACK_NO_GATE2_VERIFICATION\" -eq 1 ]; then\n   246\t    echo \"error: --restore cannot be combined with --i-understand-no-gate-2-verification\" >&2\n   247\t    exit 2\n   248\t  fi\n   249\tfi\n   250\t\n","exit_code":0,"status":"completed"}}

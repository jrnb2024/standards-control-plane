1\t                           this first to verify intent.\n   152\t  --no-enforce-admins      Disable enforce_admins. NOT canonical;\n   153\t                           requires a separate\n   154\t                           --i-understand-this-bypasses-the-gate flag\n   155\t                           to take effect (per 020G R1 SAF-003 closure).\n   156\t  --i-understand-this-bypasses-the-gate\n   157\t                           Required confirmation when combined with\n   158\t                           --no-enforce-admins. Without this flag, the\n   159\t                           script ignores --no-enforce-admins.\n   160\t  --restore PRE-STATE.json\n   161\t                           Restore branch protection from a captured\n   162\t                           pre-state JSON file.\n   163\t  --expected-wrapper-sha SHA\n   164\t                           Assert the caller pins the wrapper to a\n   165\t                           known release-tag SHA.\n   166\t  --i-understand-this-repo-has-no-prior-green-ci\n   167\t                           Bypass the forward-mode prior-green-CI safety\n   168\t                           check for cold-start adopters.\n   169\t  --i-understand-restore-removes-admin-enforcement\n   170\t                           Confirm a restore target that removes admin\n   171\t                           enforcement.\n   172\t  --i-understand-restore-removes-required-checks\n   173\t                           Confirm a restore target that removes required\n   174\t                           status checks.\n   175\t  --i-understand-restore-replaces-required-check-context\n   176\t                           Confirm a restore target that replaces the\n   177\t                           canonical required-check context with a\n   178\t                           non-canonical set.\n   179\t  --i-understand-restore-disables-required-signatures\n   180\t                           Confirm a restore target that disables\n   181\t                           required signatures.\n   182\t  --i-understand-restore-re-enables-force-pushes\n   183\t                           Confirm a restore target that re-enables\n   184\t                           allow_force_pushes.\n   185\t  --i-understand-restore-re-enables-deletions\n   186\t                           Confirm a restore target that re-enables\n   187\t                           allow_deletions.\n   188\t  --i-understand-no-gate-2-verification\n   189\t                           Confirm break-glass Gate 2 bypass during\n   190\t                           emergency recovery.\n   191\t  --i-understand-wrapper-inaccessible\n   192\t                           Confirm wrapper-content inaccessibility\n   193\t                           bypass during Gate 3 verification.\n   194\t  --help / -h              Show this help.\n   195\t\n   196\tBootstrap-only — this script is NOT run unattended. It refuses to\n   197\trun when CI=true or GITHUB_ACTIONS=true. Operator attention is\n   198\trequired for the apply, the diff review, and the invocation-log\n   199\tcommit afterward.\n   200\t\n   201\tReference: docs/DECISIONS.md D-022 (federation primitive adoption);\n   202\tD-033 (rendered context-name `policy-check / scp/policy-check`);\n   203\tD-035 (this slice's invocation procedure); WP-SCP-020 §4 020G.\n   204\tEOF\n   205\t}\n   206\t\n   207\twhile [ $# -gt 0 ]; do\n   208\t  case \"$1\" in\n   209\t    --repo)\n   210\t      [ $# -lt 2 ] && { echo \"error: --repo requires a value\" >&2; usage; exit 2; }\n   211\t      REPO=\"$2\"; shift 2 ;;\n   212\t    --branch)\n   213\t      [ $# -lt 2 ] && { echo \"error: --branch requires a value\" >&2; usage; exit 2; }\n   214\t      BRANCH=\"$2\"; shift 2 ;;\n   215\t    --required-check)\n   216\t      [ $# -lt 2 ] && { echo \"error: --required-check requires a value\" >&2; usage; exit 2; }\n   217\t      REQUIRED_CONTEXT=\"$2\"; shift 2 ;;\n   218\t    --plan) PLAN_ONLY=1; shift ;;\n   219\t    --enforce-admins) ENFORCE_ADMINS=\"true\"; shift ;;\n   220\t    --no-enforce-admins) ENFORCE_ADMINS=\"false\"; shift ;;\n   221\t    --i-understand-this-bypasses-the-gate) ACK_ADMIN_BYPASS=1; shift ;;\n   222\t    --restore)\n   223\t      [ $# -lt 2 ] && { echo \"error: --restore requires a value\" >&2; usage; exit 2; }\n   224\t      RESTORE_MODE=1\n   225\t      RESTORE_PRE_STATE=\"$2\"\n   226\t      shift 2 ;;\n   227\t    --expected-wrapper-sha)\n   228\t      [ $# -lt 2 ] && { echo \"error: --expected-wrapper-sha requires a value\" >&2; usage; exit 2; }\n   229\t      EXPECTED_WRAPPER_SHA=\"$2\"\n   230\t      shift 2 ;;\n   231\t    --i-understand-this-repo-has-no-prior-green-ci) NO_PRIOR_GREEN_CI=1; shift ;;\n   232\t    --i-understand-restore-removes-admin-enforcement) ACK_RESTORE_ADMIN_REMOVAL=1; shift ;;\n   233\t    --i-understand-restore-removes-required-checks) ACK_RESTORE_REQUIRED_CHECKS_REMOVAL=1; shift ;;\n   234\t    --i-understand-restore-replaces-required-check-context) ACK_RESTORE_REPLACES_REQUIRED_CHECK_CONTEXT=1; shift ;;\n   235\t    --i-understand-restore-disables-required-signatures) ACK_RESTORE_SIGNATURES_REMOVAL=1; shift ;;\n   236\t    --i-understand-restore-re-enables-force-pushes) ACK_RESTORE_FORCE_PUSHES=1; shift ;;\n   237\t    --i-understand-restore-re-enables-deletions) ACK_RESTORE_DELETIONS=1; shift ;;\n   238\t    --i-understand-no-gate-2-verification) ACK_NO_GATE2_VERIFICATION=1; shift ;;\n   239\t    --i-understand-wrapper-inaccessible) ACK_WRAPPER_INACCESSIBLE=1; shift ;;\n   240\t    -h|--help) usage; exit 0 ;;\n   241\t    *) echo \"unknown flag: $1\" >&2; usage; exit 2 ;;\n   242\t  esac\n   243\tdone\n   244\t\n   245\tif [ -z \"$REPO\" ] || [ -z \"$BRANCH\" ]; then\n   246\t  echo \"error: --repo and --branch are both required\" >&2\n   247\t  usage\n   248\t  exit 2\n   249\tfi\n   250\t\n   251\tif [ \"$RESTORE_MODE\" -eq 0 ]; then\n   252\t  if [ \"$ACK_RESTORE_ADMIN_REMOVAL\" -eq 1 ] || [ \"$ACK_RESTORE_REQUIRED_CHECKS_REMOVAL\" -eq 1 ] || [ \"$ACK_RESTORE_REPLACES_REQUIRED_CHECK_CONTEXT\" -eq 1 ] || [ \"$ACK_RESTORE_SIGNATURES_REMOVAL\" -eq 1 ] || [ \"$ACK_RESTORE_FORCE_PUSHES\" -eq 1 ] || [ \"$ACK_RESTORE_DELETIONS\" -eq 1 ]; then\n   253\t    echo 'error: --i-understand-restore-* flags are restore-mode-only; remove them or run with --restore <pre-state.json>' >&2\n   254\t    exit 2\n   255\t  fi\n   256\tfi\n   257\t\n   258\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n   259\t  if [ -z \"$RESTORE_PRE_STATE\" ]; then\n   260\t    echo \"error: --restore requires a pre-state JSON path\" >&2\n   280\t    echo \"error: --restore cannot be combined with --i-understand-this-repo-has-no-prior-green-ci\" >&2\n   281\t    exit 2\n   282\t  fi\n   283\t  if [ \"$ACK_NO_GATE2_VERIFICATION\" -eq 1 ]; then\n   284\t    echo \"error: --restore cannot be combined with --i-understand-no-gate-2-verification\" >&2\n   285\t    exit 2\n   286\t  fi\n   287\t  if [ \"$ACK_WRAPPER_INACCESSIBLE\" -eq 1 ]; then\n   288\t    echo \"error: --restore cannot be combined with --i-understand-wrapper-inaccessible\" >&2\n   289\t    exit 2\n   290\t  fi\n   291\tfi\n   292\t\n   293\tif [ -n \"$EXPECTED_WRAPPER_SHA\" ] && [ \"$ACK_NO_GATE2_VERIFICATION\" -eq 1 ]; then\n   294\t  echo \"error: --expected-wrapper-sha cannot be combined with --i-understand-no-gate-2-verification\" >&2\n   295\t  exit 2\n   296\tfi\n   297\t\n   298\tif [ \"$NO_PRIOR_GREEN_CI\" -eq 1 ] && [ -n \"$EXPECTED_WRAPPER_SHA\" ]; then\n   299\t  echo \"error: --expected-wrapper-sha cannot be combined with --i-understand-this-repo-has-no-prior-green-ci\" >&2\n   300\t  exit 2\n   301\tfi\n   302\t\n   303\t# Closes 020G R2 correctness CORR2-003: --i-understand-this-bypasses-\n   304\t# the-gate is silently meaningless without --no-enforce-admins.\n   305\t# Refuse the combination so an operator who pre-fills the long flag\n   306\t# from history but forgets the trigger sees a clear error.\n   307\tif [ \"$ACK_ADMIN_BYPASS\" -eq 1 ] && [ \"$ENFORCE_ADMINS\" = \"true\" ]; then\n   308\t  echo \"error: --i-understand-this-bypasses-the-gate is meaningless without --no-enforce-admins\" >&2\n   309\t  echo \"       remove the ack flag, or pair it with --no-enforce-admins\" >&2\n   310\t  exit 2\n   311\tfi\n   312\t\n   313\t# Per 020G R1 safety SAF-003: --no-enforce-admins is a serious\n   314\t# foot-gun. Refuse silently unless the explicit acknowledgement\n   315\t# flag is also set. With the flag, escalate to a 5-second pause\n   316\t# + visible warning so the operator who actually means it\n   317\t# can't run on autopilot.\n   318\tif [ \"$ENFORCE_ADMINS\" != \"true\" ]; then\n   319\t  if [ \"$ACK_ADMIN_BYPASS\" -ne 1 ]; then\n   320\t    echo \"error: --no-enforce-admins ignored without --i-understand-this-bypasses-the-gate\" >&2\n   321\t    echo \"       enforce_admins=true is the canonical SCP federation primitive posture.\" >&2\n   322\t    exit 2\n   323\t  fi\n   324\t  echo \"\" >&2\n   325\t  echo \"================================================================\" >&2\n   326\t  echo \"WARNING: --no-enforce-admins applied with explicit acknowledgement.\" >&2\n   327\t  echo \"         This means repository administrators can push directly\" >&2\n   328\t  echo \"         to '$BRANCH' bypassing the SCP policy-check gate.\" >&2\n   329\t  echo \"         5-second pause to allow Ctrl-C...\" >&2\n   330\t  echo \"================================================================\" >&2\n   331\t  sleep 5\n   332\tfi\n   333\t\n   334\t# Path-traversal guard on REPO + BRANCH (per 020G R1 safety SAF-006\n   335\t# + 020G R2 correctness CORR2-002 — `owner/..` would have satisfied\n   336\t# the original regex because `..` matches `[A-Za-z0-9._-]+`).\n   337\t# Repo names match GitHub's ASCII rules; branch names disallow `..`\n   338\t# or leading slashes that could be misread by url joining.\n   339\tcase \"$REPO\" in\n   340\t  .*|*/.*)\n   341\t    echo \"error: --repo '$REPO' contains path-traversal sequence (leading dot or dot-segment after /)\" >&2\n   342\t    exit 2 ;;\n   343\tesac\n   344\tcase \"$REPO\" in\n   345\t  *..*)\n   346\t    echo \"error: --repo '$REPO' contains path-traversal sequence (..)\" >&2\n   347\t    exit 2 ;;\n   348\tesac\n   349\tif ! printf '%s' \"$REPO\" | grep -qE '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$'; then\n   350\t  echo \"error: --repo '$REPO' does not match owner/name shape\" >&2\n   351\t  exit 2\n   352\tfi\n   353\tcase \"$BRANCH\" in\n   354\t  \"\"|*/*|*..*|.*) echo \"error: --branch '$BRANCH' invalid (no slashes, no .., no leading dot)\" >&2; exit 2 ;;\n   355\tesac\n   356\t\n   357\t# Closes 020G R3 safety SAF-R3-002: REQUIRED_CONTEXT is included\n   358\t# verbatim in the emitted markdown log block; backticks or\n   359\t# newlines would corrupt the operator's pasteable log entry. Reject\n   360\t# obvious markdown-injection chars. The actual GitHub Actions\n   380\tpath = sys.argv[1]\n   381\ttry:\n   382\t    with open(path) as fh:\n   383\t        data = json.load(fh)\n   384\texcept Exception as exc:  # pragma: no cover - defensive diagnostics\n   385\t    print(f\"error: unable to parse restore pre-state JSON: {exc}\", file=sys.stderr)\n   386\t    sys.exit(2)\n   387\t\n   388\tif not isinstance(data, dict):\n   389\t    print(\"error: restore pre-state JSON must be an object\", file=sys.stderr)\n   390\t    sys.exit(2)\n   391\t\n   392\trequired_types = {\n   393\t    \"required_status_checks\": (dict, type(None)),\n   394\t    \"enforce_admins\": dict,\n   395\t    \"required_pull_request_reviews\": (dict, type(None)),\n   396\t    \"restrictions\": (dict, type(None)),\n   397\t    \"required_signatures\": (dict, type(None)),\n   398\t}\n   399\tfor key, types in required_types.items():\n   400\t    if key not in data:\n   401\t        print(f\"error: restore pre-state JSON missing required key '{key}'\", file=sys.stderr)\n   402\t        sys.exit(2)\n   403\t    if not isinstance(data[key], types):\n   404\t        print(f\"error: restore pre-state JSON key '{key}' has unexpected type\", file=sys.stderr)\n   405\t        sys.exit(2)\n   406\t\n   407\trsc = data.get(\"required_status_checks\")\n   408\tif rsc is not None:\n   409\t    contexts = rsc.get(\"contexts\")\n   410\t    if not isinstance(contexts, list):\n   411\t        print(\"error: required_status_checks.contexts must be a list\", file=sys.stderr)\n   412\t        sys.exit(2)\n   413\t    for item in contexts:\n   414\t        if not isinstance(item, str):\n   415\t            print(f\"error: required_status_checks.contexts must contain only strings (got {type(item).__name__}: {item!r})\", file=sys.stderr)\n   416\t            sys.exit(2)\n   417\t\n   418\tenforce_admins = data.get(\"enforce_admins\")\n   419\tenabled = enforce_admins.get(\"enabled\")\n   420\tif not (\n   421\t    enabled is None\n   422\t    or isinstance(enabled, bool)\n   423\t    or (isinstance(enabled, int) and enabled in (0, 1))\n   424\t):\n   425\t    print(\"error: enforce_admins.enabled must be a boolean\", file=sys.stderr)\n   426\t    sys.exit(2)\n   427\t\n   428\tALLOWED_REQUIRED_STATUS_CHECKS_KEYS = (\"strict\", \"contexts\")\n   429\tALLOWED_REQUIRED_PULL_REQUEST_REVIEW_KEYS = (\n   430\t    \"dismissal_restrictions\",\n   431\t    \"dismiss_stale_reviews\",\n   432\t    \"require_code_owner_reviews\",\n   433\t    \"required_approving_review_count\",\n   434\t    \"require_last_push_approval\",\n   435\t    \"bypass_pull_request_allowances\",\n   436\t)\n   437\tALLOWED_RESTRICTIONS_KEYS = (\"users\", \"teams\", \"apps\")\n   438\t\n   439\t\n   440\tdef compact_actor_lists(node):\n   441\t    def compact(items, field):\n   442\t        out_items = []\n   443\t        for item in items or []:\n   444\t            if isinstance(item, dict):\n   445\t                item = item.get(field, \"\")\n   446\t            if isinstance(item, str) and item:\n   447\t                out_items.append(item)\n   448\t        return out_items\n   449\t\n   450\t    return {\n   451\t        \"users\": compact(node.get(\"users\", []), \"login\"),\n   452\t        \"teams\": compact(node.get(\"teams\", []), \"slug\"),\n   453\t        \"apps\": compact(node.get(\"apps\", []), \"slug\"),\n   454\t    }\n   455\t\n   456\t\n   457\tdef transform(node):\n   458\t    if isinstance(node, dict):\n   459\t        out = {}\n   460\t        for key, value in node.items():\n   461\t            if key in {\"_links\", \"url\", \"checks\", \"required_signatures\", \"enforcement_level\", \"contexts_url\"} or key.endswith(\"_url\"):\n   462\t                continue\n   463\t            if key == \"enforce_admins\" and isinstance(value, dict):\n   464\t                out[key] = bool(value.get(\"enabled\", False))\n   465\t            elif key == \"restrictions\" and isinstance(value, dict):\n   466\t                # Use an inclusion list for the documented branch-restriction keys.\n   467\t                out[key] = compact_actor_lists(value)\n   468\t            elif key == \"required_status_checks\" and value is None:\n   469\t                out[key] = {\"strict\": False, \"contexts\": []}\n   470\t            elif key == \"required_status_checks\" and isinstance(value, dict):\n   471\t                # Use an inclusion list so undocumented nested fields do not leak into the PUT body.\n   472\t                out[key] = {\n   473\t                    nested_key: value.get(nested_key, [] if nested_key == \"contexts\" else False)\n   474\t                    for nested_key in ALLOWED_REQUIRED_STATUS_CHECKS_KEYS\n   475\t                    if nested_key in value\n   476\t                }\n   477\t            elif key == \"required_pull_request_reviews\" and isinstance(value, dict):\n   478\t                # Use an inclusion list so undocumented nested fields do not leak into the PUT body.\n   479\t                out[key] = {}\n   480\t                for nested_key in ALLOWED_REQUIRED_PULL_REQUEST_REVIEW_KEYS:\n   481\t                    if nested_key not in value:\n   482\t                        continue\n   483\t                    nested_value = value[nested_key]\n   484\t                    if nested_key in {\"dismissal_restrictions\", \"bypass_pull_request_allowances\"} and isinstance(nested_value, dict):\n   485\t                        out[key][nested_key] = compact_actor_lists(nested_value)\n   486\t                    else:\n   487\t                        out[key][nested_key] = transform(nested_value)\n   488\t            else:\n   489\t                out[key] = transform(value)\n   490\t        return out\n   491\t    if isinstance(node, list):\n   492\t        return [transform(item) for item in node]\n   493\t    return node\n   494\t\n   495\tprint(json.dumps(transform(data)))\n   496\tPY\n   497\t}\n   498\t\n   499\tjson_file_to_pretty_stdout() {\n   500\t  local file=\"$1\"\n   501\t  python3 - \"$file\" <<'PY'\n   502\timport json\n   503\timport sys\n   504\t\n   505\tpath = sys.argv[1]\n   506\ttry:\n   507\t    with open(path) as fh:\n   508\t        data = json.load(fh)\n   509\texcept Exception:\n   510\t    with open(path) as fh:\n   511\t        sys.stdout.write(fh.read())\n   512\telse:\n   513\t    print(json.dumps(data, indent=2, sort_keys=False))\n   514\tPY\n   515\t}\n   516\t\n   517\tjson_string_to_pretty_stdout() {\n   518\t  python3 - <<'PY'\n   519\timport json\n   520\timport sys\n   530\t}\n   531\t\n   532\tsanitize_context_for_log() {\n   533\t  local context=\"$1\"\n   534\t  context=\"${context//$'\\r'/ }\"\n   535\t  context=\"${context//$'\\n'/ }\"\n   536\t  context=\"${context//\\`/\\\\\\`}\"\n   537\t  if [ \"${#context}\" -gt 200 ]; then\n   538\t    context=\"${context:0:200}\"\n   539\t  fi\n   540\t  printf '%s' \"$context\"\n   541\t}\n   542\t\n   543\tprior_restore_evidence_present() {\n   544\t  local log_path=\"$1\"\n   545\t  local target=\"$2\"\n   546\t  local target_escaped committed_blob=\"\" working_tree_diff=\"\" committed_history_diff=\"\"\n   547\t  # shellcheck disable=SC2016\n   548\t  target_escaped=\"$(printf '%s' \"$target\" | sed 's/[][\\\\.*^$()+?{}|\\\\/]/\\\\\\\\&/g')\"\n   549\t  if [ -f \"$log_path\" ]; then\n   550\t    committed_blob=\"$(cat \"$log_path\")\"\n   551\t  fi\n   552\t  working_tree_diff=\"$(git -C \"$REPO_ROOT\" diff HEAD -- \"$log_path\" 2>/dev/null || true)\"\n   553\t  committed_history_diff=\"$(git -C \"$REPO_ROOT\" log -p -- \"$log_path\" 2>/dev/null || true)\"\n   554\t  printf '%s\\n%s\\n%s' \"$committed_blob\" \"$working_tree_diff\" \"$committed_history_diff\" | awk -v target=\"$target_escaped\" '\n   555\t    BEGIN { found = 0; in_block = 0 }\n   556\t    {\n   557\t      line = $0\n   558\t      sub(/^[+-]/, \"\", line)\n   559\t      if (line ~ /^### /) {\n   560\t        pat = \"(^|[^A-Za-z0-9._/-])\" target \"([^A-Za-z0-9._/-]|$)\"\n   561\t        in_block = (match(line, pat) > 0)\n   562\t      }\n   563\t      if (in_block && line ~ /\\*\\*Restoring TO:\\*\\*/) {\n   564\t        found = 1\n   565\t        exit\n   566\t      }\n   567\t    }\n   568\t    END { exit !found }\n   569\t  '\n   570\t}\n   571\t\n   572\tvalidate_expected_wrapper_sha_against_tags() {\n   573\t  local expected_sha=\"$1\"\n   574\t  local tag_list_json matched_tag=\"\" matched_tag_lines=\"\"\n   575\t  tag_list_json=\"$(gh api --paginate \"repos/jrnb2024/standards-control-plane-/git/refs/tags?per_page=100\")\"\n   576\t  matched_tag_lines=\"$(\n   577\t    TAG_LIST_JSON=\"$tag_list_json\" python3 - \"$expected_sha\" <<'PY'\n   578\timport json\n   579\timport os\n   580\timport sys\n   581\t\n   582\texpected_sha = sys.argv[1]\n   583\tpayload = os.environ.get(\"TAG_LIST_JSON\", \"\").strip()\n   584\tdecoder = json.JSONDecoder()\n   585\tdocs = []\n   586\t\n   587\twhile payload:\n   588\t    payload = payload.lstrip()\n   589\t    if not payload:\n   590\t        break\n   591\t    doc, idx = decoder.raw_decode(payload)\n   592\t    docs.append(doc)\n   593\t    payload = payload[idx:]\n   594\t\n   595\tfor doc in docs:\n   596\t    items = doc if isinstance(doc, list) else [doc]\n   597\t    for entry in items:\n   598\t        if not isinstance(entry, dict):\n   599\t            continue\n   600\t        ref = entry.get(\"ref\", \"\")\n   601\t        obj = entry.get(\"object\") or {}\n   602\t        obj_type = obj.get(\"type\") or \"commit\"\n   603\t        obj_sha = obj.get(\"sha\", \"\")\n   604\t        if obj_type == \"commit\" and obj_sha == expected_sha:\n   605\t            print(f\"{ref}\\tcommit\\t\")\n   606\t        elif obj_type == \"tag\":\n   607\t            print(f\"{ref}\\ttag\\t{obj_sha}\")\n   608\tPY\n   609\t  )\"\n   610\t  while IFS=$'\\t' read -r ref kind tag_sha; do\n   611\t    [ -n \"$ref\" ] || continue\n   612\t    case \"$kind\" in\n   613\t      commit)\n   614\t        matched_tag=\"${ref#refs/tags/}\"\n   615\t        break\n   616\t        ;;\n   617\t      tag)\n   618\t        local annotated_commit_sha=\"\"\n   619\t        annotated_commit_sha=\"$(\n   620\t          gh api \"repos/jrnb2024/standards-control-plane-/git/tags/${tag_sha}\" --jq '.object.sha' 2>/dev/null || true\n   621\t        )\"\n   622\t        if [ \"$annotated_commit_sha\" = \"$expected_sha\" ]; then\n   623\t          matched_tag=\"${ref#refs/tags/}\"\n   624\t          break\n   625\t        fi\n   626\t        ;;\n   627\t    esac\n   628\t  done <<EOF\n   629\t$matched_tag_lines\n   630\tEOF\n   631\t  if [ -z \"$matched_tag\" ]; then\n   632\t    echo \"error: --expected-wrapper-sha '$expected_sha' was not found in the release-tag SHA cache\" >&2\n   633\t    exit 2\n   634\t  fi\n   635\t  log \"expected wrapper SHA validated against release tag: ${matched_tag}\"\n   636\t}\n   637\t\n   638\tcheck_forward_mode_safety() {\n   639\t  local created_since workflow_id workflow_runs_json run_count wrapper_content\n   640\t\n   641\t  if [ \"$NO_PRIOR_GREEN_CI\" -eq 1 ]; then\n   642\t    if prior_restore_evidence_present \"docs/reviews/WP-SCP-020/branch-protection-log.md\" \"${REPO}@${BRANCH}\"; then\n   643\t      echo \"error: --i-understand-this-repo-has-no-prior-green-ci is incompatible with prior restore evidence for ${REPO}@${BRANCH} found in docs/reviews/WP-SCP-020/branch-protection-log.md\" >&2\n   644\t      echo \"       the cold-start escape hatch is for adopters without history; prior-restore evidence indicates Gate 3 (post-break-glass re-enable) — use --expected-wrapper-sha or --i-understand-no-gate-2-verification\" >&2\n   645\t      exit 2\n   646\t    fi\n   647\t    workflow_id=\"$(gh api --paginate \"repos/${REPO}/actions/workflows?per_page=100\" --jq '.workflows[] | select(.path == \"'\"$WORKFLOW_LOOKUP_PATH\"'\") | .id' | head -n1)\"\n   648\t    if [ -n \"$workflow_id\" ]; then\n   649\t      created_since=\"$(python3 - <<'PY'\n   650\tfrom datetime import datetime, timedelta, timezone\n   651\tprint((datetime.now(timezone.utc) - timedelta(days=60)).strftime(\"%Y-%m-%dT%H:%M:%SZ\"))\n   652\tPY\n   653\t)\"\n   654\t      workflow_runs_json=\"$(gh api \"repos/${REPO}/actions/runs?status=success&created=%3E%3D${created_since}&workflow_id=${workflow_id}\")\"\n   655\t      run_count=\"$(printf '%s' \"$workflow_runs_json\" | jq '.workflow_runs | length')\"\n   656\t      if [ \"$run_count\" -gt 0 ]; then\n   657\t        log \"CAUTION: --i-understand-this-repo-has-no-prior-green-ci rejected for ${REPO}@${BRANCH}; successful workflow runs exist\"\n   658\t        echo \"error: --i-understand-this-repo-has-no-prior-green-ci is for cold-start adopters with no successful workflow-runs. Found ${run_count} successful runs on this repo, indicating a non-cold-start state. Use --expected-wrapper-sha for Gate 3 re-enable instead.\" >&2\n   659\t        exit 2\n   660\t      fi\n   661\t    fi\n   662\t    log \"safety check bypassed via --i-understand-this-repo-has-no-prior-green-ci\"\n   663\t    return 0\n   664\t  fi\n   665\t\n   666\t  workflow_id=\"$(gh api --paginate \"repos/${REPO}/actions/workflows?per_page=100\" --jq '.workflows[] | select(.path == \"'\"$WORKFLOW_LOOKUP_PATH\"'\") | .id' | head -n1)\"\n   667\t  if [ -z \"$workflow_id\" ]; then\n   668\t    echo \"error: no workflow with path '$WORKFLOW_LOOKUP_PATH' found in ${REPO}\" >&2\n   669\t    exit 2\n   670\t  fi\n   671\t\n   672\t  created_since=\"$(python3 - <<'PY'\n   673\tfrom datetime import datetime, timedelta, timezone\n   674\tprint((datetime.now(timezone.utc) - timedelta(days=60)).strftime(\"%Y-%m-%dT%H:%M:%SZ\"))\n   675\tPY\n   676\t)\"\n   677\t  workflow_runs_json=\"$(gh api \"repos/${REPO}/actions/runs?status=success&created=%3E%3D${created_since}&workflow_id=${workflow_id}\")\"\n   678\t  run_count=\"$(printf '%s' \"$workflow_runs_json\" | jq '.workflow_runs | length')\"\n   679\t  if [ \"$run_count\" -eq 0 ]; then\n   680\t    echo \"error: no successful workflow runs found for workflow path '$WORKFLOW_LOOKUP_PATH' in the last 60 days\" >&2\n   681\t    echo \"       use --i-understand-this-repo-has-no-prior-green-ci only for cold-start adopters\" >&2\n   682\t    exit 2\n   683\t  fi\n   684\t  log \"safety check: found ${run_count} successful workflow run(s) for ${WORKFLOW_LOOKUP_PATH} in the last 60 days\"\n   685\t\n   686\t  # prior_restore_evidence_present gates ACK_NO_GATE2_VERIFICATION here.\n   687\t  if prior_restore_evidence_present \"docs/reviews/WP-SCP-020/branch-protection-log.md\" \"${REPO}@${BRANCH}\"; then\n   688\t    if [ \"$ACK_NO_GATE2_VERIFICATION\" -eq 1 ]; then\n   689\t      cat >&2 <<'WARN'\n   690\t++ CAUTION: Gate 2 wrapper-SHA verification bypassed via --i-understand-no-gate-2-verification.\n   691\t++ This proceeds in 5 seconds. Press Ctrl-C to abort.\n   692\tWARN\n   693\t      sleep 5\n   694\t      GATE2_CAUTION_LINE=\"- **CAUTION:** Gate 3 invoked with --i-understand-no-gate-2-verification — wrapper SHA NOT verified against release-tag SHA. Operator @${OPERATOR} acknowledges break-glass risk.\"\n   695\t    fi\n   696\t    if [ -z \"$EXPECTED_WRAPPER_SHA\" ] && [ \"$ACK_NO_GATE2_VERIFICATION\" -ne 1 ]; then\n   697\t      echo \"error: prior --restore evidence detected for ${REPO}@${BRANCH}; --expected-wrapper-sha <release-tag-sha> is required\" >&2\n   698\t      echo \"       pass --i-understand-no-gate-2-verification to bypass Gate 2 verification (audited via CAUTION log entry)\" >&2\n   699\t      exit 2\n   700\t    fi\n   701\t  fi\n   702\t\n   703\t  if [ -n \"$EXPECTED_WRAPPER_SHA\" ]; then\n   704\t    if ! prior_restore_evidence_present \"docs/reviews/WP-SCP-020/branch-protection-log.md\" \"${REPO}@${BRANCH}\"; then\n   705\t      echo \"error: --expected-wrapper-sha requires prior --restore evidence for ${REPO}@${BRANCH} in docs/reviews/WP-SCP-020/branch-protection-log.md\" >&2\n   706\t      echo \"       check both the committed log file and the working tree diff\" >&2\n   707\t      exit 2\n   708\t    fi\n   709\t    validate_expected_wrapper_sha_against_tags \"$EXPECTED_WRAPPER_SHA\"\n   710\t    _wrapper_raw=\"$(gh api \"repos/${REPO}/contents/.github/workflows/policy-check-wrapper.yml\" --jq '.content' 2>/dev/null || true)\"\n   711\t    if [ -n \"$_wrapper_raw\" ]; then\n   712\t      wrapper_content=\"$(printf '%s' \"$_wrapper_raw\" | base64 -d 2>/dev/null)\" || {\n   713\t        echo \"ERROR: fetched adopter wrapper content but base64 decode failed — API response may be malformed\" >&2\n   714\t        echo \"       pass --i-understand-wrapper-inaccessible if wrapper is genuinely unreachable\" >&2\n   715\t        exit 2\n   716\t      }\n   717\t    else\n   718\t      wrapper_content=\"\"\n   719\t    fi\n   720\t    if [ -n \"$wrapper_content\" ]; then\n   721\t      if printf '%s' \"$wrapper_content\" | grep -vE '^[[:space:]]*#' | grep -qE '^[[:space:]]*uses:[[:space:]]+[^#]*standards-control-plane[^#]*@'\"${EXPECTED_WRAPPER_SHA}\"; then\n   722\t        log \"verified: adopter wrapper pins to ${EXPECTED_WRAPPER_SHA}\"\n   723\t      else\n   724\t        echo \"ERROR: adopter wrapper does NOT pin to ${EXPECTED_WRAPPER_SHA}\" >&2\n   725\t        echo \"       update the wrapper SHA pin before invoking Gate 3 re-enable\" >&2\n   726\t        exit 2\n   727\t      fi\n   728\t    else\n   729\t      if [ \"$ACK_WRAPPER_INACCESSIBLE\" -ne 1 ]; then\n   730\t        echo \"ERROR: adopter wrapper content is inaccessible from current context\" >&2\n   731\t        echo \"       pass --i-understand-wrapper-inaccessible to continue without wrapper-pin verification\" >&2\n   732\t        exit 2\n   733\t      fi\n   734\t      log \"CAUTION: wrapper-pin not verified — adopter wrapper content inaccessible; operator acknowledged via --i-understand-wrapper-inaccessible\"\n   735\t      WRAPPER_INACCESSIBLE_CAUTION_LINE=\"- **CAUTION:** Gate 3 wrapper content was inaccessible from the current context; operator acknowledged via --i-understand-wrapper-inaccessible before proceeding.\"\n   736\t      cat >&2 <<'WARN'\n   737\t+++ CAUTION: adopter wrapper content is inaccessible from current context.\n   738\t+++ This proceeds in 5 seconds. Press Ctrl-C to abort.\n   739\tWARN\n   740\t      sleep 5\n   741\t    fi\n   742\t  fi\n   743\t}\n   744\t\n   745\tlog() {\n   746\t  printf '[020G] %s\\n' \"$*\"\n   747\t}\n   748\t\n   749\tlog \"target repo: $REPO\"\n   750\tlog \"target branch: $BRANCH\"\n   751\tlog \"required check: $REQUIRED_CONTEXT\"\n   752\tlog \"enforce_admins: $ENFORCE_ADMINS\"\n   753\t[ \"$PLAN_ONLY\" = \"1\" ] && log \"MODE: plan-only (no API mutation)\"\n   754\t\n   755\tif [ \"$RESTORE_MODE\" -eq 0 ]; then\n   756\t  check_forward_mode_safety\n   757\tfi\n   758\t\n   759\t# ---------- Construct PUT payload ----------\n   760\t#\n   900\t  printf '%s\\n' \"$PAYLOAD\" | jq .\n   901\t  log \"post-PUT, would also enable required_signatures via the dedicated sub-resource.\"\n   902\t  log \"to apply, re-run without --plan\"\n   903\t  exit 0\n   904\tfi\n   905\t\n   906\t# ---------- Apply ----------\n   907\t\n   908\t# Closes 020G R2 safety SAF-R2-001: trap a non-zero exit during\n   909\t# the apply phase so partial state still emits an audit-trail\n   910\t# log entry. Otherwise `set -e` skips log emission entirely on\n   911\t# any HTTP 403/network failure during the dedicated POST step.\n   912\t\n   913\tAPPLY_FAIL=0\n   914\t\n   915\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n   916\t  if [ \"$RESTORE_TARGET_ADMINS_ENABLED\" = \"false\" ] && [ \"$ACK_RESTORE_ADMIN_REMOVAL\" -ne 1 ]; then\n   917\t    echo \"error: restore target removes admin enforcement; pass --i-understand-restore-removes-admin-enforcement to continue\" >&2\n   918\t    exit 2\n   919\t  fi\n   920\t  if [ \"$RESTORE_TARGET_ADMINS_ENABLED\" = \"false\" ]; then\n   921\t    log \"CAUTION: restore target removes admin enforcement; operator acknowledges posture change\"\n   922\t    RESTORE_CAUTION_LINES+=(\"- **CAUTION:** restore target removes admin enforcement; operator acknowledged via --i-understand-restore-removes-admin-enforcement.\")\n   923\t  fi\n   924\t  restore_contexts=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.required_status_checks.contexts // [] | length')\"\n   925\t  restore_canonical_present=0\n   926\t  if printf '%s' \"$RESTORE_TARGET_JSON\" | jq -e --arg ctx \"$REQUIRED_CONTEXT\" '(.required_status_checks // {}).contexts // [] | index($ctx) != null' >/dev/null 2>&1; then\n   927\t    restore_canonical_present=1\n   928\t  fi\n   929\t  if [ \"$restore_contexts\" -eq 0 ]; then\n   930\t    if [ \"$ACK_RESTORE_REQUIRED_CHECKS_REMOVAL\" -ne 1 ] && [ \"$ACK_RESTORE_REPLACES_REQUIRED_CHECK_CONTEXT\" -ne 1 ]; then\n   931\t      echo \"error: restore target removes required status checks; pass --i-understand-restore-removes-required-checks to continue\" >&2\n   932\t      exit 2\n   933\t    fi\n   934\t    log \"CAUTION: restore target removes required status checks; operator acknowledges posture change\"\n   935\t    RESTORE_CAUTION_LINES+=(\"- **CAUTION:** restore target removes required status checks; operator acknowledged via --i-understand-restore-removes-required-checks.\")\n   936\t  elif [ \"$restore_canonical_present\" -eq 0 ]; then\n   937\t    if [ \"$ACK_RESTORE_REQUIRED_CHECKS_REMOVAL\" -ne 1 ] && [ \"$ACK_RESTORE_REPLACES_REQUIRED_CHECK_CONTEXT\" -ne 1 ]; then\n   938\t      echo \"error: restore target replaces canonical required status check context; pass --i-understand-restore-replaces-required-check-context to continue or use --i-understand-restore-removes-required-checks if intentional removal\" >&2\n   939\t      exit 2\n   940\t    fi\n   941\t    log \"CAUTION: restore target replaces required_status_checks.contexts with a non-canonical set; operator acknowledges posture change\"\n   942\t    RESTORE_CAUTION_LINES+=(\"- **CAUTION:** restore target replaces required_status_checks.contexts with a non-canonical set; operator acknowledged via --i-understand-restore-replaces-required-check-context.\")\n   943\t  fi\n   944\t\n   945\t  log \"restoring branch protection (unified PUT)...\"\n   946\t  printf '%s' \"$RESTORE_PAYLOAD\" | gh api -X PUT \"repos/${REPO}/branches/${BRANCH}/protection\" \\\n   947\t    -H \"Accept: application/vnd.github+json\" \\\n   948\t    --input - >/dev/null || APPLY_FAIL=1\n   949\t\n   950\t  if [ \"$APPLY_FAIL\" -ne 0 ]; then\n   951\t    echo \"ERROR: unified PUT failed; partial branch-protection state may exist on ${REPO}@${BRANCH}\" >&2\n   952\t    echo \"       continuing to log emission so the failure is auditable, then exiting non-zero\" >&2\n   953\t    FAIL=1\n   954\t  else\n   955\t    restore_signatures_enabled=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.required_signatures.enabled // false')\"\n   956\t    if [ \"$restore_signatures_enabled\" = \"true\" ]; then\n   957\t      log \"restoring required_signatures (dedicated sub-resource: enable)...\"\n   958\t      restore_signatures_err=\"$(mktemp)\"\n   959\t      if ! gh api -X POST \"repos/${REPO}/branches/${BRANCH}/protection/required_signatures\" >/dev/null 2>\"$restore_signatures_err\"; then\n   960\t        if grep -q '404' \"$restore_signatures_err\"; then\n   961\t          log \"required_signatures POST already in desired state (404 suppressed)\"\n   962\t        else\n   963\t          echo \"ERROR: required_signatures POST failed; status-checks/admins/reviews are set but signatures are NOT\" >&2\n   964\t          echo \"       continuing to log emission so the partial-state failure is auditable, then exiting non-zero\" >&2\n   965\t          APPLY_FAIL=1\n   966\t          FAIL=1\n   967\t        fi\n   968\t      fi\n   969\t      rm -f \"$restore_signatures_err\"\n   970\t    else\n   971\t      log \"restoring required_signatures (dedicated sub-resource: disable)...\"\n   972\t      restore_signatures_err=\"$(mktemp)\"\n   973\t      if ! gh api -X DELETE \"repos/${REPO}/branches/${BRANCH}/protection/required_signatures\" >/dev/null 2>\"$restore_signatures_err\"; then\n   974\t        if grep -q '404' \"$restore_signatures_err\"; then\n   975\t          log \"required_signatures DELETE already in desired state (404 suppressed)\"\n   976\t        else\n   977\t          echo \"ERROR: required_signatures DELETE failed; status-checks/admins/reviews are set but signatures are NOT\" >&2\n   978\t          echo \"       continuing to log emission so the partial-state failure is auditable, then exiting non-zero\" >&2\n   979\t          APPLY_FAIL=1\n   980\t          FAIL=1\n  1030\t  if AFTER_JSON=\"$(gh api -X GET \"repos/${REPO}/branches/${BRANCH}/protection\")\"; then\n  1031\t    :\n  1032\t  else\n  1033\t    AFTER_JSON='{\"_error\":\"forward-mode verify GET failed\"}'\n  1034\t    echo \"ERROR: post-apply GET branch-protection failed; continuing to log emission so the failure is auditable\" >&2\n  1035\t    APPLY_FAIL=1\n  1036\t    FAIL=1\n  1037\t  fi\n  1038\tfi\n  1039\t\n  1040\tCHECKS_STRICT=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_status_checks.strict // false')\"\n  1041\tCHECKS_CONTEXTS=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_status_checks.contexts // [] | join(\",\")')\"\n  1042\tAPPLIED_ADMINS=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.enforce_admins.enabled // false')\"\n  1043\tSIGS_ENABLED=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_signatures.enabled // false')\"\n  1044\t\n  1045\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n  1046\t  EXPECTED_CHECKS_STRICT=\"$RESTORE_TARGET_CHECKS_STRICT\"\n  1047\t  EXPECTED_CHECKS_CONTEXTS=\"$RESTORE_TARGET_CHECKS_CONTEXTS\"\n  1048\t  EXPECTED_APPLIED_ADMINS=\"$RESTORE_TARGET_ADMINS_ENABLED\"\n  1049\t  EXPECTED_SIGS_ENABLED=\"$RESTORE_SIGNATURES_ENABLED\"\n  1050\telse\n  1051\t  EXPECTED_CHECKS_STRICT=\"true\"\n  1052\t  EXPECTED_CHECKS_CONTEXTS=\"$REQUIRED_CONTEXT\"\n  1053\t  EXPECTED_APPLIED_ADMINS=\"$ENFORCE_ADMINS\"\n  1054\t  EXPECTED_SIGS_ENABLED=\"true\"\n  1055\tfi\n  1056\t\n  1057\t# Closes 020G R3 correctness CORR3-001 + safety SAF-R3-001:\n  1058\t# preserve any FAIL=1 set by the apply-phase trap. Initialising\n  1059\t# FAIL=0 unconditionally would launder an apply-failure into a\n  1060\t# false-success when the pre-existing state happens to satisfy\n  1061\t# the verify checks. Default to 0 only if not already set.\n  1062\tFAIL=\"${FAIL:-0}\"\n  1063\t[ \"$CHECKS_STRICT\" = \"$EXPECTED_CHECKS_STRICT\" ] || { echo \"verify FAIL: required_status_checks.strict=${CHECKS_STRICT} (expected ${EXPECTED_CHECKS_STRICT})\" >&2; FAIL=1; }\n  1064\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n  1065\t  if ! printf '%s' \"$AFTER_JSON\" | jq -e --argjson expected_contexts \"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq '.required_status_checks.contexts // []')\" '(.required_status_checks.contexts // []) as $a | ($a | sort) == ($expected_contexts | sort)' >/dev/null 2>&1; then\n  1066\t    echo \"verify FAIL: contexts order-equivalent comparison failed (expected: ${EXPECTED_CHECKS_CONTEXTS}; got: ${CHECKS_CONTEXTS})\" >&2\n  1067\t    FAIL=1\n  1068\t  fi\n  1069\telse\n  1070\t  if [ -n \"$EXPECTED_CHECKS_CONTEXTS\" ]; then\n  1071\t    [ \"$CHECKS_CONTEXTS\" = \"$EXPECTED_CHECKS_CONTEXTS\" ] || { echo \"verify FAIL: contexts missing ${EXPECTED_CHECKS_CONTEXTS} (got: ${CHECKS_CONTEXTS})\" >&2; FAIL=1; }\n  1072\t  else\n  1073\t    [ -z \"$CHECKS_CONTEXTS\" ] || { echo \"verify FAIL: contexts expected to be empty (got: ${CHECKS_CONTEXTS})\" >&2; FAIL=1; }\n  1074\t  fi\n  1075\tfi\n  1076\t[ \"$APPLIED_ADMINS\" = \"$EXPECTED_APPLIED_ADMINS\" ] || { echo \"verify FAIL: enforce_admins=${APPLIED_ADMINS} (expected ${EXPECTED_APPLIED_ADMINS})\" >&2; FAIL=1; }\n  1077\t[ \"$SIGS_ENABLED\" = \"$EXPECTED_SIGS_ENABLED\" ] || { echo \"verify FAIL: required_signatures=${SIGS_ENABLED} (expected ${EXPECTED_SIGS_ENABLED})\" >&2; FAIL=1; }\n  1078\t\n  1079\t# Closes 020G R2 correctness CORR2-001 + safety SAF-R2-002: only\n  1080\t# emit \"verification passed\" when FAIL=0. Previously this line\n  1081\t# emitted unconditionally after the fall-through, producing a\n  1082\t# misleading false-success message on stdout when verification had\n  1083\t# actually failed.\n  1084\tif [ \"${FAIL:-0}\" -ne 0 ]; then\n  1085\t  echo \"verification failed; see message(s) above\" >&2\n  1086\t  echo \"\" >&2\n  1087\t  echo \"Even on failure, capture an invocation log entry so the audit trail\" >&2\n  1088\t  echo \"records the failure. The before/after blocks below show the partial\" >&2\n  1089\t  echo \"state and aid post-mortem.\" >&2\n  1090\t  # fall through to log emission so an audit entry exists\n  1091\telse\n  1092\t  log \"verification passed ✓\"\n  1093\t  log \"  required check:        ${CHECKS_CONTEXTS} (strict=${CHECKS_STRICT})\"\n  1094\t  log \"  enforce_admins:        ${APPLIED_ADMINS}\"\n  1095\t  log \"  required_signatures:   ${SIGS_ENABLED}\"\n  1096\tfi\n  1097\t\n  1098\t# ---------- Emit invocation log ----------\n  1099\t#\n  1100\t# Per 020G R1 safety SAF-001 + correctness CORR-002:\n  1101\t# the audit trail records the SHA256 of the actually-running\n  1102\t# script content (not the last-committed git SHA, which can lie if\n  1103\t# the operator has uncommitted changes or runs from outside an SCP\n  1104\t# clone). The git-SHA is recorded as a secondary identifier when\n  1105\t# available.\n  1106\t\n  1107\t# Self-hash via $0. Exits non-zero only if the script can't read\n  1108\t# itself, which is essentially impossible at this point.\n  1109\tSCRIPT_PATH=\"$(readlink -f \"$0\" 2>/dev/null || printf '%s' \"$0\")\"\n  1110\tSCRIPT_SHA256=\"$(shasum -a 256 \"$SCRIPT_PATH\" | awk '{print $1}')\"\n  1111\t\n  1112\t# Try to also report the last-committed git SHA if we're inside an\n  1113\t# SCP-shaped clone. Empty fallback is explicit.\n  1114\tSCRIPT_GIT_SHA=\"$(git -C \"$(dirname \"$SCRIPT_PATH\")\" log -1 --format=%H -- \"$(basename \"$SCRIPT_PATH\")\" 2>/dev/null || true)\"\n  1115\tSCRIPT_GIT_SHA=\"${SCRIPT_GIT_SHA:-not-in-git-clone}\"\n  1116\t\n  1117\tOPERATOR=\"$(gh api user --jq '.login' 2>/dev/null || echo unknown)\"\n  1118\tTS=\"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"\n  1119\t\n  1120\tLOG_FILE=\"docs/reviews/WP-SCP-020/branch-protection-log.md\"\n  1121\t\n  1122\t# Emit the log block. Use ~~~~ outer fence so inner ``` JSON\n  1123\t# fences nest correctly (CommonMark requires the closing fence\n  1124\t# to match the opening fence character; fence types ~~~ and ```\n  1125\t# do not collide). Closes 020G R1 correctness CORR-001.\n  1126\t\n  1127\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n  1128\t  cat <<EOF\n  1129\t---\n  1130\t\n  1131\t## Invocation log entry\n  1132\t\n  1133\tAppend the block below to ${LOG_FILE} on the SCP repo, commit on\n  1134\ta feature branch, open PR, merge:\n  1135\t\n  1136\t~~~markdown\n  1137\t### ${TS} — ${REPO}@${BRANCH}\n  1138\t\n  1139\t- **Operator:** @${OPERATOR}\n  1140\t- **Script SHA256:** \\`${SCRIPT_SHA256}\\` (hash of executed file)\n  1141\t- **Script git SHA:** \\`${SCRIPT_GIT_SHA}\\` (last committed; \"not-in-git-clone\" if N/A)\n  1142\t- **Required check:** \\`${RESTORE_TARGET_CHECKS_CONTEXTS_LOG}\\`\n  1143\t- **enforce_admins:** ${RESTORE_TARGET_ADMINS_ENABLED}\n  1144\t- **Plan-only:** no\n  1145\t- **Restore mode:** yes${RESTORE_CAUTION_LINES_BLOCK}\n  1146\t- **Restoring TO:**\n  1147\t\\`\\`\\`json\n  1148\t$(printf '%s' \"$RESTORE_TARGET_JSON\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$RESTORE_TARGET_JSON\")\n  1149\t\\`\\`\\`\n  1150\t- **Before:**\n  1151\t\\`\\`\\`json\n  1152\t$(printf '%s' \"$BEFORE_JSON\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$BEFORE_JSON\")\n  1153\t\\`\\`\\`\n  1154\t- **After:**\n  1155\t\\`\\`\\`json\n  1156\t$(printf '%s' \"$AFTER_JSON\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$AFTER_JSON\")\n  1157\t\\`\\`\\`\n  1158\t~~~\n  1159\t\n  1160\tThe log commit is part of the invocation procedure per WP-SCP-020\n  1161\t§4 020G(iii) + D-035; without it the apply is unrecorded.\n  1162\tEOF\n  1163\telse\n  1164\t  cat <<EOF\n  1165\t---\n  1166\t\n  1167\t## Invocation log entry\n  1168\t\n  1169\tAppend the block below to ${LOG_FILE} on the SCP repo, commit on\n  1170\ta feature branch, open PR, merge:\n  1171\t\n  1172\t~~~markdown\n  1173\t### ${TS} — ${REPO}@${BRANCH}\n  1174\t\n  1175\t- **Operator:** @${OPERATOR}\n  1176\t- **Script SHA256:** \\`${SCRIPT_SHA256}\\` (hash of executed file)\n  1177\t- **Script git SHA:** \\`${SCRIPT_GIT_SHA}\\` (last committed; \"not-in-git-clone\" if N/A)\n  1178\t- **Required check:** \\`${REQUIRED_CONTEXT}\\`\n  1179\t- **enforce_admins:** ${ENFORCE_ADMINS}\n  1180\t- **Plan-only:** no\n  1181\t${GATE2_CAUTION_LINE}\n  1182\t${WRAPPER_INACCESSIBLE_CAUTION_LINE}\n  1183\t- **PUT payload applied:**\n  1184\t\\`\\`\\`json\n  1185\t$(printf '%s' \"$PAYLOAD\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$PAYLOAD\")\n  1186\t\\`\\`\\`\n  1187\t- **Before:**\n  1188\t\\`\\`\\`json\n  1189\t$(printf '%s' \"$BEFORE_JSON\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$BEFORE_JSON\")\n  1190\t\\`\\`\\`\n  1191\t- **After:**\n  1192\t\\`\\`\\`json\n  1193\t$(printf '%s' \"$AFTER_JSON\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$AFTER_JSON\")\n  1194\t\\`\\`\\`\n  1195\t~~~\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/adoption/ADOPT-001-project-onboarding.md | sed -n '360,560p'; printf '\\\\n---\\\\n'; nl -ba docs/reviews/WP-SCP-024/024B-extras/DISPATCH-NOTE.md | sed -n '1,240p'; printf '\\\\n---\\\\n'; nl -ba docs/DECISIONS.md | sed -n '1,220p'; printf '\\\\n---\\\\n'; nl -ba policies/VERSIONING.md | sed -n '1,220p'; printf '\\\\n---\\\\n'; nl -ba STATUS.md | sed -n '1,220p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/adoption/ADOPT-001-project-onboarding.md | sed -n '360,560p'; printf '\\\\n---\\\\n'; nl -ba docs/reviews/WP-SCP-024/024B-extras/DISPATCH-NOTE.md | sed -n '1,240p'; printf '\\\\n---\\\\n'; nl -ba docs/DECISIONS.md | sed -n '1,220p'; printf '\\\\n---\\\\n'; nl -ba policies/VERSIONING.md | sed -n '1,220p'; printf '\\\\n---\\\\n'; nl -ba STATUS.md | sed -n '1,220p'\"","aggregated_output":"   360\t### 11.1 Approved modes (closed set)\n   361\t\n   362\tCustom modes are not permitted; a new mode requires a standards\n   363\tchange. The static evaluator scans for the implementation-marker\n   364\tpatterns listed below; Node/Go services must produce source patterns\n   365\tmatching the same substrings to satisfy the code-pattern scan.\n   366\t\n   367\t| Mode ID | Use | Shape | Implementation markers |\n   368\t|---------|-----|-------|------------------------|\n   369\t| `mode.user_oidc` | Browser flows | Control Tower OIDC + JWKS verification + `aud=<app-id>` claim + httpOnly cookie session | `ControlTowerAuth`, `ct_auth.`, `create_bff_routes`, `CT_JWKS_URL` |\n   370\t| `mode.service_rs256` | Service-to-service (target state; replaces HS256) | S2S RS256 + required `aud` claim + JWKS verification | `algorithms=[\"RS256\"]`, `algorithms=['RS256']`, `algorithm=\"RS256\"`, `algorithm='RS256'` |\n   371\t| `mode.api_key` | Agents, CLIs, machine callers | Control Tower-issued agent key, revocable via CT, `X-API-Key` header | `X-API-Key`, `x-api-key` |\n   372\t| `mode.bearer_legacy` | Deprecated. Pre-SVC-003 raw bearer token | Requires per-service migration waiver with explicit `deprecation_close_date` | `secrets.compare_digest` |\n   373\t\n   374\tThe reference implementation for `mode.user_oidc` is SCP's own\n   375\tservice at `src/standards_control_plane/service.py` (commit\n   376\t`66ba8a4`): vendored `ct_auth` wheel, `ControlTowerAuth` with\n   377\t`jwks_url` + `audience`, `create_bff_routes` for the cookie session\n   378\tflow.\n   379\t\n   380\t### 11.2 Consumer track: calling SCP (or any SVC-003 service)\n   381\t\n   382\tFind the target service's `services.yml` (SCP's lives at the root of\n   383\t`standards-control-plane`). The `auth_contract.accepted_modes` list\n   384\ttells you which headers your caller must send.\n   385\t\n   386\t- **Browser**: perform the Control Tower OIDC login flow at the\n   387\t  service's `/auth/login`; subsequent requests carry the httpOnly\n   388\t  cookie session the BFF sets. No explicit header from your code.\n   389\t- **Machine caller (`mode.api_key`)**: request an agent key from\n   390\t  Control Tower's agent-key admin surface and send\n   391\t  `X-API-Key: <key>` on every request. Keys are revocable via CT.\n   392\t- **Machine caller (`mode.bearer_legacy`, deprecated)**: during the\n   393\t  deprecation window (close date per D-019 is 2026-06-30), send\n   394\t  `Authorization: Bearer <token>` using the token the target service\n   395\t  configured via `--auth-token`. Plan your migration to\n   396\t  `mode.api_key` before the close date — after it, SVC-003 fires\n   397\t  `bearer-legacy-close-date-passed` on the target service.\n   398\t- **S2S caller (`mode.service_rs256`)**: mint an RS256 JWT with\n   399\t  `aud` set to the target service's `services.yml` key and send it\n   400\t  in the Authorization header.\n   401\t\n   402\tThe producer subsections below describe the shape a service\n   403\tpublishes; as a consumer, you only need the declaration's mode list\n   404\tand the issuance endpoint for each mode.\n   405\t\n   406\t### 11.3 Producer track: upgrading a pre-SVC-003 services.yml\n   407\t\n   408\tIf your repo already has a `services.yml` from WP-SCP-018 or earlier\n   409\tand it has no `auth_contract` block, SVC-003's auto-check will fire\n   410\t`missing-auth-contract` against every non-planned service. The\n   411\tminimum upgrade:\n   412\t\n   413\t1. Pick the auth mode(s) your service actually accepts today. If it\n   414\t   still uses `--auth-token`, that is `mode.bearer_legacy` and needs\n   415\t   the waiver shape in §11.7.\n   416\t2. Add the `auth_contract` block under each service's\n   417\t   `runtime_contract` (see §11.4–§11.7 for per-mode shape).\n   418\t3. Run `standards-control-plane audit --request <your-request>.json\n   419\t   --domains service-lifecycle` and address any findings.\n   420\t\n   421\tUpgrading one service at a time is supported — other services fire\n   422\ttheir own `missing-auth-contract` until they are declared, but the\n   423\trule scope is per-service.\n   424\t\n   425\t### 11.4 Producer track: mode.user_oidc\n   426\t\n   427\tRegister an OAuth client with Control Tower for each environment\n   428\t(e.g. `my-app`, `my-app-dev`). Control Tower registration covers the\n   429\tredirect URIs and CORS origins; SCP's `docs/deployment.md` §3 is a\n   430\tworked example for reference.\n   431\t\n   432\tSet runtime env vars on the service process:\n   433\t\n   434\t```text\n   435\tAUTH_ENABLED=true\n   436\tCT_BASE_URL=https://control-tower.brokapps.ai\n   437\tCT_APP_ID=my-app-dev\n   438\tPUBLIC_BASE_URL=https://my-app-dev.brokapps.ai\n   439\t```\n   440\t\n   441\t`CT_JWKS_URL` is optional — if unset, it defaults to\n   442\t`<CT_BASE_URL>/api/v1/.well-known/jwks.json`. Override only if your\n   443\tControl Tower deployment publishes JWKS at a non-standard path.\n   444\t\n   445\tDeclare the mode in `services.yml`. The `audience` value must match\n   446\tthe service's `services.yml` key in the target environment. SCP\n   447\tsolves the \"local key vs staging key\" mismatch by using distinct\n   448\tservice keys per environment (e.g. `scp-dev` locally, `scp` in\n   449\tstaging); adopters should do the same rather than using a shared\n   450\tkey with divergent audiences.\n   451\t\n   452\t```yaml\n   453\tservices:\n   454\t  my-app-dev:\n   455\t    healthcheck: /health\n   456\t    local:\n   457\t      status: ready\n   458\t      runtime_contract:\n   459\t        # ... SVC-001 fields ...\n   460\t        auth_contract:\n   461\t          accepted_modes:\n   462\t            - mode: mode.user_oidc\n   463\t              audience: my-app-dev\n   464\t              jwks_url: https://control-tower.brokapps.ai/api/v1/.well-known/jwks.json\n   465\t```\n   466\t\n   467\tIn Python services, reuse the vendored `ct_auth` wheel:\n   468\t\n   469\t```python\n   470\tfrom ct_auth.bff import create_bff_routes\n   471\tfrom ct_auth.fastapi import ControlTowerAuth\n   472\t\n   473\tauth = ControlTowerAuth(jwks_url=CT_JWKS_URL, audience=CT_APP_ID)\n   474\tcreate_bff_routes(app, auth=auth, ...)\n   475\t```\n   476\t\n   477\tNode/Go services need the equivalent OIDC + JWKS implementation.\n   478\tThe code-pattern scan is substring-based on the markers in the\n   479\t§11.1 table; non-Python services must emit matching patterns or\n   480\taccept impl-missing findings as waivers.\n   481\t\n   482\t### 11.5 Producer track: mode.api_key\n   483\t\n   484\t**Status (as of 2026-04-18):** ratified and admin-surface-live but\n   485\toperational-doc pending. Adopters should not plan immediate\n   486\tproduction migration to `mode.api_key` yet.\n   487\t\n   488\tConcretely, per the CT 2026-04-18 audit\n   489\t(`control-tower/governance/docs/notifications/SCP-FOLLOWUP-2026-04-18-admin-ui-audit.md`):\n   490\t\n   491\t- CT's service-account + API-key backend (`CT-016`) is shipped.\n   492\t- The admin UI (create / list / revoke / rotate service-account keys,\n   493\t  7-day rotation overlap window, audit logging) is live today.\n   494\t- The **operational doc** (`CT_AGENT_KEY_OPS.md`) covering default\n   495\t  expiry, rotation cadence, revocation path, scope model, audit-log\n   496\t  format, and `mode.api_key` vs `mode.service_rs256` discrimination\n   497\t  is **not yet published** — CT-led authoring, target mid-to-late\n   498\t  May 2026.\n   499\t- Until the ops doc publishes, production adoption of `mode.api_key`\n   500\t  has undefined operational characteristics (key rotation timing,\n   501\t  expiry defaults, rate limits). Declaring the mode is fine; routing\n   502\t  real traffic through it is not advised.\n   503\t\n   504\tFor services currently on `mode.bearer_legacy` with a deprecation\n   505\twaiver, stay on the waiver track until the ops doc publishes. The\n   506\t2026-05-31 D-019 checkpoint\n   507\t(`docs/reviews/WP-SCP-019/d019-may31-checkpoint.md`) governs whether\n   508\tthe 2026-06-30 close date stands or is amended to 2026-09-30.\n   509\t\n   510\tWhen the ops doc publishes, request that Control Tower register the\n   511\tservice (or SCP, if running a shared SCP instance) as an agent-key\n   512\tissuer. SCP itself is tracked as an SCP-071 dependency.\n   513\t\n   514\tDeclaration shape:\n   515\t\n   516\t```yaml\n   517\tauth_contract:\n   518\t  accepted_modes:\n   519\t    - mode: mode.api_key\n   520\t      issuer: control-tower\n   521\t```\n   522\t\n   523\tMachine callers pass `X-API-Key: <key>` on every request. Agent keys\n   524\tare issued and revoked via Control Tower's agent-key admin surface\n   525\t(not via services.yml edits).\n   526\t\n   527\t### 11.6 Producer track: mode.service_rs256\n   528\t\n   529\tTarget state for in-estate S2S calls; replaces the HS256 tokens used\n   530\tby pre-WP-SCP-019 services. The declaration shape matches\n   531\t`mode.user_oidc` (audience + jwks_url):\n   532\t\n   533\t```yaml\n   534\tauth_contract:\n   535\t  accepted_modes:\n   536\t    - mode: mode.service_rs256\n   537\t      audience: my-app\n   538\t      jwks_url: https://control-tower.brokapps.ai/api/v1/.well-known/jwks.json\n   539\t```\n   540\t\n   541\tVerifying services validate `aud == \"<services.yml key>\"` and the\n   542\tRS256 signature against the JWKS endpoint.\n   543\t\n   544\t### 11.7 Producer track: mode.bearer_legacy (deprecated)\n   545\t\n   546\tThe `--auth-token <token>` flag that shipped in WP-SCP-018 is now\n   547\tclassified as `mode.bearer_legacy`. Services still using this path\n   548\tmust:\n   549\t\n   550\t1. Declare the mode in `services.yml` with both\n   551\t   `deprecation_close_date` (an ISO date) and `waiver_ref` (the\n   552\t   `waiver_id` of a record in `output/findings/waivers.json`).\n   553\t2. Register the waiver in `output/findings/waivers.json` with\n   554\t   `approved_by`, `created_at`, and `expires_at` at or before the\n   555\t   close date.\n   556\t3. Draft and track a migration plan to either `mode.api_key`\n   557\t   (Control Tower-issued agent keys, for most machine callers) or\n   558\t   `mode.service_rs256` (CT-signed S2S JWT, for high-throughput or\n   559\t   inter-service callers where a CT round-trip per request is a\n   560\t   latency-budget problem) by the close date. `mode.bearer_legacy`\n\n---\n     1\t# DISPATCH-NOTE — WP-SCP-024 slice 024B-extras\n     2\t\n     3\t**Date:** 2026-05-10\n     4\t**Branch:** `feature/wp-scp-024-024b-extras` (off main, after 024B-core merges)\n     5\t**Predecessor:** WP-SCP-024 024B-core (merged at 249aa9f). Original 024B work preserved at `feature/wp-scp-024-024b-extras-parking`. Split per `docs/reviews/WP-SCP-024/024B-core/SCOPE-CORRECTION-2026-05-09.md`.\n     6\t**Successor target:** WP-SCP-024 024C PIM canary cascade.\n     7\t**Decision filed:** D-047.\n     8\t\n     9\t`cascade-status: not applicable` — this slice ships rollback + break-glass + CI wiring; not a cohort cascade slice.\n    10\t\n    11\t## Backstory\n    12\t\n    13\t024B-core merged at 249aa9f shipped scaffolder + adopter wrapper template + cascade-status CI enforcement script (CLI) + tests. This slice (024B-extras) ships the deferred deliverables.\n    14\t\n    15\tCarry-forward findings from extras-parking R8-archive (preserved in `feature/wp-scp-024-024b-extras-parking`):\n    16\t- **R8-CORR-001** (extras-parking): cascade-status regex first-match captures trailing inline prose. **CLOSED in 024B-core** via single-pass regex with full-value capture + closed-set validation.\n    17\t- **R8-CORR-002** (extras-parking): prior-entry detection runs outside restore-mode guard, emitting spurious contradiction message. **APPLIES TO 024B-EXTRAS** — ensure restore-mode guard scoping is tight.\n    18\t- **R8-CORR-003** (extras-parking): TF-ticket match pattern parameterises over canonicalised slug instead of plan-doc §2 invariant 2 literal regex. **CLOSED in 024B-core** (slug canonicalisation now spec-compliant).\n    19\t\n    20\t## Why\n    21\t\n    22\t024B-core delivered the WHAT (scaffolder + template + CI script + tests). This slice delivers the HOW (rollback + break-glass + CI integration):\n    23\t\n    24\t1. **`enable-required-check.sh --restore` mode** proves invariant 7's <30-min rollback SLO is real, not aspirational. Operator-interactive demo at step 7 is merge-blocking AC and is recorded through the placeholder evidence path until the operator completes the real-repo round-trip.\n    25\t2. **ADOPT-001 §12.8 break-glass procedure** documents the 3-gate playbook for federation-primitive failure recovery.\n    26\t3. **`.github/workflows/check-invocation-log-entry.yml`** wires the CLI script (shipped in 024B-core) into GitHub Actions so cohort cascade slices 024C–F have automated CI enforcement.\n    27\t\n    28\tWithout 024B-extras, 024C cannot open. Plan-doc §6 cohort dispatcher precondition: 024C entry gates on BOTH 024B-core + 024B-extras merging + TF-024B-REQCHECK-ENABLE-001 closure (required-status-check `check-invocation-log-entry / check-invocation-log-entry` enabled on SCP main via `gh api PATCH repos/jrnb2024/standards-control-plane-/branches/main/protection`), plus FUP-ACC-INSTALL-TARGET-REPO-001 closure.\n    29\t\n    30\t## Scope (in)\n    31\t\n    32\t| Deliverable | Path | Notes |\n    33\t|---|---|---|\n    34\t| `enable-required-check.sh --restore` mode | `scripts/enable-required-check.sh` (modify) | New `--restore <pre-state.json>` flag reverses prior branch-protection mutation per plan-doc invariant 7. Existing forward-mode unchanged. **Key behaviours per extras-parking lessons:** (a) GET-shape JSON transformed to PUT-shape via Python helper (strips `_links`, `url`, `checks`, `required_signatures`); (b) `required_signatures` reset via dedicated DELETE/POST sub-resource calls; (c) APPLY_FAIL=0 wrap pattern (failed PUT continues to log emission); (d) posture-degradation flags `--i-understand-restore-removes-admin-enforcement`, `--i-understand-restore-removes-required-checks`, `--i-understand-restore-disables-required-signatures`, `--i-understand-restore-re-enables-force-pushes`, and `--i-understand-restore-re-enables-deletions` required when before-state would remove or re-enable those protections; (e) restore log block captures actual pre-restore state via `gh api -X GET` BEFORE PUT (not just the target good-state). |\n    35\t| Forward-mode safety check | `scripts/enable-required-check.sh` (modify) | Refuses forward-mode invocation against repo with no successful `policy-check` workflow run on default branch in last 60 days. **Critical (R8 + R9 lessons):** workflow lookup by `path == \".github/workflows/policy-check-wrapper.yml\"` (NOT by display name); query workflow-runs API WITHOUT `&branch=` filter (PR-triggered runs have head-branch = feature branch, not default; branch filter defeats gate). `--i-understand-this-repo-has-no-prior-green-ci` flag for cold-start. |\n    36\t| `--expected-wrapper-sha` flag | `scripts/enable-required-check.sh` (modify) | Validates supplied SHA against actual git tags via `gh api repos/jrnb2024/standards-control-plane-/git/refs/tags/<tag>` (NOT just 40-char shape match). Used by Gate 3 of break-glass. **Mutex with `--i-understand-this-repo-has-no-prior-green-ci`** (R7 SAFE-MAJ-001 closure). |\n    37\t| ADOPT-001 §12.8 break-glass procedure | `docs/adoption/ADOPT-001-project-onboarding.md` (modify) | New §12.8 (between §12.7.15 and §13). 3-gate playbook: Gate 1 (DISABLE via `--restore` capturing pre-break SHA); Gate 2 (FIX via SHA-pin to last known-good release tag — concrete `gh api .../tags/<tag>` resolution; NOT illustrative); Gate 3 (RE-ENABLE via Renovate-bumped fix release + `--expected-wrapper-sha <release-tag-sha>` REQUIRED — not optional/advisory). SLO <30 min from operator decision to merge-restored state. WARNING + CAUTION callouts for `--i-understand-no-gate-2-verification` escape hatch. |\n    38\t| `.github/workflows/check-invocation-log-entry.yml` | NEW file | CI workflow wiring for the CLI script (shipped in 024B-core). Triggers on `pull_request: [opened, synchronize, reopened]` against main with path filter targeting `docs/reviews/WP-SCP-024/024[C-Z]*/**` + `docs/reviews/WP-SCP-020/branch-protection-log.md` + `STATUS.md`. **paths: `docs/reviews/WP-SCP-024/024[C-Z]*/**`** plus explicit `branch-protection-log.md` / `STATUS.md` triggers and job-body short-circuit: if `gh pr diff --name-only` finds no cascade-slice `DISPATCH-NOTE.md`, or the resolved slice is tooling (`024A`, `024B-core`, `024B-extras`, `024G`), the job exits 0 immediately. This closes the bootstrap defect from extras-parking R7 without permitting cohort slices to bypass enforcement. SHA-pinned actions (per D-038 supply-chain hardening). Single job invokes `scripts/check-invocation-log-entry.sh --diff-base origin/main --dispatch-note <found> --status-md STATUS.md --branch-protection-log docs/reviews/WP-SCP-020/branch-protection-log.md`. Required-status-check eligible. |\n    39\t| `--restore` mode tests | `tests/check_invocation_log/test_check_invocation_log_entry.sh` (modify) | Add `run_restore_case` + `make_restore_fake_gh` helpers (mirrors extras-parking patterns). Tests: GET→PUT shape transform; APPLY_FAIL pattern (failed PUT still emits log); posture-degradation flag enforcement; `required_signatures` POST + DELETE sub-resource handling; required-signatures removal acknowledgement flag; absolute path normalisation; --expected-wrapper-sha tag-validation (release-tag SHA → exit 0; arbitrary SHA → exit 2); --restore + forward-mode-flag incompatibility (--no-enforce-admins, --plan, --i-understand-this-bypasses-the-gate, --expected-wrapper-sha + --i-understand-this-repo-has-no-prior-green-ci). |\n    40\t| D-047 row | `docs/DECISIONS.md` | New decision ratifying --restore mode operational contract + ADOPT-001 §12.8 break-glass procedure + CI workflow wiring. |\n    41\t| STATUS.md update | `STATUS.md` | \"Today's chain (2026-05-10 — slice 024B-extras)\" entry. |\n    42\t| **Step 7 operator-interactive demo evidence** | `docs/reviews/WP-SCP-024/024B-extras/restore-roundtrip-evidence-PLACEHOLDER.md` | **MERGE-BLOCKING.** Operator-interactive after R-fixpoint reached. Real-repo round-trip on throw-away test repo: create test repo → invoke `enable-required-check.sh` forward-mode → capture pre-state → invoke `--restore` mode → verify key protected fields comparison (strict, contexts, enforce_admins.enabled, required_signatures.enabled) via jq after stripping GitHub envelope fields (timestamps, _links, url, contexts_url) → commit evidence. NOT a dry-run mock. The placeholder path is the handoff target until the operator completes the demo. Closes plan-doc invariant 7 SLO + 024A R1 MAJ-SAFE-003. |\n    43\t\n    44\t## Scope (out)\n    45\t\n    46\t- 024C PIM cascade kickoff. Unblocked when this slice merges + FUP-ACC-INSTALL-TARGET-REPO-001 closes.\n    47\t- TF-023E-002 closure. Carry-forward.\n    48\t- D-021 May-31 atomic-workday filing. Independent track.\n    49\t\n    50\t## Carry-forward known findings (from extras-parking r8-archive)\n    51\t\n    52\tThese were surfaced in extras-parking R8 but not closed at parking time. Address proactively in this slice:\n    53\t\n    54\t1. **R8-SAFE-001** (extras-parking): `--i-understand-no-gate-2-verification` is a backdoor; D-044 trust-model claim 'Gate 2 wrapper-SHA pin is explicit operator consent' becomes inaccurate when bypassed. Mitigation: WARNING + CAUTION callouts in ADOPT-001 §12.8 + log-block CAUTION line + D-047 rationale acknowledging escape hatch.\n    55\t2. **R8-SAFE-002** (extras-parking): Gate 3 forward-mode prior-entry detection misses uncommitted Gate-1 entries. Mitigation: also check working-tree diff via `git diff HEAD branch-protection-log.md`.\n    56\t3. **R8 Bootstrap** (extras-parking): workflow self-blocks introducing slice's own PR. **CLOSED in 024B-extras** via paths-ignore `024[AB]*/**` + `STATUS.md` / branch-protection-log ignores + job-body short-circuit on tooling slices or missing cascade-slice DISPATCH-NOTE.\n    57\t\n    58\t## Acceptance criteria\n    59\t\n    60\t- [ ] `--restore` mode logic correct (GET→PUT transform; APPLY_FAIL; posture-degradation flags; required_signatures sub-resource; pre-restore state capture; restore log block).\n    61\t- [ ] Forward-mode safety check uses path-pinned workflow lookup (not display name) + no branch filter on workflow-runs API.\n    62\t- [ ] `--expected-wrapper-sha` validates against git tags, and Gate 3 requires it when prior restore evidence exists.\n    63\t- [ ] ADOPT-001 §12.8 break-glass procedure: 3-gate playbook with REQUIRED (not advisory) prerequisite checks; concrete tag-SHA resolution commands; WARNING + CAUTION callouts for escape hatches.\n    64\t- [ ] `.github/workflows/check-invocation-log-entry.yml` wires CLI script with `paths: 024[C-Z]*/**` + explicit branch-protection-log.md / STATUS.md triggers + SHA-pinned actions.\n    65\t- [ ] Tests cover all `--restore` mode behaviours + forward-mode safety check + workflow integration.\n    66\t- [ ] D-047 filed.\n    67\t- [ ] **Operator-interactive `--restore` real-repo round-trip demo evidence committed** (`docs/reviews/WP-SCP-024/024B-extras/restore-roundtrip-evidence-PLACEHOLDER.md`).\n    68\t- [ ] 3-lens R1+R2 fixpoint (0 CRIT + 0 MAJ).\n    69\t- [ ] CI green.\n    70\t- [ ] Self-merge per D-040.\n    71\t\n    72\t## Cross-repo coordination\n    73\t\n    74\tNone for 024B-extras. Cascade-start announcement files at 024C kickoff per plan-doc §5.5.\n    75\t\n    76\t## FLA pilot safety findings reviewed\n    77\t\n    78\tnone new since 2026-05-09 — internal slice; no FLA implications.\n    79\t\n    80\t## Protocol deviation note\n    81\t\n    82\tSame deviation as 024B-core: direct `codex exec` / `claude -p` (kernel hook in ACC only; FUP-ACC-INSTALL-TARGET-REPO-001 still open). Compensating manual steps apply.\n    83\t\n    84\t## Sequencing\n    85\t\n    86\t| Phase | Work | Mode | Wall |\n    87\t|---|---|---|---|\n    88\t| 0 | DISPATCH-NOTE finalised + spec_paths verified | Opus | done (this draft) |\n    89\t| 1 | Codex executor: --restore mode + safety check + --expected-wrapper-sha + ADOPT-001 §12.8 + workflow wiring + tests + D-047 + STATUS | Codex T3 | ~45 min |\n    90\t| 2 | Manual scope check + verify-commands | Opus | ~5 min |\n    91\t| 3 | 3× sequential Sonnet R1 review (64k cap) | Sonnet | ~30 min |\n    92\t| 4 | Fix-rounds (expected 1-2 given carry-forward findings pre-addressed) | Codex + Sonnet | variable |\n    93\t| 5 | **Operator-interactive `--restore` real-repo round-trip demo** | Operator interactive (gh PAT, throw-away test repo) | ~15 min |\n    94\t| 6 | Final R-fixpoint + self-merge | Opus | ~10 min |\n    95\t\n    96\tTarget: 024B-extras merged within ~3-4 hours wall-clock + operator demo gating window.\n    97\t\n    98\t## Reservation guard\n    99\t\n   100\tD-047 reserved for this slice. Codex must NOT assign D-047 to anything else.\n   101\t\n   102\t---\n   103\t\n   104\t**Status:** ACTIVE (post-024B-core merge). Awaiting operator-interactive step-7 evidence completion and R-fixpoint review.\n\n---\n     1\t# Standards Control Plane — Decision Log\n     2\t\n     3\t**Last Updated:** 2026-05-11 (WP-SCP-024 024B-extras R11 hardening; restore CAUTION rendering, Gate 2/3 abort windows, wrapper-tag verification)\n     4\t\n     5\t> **D-021 reservation note (2026-04-28):** D-021 is reserved for the\n     6\t> 2026-05-31 atomic workday filing per WP-SCP-019 hygiene response (PR\n     7\t> #30, 2026-04-21). Codex executors running WP-SCP-022 implementation\n     8\t> slices must NOT assign D-021 to any decision filed during the\n     9\t> autonomous run. The WP-SCP-022 §4.7 gate-enforcement helper\n    10\t> (`scripts/wp_scp_022_gate_check.sh --check-d021`) detects collisions.\n    11\t\n    12\t> **D-041 / D-042 / D-043 reservation note (2026-05-03, plan-doc 023A):**\n    13\t> D-041 is reserved for WP-SCP-023 slice 023B (cross-repo scorecard data\n    14\t> shape + opt-in adopter participation model). D-042 is reserved for\n    15\t> slice 023C (aggregator pipeline trust model — GitHub Actions Artifact\n    16\t> Attestation for adopter emits + SCP-side Ed25519 key registry).\n    17\t> **Mandatory trust constraint on D-042 (closes 023A R2 MAJ-SAFE-R2-001,\n    18\t> per WP-SCP-023 §5 step 3):** the 023C aggregator MUST verify the\n    19\t> `job_workflow_ref` OIDC claim in each artifact attestation against the\n    20\t> SCP reusable workflow path AND SHA pin via `gh attestation verify\n    21\t> --signer-workflow <owner>/<repo>/.github/workflows/policy-check.yml@<sha>`;\n    22\t> OIDC JWKS signature verification alone is not sufficient.\n    23\t> D-043 is reserved for slice 023D (MCP method `scp.consult_scorecard`\n    24\t> shape + read-only contract). Codex executors dispatched for any\n    25\t> WP-SCP-023 implementation slice must NOT assign D-041, D-042, or D-043\n    26\t> to any other decision filed during that slice. The reservation pattern\n    27\t> mirrors the D-021 guard above.\n    28\t\n    29\t> **D-044 / D-045 / D-046 reservation note (2026-05-03, plan-doc 024A):**\n    30\t> D-044 was reserved for WP-SCP-024 slice 024B (`scripts/scaffold-downstream.sh`\n    31\t> = `SCP-073-scaffolder` operational contract + adopter-template versioning\n    32\t> + invocation-log convention extension). It is now filed as ACCEPTED in\n    33\t> 024B-core; the deferred 024B-extras surface carries the `--restore`\n    34\t> rollback mode and workflow wiring. D-045 is reserved for slice 024C (estate\n    35\t> cascade ordering canary-first per WP-SCP-024 §5.1, per-adopter\n    36\t> onboarding contract per §5.2, post-bake observation window ≥1 calendar\n    37\t> week + ≥1 Renovate bump cycle per invariant 8, cascade-slice rollback\n    38\t> procedure per invariant 7). D-046 is reserved for slice 024G\n    39\t> (estate-cascade Threshold A criteria + post-Threshold-A maintenance\n    40\t> posture: recurring drift remediation, version-ramp coordination,\n    41\t> departing-adopter procedure; decision on whether `scp.consult_estate_status`\n    42\t> ships standalone or rolls into existing `consult_scorecard`). Codex\n    43\t> executors dispatched for any WP-SCP-024 implementation slice must NOT\n    44\t> assign D-044, D-045, or D-046 to any other decision filed during that\n    45\t> slice. The reservation pattern mirrors the D-021 / D-041–043 guards\n    46\t> above.\n    47\t\n    48\t> **D-047 reservation note (2026-05-10):** D-047 was reserved for WP-SCP-024\n    49\t> 024B-extras (`--restore` + ADOPT-001 §12.8 break-glass + CI workflow wiring);\n    50\t> now consumed and filed.\n    51\t\n    52\t| ID | Date | Decision | Status | Rationale |\n    53\t|----|------|----------|--------|-----------|\n    54\t| D-001 | 2026-04-11 | Use Python for the phase 1 CLI-first implementation | ACCEPTED | Fast path to explicit schemas, local tooling, JSON validation, and deterministic file-based execution |\n    55\t| D-002 | 2026-04-11 | Keep the project as a standalone app rather than extending docs-agent or Control Tower directly | ACCEPTED | Keeps evaluator runtime independent while still allowing later integration with both systems |\n    56\t| D-003 | 2026-04-11 | Limit the first governed implementation slice to standards registry loading, minimal findings loading, and consult retrieval | ACCEPTED | Keeps the first end-to-end work package narrow enough to review rigorously while still allowing real consult output |\n    57\t| D-004 | 2026-04-11 | Introduce an explicit project-area intermediate representation before evaluator implementation | ACCEPTED | Keeps evaluator inputs deterministic, testable, and independent from raw repo sprawl |\n    58\t| D-005 | 2026-04-11 | Wire governance evaluation through the audit CLI before attempting architecture evaluation | ACCEPTED | Establishes one real evaluator path end to end before widening the audit surface |\n    59\t| D-006 | 2026-04-11 | Extend audit and project-area contracts before WP-SCP-003 implementation | ACCEPTED | Governance review evidence and unsupported-domain coverage must be first-class structured data, not implied by prose or raw path scanning |\n    60\t| D-007 | 2026-04-11 | Use an explicit unattended-delivery protocol for the remaining programme | ACCEPTED | The remaining work should continue without waiting for user answers, using documented default decisions, bounded review loops, and backlog carry-forward for non-blocking residuals |\n    61\t| D-008 | 2026-04-12 | Use explicit file-content signal heuristics for phase-1 architecture evaluation | ACCEPTED | The architecture slice needs deterministic, test-backed checks against repo-local evidence rather than broad semantic inference or prompt-only judgement |\n    62\t| D-009 | 2026-04-12 | Add a second repo-backed fixture corpus for architecture signal coverage | ACCEPTED | `ARCH-003` and `ARCH-004` need concrete repo-backed sample files instead of synthetic payload-only tests if the slice is going to prove its own honesty |\n    63\t| D-010 | 2026-04-12 | Reconcile findings by deterministic finding ID and area-scoped audit coverage | ACCEPTED | Findings persistence must refresh and resolve records only inside the audited area and evaluated domains so unrelated history is not disturbed |\n    64\t| D-011 | 2026-04-12 | Guard findings persistence with scope-collision checks and per-file atomic replacement plus rollback | ACCEPTED | Persisted lifecycle state must fail on `finding_id` scope collisions and should avoid half-written files without pretending phase 1 has a crash-safe multi-file transaction |\n    65\t| D-012 | 2026-04-12 | Bind generated report and area-summary timestamps to the current audit timestamp | ACCEPTED | Report outputs need byte-stable reruns and freshness checks, so they should reuse `audit_result.generated_at` rather than inventing wall-clock timestamps |\n    66\t| D-013 | 2026-04-12 | Reuse the current write-flow guarantees for report artifacts and carry true bundled transactions to backlog | ACCEPTED | The reporting slice should stay downstream of the existing persistence guarantees instead of pretending to offer a crash-safe cross-artifact commit in phase 1 |\n    67\t| D-014 | 2026-04-12 | Guard `report` freshness with embedded findings-state signatures as well as audit timestamp | ACCEPTED | A date-bound audit timestamp alone is too weak to detect same-day content drift, so the report needs a stronger freshness check against persisted findings state |\n    68\t| D-015 | 2026-04-12 | Apply waivers as an audit-time overlay rather than embedding waiver rules inside evaluators | ACCEPTED | Evaluators should keep emitting deterministic raw findings so the same checks can be reused with or without waivers, while audit assembly owns exception handling |\n    69\t| D-016 | 2026-04-12 | Centralise score calculation in a shared module and count only active unwaived findings against score | ACCEPTED | Score semantics must be documented, deterministic, and consistent across evaluators and audit assembly, and waived issues should not drag active score down |\n    70\t| D-017 | 2026-04-12 | Use one embedded fenced JSON review-evidence block as the shared contract for governance validation and historical review retrieval | ACCEPTED | One small structured block inside markdown keeps review evidence inspectable in git while avoiding two drifting review-data formats |\n    71\t| D-018 | 2026-04-12 | Keep historical review retrieval as explicit consult output rather than hiding it inside generic guidance text | ACCEPTED | Review history should be visible, bounded, and machine-readable so later consumers can use it without reparsing prose |\n    72\t| D-019 | 2026-04-18 | SVC-003 is declare-a-contract with a closed four-mode set (`mode.user_oidc`, `mode.service_rs256`, `mode.api_key`, `mode.bearer_legacy`); commit `66ba8a4` codifies `mode.user_oidc` with no rework; WP-SCP-018 `--auth-token` classifies as `mode.bearer_legacy` with deprecation close date 2026-06-30 | ACCEPTED | Estate reality has three live token types plus a cookie session flow; a single fixed mechanism breaks machine callers; a closed mode set prevents drift; codifying the existing CT OIDC layer keeps the in-repo auth story consistent without forcing a rework |\n    73\t| D-020 | 2026-04-18 | `_normalise_scope` accepts `request.scope.area_id` as the normaliser hint when `_infer_area_id` raises `AreaIdInferenceError`; mismatched-inference still raises the same way as before | ACCEPTED | Adopters auditing scopes that lack an ENH-style marker (e.g. a root-level `services.yml` dogfood) would otherwise have to plant placeholder enhancement docs to satisfy area-id inference; the narrow relaxation preserves the auditor discipline of catching inferred-vs-claimed mismatches while closing the genuine uninferrable-scope ergonomic gap |\n    74\t| D-022 | 2026-04-21 | Adopt reusable GitHub Actions workflow + OPA/Conftest + Renovate shared preset + required status check with `enforce_admins=true` as the estate's policy federation primitive. Alternatives rejected: `palantir/policy-bot` (GitHub App per org, HCL-not-Rego, no Renovate cascade, no native waiver-overlay); custom control-plane service (build cost, duplicates GH Actions + branch protection primitives) | ACCEPTED | Industry-standard shape; no custom control-plane service required; cheapest path converting SCP from advisory auditor to pre-merge gate; Renovate preset cascade gives \"change one rule → enforce across 10 repos in 24h\"; supports waiver-aware evaluation and structured annotation payloads. Full rationale body in `docs/plans/WP-SCP-020-policy-federation-primitive.md` §10 |\n    75\t| D-023 | 2026-04-21 | Reject multi-agent free-form chat-forum pattern as the agent-coordination venue; adopt structured proposal queue (`docs/reviews/proposals/PROP-NNN.md` + MCP `propose()` tool — initial stub in WP-SCP-021 slice 021E; full adjudication workflow in `WP-SCP-022-proposal-queue`, separately tracked per `docs/plans/WP-SCP-022-implementation-programme-plan.md` §12). Agents never free-form chat with each other; they read SCP's decision records and call SCP's MCP tools | ACCEPTED | Du et al. (ICML 2024, `arxiv 2305.14325`) show multi-agent debate converges to consensus fast including when the consensus is wrong; Anthropic's multi-agent research post reports ~15× token cost with compounding coordination errors; human-on-the-loop literature converges on moderator-as-bottleneck past a few decisions/hour. Proposal-queue pattern scales because the human is on the loop, not in it. Full rationale body in `docs/plans/WP-SCP-020-policy-federation-primitive.md` §10 (decision originator) and `docs/plans/WP-SCP-021-scp-as-mcp-server.md` §10 (`propose()` stub design). Note 2026-04-28: original D-023 forward-referenced \"WP-SCP-022 plan when that WP opens\"; WP-SCP-022 v0.2 is the implementation programme plan, not the proposal-queue WP — the rationale-body expansion lives in the parent plans named here, and the adjudication WP is renamed `WP-SCP-022-proposal-queue` |\n    76\t| D-024 | 2026-04-21 | Adopt Anthropic's Model Context Protocol (MCP) as the estate's agent-to-SCP tool protocol. Transports: stdio (primary, local, trust-the
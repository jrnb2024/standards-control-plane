safety SAF-003: --no-enforce-admins is a serious\n   270\t# foot-gun. Refuse silently unless the explicit acknowledgement\n   271\t# flag is also set. With the flag, escalate to a 5-second pause\n   272\t# + visible warning so the operator who actually means it\n   273\t# can't run on autopilot.\n   274\tif [ \"$ENFORCE_ADMINS\" != \"true\" ]; then\n   275\t  if [ \"$ACK_ADMIN_BYPASS\" -ne 1 ]; then\n   276\t    echo \"error: --no-enforce-admins ignored without --i-understand-this-bypasses-the-gate\" >&2\n   277\t    echo \"       enforce_admins=true is the canonical SCP federation primitive posture.\" >&2\n   278\t    exit 2\n   279\t  fi\n   280\t  echo \"\" >&2\n   281\t  echo \"================================================================\" >&2\n   282\t  echo \"WARNING: --no-enforce-admins applied with explicit acknowledgement.\" >&2\n   283\t  echo \"         This means repository administrators can push directly\" >&2\n   284\t  echo \"         to '$BRANCH' bypassing the SCP policy-check gate.\" >&2\n   285\t  echo \"         5-second pause to allow Ctrl-C...\" >&2\n   286\t  echo \"================================================================\" >&2\n   287\t  sleep 5\n   288\tfi\n   289\t\n   290\t# Path-traversal guard on REPO + BRANCH (per 020G R1 safety SAF-006\n   291\t# + 020G R2 correctness CORR2-002 — `owner/..` would have satisfied\n   292\t# the original regex because `..` matches `[A-Za-z0-9._-]+`).\n   293\t# Repo names match GitHub's ASCII rules; branch names disallow `..`\n   294\t# or leading slashes that could be misread by url joining.\n   295\tcase \"$REPO\" in\n   296\t  .*|*/.*)\n   297\t    echo \"error: --repo '$REPO' contains path-traversal sequence (leading dot or dot-segment after /)\" >&2\n   298\t    exit 2 ;;\n   299\tesac\n   300\tcase \"$REPO\" in\n   301\t  *..*)\n   302\t    echo \"error: --repo '$REPO' contains path-traversal sequence (..)\" >&2\n   303\t    exit 2 ;;\n   304\tesac\n   305\tif ! printf '%s' \"$REPO\" | grep -qE '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$'; then\n   306\t  echo \"error: --repo '$REPO' does not match owner/name shape\" >&2\n   307\t  exit 2\n   308\tfi\n   309\tcase \"$BRANCH\" in\n   310\t  \"\"|*/*|*..*|.*) echo \"error: --branch '$BRANCH' invalid (no slashes, no .., no leading dot)\" >&2; exit 2 ;;\n   311\tesac\n   312\t\n   313\t# Closes 020G R3 safety SAF-R3-002: REQUIRED_CONTEXT is included\n   314\t# verbatim in the emitted markdown log block; backticks or\n   315\t# newlines would corrupt the operator's pasteable log entry. Reject\n   316\t# obvious markdown-injection chars. The actual GitHub Actions\n   317\t# check-run name space is bounded (alphanumerics, slashes, spaces,\n   318\t# hyphens, parentheses) — no legitimate name needs backticks or\n   319\t# newlines.\n   320\tcase \"$REQUIRED_CONTEXT\" in\n   321\t  *'`'*|*$'\\n'*|*$'\\r'*)\n   322\t    echo \"error: --required-check '$REQUIRED_CONTEXT' contains markdown-corrupting chars (backtick, CR, LF)\" >&2\n   323\t    exit 2 ;;\n   324\tesac\n   325\tif [ \"${#REQUIRED_CONTEXT}\" -gt 200 ]; then\n   326\t  echo \"error: --required-check value is ${#REQUIRED_CONTEXT} chars; max 200\" >&2\n   327\t  exit 2\n   328\tfi\n   329\t\n   330\tvalidate_restore_source_json() {\n   331\t  local path=\"$1\"\n   332\t  python3 - \"$path\" <<'PY'\n   333\timport json\n   334\timport sys\n   335\t\n   336\tpath = sys.argv[1]\n   337\ttry:\n   338\t    with open(path) as fh:\n   339\t        data = json.load(fh)\n   340\texcept Exception as exc:  # pragma: no cover - defensive diagnostics\n   341\t    print(f\"error: unable to parse restore pre-state JSON: {exc}\", file=sys.stderr)\n   342\t    sys.exit(2)\n   343\t\n   344\tif not isinstance(data, dict):\n   345\t    print(\"error: restore pre-state JSON must be an object\", file=sys.stderr)\n   346\t    sys.exit(2)\n   347\t\n   348\trequired_types = {\n   349\t    \"required_status_checks\": (dict, type(None)),\n   350\t    \"enforce_admins\": dict,\n   351\t    \"required_pull_request_reviews\": (dict, type(None)),\n   352\t    \"restrictions\": (dict, type(None)),\n   353\t    \"required_signatures\": (dict, type(None)),\n   354\t}\n   355\tfor key, types in required_types.items():\n   356\t    if key not in data:\n   357\t        print(f\"error: restore pre-state JSON missing required key '{key}'\", file=sys.stderr)\n   358\t        sys.exit(2)\n   359\t    if not isinstance(data[key], types):\n   360\t        print(f\"error: restore pre-state JSON key '{key}' has unexpected type\", file=sys.stderr)\n   500\t      }\n   501\t    }\n   502\t    END { exit !found }\n   503\t  '\n   504\t}\n   505\t\n   506\tvalidate_expected_wrapper_sha_against_tags() {\n   507\t  :\n   508\t}\n   509\t\n   510\tcheck_forward_mode_safety() {\n   511\t  local created_since workflow_id workflow_runs_json run_count\n   512\t\n   513\t  if [ \"$NO_PRIOR_GREEN_CI\" -eq 1 ]; then\n   514\t    if prior_restore_evidence_present \"docs/reviews/WP-SCP-020/branch-protection-log.md\" \"${REPO}@${BRANCH}\"; then\n   515\t      echo \"error: --i-understand-this-repo-has-no-prior-green-ci is incompatible with prior restore evidence for ${REPO}@${BRANCH} found in docs/reviews/WP-SCP-020/branch-protection-log.md\" >&2\n   516\t      echo \"       the cold-start escape hatch is for adopters without history; prior-restore evidence indicates a non-cold-start state\" >&2\n   517\t      exit 2\n   518\t    fi\n   519\t    workflow_id=\"$(gh api --paginate \"repos/${REPO}/actions/workflows?per_page=100\" --jq '.workflows[] | select(.path == \"'\"$WORKFLOW_LOOKUP_PATH\"'\") | .id' | head -n1)\"\n   520\t    if [ -n \"$workflow_id\" ]; then\n   521\t      created_since=\"$(python3 - <<'PY'\n   522\tfrom datetime import datetime, timedelta, timezone\n   523\tprint((datetime.now(timezone.utc) - timedelta(days=60)).strftime(\"%Y-%m-%dT%H:%M:%SZ\"))\n   524\tPY\n   525\t)\"\n   526\t      workflow_runs_json=\"$(gh api \"repos/${REPO}/actions/runs?status=success&created=%3E%3D${created_since}&workflow_id=${workflow_id}\")\"\n   527\t      run_count=\"$(printf '%s' \"$workflow_runs_json\" | jq '.workflow_runs | length')\"\n   528\t      if [ \"$run_count\" -gt 0 ]; then\n   529\t        log \"CAUTION: --i-understand-this-repo-has-no-prior-green-ci rejected for ${REPO}@${BRANCH}; successful workflow runs exist\"\n   530\t        echo \"error: --i-understand-this-repo-has-no-prior-green-ci is for cold-start adopters with no successful workflow-runs. Found ${run_count} successful runs on this repo, indicating a non-cold-start state.\" >&2\n   531\t        exit 2\n   532\t      fi\n   533\t    fi\n   534\t    log \"safety check bypassed via --i-understand-this-repo-has-no-prior-green-ci\"\n   535\t    return 0\n   536\t  fi\n   537\t\n   538\t  workflow_id=\"$(gh api --paginate \"repos/${REPO}/actions/workflows?per_page=100\" --jq '.workflows[] | select(.path == \"'\"$WORKFLOW_LOOKUP_PATH\"'\") | .id' | head -n1)\"\n   539\t  if [ -z \"$workflow_id\" ]; then\n   540\t    echo \"error: no workflow with path '$WORKFLOW_LOOKUP_PATH' found in ${REPO}\" >&2\n   541\t    exit 2\n   542\t  fi\n   543\t\n   544\t  created_since=\"$(python3 - <<'PY'\n   545\tfrom datetime import datetime, timedelta, timezone\n   546\tprint((datetime.now(timezone.utc) - timedelta(days=60)).strftime(\"%Y-%m-%dT%H:%M:%SZ\"))\n   547\tPY\n   548\t)\"\n   549\t  workflow_runs_json=\"$(gh api \"repos/${REPO}/actions/runs?status=success&created=%3E%3D${created_since}&workflow_id=${workflow_id}\")\"\n   550\t  run_count=\"$(printf '%s' \"$workflow_runs_json\" | jq '.workflow_runs | length')\"\n   551\t  if [ \"$run_count\" -eq 0 ]; then\n   552\t    echo \"error: no successful workflow runs found for workflow path '$WORKFLOW_LOOKUP_PATH' in the last 60 days\" >&2\n   553\t    echo \"       use --i-understand-this-repo-has-no-prior-green-ci only for cold-start adopters\" >&2\n   554\t    exit 2\n   555\t  fi\n   556\t  log \"safety check: found ${run_count} successful workflow run(s) for ${WORKFLOW_LOOKUP_PATH} in the last 60 days\"\n   557\t}\n   558\t\n   559\tlog() {\n   560\t  printf '[020G] %s\\n' \"$*\"\n   561\t}\n   562\t\n   563\tlog \"target repo: $REPO\"\n   564\tlog \"target branch: $BRANCH\"\n   565\tlog \"required check: $REQUIRED_CONTEXT\"\n   566\tlog \"enforce_admins: $ENFORCE_ADMINS\"\n   567\t[ \"$PLAN_ONLY\" = \"1\" ] && log \"MODE: plan-only (no API mutation)\"\n   568\t\n   569\tif [ \"$RESTORE_MODE\" -eq 0 ]; then\n   570\t  check_forward_mode_safety\n   571\tfi\n   572\t\n   573\t# ---------- Construct PUT payload ----------\n   574\t#\n   575\t# Per 020G R1 correctness CORR-003: required_signatures is a\n   576\t# DEDICATED sub-resource and is NOT a documented field of the\n   577\t# unified branch-protection PUT body. Apply it separately via\n   578\t# the /required_signatures endpoint after the main PUT. The\n   579\t# unified PUT body therefore omits required_signatures.\n   580\t#\n   581\t# Per 020G R1 safety SAF-002: required_pull_request_reviews must\n   582\t# be PRESERVED if it already exists. We capture before-state and\n   583\t# splice the existing review-shape into the PUT payload rather\n   584\t# than nulling it out.\n   585\t\n   586\tbuild_payload() {\n   587\t  local existing_reviews=\"$1\"\n   588\t  jq -n \\\n   589\t    --arg context \"$REQUIRED_CONTEXT\" \\\n   590\t    --argjson admins \"$ENFORCE_ADMINS\" \\\n   591\t    --argjson reviews \"$existing_reviews\" \\\n   592\t    '{\n   593\t       required_status_checks: {\n   594\t         strict: true,\n   595\t         contexts: [$context]\n   596\t       },\n   597\t       enforce_admins: $admins,\n   598\t       required_pull_request_reviews: $reviews,\n   599\t       restrictions: null,\n   600\t       required_linear_history: false,\n   601\t       allow_force_pushes: false,\n   602\t       allow_deletions: false,\n   603\t       block_creations: false,\n   604\t       required_conversation_resolution: false,\n   605\t       lock_branch: false,\n   606\t       allow_fork_syncing: false\n   607\t     }'\n   608\t}\n   609\t\n   610\t# ---------- Capture before-state ----------\n   611\t\n   612\tlog \"capturing before-state...\"\n   613\tBEFORE_RAW=\"$(gh api -X GET \"repos/${REPO}/branches/${BRANCH}/protection\" 2>&1)\" || BEFORE_STATUS=$?\n   614\tBEFORE_STATUS=\"${BEFORE_STATUS:-0}\"\n   615\t\n   616\tif [ \"$BEFORE_STATUS\" -eq 0 ]; then\n   617\t  BEFORE_JSON=\"$BEFORE_RAW\"\n   618\telif printf '%s' \"$BEFORE_RAW\" | grep -q \"Branch not protected\"; then\n   619\t  BEFORE_JSON='{\"_note\":\"no protection currently configured\"}'\n   620\telse\n   621\t  echo \"error: gh api GET branch protection failed; cannot proceed safely\" >&2\n   622\t  echo \"$BEFORE_RAW\" >&2\n   623\t  exit 1\n   624\tfi\n   625\t\n   626\t# Extract existing required_pull_request_reviews, default to null\n   627\t# if absent. Either way, we send what was there.\n   628\tEXISTING_REVIEWS=\"$(printf '%s' \"$BEFORE_JSON\" | jq '.required_pull_request_reviews // null')\"\n   629\t\n   630\t# Per WP-SCP-022 020H pt 3 R3 SAFE-R3-003 closure (2026-04-30):\n   631\t# multi-maintainer adopters MUST set dismiss_stale_reviews: true to\n   632\t# close the post-approval-malicious-push attack surface (see\n   633\t# ADOPT-001 §12.7.4). This script preserves the adopter's existing\n   634\t# review-shape verbatim and does NOT set dismiss_stale_reviews; emit\n   635\t# a stderr WARNING if it is currently false or absent so the operator\n   636\t# is prompted to configure it explicitly.\n   637\tDISMISS_STALE_VAL=\"$(printf '%s' \"$EXISTING_REVIEWS\" | jq -r '\n   638\t  if . == null then \"absent\"\n   639\t  elif (.dismiss_stale_reviews // false) == true then \"true\"\n   640\t  else \"false\"\n   641\t  end\n   642\t')\"\n   643\tif [ \"$DISMISS_STALE_VAL\" != \"true\" ]; then\n   644\t  echo \"[020G] WARNING: required_pull_request_reviews.dismiss_stale_reviews is ${DISMISS_STALE_VAL} on the target repo\" >&2\n   645\t  echo \"[020G] WARNING: multi-maintainer SCP adopters MUST set dismiss_stale_reviews: true (ADOPT-001 §12.7.4)\" >&2\n   646\t  echo \"[020G] WARNING: this script preserves the existing review-shape verbatim and does not set this for you\" >&2\n   647\t  echo \"[020G] WARNING: configure it via 'gh api -X PATCH repos/<owner>/<repo>/branches/<branch>/protection/required_pull_request_reviews -F dismiss_stale_reviews=true'\" >&2\n   648\t  echo \"[020G] WARNING: single-operator adopters with required_approving_review_count=0 (per D-033) can ignore this warning\" >&2\n   649\tfi\n   650\t\n   651\tRESTORE_TARGET_JSON=\"\"\n   652\tRESTORE_PAYLOAD=\"\"\n   653\tRESTORE_SIGNATURES_ENABLED=\"\"\n   654\tRESTORE_TARGET_CHECKS_STRICT=\"\"\n   655\tRESTORE_TARGET_CHECKS_CONTEXTS=\"\"\n   656\tRESTORE_TARGET_CHECKS_CONTEXTS_LOG=\"\"\n   657\tRESTORE_TARGET_ADMINS_ENABLED=\"\"\n   658\tRESTORE_TARGET_FORCE_PUSHES=\"\"\n   659\tRESTORE_TARGET_DELETIONS=\"\"\n   660\tRESTORE_CAUTION_LINES=()\n   661\tRESTORE_CAUTION_LINES_BLOCK=\"\"\n   662\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n   663\t  RESTORE_TARGET_JSON=\"$(cat \"$RESTORE_PRE_STATE\")\"\n   664\t  RESTORE_PAYLOAD=\"$(validate_restore_source_json \"$RESTORE_PRE_STATE\")\"\n   665\t  RESTORE_TARGET_CHECKS_STRICT=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.required_status_checks.strict // false')\"\n   666\t  RESTORE_TARGET_CHECKS_CONTEXTS=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.required_status_checks.contexts // [] | join(\",\")')\"\n   667\t  RESTORE_TARGET_CHECKS_CONTEXTS_LOG=\"$(sanitize_context_for_log \"$RESTORE_TARGET_CHECKS_CONTEXTS\")\"\n   668\t  RESTORE_TARGET_ADMINS_ENABLED=\"$(printf '%s' \"$RESTORE_PAYLOAD\" | jq -r '.enforce_admins // false')\"\n   669\t  RESTORE_TARGET_FORCE_PUSHES=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.allow_force_pushes // false')\"\n   670\t  RESTORE_TARGET_DELETIONS=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.allow_deletions // false')\"\n   671\t  CURRENT_SIGNATURES_ENABLED=\"$(printf '%s' \"$BEFORE_JSON\" | jq -r '.required_signatures.enabled // false')\"\n   672\t  RESTORE_SIGNATURES_ENABLED=\"$(python3 - \"$RESTORE_PRE_STATE\" <<'PY'\n   673\timport json\n   674\timport sys\n   675\t\n   676\twith open(sys.argv[1]) as fh:\n   677\t    data = json.load(fh)\n   678\tenabled = bool(((data.get(\"required_signatures\") or {}).get(\"enabled\", False)))\n   679\tprint(\"true\" if enabled else \"false\")\n   680\tPY\n   681\t)\"\n   682\t  if [ \"$CURRENT_SIGNATURES_ENABLED\" = \"true\" ] && [ \"$RESTORE_SIGNATURES_ENABLED\" = \"false\" ] && [ \"$ACK_RESTORE_SIGNATURES_REMOVAL\" -ne 1 ]; then\n   683\t    echo \"error: restore target disables required signatures; pass --i-understand-restore-disables-required-signatures to continue\" >&2\n   684\t    exit 2\n   685\t  fi\n   686\t  if [ \"$CURRENT_SIGNATURES_ENABLED\" = \"true\" ] && [ \"$RESTORE_SIGNATURES_ENABLED\" = \"false\" ]; then\n   687\t    log \"CAUTION: restore target disables required_signatures; operator acknowledges posture change\"\n   688\t    RESTORE_CAUTION_LINES+=(\"- **CAUTION:** restore target disables required_signatures; operator acknowledges posture change.\")\n   689\t  fi\n   690\t  if [ \"$RESTORE_TARGET_FORCE_PUSHES\" = \"true\" ]; then\n   691\t    if [ \"$ACK_RESTORE_FORCE_PUSHES\" -ne 1 ]; then\n   692\t      echo \"error: restore target re-enables allow_force_pushes; pass --i-understand-restore-re-enables-force-pushes to continue\" >&2\n   693\t      exit 2\n   694\t    fi\n   695\t    log \"CAUTION: restore target re-enables allow_force_pushes; operator acknowledges posture change\"\n   696\t    RESTORE_CAUTION_LINES+=(\"- **CAUTION:** restore target re-enables allow_force_pushes; operator acknowledges posture change.\")\n   697\t  fi\n   698\t  if [ \"$RESTORE_TARGET_DELETIONS\" = \"true\" ]; then\n   699\t    if [ \"$ACK_RESTORE_DELETIONS\" -ne 1 ]; then\n   700\t      echo \"error: restore target re-enables allow_deletions; pass --i-understand-restore-re-enables-deletions to continue\" >&2\n   701\t      exit 2\n   702\t    fi\n   703\t    log \"CAUTION: restore target re-enables allow_deletions; operator acknowledges posture change\"\n   704\t    RESTORE_CAUTION_LINES+=(\"- **CAUTION:** restore target re-enables allow_deletions; operator acknowledges posture change.\")\n   705\t  fi\n   706\tfi\n   707\t\n   708\tPAYLOAD=\"$(build_payload \"$EXISTING_REVIEWS\")\"\n   709\t\n   710\tif [ \"$PLAN_ONLY\" = \"1\" ]; then\n   711\t  log \"current branch-protection state (before):\"\n   712\t  printf '%s\\n' \"$BEFORE_JSON\" | jq .\n   713\t  log \"plan (would PUT to repos/${REPO}/branches/${BRANCH}/protection):\"\n   714\t  printf '%s\\n' \"$PAYLOAD\" | jq .\n   715\t  log \"post-PUT, would also enable required_signatures via the dedicated sub-resource.\"\n   716\t  log \"to apply, re-run without --plan\"\n   717\t  exit 0\n   718\tfi\n   719\t\n   720\t# ---------- Apply ----------\n   721\t\n   722\t# Closes 020G R2 safety SAF-R2-001: trap a non-zero exit during\n   723\t# the apply phase so partial state still emits an audit-trail\n   724\t# log entry. Otherwise `set -e` skips log emission entirely on\n   725\t# any HTTP 403/network failure during the dedicated POST step.\n   726\t\n   727\tAPPLY_FAIL=0\n   728\t\n   729\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n   730\t  if [ \"$RESTORE_TARGET_ADMINS_ENABLED\" = \"false\" ] && [ \"$ACK_RESTORE_ADMIN_REMOVAL\" -ne 1 ]; then\n   731\t    echo \"error: restore target removes admin enforcement; pass --i-understand-restore-removes-admin-enforcement to continue\" >&2\n   732\t    exit 2\n   733\t  fi\n   734\t  if [ \"$RESTORE_TARGET_ADMINS_ENABLED\" = \"false\" ]; then\n   735\t    log \"CAUTION: restore target removes admin enforcement; operator acknowledges posture change\"\n   736\t    RESTORE_CAUTION_LINES+=(\"- **CAUTION:** restore target removes admin enforcement; operator acknowledged via --i-understand-restore-removes-admin-enforcement.\")\n   737\t  fi\n   738\t  restore_contexts=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.required_status_checks.contexts // [] | length')\"\n   739\t  if [ \"$restore_contexts\" -eq 0 ]; then\n   740\t    if [ \"$ACK_RESTORE_REQUIRED_CHECKS_REMOVAL\" -ne 1 ]; then\n   741\t      echo \"error: restore target removes required status checks; pass --i-understand-restore-removes-required-checks to continue\" >&2\n   742\t      exit 2\n   743\t    fi\n   744\t    log \"CAUTION: restore target removes required status checks; operator acknowledges posture change\"\n   745\t    RESTORE_CAUTION_LINES+=(\"- **CAUTION:** restore target removes required status checks; operator acknowledged via --i-understand-restore-removes-required-checks.\")\n   746\t  fi\n   747\t\n   748\t  log \"restoring branch protection (unified PUT)...\"\n   749\t  printf '%s' \"$RESTORE_PAYLOAD\" | gh api -X PUT \"repos/${REPO}/branches/${BRANCH}/protection\" \\\n   750\t    -H \"Accept: application/vnd.github+json\" \\\n   751\t    --input - >/dev/null || APPLY_FAIL=1\n   752\t\n   753\t  if [ \"$APPLY_FAIL\" -ne 0 ]; then\n   754\t    echo \"ERROR: unified PUT failed; partial branch-protection state may exist on ${REPO}@${BRANCH}\" >&2\n   755\t    echo \"       continuing to log emission so the failure is auditable, then exiting non-zero\" >&2\n   756\t    FAIL=1\n   757\t  else\n   758\t    restore_signatures_enabled=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.required_signatures.enabled // false')\"\n   759\t    if [ \"$restore_signatures_enabled\" = \"true\" ]; then\n   760\t      log \"restoring required_signatures (dedicated sub-resource: enable)...\"\n   900\t  log \"  required check:        ${CHECKS_CONTEXTS} (strict=${CHECKS_STRICT})\"\n   901\t  log \"  enforce_admins:        ${APPLIED_ADMINS}\"\n   902\t  log \"  required_signatures:   ${SIGS_ENABLED}\"\n   903\tfi\n   904\t\n   905\t# ---------- Emit invocation log ----------\n   906\t#\n   907\t# Per 020G R1 safety SAF-001 + correctness CORR-002:\n   908\t# the audit trail records the SHA256 of the actually-running\n   909\t# script content (not the last-committed git SHA, which can lie if\n   910\t# the operator has uncommitted changes or runs from outside an SCP\n   911\t# clone). The git-SHA is recorded as a secondary identifier when\n   912\t# available.\n   913\t\n   914\t# Self-hash via $0. Exits non-zero only if the script can't read\n   915\t# itself, which is essentially impossible at this point.\n   916\tSCRIPT_PATH=\"$(readlink -f \"$0\" 2>/dev/null || printf '%s' \"$0\")\"\n   917\tSCRIPT_SHA256=\"$(shasum -a 256 \"$SCRIPT_PATH\" | awk '{print $1}')\"\n   918\t\n   919\t# Try to also report the last-committed git SHA if we're inside an\n   920\t# SCP-shaped clone. Empty fallback is explicit.\n   921\tSCRIPT_GIT_SHA=\"$(git -C \"$(dirname \"$SCRIPT_PATH\")\" log -1 --format=%H -- \"$(basename \"$SCRIPT_PATH\")\" 2>/dev/null || true)\"\n   922\tSCRIPT_GIT_SHA=\"${SCRIPT_GIT_SHA:-not-in-git-clone}\"\n   923\t\n   924\tOPERATOR=\"$(gh api user --jq '.login' 2>/dev/null || echo unknown)\"\n   925\tTS=\"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"\n   926\t\n   927\tLOG_FILE=\"docs/reviews/WP-SCP-020/branch-protection-log.md\"\n   928\t\n   929\t# Emit the log block. Use ~~~~ outer fence so inner ``` JSON\n   930\t# fences nest correctly (CommonMark requires the closing fence\n   931\t# to match the opening fence character; fence types ~~~ and ```\n   932\t# do not collide). Closes 020G R1 correctness CORR-001.\n   933\t\n   934\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n   935\t  cat <<EOF\n   936\t---\n   937\t\n   938\t## Invocation log entry\n   939\t\n   940\tAppend the block below to ${LOG_FILE} on the SCP repo, commit on\n   941\ta feature branch, open PR, merge:\n   942\t\n   943\t~~~markdown\n   944\t### ${TS} — ${REPO}@${BRANCH}\n   945\t\n   946\t- **Operator:** @${OPERATOR}\n   947\t- **Script SHA256:** \\`${SCRIPT_SHA256}\\` (hash of executed file)\n   948\t- **Script git SHA:** \\`$
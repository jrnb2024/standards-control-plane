{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"nl -ba scripts/enable-required-check.sh | sed -n '920,1010p'\"","aggregated_output":"   920\t  if [ \"$AFTER_STATUS\" -eq 0 ]; then\n   921\t    AFTER_JSON=\"$AFTER_RAW\"\n   922\t  else\n   923\t    AFTER_JSON='{\"_error\":\"restore after-state capture failed\"}'\n   924\t    echo \"ERROR: post-restore GET branch-protection failed; continuing to log emission so the failure is auditable\" >&2\n   925\t    APPLY_FAIL=1\n   926\t    FAIL=1\n   927\t  fi\n   928\telse\n   929\t  AFTER_JSON=\"$(gh api -X GET \"repos/${REPO}/branches/${BRANCH}/protection\")\"\n   930\tfi\n   931\t\n   932\tCHECKS_STRICT=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_status_checks.strict // false')\"\n   933\tCHECKS_CONTEXTS=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_status_checks.contexts // [] | join(\",\")')\"\n   934\tAPPLIED_ADMINS=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.enforce_admins.enabled // false')\"\n   935\tSIGS_ENABLED=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_signatures.enabled // false')\"\n   936\t\n   937\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n   938\t  EXPECTED_CHECKS_STRICT=\"$RESTORE_TARGET_CHECKS_STRICT\"\n   939\t  EXPECTED_CHECKS_CONTEXTS=\"$RESTORE_TARGET_CHECKS_CONTEXTS\"\n   940\t  EXPECTED_APPLIED_ADMINS=\"$RESTORE_TARGET_ADMINS_ENABLED\"\n   941\t  EXPECTED_SIGS_ENABLED=\"$RESTORE_SIGNATURES_ENABLED\"\n   942\telse\n   943\t  EXPECTED_CHECKS_STRICT=\"true\"\n   944\t  EXPECTED_CHECKS_CONTEXTS=\"$REQUIRED_CONTEXT\"\n   945\t  EXPECTED_APPLIED_ADMINS=\"$ENFORCE_ADMINS\"\n   946\t  EXPECTED_SIGS_ENABLED=\"true\"\n   947\tfi\n   948\t\n   949\t# Closes 020G R3 correctness CORR3-001 + safety SAF-R3-001:\n   950\t# preserve any FAIL=1 set by the apply-phase trap. Initialising\n   951\t# FAIL=0 unconditionally would launder an apply-failure into a\n   952\t# false-success when the pre-existing state happens to satisfy\n   953\t# the verify checks. Default to 0 only if not already set.\n   954\tFAIL=\"${FAIL:-0}\"\n   955\t[ \"$CHECKS_STRICT\" = \"$EXPECTED_CHECKS_STRICT\" ] || { echo \"verify FAIL: required_status_checks.strict=${CHECKS_STRICT} (expected ${EXPECTED_CHECKS_STRICT})\" >&2; FAIL=1; }\n   956\tif [ -n \"$EXPECTED_CHECKS_CONTEXTS\" ]; then\n   957\t  printf '%s' \"$CHECKS_CONTEXTS\" | grep -q -F \"$EXPECTED_CHECKS_CONTEXTS\" || { echo \"verify FAIL: contexts missing ${EXPECTED_CHECKS_CONTEXTS} (got: ${CHECKS_CONTEXTS})\" >&2; FAIL=1; }\n   958\telse\n   959\t  [ -z \"$CHECKS_CONTEXTS\" ] || { echo \"verify FAIL: contexts expected to be empty (got: ${CHECKS_CONTEXTS})\" >&2; FAIL=1; }\n   960\tfi\n   961\t[ \"$APPLIED_ADMINS\" = \"$EXPECTED_APPLIED_ADMINS\" ] || { echo \"verify FAIL: enforce_admins=${APPLIED_ADMINS} (expected ${EXPECTED_APPLIED_ADMINS})\" >&2; FAIL=1; }\n   962\t[ \"$SIGS_ENABLED\" = \"$EXPECTED_SIGS_ENABLED\" ] || { echo \"verify FAIL: required_signatures=${SIGS_ENABLED} (expected ${EXPECTED_SIGS_ENABLED})\" >&2; FAIL=1; }\n   963\t\n   964\t# Closes 020G R2 correctness CORR2-001 + safety SAF-R2-002: only\n   965\t# emit \"verification passed\" when FAIL=0. Previously this line\n   966\t# emitted unconditionally after the fall-through, producing a\n   967\t# misleading false-success message on stdout when verification had\n   968\t# actually failed.\n   969\tif [ \"${FAIL:-0}\" -ne 0 ]; then\n   970\t  echo \"verification failed; see message(s) above\" >&2\n   971\t  echo \"\" >&2\n   972\t  echo \"Even on failure, capture an invocation log entry so the audit trail\" >&2\n   973\t  echo \"records the failure. The before/after blocks below show the partial\" >&2\n   974\t  echo \"state and aid post-mortem.\" >&2\n   975\t  # fall through to log emission so an audit entry exists\n   976\telse\n   977\t  log \"verification passed ✓\"\n   978\t  log \"  required check:        ${CHECKS_CONTEXTS} (strict=${CHECKS_STRICT})\"\n   979\t  log \"  enforce_admins:        ${APPLIED_ADMINS}\"\n   980\t  log \"  required_signatures:   ${SIGS_ENABLED}\"\n   981\tfi\n   982\t\n   983\t# ---------- Emit invocation log ----------\n   984\t#\n   985\t# Per 020G R1 safety SAF-001 + correctness CORR-002:\n   986\t# the audit trail records the SHA256 of the actually-running\n   987\t# script content (not the last-committed git SHA, which can lie if\n   988\t# the operator has uncommitted changes or runs from outside an SCP\n   989\t# clone). The git-SHA is recorded as a secondary identifier when\n   990\t# available.\n   991\t\n   992\t# Self-hash via $0. Exits non-zero only if the script can't read\n   993\t# itself, which is essentially impossible at this point.\n   994\tSCRIPT_PATH=\"$(readlink -f \"$0\" 2>/dev/null || printf '%s' \"$0\")\"\n   995\tSCRIPT_SHA256=\"$(shasum -a 256 \"$SCRIPT_PATH\" | awk '{print $1}')\"\n   996\t\n   997\t# Try to also report the last-committed git SHA if we're inside an\n   998\t# SCP-shaped clone. Empty fallback is explicit.\n   999\tSCRIPT_GIT_SHA=\"$(git -C \"$(dirname \"$SCRIPT_PATH\")\" log -1 --format=%H -- \"$(basename \"$SCRIPT_PATH\")\" 2>/dev/null || true)\"\n  1000\tSCRIPT_GIT_SHA=\"${SCRIPT_GIT_SHA:-not-in-git-clone}\"\n  1001\t\n  1002\tOPERATOR=\"$(gh api user --jq '.login' 2>/dev/null || echo unknown)\"\n  1003\tGATE2_CAUTION_LINE=\"\"\n  1004\tif [ \"$ACK_NO_GATE2_VERIFICATION\" -eq 1 ]; then\n  1005\t  GATE2_CAUTION_LINE=\"- **CAUTION:** Gate 3 invoked with --i-understand-no-gate-2-verification — wrapper SHA NOT verified against release-tag SHA. Operator @${OPERATOR} acknowledges break-glass risk.\"\n  1006\tfi\n  1007\tTS=\"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"\n  1008\t\n  1009\tLOG_FILE=\"docs/reviews/WP-SCP-020/branch-protection-log.md\"\n  1010\t\n","exit_code":0,"status":"completed"}}

h no successful workflow-runs. Found ${run_count} successful runs on this repo, indicating a non-cold-start state. Use --expected-wrapper-sha for Gate 3 re-enable instead.\" >&2\n   581\t        exit 2\n   582\t      fi\n   583\t    fi\n   584\t    log \"safety check bypassed via --i-understand-this-repo-has-no-prior-green-ci\"\n   585\t    return 0\n   586\t  fi\n   587\t\n   588\t  workflow_id=\"$(gh api --paginate \"repos/${REPO}/actions/workflows?per_page=100\" --jq '.workflows[] | select(.path == \"'\"$WORKFLOW_LOOKUP_PATH\"'\") | .id' | head -n1)\"\n   589\t  if [ -z \"$workflow_id\" ]; then\n   590\t    echo \"error: no workflow with path '$WORKFLOW_LOOKUP_PATH' found in ${REPO}\" >&2\n   591\t    exit 2\n   592\t  fi\n   593\t\n   594\t  created_since=\"$(python3 - <<'PY'\n   595\tfrom datetime import datetime, timedelta, timezone\n   596\tprint((datetime.now(timezone.utc) - timedelta(days=60)).strftime(\"%Y-%m-%dT%H:%M:%SZ\"))\n   597\tPY\n   598\t)\"\n   599\t  workflow_runs_json=\"$(gh api \"repos/${REPO}/actions/runs?status=success&created=%3E%3D${created_since}&workflow_id=${workflow_id}\")\"\n   600\t  run_count=\"$(printf '%s' \"$workflow_runs_json\" | jq '.workflow_runs | length')\"\n   601\t  if [ \"$run_count\" -eq 0 ]; then\n   602\t    echo \"error: no successful workflow runs found for workflow path '$WORKFLOW_LOOKUP_PATH' in the last 60 days\" >&2\n   603\t    echo \"       use --i-understand-this-repo-has-no-prior-green-ci only for cold-start adopters\" >&2\n   604\t    exit 2\n   605\t  fi\n   606\t  log \"safety check: found ${run_count} successful workflow run(s) for ${WORKFLOW_LOOKUP_PATH} in the last 60 days\"\n   607\t\n   608\t  if prior_restore_evidence_present \"docs/reviews/WP-SCP-020/branch-protection-log.md\" \"${REPO}@${BRANCH}\"; then\n   609\t    if [ -z \"$EXPECTED_WRAPPER_SHA\" ] && [ \"$ACK_NO_GATE2_VERIFICATION\" -ne 1 ]; then\n   610\t      echo \"error: prior --restore evidence detected for ${REPO}@${BRANCH}; --expected-wrapper-sha <release-tag-sha> is required\" >&2\n   611\t      echo \"       pass --i-understand-no-gate-2-verification to bypass Gate 2 verification (audited via CAUTION log entry)\" >&2\n   612\t      exit 2\n   613\t    fi\n   614\t  fi\n   615\t\n   616\t  if [ -n \"$EXPECTED_WRAPPER_SHA\" ]; then\n   617\t    if ! prior_restore_evidence_present \"docs/reviews/WP-SCP-020/branch-protection-log.md\" \"${REPO}@${BRANCH}\"; then\n   618\t      echo \"error: --expected-wrapper-sha requires prior --restore evidence for ${REPO}@${BRANCH} in docs/reviews/WP-SCP-020/branch-protection-log.md\" >&2\n   619\t      echo \"       check both the committed log file and the working tree diff\" >&2\n   620\t      exit 2\n   621\t    fi\n   622\t    validate_expected_wrapper_sha_against_tags \"$EXPECTED_WRAPPER_SHA\"\n   623\t    wrapper_content=\"$(\n   624\t      gh api \"repos/${REPO}/contents/.github/workflows/policy-check-wrapper.yml\" --jq '.content' | base64 -d 2>/dev/null || echo ''\n   625\t    )\"\n   626\t  if [ -n \"$wrapper_content\" ]; then\n   627\t      if printf '%s' \"$wrapper_content\" | grep -vE '^[[:space:]]*#' | grep -qE '^[[:space:]]*uses:[[:space:]]+[^#]*standards-control-plane[^#]*@'\"${EXPECTED_WRAPPER_SHA}\"; then\n   628\t        log \"verified: adopter wrapper pins to ${EXPECTED_WRAPPER_SHA}\"\n   629\t      else\n   630\t        echo \"ERROR: adopter wrapper does NOT pin to ${EXPECTED_WRAPPER_SHA}\" >&2\n   631\t        echo \"       update the wrapper SHA pin before invoking Gate 3 re-enable\" >&2\n   632\t        exit 2\n   633\t      fi\n   634\t    else\n   635\t      if [ \"$ACK_WRAPPER_INACCESSIBLE\" -ne 1 ]; then\n   636\t        echo \"ERROR: adopter wrapper content is inaccessible from current context\" >&2\n   637\t        echo \"       pass --i-understand-wrapper-inaccessible to continue without wrapper-pin verification\" >&2\n   638\t        exit 2\n   639\t      fi\n   640\t      log \"CAUTION: wrapper-pin not verified — adopter wrapper content inaccessible; operator acknowledged via --i-understand-wrapper-inaccessible\"\n   641\t      WRAPPER_INACCESSIBLE_CAUTION_LINE=\"- **CAUTION:** Gate 3 wrapper content was inaccessible from the current context; operator acknowledged via --i-understand-wrapper-inaccessible before proceeding.\"\n   642\t      cat >&2 <<'WARN'\n   643\t++ CAUTION: adopter wrapper content is inaccessible from current context.\n   644\t++ This proceeds in 5 seconds. Press Ctrl-C to abort.\n   645\tWARN\n   646\t      sleep 5\n   647\t    fi\n   648\t  fi\n   649\t}\n   650\t\n   651\tlog() {\n   652\t  printf '[020G] %s\\n' \"$*\"\n   653\t}\n   654\t\n   655\tlog \"target repo: $REPO\"\n   656\tlog \"target branch: $BRANCH\"\n   657\tlog \"required check: $REQUIRED_CONTEXT\"\n   658\tlog \"enforce_admins: $ENFORCE_ADMINS\"\n   659\t[ \"$ACK_NO_GATE2_VERIFICATION\" -eq 1 ] && log \"CAUTION: Gate 2 verification bypassed via --i-understand-no-gate-2-verification\"\n   660\tif [ \"$ACK_NO_GATE2_VERIFICATION\" -eq 1 ]; then\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba scripts/enable-required-check.sh | sed -n '690,820p'\"","aggregated_output":"   690\t    --argjson admins \"$ENFORCE_ADMINS\" \\\n   691\t    --argjson reviews \"$existing_reviews\" \\\n   692\t    '{\n   693\t       required_status_checks: {\n   694\t         strict: true,\n   695\t         contexts: [$context]\n   696\t       },\n   697\t       enforce_admins: $admins,\n   698\t       required_pull_request_reviews: $reviews,\n   699\t       restrictions: null,\n   700\t       required_linear_history: false,\n   701\t       allow_force_pushes: false,\n   702\t       allow_deletions: false,\n   703\t       block_creations: false,\n   704\t       required_conversation_resolution: false,\n   705\t       lock_branch: false,\n   706\t       allow_fork_syncing: false\n   707\t     }'\n   708\t}\n   709\t\n   710\t# ---------- Capture before-state ----------\n   711\t\n   712\tlog \"capturing before-state...\"\n   713\tBEFORE_RAW=\"$(gh api -X GET \"repos/${REPO}/branches/${BRANCH}/protection\" 2>&1)\" || BEFORE_STATUS=$?\n   714\tBEFORE_STATUS=\"${BEFORE_STATUS:-0}\"\n   715\t\n   716\tif [ \"$BEFORE_STATUS\" -eq 0 ]; then\n   717\t  BEFORE_JSON=\"$BEFORE_RAW\"\n   718\telif printf '%s' \"$BEFORE_RAW\" | grep -q \"Branch not protected\"; then\n   719\t  BEFORE_JSON='{\"_note\":\"no protection currently configured\"}'\n   720\telse\n   721\t  echo \"error: gh api GET branch protection failed; cannot proceed safely\" >&2\n   722\t  echo \"$BEFORE_RAW\" >&2\n   723\t  exit 1\n   724\tfi\n   725\t\n   726\t# Extract existing required_pull_request_reviews, default to null\n   727\t# if absent. Either way, we send what was there.\n   728\tEXISTING_REVIEWS=\"$(printf '%s' \"$BEFORE_JSON\" | jq '.required_pull_request_reviews // null')\"\n   729\t\n   730\t# Per WP-SCP-022 020H pt 3 R3 SAFE-R3-003 closure (2026-04-30):\n   731\t# multi-maintainer adopters MUST set dismiss_stale_reviews: true to\n   732\t# close the post-approval-malicious-push attack surface (see\n   733\t# ADOPT-001 §12.7.4). This script preserves the adopter's existing\n   734\t# review-shape verbatim and does NOT set dismiss_stale_reviews; emit\n   735\t# a stderr WARNING if it is currently false or absent so the operator\n   736\t# is prompted to configure it explicitly.\n   737\tDISMISS_STALE_VAL=\"$(printf '%s' \"$EXISTING_REVIEWS\" | jq -r '\n   738\t  if . == null then \"absent\"\n   739\t  elif (.dismiss_stale_reviews // false) == true then \"true\"\n   740\t  else \"false\"\n   741\t  end\n   742\t')\"\n   743\tif [ \"$DISMISS_STALE_VAL\" != \"true\" ]; then\n   744\t  echo \"[020G] WARNING: required_pull_request_reviews.dismiss_stale_reviews is ${DISMISS_STALE_VAL} on the target repo\" >&2\n   745\t  echo \"[020G] WARNING: multi-maintainer SCP adopters MUST set dismiss_stale_reviews: true (ADOPT-001 §12.7.4)\" >&2\n   746\t  echo \"[020G] WARNING: this script preserves the existing review-shape verbatim and does not set this for you\" >&2\n   747\t  echo \"[020G] WARNING: configure it via 'gh api -X PATCH repos/<owner>/<repo>/branches/<branch>/protection/required_pull_request_reviews -F dismiss_stale_reviews=true'\" >&2\n   748\t  echo \"[020G] WARNING: single-operator adopters with required_approving_review_count=0 (per D-033) can ignore this warning\" >&2\n   749\tfi\n   750\t\n   751\tRESTORE_TARGET_JSON=\"\"\n   752\tRESTORE_PAYLOAD=\"\"\n   753\tRESTORE_SIGNATURES_ENABLED=\"\"\n   754\tRESTORE_TARGET_CHECKS_STRICT=\"\"\n   755\tRESTORE_TARGET_CHECKS_CONTEXTS=\"\"\n   756\tRESTORE_TARGET_CHECKS_CONTEXTS_LOG=\"\"\n   757\tRESTORE_TARGET_ADMINS_ENABLED=\"\"\n   758\tRESTORE_TARGET_FORCE_PUSHES=\"\"\n   759\tRESTORE_TARGET_DELETIONS=\"\"\n   760\tRESTORE_CAUTION_LINES=()\n   761\tRESTORE_CAUTION_LINES_BLOCK=\"\"\n   762\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n   763\t  RESTORE_TARGET_JSON=\"$(cat \"$RESTORE_PRE_STATE\")\"\n   764\t  RESTORE_PAYLOAD=\"$(validate_restore_source_json \"$RESTORE_PRE_STATE\")\"\n   765\t  RESTORE_TARGET_CHECKS_STRICT=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.required_status_checks.strict // false')\"\n   766\t  RESTORE_TARGET_CHECKS_CONTEXTS=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.required_status_checks.contexts // [] | join(\",\")')\"\n   767\t  RESTORE_TARGET_CHECKS_CONTEXTS_LOG=\"$(sanitize_context_for_log \"$RESTORE_TARGET_CHECKS_CONTEXTS\")\"\n   768\t  RESTORE_TARGET_ADMINS_ENABLED=\"$(printf '%s' \"$RESTORE_PAYLOAD\" | jq -r '.enforce_admins // false')\"\n   769\t  RESTORE_TARGET_FORCE_PUSHES=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.allow_force_pushes // false')\"\n   770\t  RESTORE_TARGET_DELETIONS=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.allow_deletions // false')\"\n   771\t  CURRENT_SIGNATURES_ENABLED=\"$(printf '%s' \"$BEFORE_JSON\" | jq -r '.required_signatures.enabled // false')\"\n   772\t  RESTORE_SIGNATURES_ENABLED=\"$(python3 - \"$RESTORE_PRE_STATE\" <<'PY'\n   773\timport json\n   774\timport sys\n   775\t\n   776\twith open(sys.argv[1]) as fh:\n   777\t    data = json.load(fh)\n   778\tenabled = bool(((data.get(\"required_signatures\") or {}).get(\"enabled\", False)))\n   779\tprint(\"true\" if enabled else \"false\")\n   780\tPY\n   781\t)\"\n   782\t  if [ \"$CURRENT_SIGNATURES_ENABLED\" = \"true\" ] && [ \"$RESTORE_SIGNATURES_ENABLED\" = \"false\" ] && [ \"$ACK_RESTORE_SIGNATURES_REMOVAL\" -ne 1 ]; then\n   783\t    echo \"error: restore target disables required signatures; pass --i-understand-restore-disables-required-signatures to continue\" >&2\n   784\t    exit 2\n   785\t  fi\n   786\t  if [ \"$CURRENT_SIGNATURES_ENABLED\" = \"true\" ] && [ \"$RESTORE_SIGNATURES_ENABLED\" = \"false\" ]; then\n   787\t    log \"CAUTION: restore target disables required_signatures; operator acknowledges posture change\"\n   788\t    RESTORE_CAUTION_LINES+=(\"- **CAUTION:** restore target disables required_signatures; operator acknowledges posture change.\")\n   789\t  fi\n   790\t  if [ \"$RESTORE_TARGET_FORCE_PUSHES\" = \"true\" ]; then\n   791\t    if [ \"$ACK_RESTORE_FORCE_PUSHES\" -ne 1 ]; then\n   792\t      echo \"error: restore target re-enables allow_force_pushes; pass --i-understand-restore-re-enables-force-pushes to continue\" >&2\n   793\t      exit 2\n   794\t    fi\n   795\t    log \"CAUTION: restore target re-enables allow_force_pushes; operator acknowledges posture change\"\n   796\t    RESTORE_CAUTION_LINES+=(\"- **CAUTION:** restore target re-enables allow_force_pushes; operator acknowledges posture change.\")\n   797\t  fi\n   798\t  if [ \"$RESTORE_TARGET_DELETIONS\" = \"true\" ]; then\n   799\t    if [ \"$ACK_RESTORE_DELETIONS\" -ne 1 ]; then\n   800\t      echo \"error: restore target re-enables allow_deletions; pass --i-understand-restore-re-enables-deletions to continue\" >&2\n   801\t      exit 2\n   802\t    fi\n   803\t    log \"CAUTION: restore target re-enables allow_deletions; operator acknowledges posture change\"\n   804\t    RESTORE_CAUTION_LINES+=(\"- **CAUTION:** restore target re-enables allow_deletions; operator acknowledges posture change.\")\n   805\t  fi\n   806\tfi\n   807\t\n   808\tif [ \"${#RESTORE_CAUTION_LINES[@]}\" -gt 0 ]; then\n   809\t  RESTORE_CAUTION_LINES_BLOCK=$'\\n'\"$(printf '%s\\n' \"${RESTORE_CAUTION_LINES[@]}\")\"\n   810\tfi\n   811\t\n   812\tPAYLOAD=\"$(build_payload \"$EXISTING_REVIEWS\")\"\n   813\t\n   814\tif [ \"$PLAN_ONLY\" = \"1\" ]; then\n   815\t  log \"current branch-protection state (before):\"\n   816\t  printf '%s\\n' \"$BEFORE_JSON\" | jq .\n   817\t  log \"plan (would PUT to repos/${REPO}/branches/${BRANCH}/protection):\"\n   818\t  printf '%s\\n' \"$PAYLOAD\" | jq .\n   819\t  log \"post-PUT, would also enable required_signatures via the dedicated sub-resource.\"\n   820\t  log \"to apply, re-run without --plan\"\n","exit_code":0,"status":"completed"}}

quired-check.sh:633:\\nscripts/enable-required-check.sh:634:  log \\\"restoring branch protection (unified PUT)...\\\"\\nscripts/enable-required-check.sh:635:  printf '%s' \\\"$RESTORE_PAYLOAD\\\" | gh api -X PUT \\\"repos/${REPO}/branches/${BRANCH}/protection\\\" \\\\\\nscripts/enable-required-check.sh:636:    -H \\\"Accept: application/vnd.github+json\\\" \\\\\\nscripts/enable-required-check.sh:637:    --input - >/dev/null || APPLY_FAIL=1\\nscripts/enable-required-check.sh:638:\\nscripts/enable-required-check.sh:639:  if [ \\\"$APPLY_FAIL\\\" -ne 0 ]; then\\nscripts/enable-required-check.sh:640:    echo \\\"ERROR: unified PUT failed; partial branch-protection state may exist on ${REPO}@${BRANCH}\\\" >&2\\nscripts/enable-required-check.sh:641:    echo \\\"       continuing to log emission so the failure is auditable, then exiting non-zero\\\" >&2\\nscripts/enable-required-check.sh:642:    FAIL=1\\nscripts/enable-required-check.sh:643:  else\\nscripts/enable-required-check.sh:644:    restore_signatures_enabled=\\\"$(printf '%s' \\\"$RESTORE_TARGET_JSON\\\" | jq -r '.required_signatures.enabled // false')\\\"\\nscripts/enable-required-check.sh:645:    if [ \\\"$restore_signatures_enabled\\\" = \\\"true\\\" ]; then\\nscripts/enable-required-check.sh:646:      log \\\"restoring required_signatures (dedicated sub-resource: enable)...\\\"\\nscripts/enable-required-check.sh:647:      restore_signatures_err=\\\"$(mktemp)\\\"\\nscripts/enable-required-check.sh:648:      if ! gh api -X POST \\\"repos/${REPO}/branches/${BRANCH}/protection/required_signatures\\\" >/dev/null 2>\\\"$restore_signatures_err\\\"; then\\nscripts/enable-required-check.sh:649:        if grep -q '404' \\\"$restore_signatures_err\\\"; then\\nscripts/enable-required-check.sh:650:          log \\\"required_signatures POST already in desired state (404 suppressed)\\\"\\nscripts/enable-required-check.sh:651:        else\\nscripts/enable-required-check.sh:652:          echo \\\"ERROR: required_signatures POS
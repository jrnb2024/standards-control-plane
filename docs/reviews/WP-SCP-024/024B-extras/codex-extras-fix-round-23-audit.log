check.sh:698:log \\\"verifying...\\\"\\nscripts/enable-required-check.sh:699:if [ \\\"$RESTORE_MODE\\\" -eq 1 ]; then\\nscripts/enable-required-check.sh:700:  AFTER_RAW=\\\"$(gh api -X GET \\\"repos/${REPO}/branches/${BRANCH}/protection\\\" 2>&1)\\\" || AFTER_STATUS=$?\\nscripts/enable-required-check.sh:701:  AFTER_STATUS=\\\"${AFTER_STATUS:-0}\\\"\\nscripts/enable-required-check.sh:702:  if [ \\\"$AFTER_STATUS\\\" -eq 0 ]; then\\nscripts/enable-required-check.sh:703:    AFTER_JSON=\\\"$AFTER_RAW\\\"\\nscripts/enable-required-check.sh:704:  else\\nscripts/enable-required-check.sh:705:    AFTER_JSON='{\\\"_error\\\":\\\"restore after-state capture failed\\\"}'\\nscripts/enable-required-check.sh:706:    echo \\\"ERROR: post-restore GET branch-protection failed; continuing to log emission so the failure is auditable\\\" >&2\\nscripts/enable-required-check.sh:707:    APPLY_FAIL=1\\nscripts/enable-required-check.sh:708:    FAIL=1\\nscripts/enable-required-check.sh:709:  fi\\nscripts/enable-required-check.sh:710:else\\nscripts/enable-required-check.sh:711:  AFTER_JSON=\\\"$(gh api -X GET \\\"repos/${REPO}/branches/${BRANCH}/protection\\\")\\\"\\nscripts/enable-required-check.sh:712:fi\\nscripts/enable-required-check.sh:713:\\nscripts/enable-required-check.sh:714:CHECKS_STRICT=\\\"$(printf '%s' \\\"$AFTER_JSON\\\" | jq -r '.required_status_checks.strict // false')\\\"\\nscripts/enable-required-check.sh:715:CHECKS_CONTEXTS=\\\"$(printf '%s' \\\"$AFTER_JSON\\\" | jq -r '.required_status_checks.contexts // [] | join(\\\",\\\")')\\\"\\nscripts/enable-required-check.sh:716:APPLIED_ADMINS=\\\"$(printf '%s' \\\"$AFTER_JSON\\\" | jq -r '.enforce_admins.enabled // false')\\\"\\nscripts/enable-required-check.sh:717:SIGS_ENABLED=\\\"$(printf '%s' \\\"$AFTER_JSON\\\" | jq -r '.required_signatures.enabled // false')\\\"\\nscripts/enable-required-check.sh:718:\\nscripts/enable-required-check.sh:719:if [ \\\"$RESTORE_MODE\\\" -eq 1 ]; then\\nscripts/enable-required-check.sh:720:  EXPECTED_CHECKS_STRICT=\\\"$RESTORE_TARGET_CHECKS_STRICT\\\"\\nscripts/enable-required-check.sh:721:  EXPECTED_CHECKS_CONTEXTS=\\\"$RESTORE_TARGET_CHECKS_CONTEXTS\\\"\\nscripts/enable-required-check.sh:722:  EXPECTED_APPLIED_ADMINS=\\\"$RESTORE_TARGET_ADMINS_ENABLED\\\"\\nscripts/enable-required-check.sh:723:  EXPECTED_SIGS_ENABLED=\\\"$RESTORE_SIGNATURES_ENABLED\\\"\\nscripts/enable-required-check.sh:724:else\\nscripts/enable-required-check.sh:725:  EXPECTED_CHECKS_STRICT=\\\"true\\\"\\nscripts/enable-required-check.sh:726:  EXPECTED_CHECKS_CONTEXTS=\\\"$REQUIRED_CONTEXT\\\"\\nscripts/enable-required-check.sh:727:  EXPECTED_APPLIED_ADMINS=\\\"$ENFORCE_ADMINS\\\"\\nscripts/enable-required-check.sh:728:  EXPECTED_SIGS_ENABLED=\\\"true\\\"\\nscripts/enable-required-check.sh:729:fi\\nscripts/enable-required-check.sh:730:\\nscripts/enable-required-check.sh:731:# Closes 020G R3 correctness CORR3-001 + safety SAF-R3-001:\\nscripts/enable-required-check.sh:732:# preserve any FAIL=1 set by the apply-phase trap. Initialising\\nscripts/enable-required-check.sh:733:# FAIL=0 unconditionally would launder an apply-failure into a\\nscripts/enable-required-check.sh:734:# false-success when the pre-existing state happens to satisfy\\nscripts/enable-required-check.sh:735:# the verify checks. Default to 0 only if not already set.\\nscripts/enable-required-check.sh:736:FAIL=\\\"${FAIL:-0}\\\"\\nscripts/enable-required-check.sh:737:[ \\\"$CHECKS_STRICT\\\" = \\\"$EXPECTED_CHECKS_STRICT\\\" ] || { echo \\\"verify FAIL: required_status_checks.strict=${CHECKS_STRICT} (expected ${EXPECTED_CHECKS_STRICT})\\\" >&2; FAIL=1; }\\nscripts/enable-required-check.sh:738:if [ -n \\\"$EXPECTED_CHECKS_CONTEXTS\\\" ]; then\\nscripts/enable-required-check.sh:739:  printf '%s' \\\"$CHECKS_CONTEXTS\\\" | grep -q -F \\\"$EXPECTED_CHECKS_CONTEXTS\\\" || { echo \\\"verify FAIL: contexts missing ${EXPECTED_CHECKS_CONTEXTS} (got: ${CHECKS_CONTEXTS})\\\" >&2; FAIL=1; }\\nscripts/enable-required-check.sh:740:else\\nscripts/enable-required-check.sh:741:  [ -z \\\"$CHECKS_CONTEXTS\\\" ] || { echo \\\"verify FAIL: contexts expected to be empty (got: ${CHECKS_CONTEXTS})\\\" >&2; FAIL=1; }\\nscripts/enable-required-check.sh:742:fi\\nscripts/enable-required-check.sh:743:[ \\\"$APPLIED_ADMINS\\\" = \\\"$EXPECTED_APPLIED_ADMINS\\\" ] || { echo \\\"verify FAIL: enforce_admins=${APPLIED_ADMINS} (expected ${EXPECTED_APPLIED_ADMINS})\\\" >&2; FAIL=1; }\\nscripts/enable-required-check.sh:744:[ \\\"$SIGS_ENABLED\\\" = \\\"$EXPECTED_SIGS_ENABLED\\\" ] || { echo \\\"verify FAIL: required_signatures=${SIGS_ENABLED} (expected ${EXPECTED_SIGS_ENABLED})\\\" >&2; FAIL=1; }\\nscripts/enable-required-check.sh:745:\\nscripts/enable-required-check.sh:746:# Closes 020G R2 correctness CORR2-001 + safety SAF-R2-002: only\\nscripts/enable-required-check.sh:747:# emit \\\"verification passed\\\" when FAIL=0. Previously this line\\nscripts/enable-required-check.sh:748:# emitted unconditionally after the fall-through, producing a\\nscripts/enable-required-check.sh:749:# misleading false-success message on stdout when verification had\\nscripts/enable-required-check.sh:750:# actually failed.\\nscripts/enable-required-check.sh:751:if [ \\\"${FAIL:-0}\\\" -ne 0 ]; then\\nscripts/enable-required-check.sh:752:  echo \\\"verification failed; see message(s) above\\\" >&2\\nscripts/enable-required-check.sh:753:  echo \\\"\\\" >&2\\nscripts/enable-required-check.sh:754:  echo \\\"Even on failure, capture an invocation log entry so the audit trail\\\" >&2\\nscripts/enable-required-check.sh:755:  echo \\\"records the failure. The before/after blocks below show the partial\\\" >&2\\nscripts/enable-required-check.sh:756:  echo \\\"state and aid post-mortem.\\\" >&2\\nscripts/enable-required-check.sh:757:  # fall through to log emission so an audit entry exists\\nscripts/enable-required-check.sh:758:else\\nscripts/enable-required-check.sh:759:  log \\\"verification passed ✓\\\"\\nscripts/enable-required-check.sh:760:  log \\\"  required check:        ${CHECKS_CONTEXTS} (strict=${CHECKS_STRICT})\\\"\\nscripts/enable-required-check.sh:761:  log \\\"  enforce_admins:        ${APPLIED_ADMINS}\\\"\\nscripts/enable-required-check.sh:762:  log \\\"  required_signatures:   ${SIGS_ENABLED}\\\"\\nscripts/enable-required-check.sh:763:fi\\nscripts/enable-required-check.sh:764:\\nscripts/enable-required-check.sh:765:# ---------- Emit invocation log ----------\\nscripts/enable-required-check.sh:766:#\\nscripts/enable-required-check.sh:767:# Per 020G R1 safety SAF-001 + correctness CORR-002:\\nscripts/enable-required-check.sh:768:# the audit trail records the SHA256 of the actually-running\\nscripts/enable-required-check.sh:769:# script content (not the last-committed git SHA, which can lie if\\nscripts/enable-required-check.sh:770:# the operator has uncommitted changes or runs from outside an SCP\\nscripts/enable-required-check.sh:771:# clone). The git-SHA is recorded as a secondary identifier when\\nscripts/enable-required-check.sh:772:# available.\\nscripts/enable-required-check.sh:773:\\nscripts/enable-required-check.sh:774:# Self-hash via $0. Exits non-zero only if the script can't read\\nscripts/enable-required-check.sh:775:# itself, which is essentially impossible at this point.\\nscripts/enable-required-check.sh:776:SCRIPT_PATH=\\\"$(readlink -f \\\"$0\\\" 2>/dev/null || printf '%s' \\\"$0\\\")\\\"\\nscripts/enable-required-check.sh:777:SCRIPT_SHA256=\\\"$(shasum -a 256 \\\"$SCRIPT_PATH\\\" | awk '{print $1}')\\\"\\nscripts/enable-required-check.sh:778:\\nscripts/enable-required-check.sh:779:# Try to also report the last-committed git SHA if we're inside an\\nscripts/enable-required-check.sh:780:# SCP-shaped clone. Empty fallback is explicit.\\nscripts/enable-required-check.sh:781:SCRIPT_GIT_SHA=\\\"$(git -C \\\"$(dirname \\\"$SCRIPT_PATH\\\")\\\" log -1 --format=%H -- \\\"$(basename \\\"$SCRIPT_PATH\\\")\\\" 2>/dev/null || true)\\\"\\nscripts/enable-required-check.sh:782:SCRIPT_GIT_SHA=\\\"${SCRIPT_GIT_SHA:-not-in-git-clone}\\\"\\nscripts/enable-required-check.sh:783:\\nscripts/enable-required-check.sh:784:OPERATOR=\\\"$(gh api user --jq '.login' 2>/dev/null || echo unknown)\\\"\\nscripts/enable-required-check.sh:785:TS=\\\"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\\\"\\nscripts/enable-required-check.sh:786:\\nscripts/enable-required-check.sh:787:LOG_FILE=\\\"docs/reviews/WP-SCP-020/branch-protection-log.md\\\"\\nscripts/enable-required-check.sh:788:\\nscripts/enable-required-check.sh:789:# Emit the log block. Use ~~~~ outer fence so inner ``` JSON\\nscripts/enable-required-check.sh:790:# fences nest correctly (CommonMark requires the closing fence\\nscripts/enable-required-check.sh:791:# to match the opening fence character; fence types ~~~ and ```\\nscripts/enable-required-check.sh:792:# do not collide). Closes 020G R1 correctness CORR-001.\\nscripts/enable-required-check.sh:793:\\nscripts/enable-required-check.sh:794:if [ \\\"$RESTORE_MODE\\\" -eq 1 ]; then\\nscripts/enable-required-check.sh:795:  cat <<EOF\\nscripts/enable-required-check.sh:796:---\\nscripts/enable-required-check.sh:797:\\nscripts/enable-required-check.sh:798:## Invocation log entry\\nscripts/enable-required-check.sh:799:\\nscripts/enable-required-check.sh:800:Append the block below to ${LOG_FILE} on the SCP repo, commit on\\nscripts/enable-required-check.sh:801:a feature branch, open PR, merge:\\nscripts/enable-required-check.sh:802:\\nscripts/enable-required-check.sh:803:~~~markdown\\nscripts/enable-required-check.sh:804:### ${TS} — ${REPO}@${BRANCH}\\nscripts/enable-required-check.sh:805:\\nscripts/enable-required-check.sh:806:- **Operator:** @${OPERATOR}\\nscripts/enable-required-check.sh:807:- **Script SHA256:** \\\\`${SCRIPT_SHA256}\\\\` (hash of executed file)\\nscripts/enable-required-check.sh:808:- **Script git SHA:** \\\\`${SCRIPT_GIT_SHA}\\\\` (last committed; \\\"not-in-git-clone\\\" if N/A)\\nscripts/enable-required-check.sh:809:- **Required check:** \\\\`${RESTORE_TARGET_CHECKS_CONTEXTS}\\\\`\\nscripts/enable-required-check.sh:810:- **enforce_admins:** ${RESTORE_TARGET_ADMINS_ENABLED}\\nscripts/enable-required-check.sh:811:- **Plan-only:** no\\nscripts/enable-required-check.sh:812:- **Restore mode:** yes\\nscripts/enable-required-check.sh:813:- **Restoring TO:**\\nscripts/enable-required-check.sh:814:\\\\`\\\\`\\\\`json\\nscripts/enable-required-check.sh:815:$(printf '%s' \\\"$RESTORE_TARGET_JSON\\\" | python3 -m json.tool 2>/dev/null || printf '%s' \\\"$RESTORE_TARGET_JSON\\\")\\nscripts/enable-required-check.sh:816:\\\\`\\\\`\\\\`\\nscripts/enable-required-check.sh:817:- **Before:**\\nscripts/enable-required-check.sh:818:\\\\`\\\\`\\\\`json\\nscripts/enable-required-check.sh:819:$(printf '%s' \\\"$BEFORE_JSON\\\" | python3 -m json.tool 2>/dev/null || printf '%s' \\\"$BEFORE_JSON\\\")\\nscripts/enable-required-check.sh:820:\\\\`\\\\`\\\\`\\nscripts/enable-required-check.sh:821:- **After:**\\nscripts/enable-required-check.sh:822:\\\\`\\\\`\\\\`json\\nscripts/enable-required-check.sh:823:$(printf '%s' \\\"$AFTER_JSON\\\" | python3 -m json.tool 2>/dev/null || printf '%s' \\\"$AFTER_JSON\\\")\\nscripts/enable-required-check.sh:824:\\\\`\\\\`\\\\`\\nscripts/enable-required-check.sh:825:~~~\\nscripts/enable-required-check.sh:826:\\nscripts/enable-required-check.sh:827:The log commit is part of the invocation procedure per WP-SCP-020\\nscripts/enable-required-check.sh:828:§4 020G(iii) + D-035; without it the apply is unrecorded.\\nscripts/enable-required-check.sh:829:EOF\\nscripts/enable-required-check.sh:830:else\\nscripts/enable-required-check.sh:831:  cat <<EOF\\nscripts/enable-required-check.sh:832:---\\nscripts/enable-required-check.sh:833:\\nscripts/enable-required-check.sh:834:## Invocation log entry\\nscripts/enable-required-check.sh:835:\\nscripts/enable-required-check.sh:836:Append the block below to ${LOG_FILE} on the SCP repo, commit on\\nscripts/enable-required-check.sh:837:a feature branch, open PR, merge:\\nscripts/enable-required-check.sh:838:\\nscripts/enable-required-check.sh:839:~~~markdown\\nscripts/enable-required-check.sh:840:### ${TS} — ${REPO}@${BRANCH}\\nscripts/enable-required-check.sh:841:\\nscripts/enable-required-check.sh:842:- **Operator:** @${OPERATOR}\\nscripts/enable-required-check.sh:843:- **Script SHA256:** \\\\`${SCRIPT_SHA256}\\\\` (hash of executed file)\\nscripts/enable-required-check.sh:844:- **Script git SHA:** \\\\`${SCRIPT_GIT_SHA}\\\\` (last committed; \\\"not-in-git-clone\\\" if N/A)\\nscripts/enable-required-check.sh:845:- **Required check:** \\\\`${REQUIRED_CONTEXT}\\\\`\\nscripts/enable-required-check.sh:846:- **enforce_admins:** ${ENFORCE_ADMINS}\\nscripts/enable-required-check.sh:847:- **Plan-only:** no\\nscripts/enable-required-check.sh:848:- **PUT payload applied:**\\nscripts/enable-required-check.sh:849:\\\\`\\\\`\\\\`json\\nscripts/enable-required-check.sh:850:$(printf '%s' \\\"$PAYLOAD\\\" | python3 -m json.tool 2>/dev/null || printf '%s' \\\"$PAYLOAD\\\")\\nscripts/enable-required-check.sh:851:\\\\`\\\\`\\\\`\\nscripts/enable-required-check.sh:852:- **Before:**\\nscripts/enable-required-check.sh:853:\\\\`\\\\`\\\\`json\\nscripts/enable-required-check.sh:854:$(printf '%s' \\\"$BEFORE_JSON\\\" | python3 -m json.tool 2>/dev/null || printf '%s' \\\"$BEFORE_JSON\\\")\\nscripts/enable-required-check.sh:855:\\\\`\\\\`\\\\`\\nscripts/enable-required-check.sh:856:- **After:**\\nscripts/enable-required-check.sh:857:\\\\`\\\\`\\\\`json\\nscripts/enable-required-check.sh:858:$(printf '%s' \\\"$AFTER_JSON\\\" | python3 -m json.tool 2>/dev/null || printf '%s' \\\"$AFTER_JSON\\\")\\nscripts/enable-required-check.sh:859:\\\\`\\\\`\\\\`\\nscripts/enable-required-check.sh:860:~~~\\nscripts/enable-required-check.sh:861:\\nscripts/enable-required-check.sh:862:The log commit is part of the invocation procedure per WP-SCP-020\\nscripts/enable-required-check.sh:863:§4 020G(iii) + D-035; without it the apply is unrecorded.\\nscripts/enable-required-check.sh:864:EOF\\nscrip
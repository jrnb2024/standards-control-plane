{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,120p' .github/workflows/check-invocation-log-entry.yml\"","aggregated_output":"# WP-SCP-024 024B-extras — CI wiring for the invocation-log gate.\n#\n# D-047 ratifies the break-glass restore flow and this workflow wiring.\n# Plan-doc invariant 2 still governs the enforcement script itself;\n# this workflow just feeds it the correct slice-local arguments.\n#\n# Critical bootstrap guard: paths-ignore excludes 024A / 024B-*\n# tooling slices plus status/log-only churn, and the job body\n# short-circuits tooling slices or PRs with no cascade note in diff.\n\nname: check-invocation-log-entry\n\n\"on\":\n  pull_request:\n    branches: [main]\n    types: [opened, synchronize, reopened]\n    paths:\n      - \"docs/reviews/WP-SCP-024/024[C-Z]*/**\"\n      - \"docs/reviews/WP-SCP-020/branch-protection-log.md\"\n      - \"STATUS.md\"\n    paths-ignore:\n      - \"docs/reviews/WP-SCP-024/024[AB]*/**\"\n      - \"docs/reviews/WP-SCP-020/branch-protection-log.md\"\n      - \"STATUS.md\"\n\npermissions:\n  contents: read\n\njobs:\n  check-invocation-log-entry:\n    runs-on: ubuntu-24.04\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Resolve dispatch note path\n        shell: bash\n        env:\n          GH_TOKEN: ${{ github.token }}\n          PR_NUMBER: ${{ github.event.pull_request.number }}\n        run: |\n          set -euo pipefail\n          pr_files=\"$(gh pr diff \"$PR_NUMBER\" --name-only --repo \"$GITHUB_REPOSITORY\")\"\n          dispatch_note=\"$(printf '%s\\n' \"$pr_files\" | grep -E '^docs/reviews/WP-SCP-024/024[A-Za-z][^/]*/DISPATCH-NOTE.md$' | tail -n1 || true)\"\n          if [ -z \"$dispatch_note\" ]; then\n            echo \"No cascade-slice DISPATCH-NOTE found in PR diff; not a cohort cascade slice - nothing to enforce.\"\n            exit 0\n          fi\n          slice_id=\"$(basename \"$(dirname \"$dispatch_note\")\")\"\n          case \"$slice_id\" in\n            024A|024B-core|024B-extras|024G)\n              echo \"Tooling slice ($slice_id); no enforcement needed.\"\n              exit 0\n              ;;\n          fi\n          printf 'dispatch_note=%s\\n' \"$dispatch_note\" >> \"$GITHUB_ENV\"\n\n      - name: Check invocation log entry\n        shell: bash\n        run: |\n          set -euo pipefail\n          scripts/check-invocation-log-entry.sh \\\n            --diff-base origin/main \\\n            --dispatch-note \"$dispatch_note\" \\\n            --status-md STATUS.md \\\n            --branch-protection-log docs/reviews/WP-SCP-020/branch-protection-log.md\n","exit_code":0,"status":"completed"}}

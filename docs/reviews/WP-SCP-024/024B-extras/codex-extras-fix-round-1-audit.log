 json.loads(payload)\nscripts/enable-required-check.sh:395:except Exception:\nscripts/enable-required-check.sh:396:    sys.stdout.write(payload)\nscripts/enable-required-check.sh:397:else:\nscripts/enable-required-check.sh:398:    print(json.dumps(data, indent=2, sort_keys=False))\nscripts/enable-required-check.sh:399:PY\nscripts/enable-required-check.sh:400:}\nscripts/enable-required-check.sh:401:\nscripts/enable-required-check.sh:402:prior_restore_evidence_present() {\nscripts/enable-required-check.sh:403:  local log_path=\"$1\"\nscripts/enable-required-check.sh:404:  local target=\"$2\"\nscripts/enable-required-check.sh:405:  local committed_blob=\"\" working_tree_diff=\"\"\nscripts/enable-required-check.sh:406:  if [ -f \"$log_path\" ]; then\nscripts/enable-required-check.sh:407:    committed_blob=\"$(cat \"$log_path\")\"\nscripts/enable-required-check.sh:408:  fi\nscripts/enable-required-check.sh:409:  working_tree_diff=\"$(git diff HEAD -- \"$log_path\" 2>/dev/null || true)\"\nscripts/enable-required-check.sh:410:  if printf '%s\\n%s' \"$committed_blob\" \"$working_tree_diff\" | grep -Fq \"$target\" && \\\nscripts/enable-required-check.sh:411:     printf '%s\\n%s' \"$committed_blob\" \"$working_tree_diff\" | grep -Fq 'Restore mode'; then\nscripts/enable-required-check.sh:412:    return 0\nscripts/enable-required-check.sh:413:  fi\nscripts/enable-required-check.sh:414:  if printf '%s\\n%s' \"$committed_blob\" \"$working_tree_diff\" | grep -Fq 'Restoring TO:'; then\nscripts/enable-required-check.sh:415:    return 0\nscripts/enable-required-check.sh:416:  fi\nscripts/enable-required-check.sh:417:  return 1\nscripts/enable-required-check.sh:418:}\nscripts/enable-required-check.sh:419:\nscripts/enable-required-check.sh:420:validate_expected_wrapper_sha_against_tags() {\nscripts/enable-required-check.sh:421:  local expected_sha=\"$1\"\nscripts/enable-required-check.sh:422:  local tag_list_json tag_name tag_sha matched_tag=\"\"\nscripts/enable-required-check.sh:423:  tag_list_json=\"$(gh api \"repos/jrnb2024/standards-control-plane/git/refs/tags?per_page=100\")\"\nscripts/enable-required-check.sh:424:  while IFS= read -r tag_name; do\nscripts/enable-required-check.sh:425:    [ -z \"$tag_name\" ] && continue\nscripts/enable-required-check.sh:426:    tag_sha=\"$(gh api \"repos/jrnb2024/standards-control-plane/git/ref/tags/${tag_name}\" --jq '.object.sha')\"\nscripts/enable-required-check.sh:427:    if [ \"$tag_sha\" = \"$expected_sha\" ]; then\nscripts/enable-required-check.sh:428:      matched_tag=\"$tag_name\"\nscripts/enable-required-check.sh:429:      break\nscripts/enable-required-check.sh:430:    fi\nscripts/enable-required-check.sh:431:  done < <(printf '%s' \"$tag_list_json\" | jq -r '.[]? | .ref // empty | sub(\"^refs/tags/\"; \"\")')\nscripts/enable-required-check.sh:432:  if [ -z \"$matched_tag\" ]; then\nscripts/enable-required-check.sh:433:    echo \"error: --expected-wrapper-sha '$expected_sha' was not found in the release-tag SHA cache\" >&2\nscripts/enable-required-check.sh:434:    exit 2\nscripts/enable-required-check.sh:435:  fi\nscripts/enable-required-check.sh:436:  log \"expected wrapper SHA validated against release tag: ${matched_tag}\"\nscripts/enable-required-check.sh:437:}\nscripts/enable-required-check.sh:438:\nscripts/enable-required-check.sh:439:check_forward_mode_safety() {\nscripts/enable-required-check.sh:440:  local created_since workflow_id workflow_runs_json run_count default_branch\nscripts/enable-required-check.sh:441:\nscripts/enable-required-check.sh:442:  if [ \"$NO_PRIOR_GREEN_CI\" -eq 1 ]; then\nscripts/enable-required-check.sh:443:    log \"safety check bypassed via --i-understand-this-repo-has-no-prior-green-ci\"\nscripts/enable-required-check.sh:444:    return 0\nscripts/enable-required-check.sh:445:  fi\nscripts/enable-required-check.sh:446:\nscripts/enable-required-check.sh:447:  workflow_id=\"$(gh api \"repos/${REPO}/actions/workflows?per_page=100\" --jq '.workflows[] | select(.path
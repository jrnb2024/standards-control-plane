   required_status_checks: {\nscripts/enable-required-check.sh:521:         strict: true,\nscripts/enable-required-check.sh:522:         contexts: [$context]\nscripts/enable-required-check.sh:523:       },\nscripts/enable-required-check.sh:524:       enforce_admins: $admins,\nscripts/enable-required-check.sh:525:       required_pull_request_reviews: $reviews,\nscripts/enable-required-check.sh:526:       restrictions: null,\nscripts/enable-required-check.sh:527:       required_linear_history: false,\nscripts/enable-required-check.sh:528:       allow_force_pushes: false,\nscripts/enable-required-check.sh:529:       allow_deletions: false,\nscripts/enable-required-check.sh:530:       block_creations: false,\nscripts/enable-required-check.sh:531:       required_conversation_resolution: false,\nscripts/enable-required-check.sh:532:       lock_branch: false,\nscripts/enable-required-check.sh:533:       allow_fork_syncing: false\nscripts/enable-required-check.sh:534:     }'\nscripts/enable-required-check.sh:535:}\nscripts/enable-required-check.sh:536:\nscripts/enable-required-check.sh:537:# ---------- Capture before-state ----------\nscripts/enable-required-check.sh:538:\nscripts/enable-required-check.sh:539:log \"capturing before-state...\"\nscripts/enable-required-check.sh:540:BEFORE_RAW=\"$(gh api -X GET \"repos/${REPO}/branches/${BRANCH}/protection\" 2>&1)\" || BEFORE_STATUS=$?\nscripts/enable-required-check.sh:541:BEFORE_STATUS=\"${BEFORE_STATUS:-0}\"\nscripts/enable-required-check.sh:542:\nscripts/enable-required-check.sh:543:if [ \"$BEFORE_STATUS\" -eq 0 ]; then\nscripts/enable-required-check.sh:544:  BEFORE_JSON=\"$BEFORE_RAW\"\nscripts/enable-required-check.sh:545:elif printf '%s' \"$BEFORE_RAW\" | grep -q \"Branch not protected\"; then\nscripts/enable-required-check.sh:546:  BEFORE_JSON='{\"_note\":\"no protection currently configured\"}'\nscripts/enable-required-check.sh:547:else\nscripts/enable-required-check.sh:548:  echo \"error: gh api GET branch protection 
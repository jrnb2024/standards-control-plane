y.sh \\\n            --diff-base origin/main \\\n            --dispatch-note \"$dispatch_note\" \\\n            --status-md STATUS.md \\\n            --branch-protection-log docs/reviews/WP-SCP-020/branch-protection-log.md\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' .github/workflows/policy-check.yml\"","aggregated_output":"name: policy-check\n\n\"on\":\n  workflow_call:\n    inputs:\n      rule-set:\n        description: Rule bundle selector for the reusable policy check.\n        required: false\n        type: string\n        default: starter\n      threshold:\n        description: Threshold that converts policy findings into a failing result.\n        required: false\n        type: string\n        default: deny\n      annotate:\n        description: Emit workflow-command annotations for deny findings.\n        required: false\n        type: boolean\n        default: true\n      scp_bypass:\n        description: Enable the break-glass pairing and waiver gates.\n        required: false\n        type: boolean\n        default: false\n      waivers-path:\n        description: Caller-side waiver document path.\n        required: false\n        type: string\n        default: output/findings/waivers.json\n      rule-config-path:\n        description: Caller-side rule configuration path.\n        required: false\n        type: string\n        default: .scp/rule-config.yaml\n      fixture-path:\n        description: Restrict changed-file discovery to a fixture subtree when the selftest harness invokes the workflow.\n        required: false\n        type: string\n        default: .\n      scorecard-emit:\n        description: |\n          Opt-in: emit `output/scorecards/scorecard-emit.json` alongside the\n          policy-check run for cross-repo scorecard aggregation per WP-SCP-023.\n          Default false (existing adopters see no behaviour change). Adopters\n          opt in by setting `with: scorecard-emit: true`. The emit carries\n          aggregated counts only — NEVER waiver content (per WP-SCP-023\n          plan-doc invariant 2). See `schemas/scorecard-emit.schema.json` for\n          the data shape and ADOPT-001 §13 (lands in slice 023D) for adopter\n          onboarding. Closes WP-SCP-023 plan-doc §5 emitter contract; ratifies\n          D-041.\n        required: false\n        type: boolean\n        default: false\n\npermissions:\n  contents: read\n  statuses: write\n  # WP-SCP-023 023B: workflow-level permissions DO NOT include\n  # attestations: write or id-token: write — those are job-scoped on\n  # the `attest-scorecard` job below (closes 023B R1 MAJ-SAFE-001).\n  # Granting id-token: write workflow-wide would let any step in any\n  # policy-check run request a GitHub OIDC token asserting the SCP\n  # reusable workflow identity, exposing adopter cloud-IAM trust\n  # configurations to compromised steps in opt-out runs. Job-scoping\n  # bounds this to runs that actually opt into scorecard-emit.\n\njobs:\n  policy-check:\n    # GitHub records reusable-workflow checks as \"{calling-job-name} / scp/policy-check\".\n    # 020D1/020D2 must verify the combined context before configuring branch protection.\n    name: scp/policy-check\n    runs-on: ubuntu-24.04\n    env:\n      SCP_ANNOTATE: ${{ inputs.annotate }}\n      SCP_BASE_REF: ${{ github.event.pull_request.base.ref }}\n      SCP_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n      SCP_BYPASS: ${{ inputs.scp_bypass }}\n      SCP_BYPASS_APPROVED: \"false\"\n      SCP_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n      SCP_FIXTURE_PATH: ${{ inputs.fixture-path }}\n      SCP_PR_SHA: ${{ github.sha }}\n      SCP_RULE_CONFIG_PATH: ${{ inputs.rule-config-path }}\n      SCP_RULE_SET: ${{ inputs.rule-set }}\n      SCP_SUMMARY_PATH: policy-check-summary.json\n      SCP_THRESHOLD: ${{ inputs.threshold }}\n      SCP_RUNTIME_ROOT: .scp-runtime\n      SCP_WAIVERS_PATH: ${{ inputs.waivers-path }}\n      SCP_WORKFLOW_RUN_ID: ${{ github.run_id }}\n    steps:\n      - name: Checkout caller repository\n        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Checkout SCP runtime repository\n        # When invoked cross-repo (the standard adopter path), this step\n        # checks out the pinned SCP runtime into .scp-runtime so the\n        # install + lib-source steps can read scripts/.tool-versions,\n        # scripts/scp-policy-check.lock, lib/policy_check_invocation.sh,\n        # and policies/. When invoked LOCALLY (`uses: ./...` from the\n        # same repo, e.g. workflow-selftest), github.action_ref is\n        # empty and the populate step below symlinks the caller\n        # working directory in place of the empty .scp-runtime.\n        if: github.action_ref != ''\n        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2\n        with:\n          repository: ${{ github.action_repository }}\n          ref: ${{ github.action_ref }}\n          path: .scp-runtime\n          fetch-depth: 1\n          persist-credentials: false\n\n      - name: Populate .scp-runtime (self-call fallback)\n        # Closes the WP-SCP-022 020C.1 selftest gap. The cross-repo\n        # checkout step above always partially runs (creates .scp-runtime\n        # with an empty git init even when github.action_repository is\n        # the calling repo or the ref is local-form). We therefore\n        # detect \"did the runtime content actually land?\" by checking\n        # for scripts/.tool-versions — the canonical sentinel — rather\n        # than directory existence. If the sentinel is missing, replace\n        # .scp-runtime with a symlink to the caller working directory\n        # so the install + lib + policies steps resolve identically to\n        # the cross-repo adopter path.\n        shell: bash\n        run: |\n          set -euo pipefail\n          if [ -f .scp-runtime/scripts/.tool-versions ]; then\n            echo \"::debug::.scp-runtime populated by cross-repo checkout\"\n            exit 0\n          fi\n          rm -rf .scp-runtime\n          ln -s \"$(pwd)\" .scp-runtime\n          ls -la .scp-runtime/scripts/.tool-versions .scp-runtime/scripts/scp-policy-check.lock .scp-runtime/lib/policy_check_invocation.sh .scp-runtime/policies >/dev/null\n          echo \"::debug::.scp-runtime symlinked to caller working directory (self-call path)\"\n\n      - name: Freshness warning (wrapper pin vs SCP main HEAD)\n        # WP-SCP-022 020H.1 sub-criterion (closes ADOPT-001 §12.7.11\n        # forward-looking flag): annotate ::warning:: when the wrapper's\n        # SHA pin is more than `freshness_warning_threshold_minor`\n        # minor versions behind SCP main HEAD's published version.\n        # Best-effort — never fails the workflow. Adopters who pinned\n        # at a pre-020H.1 SHA (no version-manifest.json shipped) get a\n        # silent skip; adopters who pinned at 020H.1+ get the warning\n        # if they fall behind.\n        shell: bash\n        run: |\n          set -uo pipefail  # NOT errexit — best-effort, must not fail the gate.\n\n          pinned=\"${SCP_RUNTIME_ROOT}/version-manifest.json\"\n          if [ ! -f \"${pinned}\" ]; then\n            echo \"::debug::freshness-warning: wrapper pin predates 020H.1 (no version-manifest.json under .scp-runtime); skipping check\"\n            exit 0\n          fi\n\n          # Read BOTH minor and threshold from the PINNED (lockfile-trust)\n          # manifest. Reading the threshold from the remote main HEAD\n          # would let an attacker who compromises main HEAD silence the\n          # warning by setting threshold to a large number. The pinned\n          # manifest is SHA-pinned via the wrapper; tampering with it\n          # requires a CODEOWNERS-gated PR (per scripts/** + vendor/**\n          # CODEOWNERS coverage at the SCP source). Closes 020H.1 R1\n          # SAFE-MIN-006.\n          pinned_parsed=\"$(python3 -c '\n          import json, sys\n          try:\n              with open(sys.argv[1]) as f:\n                  p = json.load(f)\n              print(p.get(\"minor\", \"\"))\n              print(p.get(\"freshness_warning_threshold_minor\", 2))\n          except Exception:\n              print(\"\")\n              print(\"2\")\n          ' \"${pinned}\")\"\n          pinned_minor=\"$(printf '%s' \"${pinned_parsed}\" | sed -n '1p')\"\n          threshold=\"$(printf '%s' \"${pinned_parsed}\" | sed -n '2p')\"\n\n          if [ -z \"${pinned_minor}\" ]; then\n            echo \"::debug::freshness-warning: pinned manifest has no minor field; skipping\"\n            exit 0\n          fi\n\n          # Fetch SCP main HEAD's manifest. Public raw URL; --max-time\n          # caps the network step so a flaky connection cannot stretch\n          # CI wall-clock. --fail prevents an HTML 404 page from being\n          # parsed as JSON.\n          main_manifest_url=\"https://raw.githubusercontent.com/jrnb2024/standards-control-plane/main/version-manifest.json\"\n          main_manifest=\"$(curl --fail --silent --show-error --location --max-time 10 \"${main_manifest_url}\")\" || {\n            echo \"::debug::freshness-warning: could not fetch ${main_manifest_url} (network error or 404); skipping\"\n            exit 0\n          }\n\n          main_minor=\"$(printf '%s' \"${main_manifest}\" | python3 -c '\n          import json, sys\n          try:\n              p = json.load(sys.stdin)\n              print(p.get(\"minor\", \"\"))\n          except Exception:\n              pass\n          ')\"\n\n          if [ -z \"${main_minor}\" ]; then\n            echo \"::debug::freshness-warning: main manifest has no minor field; skipping\"\n            exit 0\n          fi\n\n          # Parse \"X.Y\" minor strings as floats for comparison; falls\n          # back to string-equal if parse fails.\n          delta=\"$(python3 -c '\n          import sys\n          try:\n              pinned = sys.argv[1].split(\".\")\n              main = sys.argv[2].split(\".\")\n              # Compare: same major → diff in minor; diff major → cap at threshold+1 to surface\n              if pinned[0] != main[0]:\n                  print(int(sys.argv[3]) + 1)\n              else:\n                  print(int(main[1]) - int(pinned[1]))\n          except Exception:\n","exit_code":0,"status":"completed"}}

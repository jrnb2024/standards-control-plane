\n   624\t  fi\n   625\t\n   626\t  log \"restoring branch protection (unified PUT)...\"\n   627\t  printf '%s' \"$RESTORE_PAYLOAD\" | gh api -X PUT \"repos/${REPO}/branches/${BRANCH}/protection\" \\\n   628\t    -H \"Accept: application/vnd.github+json\" \\\n   629\t    --input - >/dev/null || APPLY_FAIL=1\n   630\t\n   631\t  if [ \"$APPLY_FAIL\" -ne 0 ]; then\n   632\t    echo \"ERROR: unified PUT failed; partial branch-protection state may exist on ${REPO}@${BRANCH}\" >&2\n   633\t    echo \"       continuing to log emission so the failure is auditable, then exiting non-zero\" >&2\n   634\t    FAIL=1\n   635\t  else\n   636\t    restore_signatures_enabled=\"$(printf '%s' \"$RESTORE_TARGET_JSON\" | jq -r '.required_signatures.enabled // false')\"\n   637\t    if [ \"$restore_signatures_enabled\" = \"true\" ]; then\n   638\t      log \"restoring required_signatures (dedicated sub-resource: enable)...\"\n   639\t      restore_signatures_err=\"$(mktemp)\"\n   640\t      if ! gh api -X POST \"repos/${REPO}/branches/${BRANCH}/protection/required_signatures\" >/dev/null 2>\"$restore_signatures_err\"; then\n   641\t        if grep -q '404' \"$restore_signatures_err\"; then\n   642\t          log \"required_signatures POST already in desired state (404 suppressed)\"\n   643\t        else\n   644\t          echo \"ERROR: required_signatures POST failed; status-checks/admins/reviews are set but signatures are NOT\" >&2\n   645\t          echo \"       continuing to log emission so the partial-state failure is auditable, then exiting non-zero\" >&2\n   646\t          APPLY_FAIL=1\n   647\t          FAIL=1\n   648\t        fi\n   649\t      fi\n   650\t      rm -f \"$restore_signatures_err\"\n   651\t    else\n   652\t      log \"restoring required_signatures (dedicated sub-resource: disable)...\"\n   653\t      restore_signatures_err=\"$(mktemp)\"\n   654\t      if ! gh api -X DELETE \"repos/${REPO}/branches/${BRANCH}/protection/required_signatures\" >/dev/null 2>\"$restore_signatures_err\"; then\n   655\t        if grep -q '404' \"$restore_signatures_err\"; then\n   656\t          log \"required_signatures DELETE already in desired state (404 suppressed)\"\n   657\t        else\n   658\t          echo \"ERROR: required_signatures DELETE failed; status-checks/admins/reviews are set but signatures are NOT\" >&2\n   659\t          echo \"       continuing to log emission so the partial-state failure is auditable, then exiting non-zero\" >&2\n   660\t          APPLY_FAIL=1\n   661\t          FAIL=1\n   662\t        fi\n   663\t      fi\n   664\t      rm -f \"$restore_signatures_err\"\n   665\t    fi\n   666\t  fi\n   667\telse\n   668\t  log \"applying branch protection (unified PUT)...\"\n   669\t  printf '%s' \"$PAYLOAD\" | gh api -X PUT \"repos/${REPO}/branches/${BRANCH}/protection\" \\\n   670\t    -H \"Accept: application/vnd.github+json\" \\\n   671\t    --input - >/dev/null || APPLY_FAIL=1\n   672\t\n   673\t  if [ \"$APPLY_FAIL\" -ne 0 ]; then\n   674\t    echo \"ERROR: unified PUT failed; partial branch-protection state may exist on ${REPO}@${BRANCH}\" >&2\n   675\t    echo \"       continuing to log emission so the failure is auditable, then exiting non-zero\" >&2\n   676\t    FAIL=1\n   677\t  else\n   678\t    log \"enabling required_signatures (dedicated sub-resource)...\"\n   679\t    gh api -X POST \"repos/${REPO}/branches/${BRANCH}/protection/required_signatures\" >/dev/null || APPLY_FAIL=1\n   680\t    if [ \"$APPLY_FAIL\" -ne 0 ]; then\n   681\t      echo \"ERROR: required_signatures POST failed; status-checks/admins/reviews are set but signatures are NOT\" >&2\n   682\t      echo \"       continuing to log emission so the partial-state failure is auditable, then exiting non-zero\" >&2\n   683\t      FAIL=1\n   684\t    fi\n   685\t  fi\n   686\tfi\n   687\t\n   688\t# ---------- Verify ----------\n   689\t\n   690\tlog \"verifying...\"\n   691\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n   692\t  AFTER_RAW=\"$(gh api -X GET \"repos/${REPO}/branches/${BRANCH}/protection\" 2>&1)\" || AFTER_STATUS=$?\n   693\t  AFTER_STATUS=\"${AFTER_STATUS:-0}\"\n   694\t  if [ \"$AFTER_STATUS\" -eq 0 ]; then\n   695\t    AFTER_JSON=\"$AFTER_RAW\"\n   696\t  else\n   697\t    AFTER_JSON='{\"_error\":\"restore after-state capture failed\"}'\n   698\t    echo \"ERROR: post-restore GET branch-protection failed; continuing to log emission so the failure is auditable\" >&2\n   699\t    APPLY_FAIL=1\n   700\t    FAIL=1\n   701\t  fi\n   702\telse\n   703\t  AFTER_JSON=\"$(gh api -X GET \"repos/${REPO}/branches/${BRANCH}/protection\")\"\n   704\tfi\n   705\t\n   706\tCHECKS_STRICT=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_status_checks.strict // false')\"\n   707\tCHECKS_CONTEXTS=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_status_checks.contexts // [] | join(\",\")')\"\n   708\tAPPLIED_ADMINS=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.enforce_admins.enabled // false')\"\n   709\tSIGS_ENABLED=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_signatures.enabled // false')\"\n   710\t\n   711\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n   712\t  EXPECTED_CHECKS_STRICT=\"$RESTORE_TARGET_CHECKS_STRICT\"\n   713\t  EXPECTED_CHECKS_CONTEXTS=\"$RESTORE_TARGET_CHECKS_CONTEXTS\"\n   714\t  EXPECTED_APPLIED_ADMINS=\"$RESTORE_TARGET_ADMINS_ENABLED\"\n   715\t  EXPECTED_SIGS_ENABLED=\"$RESTORE_SIGNATURES_ENABLED\"\n   716\telse\n   717\t  EXPECTED_CHECKS_STRICT=\"true\"\n   718\t  EXPECTED_CHECKS_CONTEXTS=\"$REQUIRED_CONTEXT\"\n   719\t  EXPECTED_APPLIED_ADMINS=\"$ENFORCE_ADMINS\"\n   720\t  EXPECTED_SIGS_ENABLED=\"true\"\n   721\tfi\n   722\t\n   723\t# Closes 020G R3 correctness CORR3-001 + safety SAF-R3-001:\n   724\t# preserve any FAIL=1 set by the apply-phase trap. Initialising\n   725\t# FAIL=0 unconditionally would launder an apply-failure into a\n   726\t# false-success when the pre-existing state happens to satisfy\n   727\t# the verify checks. Default to 0 only if not already set.\n   728\tFAIL=\"${FAIL:-0}\"\n   729\t[ \"$CHECKS_STRICT\" = \"$EXPECTED_CHECKS_STRICT\" ] || { echo \"verify FAIL: required_status_checks.strict=${CHECKS_STRICT} (expected ${EXPECTED_CHECKS_STRICT})\" >&2; FAIL=1; }\n   730\tif [ -n \"$EXPECTED_CHECKS_CONTEXTS\" ]; then\n   731\t  printf '%s' \"$CHECKS_CONTEXTS\" | grep -q -F \"$EXPECTED_CHECKS_CONTEXTS\" || { echo \"verify FAIL: contexts missing ${EXPECTED_CHECKS_CONTEXTS} (got: ${CHECKS_CONTEXTS})\" >&2; FAIL=1; }\n   732\telse\n   733\t  [ -z \"$CHECKS_CONTEXTS\" ] || { echo \"verify FAIL: contexts expected to be empty (got: ${CHECKS_CONTEXTS})\" >&2; FAIL=1; }\n   734\tfi\n   735\t[ \"$APPLIED_ADMINS\" = \"$EXPECTED_APPLIED_ADMINS\" ] || { echo \"verify FAIL: enforce_admins=${APPLIED_ADMINS} (expected ${EXPECTED_APPLIED_ADMINS})\" >&2; FAIL=1; }\n   736\t[ \"$SIGS_ENABLED\" = \"$EXPECTED_SIGS_ENABLED\" ] || { echo \"verify FAIL: required_signatures=${SIGS_ENABLED} (expected ${EXPECTED_SIGS_ENABLED})\" >&2; FAIL=1; }\n   737\t\n   738\t# Closes 020G R2 correctness CORR2-001 + safety SAF-R2-002: only\n   739\t# emit \"verification passed\" when FAIL=0. Previously this line\n   740\t# emitted unconditionally after the fall-through, producing a\n   741\t# misleading false-success message on stdout when verification had\n   742\t# actually failed.\n   743\tif [ \"${FAIL:-0}\" -ne 0 ]; then\n   744\t  echo \"verification failed; see message(s) above\" >&2\n   745\t  echo \"\" >&2\n   746\t  echo \"Even on failure, capture an invocation log entry so the audit trail\" >&2\n   747\t  echo \"records the failure. The before/after blocks below show the partial\" >&2\n   748\t  echo \"state and aid post-mortem.\" >&2\n   749\t  # fall through to log emission so an audit entry exists\n   750\telse\n   751\t  log \"verification passed ✓\"\n   752\t  log \"  required check:        ${CHECKS_CONTEXTS} (strict=${CHECKS_STRICT})\"\n   753\t  log \"  enforce_admins:        ${APPLIED_ADMINS}\"\n   754\t  log \"  required_signatures:   ${SIGS_ENABLED}\"\n   755\tfi\n   756\t\n   757\t# ---------- Emit invocation log ----------\n   758\t#\n   759\t# Per 020G R1 safety SAF-001 + correctness CORR-002:\n   760\t# the audit trail records the SHA256 of the actually-running\n   761\t# script content (not the last-committed git SHA, which can lie if\n   762\t# the operator has uncommitted changes or runs from outside an SCP\n   763\t# clone). The git-SHA is recorded as a secondary identifier when\n   764\t# available.\n   765\t\n   766\t# Self-hash via $0. Exits non-zero only if the script can't read\n   767\t# itself, which is essentially impossible at this point.\n   768\tSCRIPT_PATH=\"$(readlink -f \"$0\" 2>/dev/null || printf '%s' \"$0\")\"\n   769\tSCRIPT_SHA256=\"$(shasum -a 256 \"$SCRIPT_PATH\" | awk '{print $1}')\"\n   770\t\n   771\t# Try to also report the last-committed git SHA if we're inside an\n   772\t# SCP-shaped clone. Empty fallback is explicit.\n   773\tSCRIPT_GIT_SHA=\"$(git -C \"$(dirname \"$SCRIPT_PATH\")\" log -1 --format=%H -- \"$(basename \"$SCRIPT_PATH\")\" 2>/dev/null || true)\"\n   774\tSCRIPT_GIT_SHA=\"${SCRIPT_GIT_SHA:-not-in-git-clone}\"\n   775\t\n   776\tOPERATOR=\"$(gh api user --jq '.login' 2>/dev/null || echo unknown)\"\n   777\tTS=\"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"\n   778\t\n   779\tLOG_FILE=\"docs/reviews/WP-SCP-020/branch-protection-log.md\"\n   780\t\n   781\t# Emit the log block. Use ~~~~ outer fence so inner ``` JSON\n   782\t# fences nest correctly (CommonMark requires the closing fence\n   783\t# to match the opening fence character; fence types ~~~ and ```\n   784\t# do not collide). Closes 020G R1 correctness CORR-001.\n   785\t\n   786\tif [ \"$RESTORE_MODE\" -eq 1 ]; then\n   787\t  cat <<EOF\n   788\t---\n   789\t\n   790\t## Invocation log entry\n   791\t\n   792\tAppend the block below to ${LOG_FILE} on the SCP repo, commit on\n   793\ta feature branch, open PR, merge:\n   794\t\n   795\t~~~markdown\n   796\t### ${TS} — ${REPO}@${BRANCH}\n   797\t\n   798\t- **Operator:** @${OPERATOR}\n   799\t- **Script SHA256:** \\`${SCRIPT_SHA256}\\` (hash of executed file)\n   800\t- **Script git SHA:** \\`${SCRIPT_GIT_SHA}\\` (last committed; \"not-in-git-clone\" if N/A)\n   801\t- **Required check:** \\`${RESTORE_TARGET_CHECKS_CONTEXTS}\\`\n   802\t- **enforce_admins:** ${RESTORE_TARGET_ADMINS_ENABLED}\n   803\t- **Plan-only:** no\n   804\t- **Restore mode:** yes\n   805\t- **Restoring TO:**\n   806\t\\`\\`\\`json\n   807\t$(printf '%s' \"$RESTORE_TARGET_JSON\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$RESTORE_TARGET_JSON\")\n   808\t\\`\\`\\`\n   809\t- **Before:**\n   810\t\\`\\`\\`json\n   811\t$(printf '%s' \"$BEFORE_JSON\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$BEFORE_JSON\")\n   812\t\\`\\`\\`\n   813\t- **After:**\n   814\t\\`\\`\\`json\n   815\t$(printf '%s' \"$AFTER_JSON\" | python3 -m json.tool 2>/dev/null || printf '%s' \"$AFTER_JSON\")\n   816\t\\`\\`\\`\n   817\t~~~\n   818\t\n   819\tThe log commit is part of the invocation procedure per WP-SCP-020\n   820\t§4 020G(iii) + D-035; without it the apply is unrecorded.\n   821\tEOF\n   822\telse\n   823\t  cat <<EOF\n   824\t---\n   825\t\n   826\t## Invocation log entry\n   827\t\n   828\tAppend the block below to ${LOG_FILE} on the SCP repo, commit on\n   829\ta feature branch, open PR, merge:\n   830\t\n   831\t~~~markdown\n   832\t### ${TS} — ${REPO}@${BRANCH}\n   833\t\n   834\t- **Operator:** @${OPERATOR}\n   835\t- **Script SHA256:** \\`${SCRIPT_SHA256}\\` (hash of executed file)\n   836\t- **Script git SHA:** \\`${SCRIPT_GIT_SHA}\\` (last committed; \"not-in-git-clone\" if N/A)\n   837\t- **Required check:** \\`${REQUIRED_CONTEXT}\\`\n   838\t- **enforce_admins:** ${ENFORCE_ADMINS}\n   839\t- **Plan-only:** no\n   840\t- **PUT payload applied:**\n","exit_code":0,"status":"completed"}}

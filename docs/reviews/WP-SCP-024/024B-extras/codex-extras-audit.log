{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"required_signatures|APPLY_FAIL|restore|plan-only|emit|log entry|branch-protection\" scripts/enable-required-check.sh'","aggregated_output":"3:# WP-SCP-020 slice 020G — adopter-side branch-protection helper.\n14:#   - required_signatures = true (every commit verified-signed,\n31:#   - paste the emitted markdown log entry into the SCP repo's\n32:#     `docs/reviews/WP-SCP-020/branch-protection-log.md` and merge.\n35:# WP-SCP-020 §4 020G(iii). The script emits a log block on EVERY\n38:# required_signatures POST fails) — the operator commits the\n39:# resulting log entry whether the apply succeeded or partially\n92:  # 2.40 floor — the unified branch-protection PUT shape used here\n230:# verbatim in the emitted markdown log block; backticks or\n231:# newlines would corrupt the operator's pasteable log entry. Reject\n254:[ \"$PLAN_ONLY\" = \"1\" ] && log \"MODE: plan-only (no API mutation)\"\n258:# Per 020G R1 correctness CORR-003: required_signatures is a\n260:# unified branch-protection PUT body. Apply it separately via\n261:# the /required_signatures endpoint after the main PUT. The\n262:# unified PUT body therefore omits required_signatures.\n317:# review-shape verbatim and does NOT set dismiss_stale_reviews; emit\n337:  log \"current branch-protection state (before):\"\n341:  log \"post-PUT, would also enable required_signatures via the dedicated sub-resource.\"\n349:# the apply phase so partial state still emits an audit-trail\n350:# log entry. Otherwise `set -e` skips log emission entirely on\n353:APPLY_FAIL=0\n358:  --input - >/dev/null || APPLY_FAIL=1\n360:if [ \"$APPLY_FAIL\" -ne 0 ]; then\n361:  echo \"ERROR: unified PUT failed; partial branch-protection state may exist on ${REPO}@${BRANCH}\" >&2\n365:  log \"enabling required_signatures (dedicated sub-resource)...\"\n366:  gh api -X POST \"repos/${REPO}/branches/${BRANCH}/protection/required_signatures\" >/dev/null || APPLY_FAIL=1\n367:  if [ \"$APPLY_FAIL\" -ne 0 ]; then\n368:    echo \"ERROR: required_signatures POST failed; status-checks/admins/reviews are set but signatures are NOT\" >&2\n382:SIGS_ENABLED=\"$(printf '%s' \"$AFTER_JSON\" | jq -r '.required_signatures.enabled // false')\"\n393:[ \"$SIGS_ENABLED\" = \"true\" ] || { echo \"verify FAIL: required_signatures=${SIGS_ENABLED}\" >&2; FAIL=1; }\n396:# emit \"verification passed\" when FAIL=0. Previously this line\n397:# emitted unconditionally after the fall-through, producing a\n403:  echo \"Even on failure, capture an invocation log entry so the audit trail\" >&2\n411:  log \"  required_signatures:   ${SIGS_ENABLED}\"\n436:LOG_FILE=\"docs/reviews/WP-SCP-020/branch-protection-log.md\"\n446:## Invocation log entry\n479:# verification failure even though the log block IS emitted, so\n","exit_code":0,"status":"completed"}}

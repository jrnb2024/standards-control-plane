{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,120p' .github/workflows/check-invocation-log-entry.yml\"","aggregated_output":"# WP-SCP-024 024B-extras — CI wiring for the invocation-log gate.\n#\n# D-047 ratifies the break-glass restore flow and this workflow wiring.\n# D-048 governs the depth-defense surface (024B-extras-2).\n# 024B-extras-3 pins script execution to origin/main per\n# TF-024B-EXTRAS-2-WORKFLOW-PIN-BASE-BRANCH-001 — an attacker-modified PR\n# cannot substitute the enforcement script.\n# Plan-doc invariant 2 still governs the enforcement script itself;\n# this workflow just feeds it the correct slice-local arguments.\n#\n# Critical bootstrap guard: the job body short-circuits tooling slices\n# or PRs with no cascade note in diff. Cohort slices take precedence\n# over tooling slices when a PR touches multiple dispatch-note paths.\n\nname: check-invocation-log-entry\n\n\"on\":\n  pull_request:\n    branches: [main]\n    types: [opened, synchronize, reopened]\n    paths:\n      - \"docs/reviews/WP-SCP-024/024[C-Z]*/**\"\n      - \"docs/reviews/WP-SCP-020/branch-protection-log.md\"\n      - \"STATUS.md\"\n\npermissions:\n  contents: read\n  pull-requests: read\n\njobs:\n  check-invocation-log-entry:\n    runs-on: ubuntu-24.04\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Resolve dispatch note path\n        id: resolve-dispatch\n        shell: bash\n        env:\n          GH_TOKEN: ${{ github.token }}\n          PR_NUMBER: ${{ github.event.pull_request.number }}\n        run: |\n          set -euo pipefail\n          pr_files=\"$(gh pr diff \"$PR_NUMBER\" --name-only --repo \"$GITHUB_REPOSITORY\")\"\n          all_dispatch_notes=\"$(printf '%s\\n' \"$pr_files\" | grep -E '^docs/reviews/WP-SCP-024/024[A-Za-z][^/]*/DISPATCH-NOTE.md$' || true)\"\n          log_modified_count=\"$(printf '%s\\n' \"$pr_files\" | grep -c '^docs/reviews/WP-SCP-020/branch-protection-log.md$' || true)\"\n          if [ -z \"$all_dispatch_notes\" ]; then\n            if [ \"$log_modified_count\" -gt 0 ]; then\n              echo \"ERROR: branch-protection-log.md was modified without a corresponding cascade-slice DISPATCH-NOTE update; cascade-status declaration required.\" >&2\n              exit 1\n            fi\n            echo \"No cascade-slice DISPATCH-NOTE found in PR diff; not a cohort cascade slice - nothing to enforce.\"\n            printf 'enforce=false\\n' >> \"$GITHUB_OUTPUT\"\n            exit 0\n          fi\n\n          # Prefer cohort slices (024C-024F) over tooling slices so a\n          # mixed PR cannot short-circuit enforcement on the wrong note.\n          cohort_dispatch_note=\"$(printf '%s\\n' \"$all_dispatch_notes\" | grep -E '^docs/reviews/WP-SCP-024/024[C-F]/DISPATCH-NOTE.md$' | head -n1 || true)\"\n          if [ -n \"$cohort_dispatch_note\" ]; then\n            dispatch_note=\"$cohort_dispatch_note\"\n          else\n            dispatch_note=\"$(printf '%s\\n' \"$all_dispatch_notes\" | head -n1)\"\n          fi\n\n          slice_id=\"$(basename \"$(dirname \"$dispatch_note\")\")\"\n          case \"$slice_id\" in\n            024A|024B-core|024B-extras|024B-extras-2|024G)\n              if [ \"$log_modified_count\" -gt 0 ]; then\n                echo 'ERROR: branch-protection-log.md must not be modified in a tooling-slice PR' >&2\n                exit 1\n              fi\n              echo \"Tooling slice ($slice_id); no enforcement needed.\"\n              printf 'enforce=false\\n' >> \"$GITHUB_OUTPUT\"\n              exit 0\n              ;;\n          esac\n          printf 'enforce=true\\n' >> \"$GITHUB_OUTPUT\"\n          printf 'dispatch_note=%s\\n' \"$dispatch_note\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Check invocation log entry\n        if: steps.resolve-dispatch.outputs.enforce == 'true'\n        shell: bash\n        env:\n          dispatch_note: ${{ steps.resolve-dispatch.outputs.dispatch_note }}\n        run: |\n          set -euo pipefail\n          # Pin enforcement to the base-branch (origin/main) version of the\n          # script rather than the PR HEAD copy. Closes\n          # TF-024B-EXTRAS-2-WORKFLOW-PIN-BASE-BRANCH-001: an attacker-modified\n          # PR could otherwise substitute a no-op enforcement script and\n          # bypass the gate. The actions/checkout step above runs with\n          # fetch-depth: 0 so origin/main is available locally.\n          enforcer_script=\"$(mktemp)\"\n          trap 'rm -f \"$enforcer_script\"' EXIT\n          git show origin/main:scripts/check-invocation-log-entry.sh > \"$enforcer_script\"\n          bash \"$enforcer_script\" \\\n            --diff-base origin/main \\\n            --dispatch-note \"$dispatch_note\" \\\n            --status-md STATUS.md \\\n            --branch-protection-log docs/reviews/WP-SCP-020/branch-protection-log.md\n","exit_code":0,"status":"completed"}}

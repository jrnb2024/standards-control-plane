{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope_paths", "files"],
  "properties": {
    "scope_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "files": {
      "type": "array",
      "items": {"$ref": "./extracted-file-record.schema.json"}
    }
  }
}

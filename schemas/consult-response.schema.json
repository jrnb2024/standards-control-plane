{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "domains",
    "applicable_rules",
    "approved_patterns",
    "open_findings",
    "historical_reviews",
    "guidance",
    "risks",
    "confidence",
    "confidence_class"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["governance", "architecture", "ux", "design", "product"]
      }
    },
    "applicable_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "reason"],
        "properties": {
          "rule_id": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "approved_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern_id", "reason"],
        "properties": {
          "pattern_id": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "open_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "summary", "confidence_class"],
        "properties": {
          "finding_id": {"type": "string"},
          "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "summary": {"type": "string"},
          "confidence_class": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "historical_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_id", "path", "summary"],
        "properties": {
          "review_id": {"type": "string"},
          "path": {"type": "string"},
          "summary": {"type": "string"}
        }
      }
    },
    "guidance": {
      "type": "array",
      "items": {"type": "string"}
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_class": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    }
  }
}

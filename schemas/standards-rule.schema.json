{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "domain",
    "title",
    "summary",
    "severity_default",
    "scope",
    "signals",
    "version",
    "status"
  ],
  "properties": {
    "rule_id": {"type": "string"},
    "domain": {"type": "string", "enum": ["governance", "architecture", "ux", "design", "product"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "severity_default": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "scope": {
      "type": "array",
      "items": {"type": "string"}
    },
    "signals": {
      "type": "array",
      "items": {"type": "string"}
    },
    "exceptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "related_patterns": {
      "type": "array",
      "items": {"type": "string"}
    },
    "version": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "active", "deprecated", "archived"]}
  }
}


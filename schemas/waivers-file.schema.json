{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "anyOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "reason",
          "approved_by",
          "expires_at",
          "created_at"
        ],
        "properties": {
          "waiver_id": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "$ref": "#/$defs/dateOrDateTime"
          },
          "created_at": {
            "$ref": "#/$defs/dateOrDateTime"
          }
        }
      },
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "waiver_id",
          "finding_id",
          "reason",
          "approved_by",
          "expires_at",
          "created_at"
        ],
        "properties": {
          "waiver_id": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "$ref": "#/$defs/dateOrDateTime"
          },
          "created_at": {
            "$ref": "#/$defs/dateOrDateTime"
          }
        }
      }
    ]
  },
  "$defs": {
    "dateOrDateTime": {
      "type": "string",
      "anyOf": [
        {
          "format": "date"
        },
        {
          "format": "date-time"
        }
      ]
    }
  }
}

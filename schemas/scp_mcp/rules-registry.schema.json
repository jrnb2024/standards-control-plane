{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/scp_mcp/rules-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key_id",
    "registry"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "key_id": {
      "$ref": "./common.schema.json#/$defs/keyId"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "status",
        "domains"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "domains": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain",
              "version",
              "status",
              "rules",
              "patterns"
            ],
            "properties": {
              "domain": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "rules": {
                "type": "array",
                "items": {
                  "$ref": "./common.schema.json#/$defs/rule"
                }
              },
              "patterns": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}

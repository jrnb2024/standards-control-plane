{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/scp_mcp/rule-card.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key_id",
    "rule"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "key_id": {
      "$ref": "./common.schema.json#/$defs/keyId"
    },
    "rule": {
      "allOf": [
        {
          "$ref": "./common.schema.json#/$defs/rule"
        },
        {
          "type": "object",
          "required": [
            "body_markdown"
          ]
        }
      ]
    }
  }
}

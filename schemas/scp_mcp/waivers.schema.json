{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/scp_mcp/waivers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key_id",
    "waivers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "key_id": {
      "$ref": "./common.schema.json#/$defs/keyId"
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "./common.schema.json#/$defs/waiver"
      }
    }
  }
}

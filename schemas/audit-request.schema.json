{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "domains", "scope", "standards_version"],
  "properties": {
    "mode": {
      "const": "audit"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["governance", "architecture", "ux", "design", "product"]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": true
    },
    "baseline_findings_file": {
      "type": "string"
    },
    "standards_version": {
      "type": "string",
      "minLength": 1
    }
  }
}


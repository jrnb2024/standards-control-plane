{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "domains", "scope", "standards_version"],
  "properties": {
    "mode": {
      "const": "audit"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["governance", "architecture", "ux", "design", "product", "service-lifecycle"]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "required": ["paths", "subsystem"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "subsystem": {
          "type": "string",
          "minLength": 1
        },
        "area_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "baseline_findings_file": {
      "type": "string"
    },
    "standards_version": {
      "type": "string",
      "minLength": 1,
      "format": "date"
    }
  }
}

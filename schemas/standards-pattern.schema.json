{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pattern_id",
    "domain",
    "title",
    "summary",
    "path",
    "version",
    "status"
  ],
  "properties": {
    "pattern_id": {"type": "string"},
    "domain": {"type": "string", "enum": ["governance", "architecture", "ux", "design", "product"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "path": {"type": "string"},
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "version": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "active", "deprecated", "archived"]}
  }
}

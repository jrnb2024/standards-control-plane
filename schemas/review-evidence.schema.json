{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "area_id",
    "reviewed_at",
    "summary",
    "reviewed_paths",
    "findings"
  ],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "area_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1},
    "reviewed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "status", "summary"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["open", "accepted", "waived", "resolved", "false_positive", "superseded"]
          },
          "summary": {"type": "string", "minLength": 1},
          "domain": {
            "type": "string",
            "enum": ["governance", "architecture", "ux", "design", "product"]
          }
        }
      }
    }
  }
}

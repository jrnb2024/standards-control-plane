#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)"
TOOL_VERSIONS_FILE="${SCP_POLICY_CHECK_TOOL_VERSIONS:-${SCRIPT_DIR}/.tool-versions}"
LOCKFILE="${SCP_POLICY_CHECK_LOCKFILE:-${SCRIPT_DIR}/scp-policy-check.lock}"
CACHE_ROOT="${SCP_POLICY_CHECK_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME}/.cache}/scp}"
PLATFORM_SYSTEM="${SCP_POLICY_CHECK_UNAME_S:-$(uname -s)}"
PLATFORM_MACHINE="${SCP_POLICY_CHECK_UNAME_M:-$(uname -m)}"
CHANGED_FILES_PATH="${SCP_CHANGED_FILES_PATH:-}"

emit_error() {
  local message="$1"
  printf 'scp-policy-check: %s\n' "$message" >&2
}

cleanup() {
  if [ -n "${CHANGED_FILES_PATH}" ] && [ -f "${CHANGED_FILES_PATH}" ] && [ "${CHANGED_FILES_PATH#${TMPDIR:-/tmp}/scp-policy-check.}" != "${CHANGED_FILES_PATH}" ]; then
    rm -f "${CHANGED_FILES_PATH}"
  fi
}

trap cleanup EXIT

read_tool_version() {
  local tool="$1"
  awk -v tool="$tool" '
    $1 == tool {
      print $2
      found = 1
      exit
    }
    END {
      if (!found) {
        exit 1
      }
    }
  ' "$TOOL_VERSIONS_FILE"
}

detect_platform_key() {
  local os="$1"
  local arch="$2"
  local os_key
  local arch_key

  case "$os" in
    Linux) os_key="linux" ;;
    Darwin) os_key="darwin" ;;
    *)
      return 1
      ;;
  esac

  case "$arch" in
    x86_64|amd64) arch_key="x64" ;;
    arm64|aarch64) arch_key="arm64" ;;
    *)
      return 1
      ;;
  esac

  printf '%s-%s\n' "$os_key" "$arch_key"
}

json_lock_field() {
  local tool="$1"
  local platform_key="$2"
  local field="$3"

  python3 - "$LOCKFILE" "$tool" "$platform_key" "$field" <<'PY'
import json
import sys
from pathlib import Path

lockfile = Path(sys.argv[1])
tool = sys.argv[2]
platform_key = sys.argv[3]
field = sys.argv[4]
payload = json.loads(lockfile.read_text())

try:
    value = payload[tool][platform_key][field]
except KeyError as exc:
    raise SystemExit(f"missing lockfile field: {exc}")

print(value)
PY
}

sha256_file() {
  local path="$1"
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$path" | awk '{print $1}'
    return
  fi
  sha256sum "$path" | awk '{print $1}'
}

verify_file_sha() {
  local path="$1"
  local expected="$2"
  [ "$(sha256_file "$path")" = "$expected" ]
}

ensure_cached_binary() {
  local label="$1"
  local path="$2"
  local expected_sha="$3"

  if [ ! -f "$path" ]; then
    return 1
  fi

  if ! verify_file_sha "$path" "$expected_sha"; then
    emit_error "${label} at ${path} failed SHA256 verification against ${LOCKFILE}; refusing to run."
    exit 1
  fi

  printf 'Using cached %s at %s\n' "$label" "$path" >&2
  return 0
}

download_opa() {
  local version="$1"
  local platform_key="$2"
  local asset
  local expected_sha
  local cache_dir
  local binary_path
  local base_url
  local tmp_path

  asset="$(json_lock_field opa "$platform_key" asset)"
  expected_sha="$(json_lock_field opa "$platform_key" sha256)"
  cache_dir="${CACHE_ROOT}/opa/${version}/${platform_key}"
  binary_path="${cache_dir}/opa"

  if ensure_cached_binary "OPA" "$binary_path" "$expected_sha"; then
    printf '%s\n' "$binary_path"
    return
  fi

  mkdir -p "$cache_dir"
  tmp_path="$(mktemp "${TMPDIR:-/tmp}/scp-opa.XXXXXX")"
  base_url="${SCP_POLICY_CHECK_OPA_BASE_URL:-https://github.com/open-policy-agent/opa/releases/download/v${version}}"

  printf 'Downloading OPA %s for %s\n' "$version" "$platform_key" >&2
  if ! curl --fail --silent --show-error --location "${base_url}/${asset}" --output "$tmp_path"; then
    rm -f "$tmp_path"
    emit_error "failed to download OPA ${version} from ${base_url}/${asset}"
    exit 1
  fi

  if ! verify_file_sha "$tmp_path" "$expected_sha"; then
    rm -f "$tmp_path"
    emit_error "downloaded OPA ${asset} failed SHA256 verification against ${LOCKFILE}; refusing to run."
    exit 1
  fi

  install -m 0755 "$tmp_path" "$binary_path"
  rm -f "$tmp_path"
  printf '%s\n' "$binary_path"
}

download_conftest() {
  local version="$1"
  local platform_key="$2"
  local asset
  local expected_sha
  local expected_archive_sha
  local cache_dir
  local binary_path
  local base_url
  local tmp_archive
  local tmp_extract

  asset="$(json_lock_field conftest "$platform_key" asset)"
  expected_sha="$(json_lock_field conftest "$platform_key" sha256)"
  expected_archive_sha="$(json_lock_field conftest "$platform_key" archive_sha256 2>/dev/null || true)"
  cache_dir="${CACHE_ROOT}/conftest/${version}/${platform_key}"
  binary_path="${cache_dir}/conftest"

  if ensure_cached_binary "Conftest" "$binary_path" "$expected_sha"; then
    printf '%s\n' "$binary_path"
    return
  fi

  mkdir -p "$cache_dir"
  tmp_archive="$(mktemp "${TMPDIR:-/tmp}/scp-conftest.XXXXXX.tar.gz")"
  tmp_extract="$(mktemp -d "${TMPDIR:-/tmp}/scp-conftest.XXXXXX")"
  base_url="${SCP_POLICY_CHECK_CONFTEST_BASE_URL:-https://github.com/open-policy-agent/conftest/releases/download/v${version}}"

  printf 'Downloading Conftest %s for %s\n' "$version" "$platform_key" >&2
  if ! curl --fail --silent --show-error --location "${base_url}/${asset}" --output "$tmp_archive"; then
    rm -f "$tmp_archive"
    rm -rf "$tmp_extract"
    emit_error "failed to download Conftest ${version} from ${base_url}/${asset}"
    exit 1
  fi

  if [ -n "$expected_archive_sha" ] && ! verify_file_sha "$tmp_archive" "$expected_archive_sha"; then
    rm -f "$tmp_archive"
    rm -rf "$tmp_extract"
    emit_error "downloaded Conftest archive ${asset} failed SHA256 verification against ${LOCKFILE}; refusing to run."
    exit 1
  fi

  if ! tar -xzf "$tmp_archive" -C "$tmp_extract" conftest; then
    rm -f "$tmp_archive"
    rm -rf "$tmp_extract"
    emit_error "failed to extract Conftest from ${asset}"
    exit 1
  fi

  if ! verify_file_sha "${tmp_extract}/conftest" "$expected_sha"; then
    rm -f "$tmp_archive"
    rm -rf "$tmp_extract"
    emit_error "downloaded Conftest binary from ${asset} failed SHA256 verification against ${LOCKFILE}; refusing to run."
    exit 1
  fi

  install -m 0755 "${tmp_extract}/conftest" "$binary_path"
  rm -f "$tmp_archive"
  rm -rf "$tmp_extract"
  printf '%s\n' "$binary_path"
}

prepare_changed_files() {
  if [ -n "${CHANGED_FILES_PATH}" ] && [ -f "${CHANGED_FILES_PATH}" ]; then
    return
  fi

  CHANGED_FILES_PATH="$(mktemp "${TMPDIR:-/tmp}/scp-policy-check.XXXXXX")"
  export SCP_CHANGED_FILES_PATH="${CHANGED_FILES_PATH}"

  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    : > "${CHANGED_FILES_PATH}"
    return
  fi

  git diff --name-only --cached --diff-filter=ACMRTUXB -- "${SCP_FIXTURE_PATH:-.}" > "${CHANGED_FILES_PATH}"
  if [ ! -s "${CHANGED_FILES_PATH}" ]; then
    git diff --name-only --diff-filter=ACMRTUXB -- "${SCP_FIXTURE_PATH:-.}" > "${CHANGED_FILES_PATH}"
  fi
}

if [ ! -f "$TOOL_VERSIONS_FILE" ]; then
  emit_error "tool versions file not found: ${TOOL_VERSIONS_FILE}"
  exit 1
fi

if [ ! -f "$LOCKFILE" ]; then
  emit_error "lockfile not found: ${LOCKFILE}"
  exit 1
fi

if ! PLATFORM_KEY="$(detect_platform_key "$PLATFORM_SYSTEM" "$PLATFORM_MACHINE")"; then
  emit_error "unsupported platform ${PLATFORM_SYSTEM}/${PLATFORM_MACHINE}; supported platforms: linux-x64, linux-arm64, darwin-arm64, darwin-x64"
  exit 1
fi

OPA_VERSION="$(read_tool_version opa)" || {
  emit_error "OPA version not found in ${TOOL_VERSIONS_FILE}"
  exit 1
}
CONFTST_VERSION="$(read_tool_version conftest)" || {
  emit_error "Conftest version not found in ${TOOL_VERSIONS_FILE}"
  exit 1
}

OPA_BIN="$(download_opa "$OPA_VERSION" "$PLATFORM_KEY")"
CONFTST_BIN="$(download_conftest "$CONFTST_VERSION" "$PLATFORM_KEY")"
export PATH="$(dirname "$OPA_BIN"):$(dirname "$CONFTST_BIN"):${PATH}"

prepare_changed_files

cd "$REPO_ROOT"

: "${SCP_RULE_SET:=starter}"
: "${SCP_THRESHOLD:=deny}"
: "${SCP_ANNOTATE:=false}"
: "${SCP_RULE_CONFIG_PATH:=.scp/rule-config.yaml}"
: "${SCP_WAIVERS_PATH:=output/findings/waivers.json}"

source "${REPO_ROOT}/lib/policy_check_invocation.sh"
scp_policy_check_run

if ! scp_policy_check_threshold_ok; then
  scp_policy_check_print_effective_denies
  exit 1
fi

.pytest_cache/
__pycache__/
.venv/
*.pyc
.DS_Store
.scp/
# Conflict-gate fixture sibling rule-config files (slice 020Q / TF-006) —
# fixtures intentionally mirror production layout so adopters see the same
# `.scp/rule-config.yaml` shape they would author. Negate the broad
# `.scp/` rule above for fixture paths only.
!tests/conflict_gate/fixtures/**/.scp/
!tests/conflict_gate/fixtures/**/.scp/**
*.pem
mcp-signing-key
mcp-signing-key.pub

# Setuptools editable-install artefacts (generated by 'pip install -e .[mcp]'
# during slice 021B's pyproject.toml verify; not source-tracked).
*.egg-info
*.egg-info/

# Office app lockfiles (created when .pptx / .docx / .xlsx is open)
~$*

# 024B-core test harness scratch (cleaned by EXIT trap; gitignored as belt-and-suspenders for SIGKILL leaks)
tmp.*/

# ACC kernel-hook per-worktree state (TF-PIM-001-GITIGNORE-ACC P3 close).
# Created by `install_acc_hook.sh --target-repo <SCP-worktree>` when SCP is
# adopted as an ACC Codex-dispatch target. Contents include generated
# dispatch + hook-report keypairs (under .acc/credentials/, mode 400),
# hook-audit-log (mode 700), and active-dispatch state (.acc/run/).
# These MUST NEVER commit: credentials are per-worktree-generated; audit
# logs are per-worktree; active-dispatch state is ephemeral. Mirrors the
# scp-track1 sibling worktree's pre-existing install posture.
.acc/

# env files carry per-host config; keep them out of version control (backed up off-repo)
.env
